 class TestContextManager(unittest.TestCase):
+    @asynctest
+    async def test_async_context_manager(self) -> None:
+        attempts = 0
+        async for attempt in AsyncRetrying(stop=stop_after_attempt(3)):
+            async with attempt as value:
+                assert value is None
+                attempts += 1
+                await asyncio.sleep(0)
+                if attempts < 3:
+                    raise ValueError("retry")
+            assert attempt.retry_state.outcome is not None
+            if attempts < 3:
+                assert isinstance(attempt.retry_state.outcome.exception(), ValueError)
+            else:
+                assert attempt.retry_state.outcome.result() is None
+        assert attempts == 3
+
+    @asynctest
+    async def test_async_context_manager_exhaustion(self) -> None:
+        for reraise in (False, True):
+            attempts = 0
+            error = ValueError("retry")
+            with pytest.raises(ValueError if reraise else RetryError) as exc_info:
+                async for attempt in AsyncRetrying(
+                    stop=stop_after_attempt(2), reraise=reraise
+                ):
+                    async with attempt:
+                        attempts += 1
+                        raise error
+            assert attempts == 2
+            if reraise:
+                assert exc_info.value is error
+            else:
+                assert isinstance(exc_info.value, RetryError)
+                assert exc_info.value.last_attempt.exception() is error
+

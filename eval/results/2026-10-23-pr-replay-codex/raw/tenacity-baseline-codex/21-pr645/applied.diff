diff --git a/tests/test_asyncio.py b/tests/test_asyncio.py
index f4fded1..9ea2a5b 100644
--- a/tests/test_asyncio.py
+++ b/tests/test_asyncio.py
@@ -199,6 +199,38 @@ class TestAsyncio(unittest.TestCase):
 
 
 class TestAsyncEnabled(unittest.TestCase):
+    @asynctest
+    async def test_enabled_false_direct_call(self) -> None:
+        async def check_call(is_async: bool, fails: bool) -> None:
+            call_count = 0
+            error = ValueError("fail")
+            result = object()
+
+            def fn(value: object, *, fail: bool) -> object:
+                nonlocal call_count
+                call_count += 1
+                if fail:
+                    raise error
+                return value
+
+            async def async_fn(value: object, *, fail: bool) -> object:
+                await asyncio.sleep(0)
+                return fn(value, fail=fail)
+
+            target = async_fn if is_async else mock.Mock(side_effect=fn)
+            retrying = AsyncRetrying(enabled=False, stop=stop_after_attempt(3))
+            if fails:
+                with pytest.raises(ValueError) as exc_info:
+                    await retrying(target, result, fail=True)
+                assert exc_info.value is error
+            else:
+                assert await retrying(target, result, fail=False) is result
+            assert call_count == 1
+
+        for is_async in (False, True):
+            for fails in (False, True):
+                await check_call(is_async, fails)
+
     @asynctest
     async def test_enabled_false_skips_retry(self) -> None:
         """When enabled=False, async function is called directly without retrying."""

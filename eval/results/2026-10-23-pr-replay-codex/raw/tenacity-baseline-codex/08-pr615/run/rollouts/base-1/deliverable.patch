diff --git a/tests/test_pickle.py b/tests/test_pickle.py
new file mode 100644
index 0000000..f56c6a3
--- /dev/null
+++ b/tests/test_pickle.py
@@ -0,0 +1,102 @@
+import multiprocessing
+import pickle
+import re
+import sys
+
+import pytest
+
+import tenacity
+
+
+@tenacity.retry(stop=tenacity.stop_after_attempt(2))
+def decorated_identity(value: int) -> int:
+    return value
+
+
+@pytest.mark.parametrize("protocol", [0, pickle.HIGHEST_PROTOCOL])
+@pytest.mark.parametrize(
+    "strategy",
+    [
+        tenacity.retry_never,
+        tenacity.retry_always,
+        tenacity.retry_if_exception(bool),
+        tenacity.retry_if_exception_type((ValueError, TypeError)),
+        tenacity.retry_if_not_exception_type(ValueError),
+        tenacity.retry_unless_exception_type(ValueError),
+        tenacity.retry_if_exception_cause_type(ValueError),
+        tenacity.retry_if_result(bool),
+        tenacity.retry_if_not_result(bool),
+        tenacity.retry_if_exception_message(message="failure"),
+        tenacity.retry_if_exception_message(match=r"fail.*"),
+        tenacity.retry_if_exception_message(match=re.compile("FAIL.*", re.I)),
+        tenacity.retry_if_not_exception_message(message="failure"),
+        tenacity.retry_if_not_exception_message(match=r"fail.*"),
+        tenacity.retry_if_exception_type(ValueError)
+        | tenacity.retry_if_exception_message(message="failure"),
+        tenacity.retry_if_exception_type(ValueError)
+        & tenacity.retry_if_not_exception_message(match="other"),
+    ],
+)
+def test_strategy_pickle(strategy: tenacity.retry_base, protocol: int) -> None:
+    restored = pickle.loads(pickle.dumps(strategy, protocol))
+    assert type(restored) is type(strategy)
+    state = tenacity.RetryCallState(None, None, (), {})
+    for result in (None, False, True, "failure"):
+        state.set_result(result)
+        assert restored(state) == strategy(state)
+    for exception in (ValueError("failure"), TypeError("other")):
+        try:
+            raise exception from ValueError("cause")
+        except Exception:
+            state.set_exception(sys.exc_info())
+        assert restored(state) == strategy(state)
+
+
+@pytest.mark.parametrize("protocol", [0, pickle.HIGHEST_PROTOCOL])
+@pytest.mark.parametrize("used", ["unused", "success", "failure"])
+def test_retrying_pickle(protocol: int, used: str) -> None:
+    retrying = tenacity.Retrying(
+        stop=tenacity.stop_after_attempt(2),
+        wait=tenacity.wait_fixed(0),
+        retry=tenacity.retry_if_exception_type(ValueError),
+        reraise=True,
+        name="pickle test",
+    )
+    if used == "success":
+        assert retrying(int, "42") == 42
+    elif used == "failure":
+        with pytest.raises(ValueError):
+            retrying(int, "invalid")
+    statistics = retrying.statistics.copy()
+    restored = pickle.loads(pickle.dumps(retrying, protocol))
+    assert restored.statistics == statistics
+    assert restored.statistics is not retrying.statistics
+    assert restored._local is not retrying._local
+    assert restored.iter_state.actions == []
+    assert restored.reraise is True
+    assert str(restored) == "pickle test"
+    attempts = []
+
+    def fail_once() -> str:
+        attempts.append(None)
+        if len(attempts) == 1:
+            raise ValueError("failure")
+        return "success"
+
+    assert restored(fail_once) == "success"
+    assert restored.statistics["attempt_number"] == 2
+    assert retrying.statistics == statistics
+    # A used controller can be serialized repeatedly, including after retries.
+    again = pickle.loads(pickle.dumps(restored, protocol))
+    assert again.statistics == restored.statistics
+    assert again(int, "7") == 7
+
+
+def test_decorated_function_pool_map() -> None:
+    with multiprocessing.get_context("spawn").Pool(1) as pool:
+        assert pool.map(decorated_identity, [1, 2, 3]) == [1, 2, 3]
+
+
+def test_default_retrying_pickle() -> None:
+    restored = pickle.loads(pickle.dumps(tenacity.Retrying()))
+    assert restored(int, "42") == 42

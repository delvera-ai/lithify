+    def test_wait_exponential_jitter_with_min_and_time_units(self) -> None:
+        for min_, max_, jitter in (
+            (3.5, 10.5, 0.5),
+            (
+                datetime.timedelta(seconds=3.5),
+                datetime.timedelta(seconds=10.5),
+                datetime.timedelta(seconds=0.5),
+            ),
+        ):
+            with self.subTest(min=min_, max=max_, jitter=jitter):
+                fn = tenacity.wait_exponential_jitter(
+                    max=max_, jitter=jitter, min=min_
+                )
+                with mock.patch(
+                    "tenacity.wait.random.uniform", return_value=0.5
+                ) as uniform:
+                    for attempt, expected in ((1, 3.5), (3, 4.5), (5, 10.5)):
+                        self.assertEqual(fn(make_retry_state(attempt, 0)), expected)
+                    uniform.assert_called_with(0, 0.5)
+
+    def test_wait_exponential_jitter_min_bounds(self) -> None:
+        for min_, max_, initial, attempt, expected in (
+            (-5, 10, -1, 1, 0),
+            (20, 10, 1, 1, 20),
+            (5, 10, 1, 10000, 10),
+            (20, 10, 1, 10000, 20),
+        ):
+            with self.subTest(min=min_, max=max_, initial=initial, attempt=attempt):
+                fn = tenacity.wait_exponential_jitter(
+                    initial=initial, max=max_, min=min_, jitter=0
+                )
+                self.assertEqual(fn(make_retry_state(attempt, 0)), expected)
+

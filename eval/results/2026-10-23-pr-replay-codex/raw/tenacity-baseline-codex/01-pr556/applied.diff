 import functools
 
+import pytest
+
 from tenacity import _utils
 
 
+@pytest.mark.parametrize(
+    "number, suffix",
+    [
+        (number, "th")
+        for number in (
+            0, 4, 10, 11, 12, 13, 20, 100, 110, 111, 112, 113, 114,
+            211, 212, 213, 1011, 1012, 1013,
+        )
+    ]
+    + [(number, "st") for number in (1, 21, 101, 121)]
+    + [(number, "nd") for number in (2, 22, 102, 122)]
+    + [(number, "rd") for number in (3, 23, 103, 123)],
+)
+def test_ordinal(number: int, suffix: str) -> None:
+    assert _utils.find_ordinal(number) == suffix
+    assert _utils.to_ordinal(number) == f"{number}{suffix}"
+
+

+    def test_exponential_with_underflowing_max_ratio(self) -> None:
+        wait = tenacity.wait_exponential(multiplier=1e300, max=1e-100)
+        for attempt in (1, 2, 50, 10000):
+            with self.subTest(attempt=attempt):
+                self.assertEqual(wait(make_retry_state(attempt, 0)), 1e-100)
+
+    def test_exponential_with_nonfinite_multiplier(self) -> None:
+        for multiplier, expected in (
+            (float("inf"), 40),
+            (float("-inf"), 0),
+            (float("nan"), 0),
+        ):
+            for attempt in (1, 2, 50):
+                with self.subTest(multiplier=multiplier, attempt=attempt):
+                    wait = tenacity.wait_exponential(multiplier=multiplier, max=40)
+                    self.assertEqual(wait(make_retry_state(attempt, 0)), expected)
+
     def test_exponential_with_min_wait(self) -> None:
         r = Retrying(wait=tenacity.wait_exponential(min=20))

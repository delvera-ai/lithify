diff --git a/tests/test_after.py b/tests/test_after.py
index 25d8a7c..88bbd64 100644
--- a/tests/test_after.py
+++ b/tests/test_after.py
@@ -74,3 +74,19 @@ class TestAfterLogFormat(unittest.TestCase):
             f"after {sec_format % retry_state.seconds_since_start}(s), "
             f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
         )
+
+    def test_missing_outcome_timestamp(self) -> None:
+        logger = unittest.mock.MagicMock(spec=logging.Logger)
+        retry_state = test_tenacity.make_retry_state(self.previous_attempt_number, 0.1)
+        retry_state.outcome_timestamp = None
+
+        for sec_format in ("%.3g", "%.1f"):
+            with self.subTest(sec_format=sec_format):
+                logger.reset_mock()
+                after_log(logger, self.log_level, sec_format)(retry_state)
+
+                logger.log.assert_called_once_with(
+                    self.log_level,
+                    "Finished call to '<unknown>' after ?(s), "
+                    f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
+                )

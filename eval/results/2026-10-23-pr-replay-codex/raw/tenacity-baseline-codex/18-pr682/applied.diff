+
+def test_override() -> None:
+    def method(value: int) -> int:
+        return value + 1
+
+    decorated = _utils.override(method)
+
+    assert decorated is method
+    assert getattr(decorated, "__override__", False) is True
+    assert decorated(1) == 2
+
+
+def test_override_fallback() -> None:
+    with mock.patch.object(sys, "version_info", (3, 10)):
+        namespace = runpy.run_path(_utils.__file__)
+
+    def method(value: int) -> int:
+        return value + 1
+
+    decorated = namespace["override"](method)
+    assert decorated is method
+    assert getattr(decorated, "__override__", False) is True
+    assert decorated(1) == 2

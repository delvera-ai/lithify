 class TestWaitConditions(unittest.TestCase):
+    def test_falsy_wait_retries_without_sleep(self) -> None:
+        for wait in (None, 0, sum([])):
+            with self.subTest(wait=wait):
+                sleep = mock.Mock()
+                fn = mock.Mock(side_effect=[ValueError(), "ok"])
+                retrying = Retrying(
+                    wait=wait,  # type: ignore[arg-type]
+                    sleep=sleep,
+                    stop=tenacity.stop_after_attempt(2),
+                )
+                self.assertEqual(retrying(fn), "ok")
+                self.assertEqual(fn.call_count, 2)
+                sleep.assert_called_once_with(0)
+
+    def test_combine_plain_callable(self) -> None:
+        state = make_retry_state(2, 0)
+
+        def plain_wait(state: RetryCallState, /) -> float:
+            return float(state.attempt_number)
+
+        for wait in (
+            tenacity.wait_combine(plain_wait, tenacity.wait_fixed(1)),
+            plain_wait + tenacity.wait_fixed(1),
+            tenacity.wait_fixed(1) + plain_wait,
+        ):
+            with self.subTest(wait=wait):
+                self.assertIsInstance(wait, tenacity.wait_combine)
+                self.assertEqual(wait(state), 3)
+
     def test_no_sleep(self) -> None:
         r = Retrying()
         self.assertEqual(0, r.wait(make_retry_state(18, 9879)))

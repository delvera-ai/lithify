diff --git a/tests/test_enabled.py b/tests/test_enabled.py
new file mode 100644
index 0000000..19dd046
--- /dev/null
+++ b/tests/test_enabled.py
@@ -0,0 +1,80 @@
+import asyncio
+from typing import Any
+from unittest import mock
+
+import pytest
+
+from tenacity import AsyncRetrying, Retrying, TryAgain, retry, stop_after_attempt
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("decorated", [False, True])
+@pytest.mark.parametrize("exception", [None, ValueError("failure"), TryAgain()])
+def test_disabled_calls_once(
+    asynchronous: bool, decorated: bool, exception: BaseException | None
+) -> None:
+    callback = mock.Mock(side_effect=AssertionError("retry logic was called"))
+    target = mock.Mock(return_value=object(), side_effect=exception)
+
+    def sync_fn(*args: Any, **kwargs: Any) -> Any:
+        return target(*args, **kwargs)
+
+    async def async_fn(*args: Any, **kwargs: Any) -> Any:
+        return target(*args, **kwargs)
+
+    options: Any = dict(
+        enabled=False,
+        sleep=callback,
+        stop=callback,
+        wait=callback,
+        retry=callback,
+        before=callback,
+        after=callback,
+        before_sleep=callback,
+        retry_error_callback=callback,
+    )
+    fn = async_fn if asynchronous else sync_fn
+    controller = AsyncRetrying(**options) if asynchronous else Retrying(**options)
+    wrapped = retry(**options)(fn) if decorated else None
+
+    def invoke() -> Any:
+        result = wrapped(1, key=2) if wrapped else controller(fn, 1, key=2)
+        if asynchronous:
+            return asyncio.run(result)
+        return result
+
+    if exception is None:
+        assert invoke() is target.return_value
+    else:
+        with pytest.raises(type(exception)) as raised:
+            invoke()
+        assert raised.value is exception
+    target.assert_called_once_with(1, key=2)
+    callback.assert_not_called()
+    assert (wrapped.statistics if wrapped else controller.statistics) == {}
+
+
+@pytest.mark.parametrize("controller_cls", [Retrying, AsyncRetrying])
+def test_enabled_copy(controller_cls: Any) -> None:
+    controller = controller_cls(enabled=False)
+    assert controller.copy().enabled is False
+    assert controller.copy(enabled=True).enabled is True
+    assert controller_cls().enabled is True
+
+
+def test_retry_with_enabled() -> None:
+    target = mock.Mock(side_effect=ValueError("failure"))
+    wrapped = retry(stop=stop_after_attempt(3), reraise=True)(target)
+    with pytest.raises(ValueError):
+        wrapped.retry_with(enabled=False)()
+    assert target.call_count == 1
+    target.reset_mock()
+    with pytest.raises(ValueError):
+        wrapped()
+    assert target.call_count == 3
+
+
+def test_async_retrying_disabled_sync_function() -> None:
+    target = mock.Mock(return_value=42)
+    assert asyncio.run(AsyncRetrying(enabled=False)(target, 1)) == 42
+    target.assert_called_once_with(1)

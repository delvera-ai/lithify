+    @asynctest
+    async def test_falsy_wait_strategies(self) -> None:
+        calls = mock.Mock()
+
+        class EmptyWait(dict[str, Any]):
+            def __call__(self, retry_state: RetryCallState) -> float:
+                calls(retry_state.attempt_number)
+                return 1.5
+
+        class FalseWait:
+            def __bool__(self) -> bool:
+                return False
+
+            async def __call__(self, retry_state: RetryCallState) -> float:
+                calls(retry_state.attempt_number)
+                return 1.5
+
+        for wait in (EmptyWait(), FalseWait()):
+            with self.subTest(wait=wait):
+                calls.reset_mock()
+                sleep = mock.AsyncMock()
+                flaky = mock.AsyncMock(side_effect=[ValueError("boom"), "ok"])
+                retrying = AsyncRetrying(
+                    wait=wait, sleep=sleep, stop=stop_after_attempt(2)
+                )
+                self.assertEqual(await retrying(flaky), "ok")
+                calls.assert_called_once_with(1)
+                sleep.assert_awaited_once_with(1.5)
+

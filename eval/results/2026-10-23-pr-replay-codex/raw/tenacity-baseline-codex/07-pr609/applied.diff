+    @asynctest
+    async def test_retry_operator_flattening(self) -> None:
+        for use_or in (True, False):
+            calls: list[int] = []
+
+            async def predicate(value: int) -> bool:
+                calls.append(value)
+                return value == 2
+
+            def strategy(value: int) -> tasyncio.retry_if_result:
+                async def check(_: Any) -> bool:
+                    return await predicate(value)
+
+                return tasyncio.retry_if_result(check)
+
+            a, b, c, d = (strategy(value) for value in range(4))
+            if use_or:
+                combinations = (a | b | c | d, a | (b | c) | d, (a | b) | (c | d))
+                container = tasyncio.retry_any
+                mixed = a | (b & c)
+            else:
+                combinations = (a & b & c & d, a & (b & c) & d, (a & b) & (c & d))

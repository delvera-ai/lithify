+            state.set_result(None)
+            for combined in combinations:
+                self.assertIsInstance(combined, container)
+                self.assertEqual(combined.retries, (a, b, c, d))
+                calls.clear()
+                self.assertEqual(await combined(state), use_or)
+                self.assertEqual(calls, [0, 1, 2] if use_or else [0])

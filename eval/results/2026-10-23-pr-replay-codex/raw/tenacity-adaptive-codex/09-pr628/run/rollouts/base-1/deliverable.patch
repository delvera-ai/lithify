+    def test_wait_exponential_jitter_with_time_units(self) -> None:
+        for min_, max_, jitter in (
+            (10, 20, 0.5),
+            (
+                datetime.timedelta(seconds=10),
+                datetime.timedelta(seconds=20),
+                datetime.timedelta(seconds=0.5),
+            ),
+            (10, datetime.timedelta(seconds=20), 0.5),
+        ):
+            with self.subTest(min=min_, max=max_, jitter=jitter):
+                fn = tenacity.wait_exponential_jitter(
+                    min=min_, max=max_, jitter=jitter
+                )
+                with mock.patch("tenacity.wait.random.uniform", return_value=0.5) as uniform:
+                    for attempt, expected in ((1, 10), (4, 10), (5, 16.5), (6, 20)):
+                        self.assertEqual(fn(make_retry_state(attempt, 0)), expected)
+                    uniform.assert_called_with(0, 0.5)
+
+    def test_wait_exponential_jitter_min_bounds(self) -> None:
+        for min_, max_, initial, attempt, expected in (
+            (-10, 20, -1, 1, 0),
+            (10, 5, 1, 1, 10),
+            (10, 20, 1, 10000, 20),
+            (30, 20, 1, 10000, 30),
+        ):
+            with self.subTest(min=min_, max=max_, initial=initial):
+                fn = tenacity.wait_exponential_jitter(
+                    initial=initial, min=min_, max=max_, exp_base=2.0, jitter=0
+                )
+                self.assertEqual(fn(make_retry_state(attempt, 0)), expected)
+

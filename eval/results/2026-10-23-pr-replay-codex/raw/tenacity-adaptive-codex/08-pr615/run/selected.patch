diff --git a/tests/test_pickle.py b/tests/test_pickle.py
new file mode 100644
index 0000000..91f506e
--- /dev/null
+++ b/tests/test_pickle.py
@@ -0,0 +1,107 @@
+import multiprocessing
+import pickle
+import re
+import typing
+
+import pytest
+
+import tenacity
+
+
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+@pytest.mark.parametrize(
+    "strategy",
+    [
+        tenacity.retry_never,
+        tenacity.retry_always,
+        tenacity.retry_if_exception_type(),
+        tenacity.retry_if_exception_type((ValueError, TypeError)),
+        tenacity.retry_if_not_exception_type(ValueError),
+        tenacity.retry_unless_exception_type(ValueError),
+        tenacity.retry_if_exception_cause_type(ValueError),
+        tenacity.retry_if_exception_message(message="retry"),
+        tenacity.retry_if_exception_message(match="ret.*"),
+        tenacity.retry_if_exception_message(match=re.compile("RETRY", re.I)),
+        tenacity.retry_if_not_exception_message(message="retry"),
+        tenacity.retry_if_not_exception_message(match="ret.*"),
+        tenacity.retry_if_exception(bool),
+        tenacity.retry_if_result(bool),
+        tenacity.retry_if_not_result(bool),
+        tenacity.retry_if_exception_type(ValueError)
+        | tenacity.retry_if_exception_message(message="retry"),
+        tenacity.retry_if_exception_type(ValueError)
+        & tenacity.retry_if_not_exception_message(match="stop"),
+    ],
+)
+def test_strategy_pickle(strategy: tenacity.retry_base, protocol: int) -> None:
+    restored = pickle.loads(pickle.dumps(strategy, protocol))
+    assert type(restored) is type(strategy)
+    state = tenacity.RetryCallState(tenacity.Retrying(), None, (), {})
+    cause = RuntimeError("outer")
+    cause.__cause__ = ValueError("retry")
+    for value in (
+        None,
+        False,
+        True,
+        "retry",
+        ValueError("retry"),
+        TypeError("stop"),
+        cause,
+    ):
+        if isinstance(value, BaseException):
+            state.set_exception((type(value), value, None))
+        else:
+            state.set_result(value)
+        assert restored(state) == strategy(state)
+
+
+def fail() -> typing.NoReturn:
+    raise ValueError("retry")
+
+
+@pytest.mark.parametrize("protocol", range(pickle.HIGHEST_PROTOCOL + 1))
+@pytest.mark.parametrize("used", ["fresh", "success", "failure"])
+def test_retrying_pickle(protocol: int, used: str) -> None:
+    controller = tenacity.Retrying(
+        stop=tenacity.stop_after_attempt(2),
+        retry=tenacity.retry_if_exception_type(ValueError),
+        reraise=True,
+        name="pickled",
+    )
+    if used == "success":
+        assert controller(int, "42") == 42
+    elif used == "failure":
+        with pytest.raises(ValueError):
+            controller(fail)
+    statistics = controller.statistics.copy()
+    restored = pickle.loads(pickle.dumps(controller, protocol))
+    assert restored.statistics == statistics
+    assert restored.statistics is not controller.statistics
+    assert restored._local is not controller._local
+    assert restored.iter_state.actions == []
+    assert str(restored) == "pickled"
+    with pytest.raises(ValueError):
+        restored(fail)
+    assert restored.statistics["attempt_number"] == 2
+    assert controller.statistics == statistics
+    assert restored(int, "42") == 42
+    assert restored.statistics["attempt_number"] == 1
+
+
+@tenacity.retry(stop=tenacity.stop_after_attempt(2))
+def decorated(value: str) -> int:
+    return int(value)
+
+
+def test_decorated_pickle() -> None:
+    assert pickle.loads(pickle.dumps(decorated))("42") == 42
+
+
+def test_pool_map() -> None:
+    with multiprocessing.get_context("spawn").Pool(1) as pool:
+        assert pool.map(decorated, ["1", "2"]) == [1, 2]
+
+
+def test_default_retrying_pickle() -> None:
+    restored = pickle.loads(pickle.dumps(tenacity.Retrying()))
+    assert restored(int, "42") == 42

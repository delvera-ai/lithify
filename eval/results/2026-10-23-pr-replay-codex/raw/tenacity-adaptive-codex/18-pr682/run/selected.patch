+def test_override() -> None:
+    def method() -> str:
+        return "result"
+
+    assert override(method) is method
+    assert getattr(method, "__override__", False) is True
+    assert method() == "result"
+    if sys.version_info >= (3, 12):
+        assert override is typing.override
+

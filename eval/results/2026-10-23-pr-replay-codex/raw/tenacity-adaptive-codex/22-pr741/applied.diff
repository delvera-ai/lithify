+    @asynctest
+    async def test_falsy_wait_strategies_are_called(self) -> None:
+        class EmptyWait(list[Any]):
+            def __call__(self, retry_state: RetryCallState) -> float:
+                calls.append(retry_state.attempt_number)
+                return 0.25
+
+        class FalsyWait:
+            def __bool__(self) -> bool:
+                return False
+
+            async def __call__(self, retry_state: RetryCallState) -> float:
+                calls.append(retry_state.attempt_number)
+                return 0.25
+
+        for wait in (EmptyWait(), FalsyWait()):
+            with self.subTest(wait=wait):
+                calls: list[int] = []
+                sleep = mock.AsyncMock()
+                retrying = AsyncRetrying(
+                    wait=wait,
+                    sleep=sleep,
+                    stop=stop_after_attempt(2),
+                    retry=tenacity.retry_if_result(lambda result: result is None),
+                )
+                with self.assertRaises(RetryError):
+                    await retrying(lambda: None)
+                self.assertEqual(calls, [1, 2])
+                sleep.assert_awaited_once_with(0.25)

 class TestStatistics(unittest.TestCase):
+    def test_delay_since_first_attempt_resets_each_run(self) -> None:
+        retrying = Retrying(stop=tenacity.stop_after_attempt(2))
+
+        def fail() -> None:
+            if retrying.statistics["attempt_number"] == 1:
+                self.assertEqual(0, retrying.statistics["delay_since_first_attempt"])
+            raise ValueError(42)
+
+        for _ in range(2):
+            with self.assertRaises(tenacity.RetryError):
+                retrying(fail)
+            self.assertGreater(retrying.statistics["delay_since_first_attempt"], 0)
+
     def test_stats(self) -> None:
         @retry()
         def _foobar() -> int:
+            self.assertEqual(0, _foobar.statistics["delay_since_first_attempt"])
             return 42
 
         self.assertEqual({}, _foobar.statistics)
         _foobar()
         self.assertEqual(1, _foobar.statistics["attempt_number"])
+        self.assertEqual(0, _foobar.statistics["delay_since_first_attempt"])
 

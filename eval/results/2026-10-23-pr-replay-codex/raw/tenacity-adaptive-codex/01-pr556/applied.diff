 import functools
 
+import pytest
+
 from tenacity import _utils
 
 
+@pytest.mark.parametrize("hundreds", [0, 100, 200, 1000])
+@pytest.mark.parametrize(
+    "number, suffix",
+    [
+        (0, "th"),
+        (1, "st"),
+        (2, "nd"),
+        (3, "rd"),
+        (4, "th"),
+        (10, "th"),
+        (11, "th"),
+        (12, "th"),
+        (13, "th"),
+        (14, "th"),
+        (20, "th"),
+        (21, "st"),
+        (22, "nd"),
+        (23, "rd"),
+        (24, "th"),
+    ],
+)
+def test_ordinal(hundreds: int, number: int, suffix: str) -> None:
+    number += hundreds
+    assert _utils.find_ordinal(number) == suffix
+    assert _utils.to_ordinal(number) == f"{number}{suffix}"
+
+

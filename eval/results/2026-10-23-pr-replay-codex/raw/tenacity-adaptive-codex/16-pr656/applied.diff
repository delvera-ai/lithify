+    def test_exponential_with_underflowing_max_multiplier_ratio(self) -> None:
+        for min_, expected in ((0, 1e-100), (1, 1)):
+            with self.subTest(min=min_):
+                wait = tenacity.wait_exponential(
+                    multiplier=1e300, max=1e-100, min=min_
+                )
+                for attempt in (1, 2, 10000):
+                    self.assertEqual(wait(make_retry_state(attempt, 0)), expected)
+
+    def test_exponential_with_nonfinite_multiplier(self) -> None:
+        for multiplier, expected in (
+            (float("inf"), 40),
+            (float("-inf"), 0),
+            (float("nan"), 0),
+        ):
+            with self.subTest(multiplier=multiplier):
+                wait = tenacity.wait_exponential(multiplier=multiplier, max=40)
+                for attempt in (1, 2, 50):
+                    self.assertEqual(wait(make_retry_state(attempt, 0)), expected)
+
     def test_exponential_with_min_wait(self) -> None:
         r = Retrying(wait=tenacity.wait_exponential(min=20))
         self.assertEqual(r.wait(make_retry_state(1, 0)), 20)

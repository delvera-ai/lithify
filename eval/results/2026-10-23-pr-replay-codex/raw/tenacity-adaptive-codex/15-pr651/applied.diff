@@ -926,6 +926,47 @@ class TestRetryConditions(unittest.TestCase):
             tenacity.retry_if_exception_message(message="negative", match="negative")
 
 
+@pytest.mark.parametrize(
+    "strategy",
+    [tenacity.retry_if_exception_message, tenacity.retry_if_not_exception_message],
+)
+@pytest.mark.parametrize("argument", ["message", "match"])
+@pytest.mark.parametrize("exception_message", ["", "nonempty"])
+def test_retry_exception_message_empty_string(
+    strategy: typing.Any, argument: str, exception_message: str
+) -> None:
+    retry_strategy = strategy(**{argument: ""})
+    retry_state = make_retry_state(1, 0)
+    exception = RuntimeError(exception_message) if exception_message else RuntimeError()
+    retry_state.set_exception((RuntimeError, exception, None))
+
+    expected = argument == "match" or exception_message == ""
+    if strategy is tenacity.retry_if_not_exception_message:
+        expected = not expected
+    assert retry_strategy(retry_state) is expected
+
+
+@pytest.mark.parametrize(
+    "strategy",
+    [tenacity.retry_if_exception_message, tenacity.retry_if_not_exception_message],
+)
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {},
+        {"message": None, "match": None},
+        {"message": "", "match": ""},
+        {"message": "", "match": "nonempty"},
+        {"message": "nonempty", "match": ""},
+    ],
+)
+def test_retry_exception_message_invalid_arguments(
+    strategy: typing.Any, kwargs: dict[str, typing.Any]
+) -> None:
+    with pytest.raises(TypeError):
+        strategy(**kwargs)
+

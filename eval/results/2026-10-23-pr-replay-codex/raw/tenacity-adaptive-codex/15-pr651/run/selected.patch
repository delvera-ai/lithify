diff --git a/tenacity/retry.py b/tenacity/retry.py
index df0cc4d..e59f4c0 100644
--- a/tenacity/retry.py
+++ b/tenacity/retry.py
@@ -223,22 +223,22 @@ class retry_if_exception_message(retry_if_exception):
         message: str | None = None,
         match: None | str | re.Pattern[str] = None,
     ) -> None:
-        if message and match:
+        if message is not None and match is not None:
             raise TypeError(
                 f"{self.__class__.__name__}() takes either 'message' or 'match', not both"
             )
 
-        if not message and not match:
+        if message is None and match is None:
             raise TypeError(
                 f"{self.__class__.__name__}() missing 1 required argument 'message' or 'match'"
             )
 
         self.message = message
-        self.match = re.compile(match) if match else None
+        self.match = re.compile(match) if match is not None else None
         super().__init__(self._check)
 
     def _check(self, exception: BaseException) -> bool:
-        if self.message:
+        if self.message is not None:
             return self.message == str(exception)
         assert self.match is not None
         return bool(self.match.match(str(exception)))
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 61fd8db..b17179b 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -926,6 +926,55 @@ class TestRetryConditions(unittest.TestCase):
             tenacity.retry_if_exception_message(message="negative", match="negative")
 
 
+@pytest.mark.parametrize(
+    "retry_type,negate",
+    [
+        (tenacity.retry_if_exception_message, False),
+        (tenacity.retry_if_not_exception_message, True),
+    ],
+)
+@pytest.mark.parametrize(
+    "kwargs,exception_message,matches",
+    [
+        ({"message": ""}, "", True),
+        ({"message": ""}, "nonempty", False),
+        ({"match": ""}, "", True),
+        ({"match": ""}, "nonempty", True),
+    ],
+)
+def test_retry_exception_message_empty(
+    retry_type: type[tenacity.retry_if_exception_message],
+    negate: bool,
+    kwargs: dict[str, str],
+    exception_message: str,
+    matches: bool,
+) -> None:
+    future = tenacity.Future(1)
+    future.set_exception(RuntimeError(exception_message))
+    retry_state = make_retry_state(1, 0, last_result=future)
+    assert retry_type(**kwargs)(retry_state) == (matches != negate)
+
+
+@pytest.mark.parametrize(
+    "retry_type",
+    [tenacity.retry_if_exception_message, tenacity.retry_if_not_exception_message],
+)
+@pytest.mark.parametrize(
+    "kwargs",
+    [
+        {},
+        {"message": "", "match": ""},
+        {"message": "", "match": "nonempty"},
+        {"message": "nonempty", "match": ""},
+    ],
+)
+def test_retry_exception_message_invalid_arguments(
+    retry_type: type[tenacity.retry_if_exception_message], kwargs: dict[str, str]
+) -> None:
+    with pytest.raises(TypeError):
+        retry_type(**kwargs)
+
+

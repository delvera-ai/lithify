@@ -0,0 +1,72 @@
+import asyncio
+from typing import Any
+
+import pytest
+
+from tenacity import AsyncRetrying, Retrying, retry_if_result, stop_after_attempt
+from tenacity.wait import wait_combine, wait_fixed
+
+
+@pytest.mark.parametrize("wait", [None, 0, sum([])])
+@pytest.mark.parametrize("asynchronous", [False, True])
+def test_falsy_wait_retries_without_sleep(wait: Any, asynchronous: bool) -> None:
+    sleeps: list[float] = []
+    attempts: list[bool] = []
+
+    def attempt() -> int:
+        attempts.append(True)
+        return len(attempts)
+
+    options: dict[str, Any] = dict(
+        wait=wait,
+        retry=retry_if_result(lambda result: result == 1),
+        stop=stop_after_attempt(2),
+    )
+    if asynchronous:
+
+        async def sleep(delay: float) -> None:
+            sleeps.append(delay)
+
+        async def run() -> Any:
+            return await AsyncRetrying(sleep=sleep, **options)(attempt)
+
+        result = asyncio.run(run())
+    else:
+        result = Retrying(sleep=sleeps.append, **options)(attempt)
+
+    assert result == 2
+    assert len(attempts) == 2
+    assert sleeps == [0]
+
+
+@pytest.mark.parametrize("composition", ["left", "right", "explicit", "sum"])
+def test_wait_callable_receives_state_positionally(composition: str) -> None:
+    states: list[Any] = []
+
+    def custom_wait(state: Any, /) -> Any:
+        states.append(state)
+        return state.attempt_number * 2
+
+    fixed: Any = wait_fixed(1)
+    if composition == "left":
+        wait = custom_wait + fixed
+    elif composition == "right":
+        wait = fixed + custom_wait
+    elif composition == "explicit":
+        wait = wait_combine(custom_wait, fixed)
+    else:
+        wait = sum([fixed, custom_wait])
+
+    assert isinstance(wait, wait_combine)
+    sleeps: list[float] = []
+    retrying = Retrying(
+        wait=wait,
+        sleep=sleeps.append,
+        retry=retry_if_result(lambda result: result == 1),
+        stop=stop_after_attempt(2),
+    )
+    attempts = iter([1, 2])
+    assert retrying(lambda: next(attempts)) == 2
+    assert sleeps == [3]
+    assert len(states) == 1
+    assert states[0].attempt_number == 2

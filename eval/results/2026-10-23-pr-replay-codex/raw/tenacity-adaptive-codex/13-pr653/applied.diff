+        @retry(stop=tenacity.stop_after_attempt(2))
+        async def inner(fail: bool) -> int:
+            self.assertIs(outer.statistics, inner.statistics)
+            self.assertIn("attempt_number", outer.statistics)
+            if fail:
+                raise ValueError("retry")
+            return 42
+
+        @wraps(inner)
+        async def outer(fail: bool) -> int:
+            return await inner(fail)
+
+        statistics = outer.statistics
+        self.assertEqual(statistics, {})
+        with self.assertRaises(RetryError):
+            await outer(True)
+        self.assertIs(outer.statistics, inner.statistics)
+        self.assertEqual(statistics["attempt_number"], 2)
+        self.assertEqual(await outer(False), 42)
+        self.assertIs(outer.statistics, inner.statistics)
+        self.assertEqual(statistics["attempt_number"], 1)

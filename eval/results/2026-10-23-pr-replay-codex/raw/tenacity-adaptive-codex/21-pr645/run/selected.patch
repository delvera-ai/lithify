diff --git a/tests/test_asyncio.py b/tests/test_asyncio.py
index f4fded1..6afcdb4 100644
--- a/tests/test_asyncio.py
+++ b/tests/test_asyncio.py
@@ -199,6 +199,30 @@ class TestAsyncio(unittest.TestCase):
 
 
 class TestAsyncEnabled(unittest.TestCase):
+    @asynctest
+    async def test_enabled_false_direct_call(self) -> None:
+        calls = []
+        error = ValueError("fail")
+
+        def sync_fn(value: str, *, fail: bool) -> str:
+            calls.append(value)
+            if fail:
+                raise error
+            return value
+
+        async def async_fn(value: str, *, fail: bool) -> str:
+            return sync_fn(value, fail=fail)
+
+        for fn in (sync_fn, async_fn):
+            calls.clear()
+            retrying = AsyncRetrying(enabled=False, stop=stop_after_attempt(3))
+            with pytest.raises(ValueError) as exc_info:
+                await retrying(fn, "failure", fail=True)
+            assert exc_info.value is error
+            assert calls == ["failure"]
+            assert await retrying(fn, "success", fail=False) == "success"
+            assert calls == ["failure", "success"]
+
     @asynctest
     async def test_enabled_false_skips_retry(self) -> None:
         """When enabled=False, async function is called directly without retrying."""

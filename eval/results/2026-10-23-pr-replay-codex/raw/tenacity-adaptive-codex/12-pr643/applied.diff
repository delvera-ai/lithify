@@ -161,6 +161,40 @@ class TestAsyncio(unittest.TestCase):
 
 
 class TestAsyncEnabled(unittest.TestCase):
+    @asynctest
+    async def test_disabled_iterator(self) -> None:
+        for async_context in (False, True):
+            for error in (None, ValueError("fail"), tenacity.TryAgain()):
+                retrying = tasyncio.AsyncRetrying(
+                    enabled=False,
+                    stop=stop_after_attempt(3),
+                    retry=tenacity.retry_always,
+                )
+                for _ in range(2):
+                    attempts = 0
+
+                    async def run() -> None:
+                        nonlocal attempts
+                        async for attempt in retrying:
+                            if async_context:
+                                async with attempt:
+                                    attempts += 1
+                                    if error is not None:
+                                        raise error
+                            else:
+                                with attempt:
+                                    attempts += 1
+                                    if error is not None:
+                                        raise error
+
+                    if error is None:
+                        await run()
+                    else:
+                        with pytest.raises(type(error)) as exc_info:
+                            await run()
+                        assert exc_info.value is error
+                    assert attempts == 1
+
     @asynctest
     async def test_enabled_false_skips_retry(self) -> None:
         """When enabled=False, async function is called directly without retrying."""

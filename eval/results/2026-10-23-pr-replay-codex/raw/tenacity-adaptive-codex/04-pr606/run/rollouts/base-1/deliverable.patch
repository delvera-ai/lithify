diff --git a/tests/test_retry_composition.py b/tests/test_retry_composition.py
new file mode 100644
index 0000000..b3f2d83
--- /dev/null
+++ b/tests/test_retry_composition.py
@@ -0,0 +1,96 @@
+import asyncio
+from collections.abc import Awaitable, Callable
+
+import pytest
+
+from tenacity import RetryCallState, Retrying, retry_all, retry_any, retry_if_result
+from tenacity.asyncio import retry as async_retry
+
+
+@pytest.mark.parametrize("strategy_result", [False, True])
+@pytest.mark.parametrize("predicate_result", [False, True])
+@pytest.mark.parametrize("reverse", [False, True])
+@pytest.mark.parametrize("conjunction", [False, True])
+def test_sync_callable_composition(
+    strategy_result: bool, predicate_result: bool, reverse: bool, conjunction: bool
+) -> None:
+    state = RetryCallState(Retrying(), None, (), {})
+    state.set_result(None)
+    calls: list[str] = []
+
+    def strategy_predicate(result: object) -> bool:
+        calls.append("strategy")
+        return strategy_result
+
+    def predicate(retry_state: RetryCallState) -> bool:
+        assert retry_state is state
+        calls.append("predicate")
+        return predicate_result
+
+    strategy = retry_if_result(strategy_predicate)
+    if conjunction:
+        combined = predicate & strategy if reverse else strategy & predicate
+        assert isinstance(combined, retry_all)
+    else:
+        combined = predicate | strategy if reverse else strategy | predicate
+        assert isinstance(combined, retry_any)
+    assert combined(state) == (
+        strategy_result and predicate_result
+        if conjunction
+        else strategy_result or predicate_result
+    )
+    first = predicate_result if reverse else strategy_result
+    order = ["predicate", "strategy"] if reverse else ["strategy", "predicate"]
+    assert calls == (order if first == conjunction else order[:1])
+
+
+@pytest.mark.parametrize("strategy_result", [False, True])
+@pytest.mark.parametrize("predicate_result", [False, True])
+@pytest.mark.parametrize("reverse", [False, True])
+@pytest.mark.parametrize("conjunction", [False, True])
+@pytest.mark.parametrize("async_callable", [False, True])
+def test_async_callable_composition(
+    strategy_result: bool,
+    predicate_result: bool,
+    reverse: bool,
+    conjunction: bool,
+    async_callable: bool,
+) -> None:
+    state = RetryCallState(Retrying(), None, (), {})
+    state.set_result(None)
+    calls: list[str] = []
+
+    async def strategy_predicate(result: object) -> bool:
+        calls.append("strategy")
+        return strategy_result
+
+    def predicate(retry_state: RetryCallState) -> bool:
+        assert retry_state is state
+        calls.append("predicate")
+        return predicate_result
+
+    async def async_predicate(retry_state: RetryCallState) -> bool:
+        return predicate(retry_state)
+
+    callable_predicate: Callable[[RetryCallState], bool] | Callable[
+        [RetryCallState], Awaitable[bool]
+    ] = async_predicate if async_callable else predicate
+    strategy = async_retry.retry_if_result(strategy_predicate)
+    if conjunction:
+        combined = (
+            callable_predicate & strategy if reverse else strategy & callable_predicate
+        )
+        assert isinstance(combined, async_retry.retry_all)
+    else:
+        combined = (
+            callable_predicate | strategy if reverse else strategy | callable_predicate
+        )
+        assert isinstance(combined, async_retry.retry_any)
+    assert asyncio.run(combined(state)) == (
+        strategy_result and predicate_result
+        if conjunction
+        else strategy_result or predicate_result
+    )
+    first = predicate_result if reverse else strategy_result
+    order = ["predicate", "strategy"] if reverse else ["strategy", "predicate"]
+    assert calls == (order if first == conjunction else order[:1])

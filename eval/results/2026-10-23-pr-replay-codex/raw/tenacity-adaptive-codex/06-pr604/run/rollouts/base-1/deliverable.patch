diff --git a/tests/test_enabled.py b/tests/test_enabled.py
new file mode 100644
index 0000000..2c3339a
--- /dev/null
+++ b/tests/test_enabled.py
@@ -0,0 +1,114 @@
+import asyncio
+from typing import Any
+from unittest import mock
+
+import pytest
+
+from tenacity import AsyncRetrying, Retrying, TryAgain, retry
+
+
+@pytest.mark.parametrize("decorate", [False, True])
+@pytest.mark.parametrize("error", [None, ValueError("original"), TryAgain()])
+def test_disabled_sync(decorate: bool, error: Exception | None) -> None:
+    hook = mock.Mock(side_effect=AssertionError("retry logic ran"))
+    fn = mock.Mock(return_value=object(), side_effect=error)
+    controller = Retrying(
+        enabled=False,
+        sleep=hook,
+        before=hook,
+        after=hook,
+        before_sleep=hook,
+        retry=hook,
+        stop=hook,
+        wait=hook,
+        retry_error_callback=hook,
+    )
+    wrapped = controller.wraps(fn)
+
+    def call(*args: Any, **kwargs: Any) -> Any:
+        if decorate:
+            return wrapped(*args, **kwargs)
+        return controller(fn, *args, **kwargs)
+
+    if error is None:
+        assert call(1, key=2) is fn.return_value
+    else:
+        with pytest.raises(type(error)) as caught:
+            call(1, key=2)
+        assert caught.value is error
+    fn.assert_called_once_with(1, key=2)
+    hook.assert_not_called()
+    assert controller.statistics == {}
+
+
+@pytest.mark.parametrize("decorate", [False, True])
+@pytest.mark.parametrize("async_fn", [False, True])
+@pytest.mark.parametrize("error", [None, ValueError("original"), TryAgain()])
+def test_disabled_async(
+    decorate: bool, async_fn: bool, error: Exception | None
+) -> None:
+    hook = mock.Mock(side_effect=AssertionError("retry logic ran"))
+    fn = (mock.AsyncMock if async_fn else mock.Mock)(
+        return_value=object(), side_effect=error
+    )
+    controller = AsyncRetrying(
+        enabled=False,
+        sleep=hook,
+        before=hook,
+        after=hook,
+        before_sleep=hook,
+        retry=hook,
+        stop=hook,
+        wait=hook,
+        retry_error_callback=hook,
+    )
+    wrapped = controller.wraps(fn)
+
+    def call(*args: Any, **kwargs: Any) -> Any:
+        if decorate:
+            return wrapped(*args, **kwargs)
+        return controller(fn, *args, **kwargs)
+
+    if error is None:
+        assert asyncio.run(call(1, key=2)) is fn.return_value
+    else:
+        with pytest.raises(type(error)) as caught:
+            asyncio.run(call(1, key=2))
+        assert caught.value is error
+    fn.assert_called_once_with(1, key=2)
+    if async_fn:
+        fn.assert_awaited_once_with(1, key=2)
+    hook.assert_not_called()
+    assert controller.statistics == {}
+
+
+@pytest.mark.parametrize("controller_type", [Retrying, AsyncRetrying])
+def test_enabled_copy(controller_type: type[Retrying] | type[AsyncRetrying]) -> None:
+    controller = controller_type()
+    assert controller.enabled is True
+    disabled = controller.copy(enabled=False)
+    assert disabled.enabled is False
+    assert disabled.copy().enabled is False
+    assert disabled.copy(enabled=True).enabled is True
+
+
+def test_enabled_decorator() -> None:
+    error = ValueError("original")
+    fn = mock.Mock(side_effect=error)
+    wrapped = retry(enabled=False)(fn)
+    with pytest.raises(ValueError) as caught:
+        wrapped()
+    assert caught.value is error
+    fn.assert_called_once_with()
+    assert wrapped.retry_with(enabled=True).retry.enabled is True
+
+
+def test_enabled_async_decorator() -> None:
+    error = ValueError("original")
+    fn = mock.AsyncMock(side_effect=error)
+    wrapped = retry(enabled=False)(fn)
+    with pytest.raises(ValueError) as caught:
+        asyncio.run(wrapped())
+    assert caught.value is error
+    fn.assert_awaited_once_with()
+    assert wrapped.retry_with(enabled=True).retry.enabled is True

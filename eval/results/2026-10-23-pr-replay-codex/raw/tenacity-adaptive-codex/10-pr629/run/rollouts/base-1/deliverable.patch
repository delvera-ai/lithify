+    def test_wait_exponential_jitter_initial_deprecated(self) -> None:
+        for initial in (0, 1, 3):
+            with pytest.warns(DeprecationWarning, match="initial.*multiplier"):
+                positional = tenacity.wait_exponential_jitter(initial, 20, 3, 0, 1)
+            with pytest.warns(DeprecationWarning, match="initial.*multiplier"):
+                keyword = tenacity.wait_exponential_jitter(

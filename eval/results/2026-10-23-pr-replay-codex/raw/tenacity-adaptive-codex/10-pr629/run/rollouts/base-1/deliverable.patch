+    def test_wait_exponential_jitter_multiplier(self) -> None:
+        for multiplier in (0, 1, 3):
+            fn = tenacity.wait_exponential_jitter(
+                multiplier=multiplier, jitter=0, exp_base=3, max=20, min=1
+            )
+            for attempt in range(1, 5):

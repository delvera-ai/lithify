index 04774d9..d6f782d 100644
--- a/tests/test_filesize.py
+++ b/tests/test_filesize.py
@@ -7,12 +7,37 @@ from __future__ import annotations
 import pytest
 
 import humanize
+from humanize.filesize import suffixes
+
+
+@pytest.mark.parametrize("mode", ["decimal", "binary", "gnu"])
+@pytest.mark.parametrize("exp", range(1, 11))
+@pytest.mark.parametrize("sign", [1, -1])
+@pytest.mark.parametrize("precision", [0, 1, 3])
+def test_naturalsize_rounding(mode: str, exp: int, sign: int, precision: int) -> None:
+    base = 1000 if mode == "decimal" else 1024
+    format_ = f"%.{precision}f"
+    value = sign * (base - 0.1 * 10**-precision) * base**exp
+    next_exp = min(exp + 1, len(suffixes[mode]))
+    number = format_ % (value / base**next_exp)
+    space = "" if mode == "gnu" else " "
+    expected = number + space + suffixes[mode][next_exp - 1]
+    assert humanize.naturalsize(
+        value, binary=mode == "binary", gnu=mode == "gnu", format=format_
+    ) == expected
 
 
 @pytest.mark.parametrize(
     "test_args, expected",
     [
         ([300], "300 Bytes"),
+        ([999999], "1.0 MB"),
+        ([1024**2 - 1, True], "1.0 MiB"),
+        ([1024**2 - 1, False, True], "1.0M"),
+        ([999949], "999.9 kB"),
+        ([1024**2 - 100, True], "1023.9 KiB"),

--- a/tests/test_lists.py
+++ b/tests/test_lists.py
@@ -1,5 +1,7 @@
 from __future__ import annotations
 
+from collections.abc import Callable, Iterable
+
 import pytest
 
 import humanize
@@ -22,3 +24,25 @@ def test_natural_list(
     test_args: list[str] | list[int] | list[str | int], expected: str
 ) -> None:
     assert humanize.natural_list(*test_args) == expected
+
+
+@pytest.mark.parametrize(
+    "make_iterable",
+    [
+        list,
+        tuple,
+        set,
+        frozenset,
+        iter,
+        lambda items: (item for item in items),
+        lambda items: dict.fromkeys(items).keys(),
+        lambda items: range(len(list(items))),
+    ],
+)
+@pytest.mark.parametrize("length", [0, 1, 2, 3, 5])
+def test_natural_list_iterables(
+    make_iterable: Callable[[Iterable[int]], Iterable[int]], length: int
+) -> None:
+    items = make_iterable(range(length))
+    expected = humanize.natural_list(list(items))
+    assert humanize.natural_list(make_iterable(range(length))) == expected

+@pytest.mark.parametrize("function", [humanize.naturalday, humanize.naturaldate])
+@pytest.mark.parametrize(
+    "now, offset",
+    [("2023-10-15 23:00:00", 11), ("2023-10-15 01:00:00", -7)],
+)
+@pytest.mark.parametrize(
+    "days, expected", [(-1, "yesterday"), (0, "today"), (1, "tomorrow")]
+)
+def test_naturalday_and_naturaldate_timezone(
+    function: typing.Callable[[dt.datetime], str],
+    now: str,
+    offset: int,
+    days: int,
+    expected: str,
+) -> None:
+    with freeze_time(now):
+        timezone = dt.timezone(dt.timedelta(hours=offset))
+        hours = 7 if offset > 0 else -7
+        value = dt.datetime.now(timezone) + dt.timedelta(days=days, hours=hours)
+        assert function(value) == expected
+
+
+@pytest.mark.parametrize(
+    "now, offset",
+    [("2023-10-15 23:00:00", 11), ("2023-10-15 01:00:00", -7)],
+)
+@pytest.mark.parametrize("days", [-153, -152, 152, 153])
+def test_naturaldate_timezone_year(now: str, offset: int, days: int) -> None:
+    with freeze_time(now):
+        timezone = dt.timezone(dt.timedelta(hours=offset))
+        value = dt.datetime.now(timezone) + dt.timedelta(days=days)
+        format = "%b %d %Y" if abs(days) == 153 else "%b %d"
+        assert humanize.naturaldate(value) == value.strftime(format)
+
+
+@freeze_time("2023-10-15 23:00:00")
+@pytest.mark.parametrize("function", [humanize.naturalday, humanize.naturaldate])
+@pytest.mark.parametrize("value", [dt.date(2023, 10, 16), dt.datetime(2023, 10, 16)])
+def test_naturalday_and_naturaldate_local_date(
+    function: typing.Callable[[dt.date], str], value: dt.date
+) -> None:
+    assert function(value) == "tomorrow"
+

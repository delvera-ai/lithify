+@pytest.mark.parametrize(
+    "exponent, previous_unit, next_unit",
+    [
+        (24, "sextillion", "septillion"),
+        (27, "septillion", "octillion"),
+        (30, "octillion", "nonillion"),
+        (33, "nonillion", "decillion"),
+    ],
+)
+@pytest.mark.parametrize("sign", [1, -1])
+@pytest.mark.parametrize("format", ["%.1f", "%.2f"])
+def test_intword_large_magnitude_rounding(
+    exponent: int, previous_unit: str, next_unit: str, sign: int, format: str
+) -> None:
+    prefix = "-" if sign < 0 else ""
+    assert humanize.intword(sign * (10**exponent - 1), format) == (
+        f"{prefix}{format % 1.0} {next_unit}"
+    )
+    value = 9999 * 10 ** (exponent - 4)
+    assert humanize.intword(sign * value, format) == (
+        f"{prefix}{format % 999.9} {previous_unit}"
+    )
+

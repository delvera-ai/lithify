 import pytest
 from freezegun import freeze_time
@@ -351,3 +353,63 @@ def test_intword_unit_has_no_format_placeholder(locale: str) -> None:
         pytest.skip("Generate .mo with scripts/generate-translation-binaries.sh")
     finally:
         humanize.i18n.deactivate()
+
+
+def test_update_translations_preserves_number_translations(
+    tmp_path: pathlib.Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    for tool in ("xgettext", "msgmerge", "msgfmt"):
+        if shutil.which(tool) is None:
+            pytest.skip(f"{tool} is required to update translations")
+
+    root = pathlib.Path(__file__).resolve().parents[1]
+    source = tmp_path / "src" / "humanize"
+    source.mkdir(parents=True)
+    for module in (root / "src" / "humanize").glob("*.py"):
+        shutil.copy(module, source)
+    for locale in ("de_DE", "fr_FR"):
+        shutil.copytree(LOCALE_DIR / locale, source / "locale" / locale)
+
+    subprocess.run(
+        ["bash", str(root / "scripts" / "update-translations.sh")],
+        cwd=tmp_path,
+        check=True,
+        capture_output=True,
+        text=True,
+    )
+    catalog = (tmp_path / "humanize.pot").read_text()
+    words = ("zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine")
+    for word in words:
+        assert f'msgid "{word}"' in catalog
+    for gender in ("male", "female"):
+        suffixes = ("th", "st", "nd", "rd", "th", "th", "th", "th", "th", "th")
+        for digit, suffix in enumerate(suffixes):
+            assert f'msgctxt "{digit} ({gender})"\nmsgid "{suffix}"' in catalog
+
+    monkeypatch.setattr(
+        humanize.i18n, "_TRANSLATIONS", {None: humanize.i18n._TRANSLATIONS[None]}
+    )
+    try:
+        for locale, words, male, female in (
+            (
+                "de_DE",
+                ("eins", "zwei", "drei", "vier", "fünf", "sechs", "sieben", "acht", "neun"),
+                "1.",
+                "1.",
+            ),
+            (
+                "fr_FR",
+                ("un", "deux", "trois", "quatre", "cinq", "six", "sept", "huit", "neuf"),
+                "1er",
+                "1ère",
+            ),
+        ):
+            humanize.i18n.activate(locale, source / "locale")
+            assert tuple(humanize.apnumber(n) for n in range(1, 10)) == words
+            assert humanize.ordinal(1, gender="male") == male
+            assert humanize.ordinal(1, gender="female") == female
+        humanize.i18n.deactivate()
+        assert humanize.apnumber(1) == "one"
+        assert humanize.ordinal(1, gender="female") == "1st"
+    finally:
+        humanize.i18n.deactivate()

diff --git a/tests/test_lists.py b/tests/test_lists.py
index cc514f3..b072834 100644
--- a/tests/test_lists.py
+++ b/tests/test_lists.py
@@ -1,5 +1,7 @@
 from __future__ import annotations
 
+from collections.abc import Callable, Iterable
+
 import pytest
 
 import humanize
@@ -22,3 +24,25 @@ def test_natural_list(
     test_args: list[str] | list[int] | list[str | int], expected: str
 ) -> None:
     assert humanize.natural_list(*test_args) == expected
+
+
+@pytest.mark.parametrize("size", [0, 1, 2, 3, 5])
+@pytest.mark.parametrize(
+    "factory",
+    [
+        tuple,
+        set,
+        frozenset,
+        iter,
+        lambda items: (item for item in items),
+        lambda items: dict.fromkeys(items).keys(),
+        lambda items: range(len(items)),
+        lambda items: map(str, items),
+    ],
+)
+def test_natural_list_iterables(
+    factory: Callable[[list[int]], Iterable[int | str]], size: int
+) -> None:
+    items = factory(list(range(size)))
+    expected = humanize.natural_list(list(items))
+    assert humanize.natural_list(factory(list(range(size)))) == expected

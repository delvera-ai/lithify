+@pytest.mark.parametrize(
+    "exponent, lower_unit, upper_unit",
+    [
+        (24, "sextillion", "septillion"),
+        (27, "septillion", "octillion"),
+        (30, "octillion", "nonillion"),
+        (33, "nonillion", "decillion"),
+    ],
+)
+@pytest.mark.parametrize("sign", [1, -1])
+@pytest.mark.parametrize("precision", [0, 1, 2])
+def test_intword_large_magnitude_rounding(
+    exponent: int, lower_unit: str, upper_unit: str, sign: int, precision: int
+) -> None:
+    prefix = "-" if sign < 0 else ""
+    format = f"%.{precision}f"
+    assert humanize.intword(sign * (10**exponent - 1), format) == (
+        f"{prefix}{format % 1} {upper_unit}"
+    )
+    below_rounding = 10**exponent - 10 ** (exponent - 3 - precision)
+    assert humanize.intword(sign * below_rounding, format) == (
+        f"{prefix}{format % (1000 - 10**-precision)} {lower_unit}"
+    )
+

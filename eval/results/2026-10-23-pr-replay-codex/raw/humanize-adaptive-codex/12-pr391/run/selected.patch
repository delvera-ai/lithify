diff --git a/tests/test_translation_extraction.py b/tests/test_translation_extraction.py
new file mode 100644
index 0000000..ef71656
--- /dev/null
+++ b/tests/test_translation_extraction.py
@@ -0,0 +1,69 @@
+"""Regression coverage for the translation update pipeline."""
+
+from __future__ import annotations
+
+import gettext
+import pathlib
+import shutil
+import subprocess
+
+import pytest
+
+import humanize
+
+
+@pytest.mark.skipif(
+    any(shutil.which(tool) is None for tool in ("bash", "xgettext", "msgmerge", "msgfmt")),
+    reason="Translation update requires GNU gettext tools and bash",
+)
+def test_update_preserves_number_translations(
+    tmp_path: pathlib.Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    root = pathlib.Path(__file__).resolve().parents[1]
+    shutil.copytree(root / "src", tmp_path / "src")
+    shutil.copytree(root / "scripts", tmp_path / "scripts")
+    subprocess.run(
+        ["bash", "scripts/update-translations.sh"],
+        cwd=tmp_path,
+        check=True,
+        capture_output=True,
+    )
+    locale_path = tmp_path / "src" / "humanize" / "locale"
+    suffixes = ("th", "st", "nd", "rd", "th", "th", "th", "th", "th", "th")
+    words = (
+        "zero",
+        "one",
+        "two",
+        "three",
+        "four",
+        "five",
+        "six",
+        "seven",
+        "eight",
+        "nine",
+    )
+    for locale in ("de_DE", "fr_FR"):
+        catalog = gettext.translation("humanize", locale_path, [locale])._catalog
+        for word in words:
+            assert word in catalog
+        for gender in ("male", "female"):
+            for digit, suffix in enumerate(suffixes):
+                assert f"{digit} ({gender})\x04{suffix}" in catalog
+
+    monkeypatch.setattr(
+        humanize.i18n, "_TRANSLATIONS", {None: gettext.NullTranslations()}
+    )
+    try:
+        for locale, one, male, female in (
+            ("de_DE", "eins", "1.", "1."),
+            ("fr_FR", "un", "1er", "1ère"),
+            ("de_DE", "eins", "1.", "1."),
+        ):
+            humanize.i18n.activate(locale, path=locale_path)
+            assert humanize.apnumber(1) == one
+            assert humanize.ordinal(1, gender="male") == male
+            assert humanize.ordinal(1, gender="female") == female
+    finally:
+        humanize.i18n.deactivate()
+    assert humanize.apnumber(1) == "one"
+    assert humanize.ordinal(1, gender="female") == "1st"

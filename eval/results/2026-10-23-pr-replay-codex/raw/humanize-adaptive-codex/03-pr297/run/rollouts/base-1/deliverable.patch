+@pytest.mark.parametrize("humanizer", [humanize.naturalday, humanize.naturaldate])
+@pytest.mark.parametrize(
+    "now, offset",
+    [("2023-10-15 23:00:00+00:00", 11), ("2023-10-16 01:00:00+00:00", -7)],
+)
+@pytest.mark.parametrize(
+    "days, expected", [(-1, "yesterday"), (0, "today"), (1, "tomorrow")]
+)
+def test_naturalday_and_naturaldate_timezone(
+    humanizer: typing.Callable[[dt.datetime], str],
+    now: str,
+    offset: int,
+    days: int,
+    expected: str,
+) -> None:
+    with freeze_time(now):
+        tz = dt.timezone(dt.timedelta(hours=offset))
+        hours = 7 if offset > 0 else -7
+        value = dt.datetime.now(tz) + dt.timedelta(hours=hours, days=days)
+        assert humanizer(value) == expected
+
+
+@freeze_time("2023-10-15 23:00:00+00:00")
+@pytest.mark.parametrize("humanizer", [humanize.naturalday, humanize.naturaldate])
+@pytest.mark.parametrize("value", [dt.datetime(2023, 10, 16), dt.date(2023, 10, 16)])
+def test_naturalday_and_naturaldate_local_date(
+    humanizer: typing.Callable[[dt.date], str], value: dt.date
+) -> None:
+    assert humanizer(value) == "tomorrow"
+
+
+@freeze_time("2023-10-15 23:00:00+00:00")
+def test_naturaldate_timezone_year_threshold() -> None:

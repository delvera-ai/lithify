@@ -396,7 +397,61 @@ def to_node(
         table = c.table
         col_source: exp.Table | Scope | None = scope.sources.get(table)
 
-        if isinstance(col_source, Scope):
+        if unpivot and table == unpivot.alias_or_name:
+            # UNPIVOT value columns come from the columns listed in its IN clause, and its name column
+            # is built from those labels rather than from any source column
+            unpivot_source = unpivot.parent
+            unpivot_scope = scope.cte_sources.get(unpivot_source.name) if unpivot_source else None
+            unpivot_scope = unpivot_scope or col_source
+
+            def _unpivot_columns(expr: exp.Expr) -> list[exp.Expr]:
+                return expr.expressions if isinstance(expr, exp.Tuple) else [expr]
+
+            value_names = [v.name for v in _unpivot_columns(unpivot.expressions[0])]
+            downstream_columns: list[exp.Column] = []
+            if c.name in value_names:
+                value_index = value_names.index(c.name)
+                for field in unpivot.fields:
+                    for in_expr in field.expressions:
+                        in_src = in_expr.this if isinstance(in_expr, exp.PivotAlias) else in_expr
+                        in_col = _unpivot_columns(in_src)[value_index]
+                        downstream_columns.append(exp.column(in_col.this, table=table))
+            elif c.name != unpivot.fields[0].this.name:
+                downstream_columns.append(exp.column(c.this, table=table))
+
+            if not downstream_columns:
+                leaf = Node(name=c.sql(comments=False), source=unpivot, expression=unpivot)
+                node.downstream.append(leaf)
+                if on_node:
+                    on_node(leaf)
+
+            for downstream_column in downstream_columns:
+                if isinstance(unpivot_scope, Scope):
+                    to_node(
+                        downstream_column.name,
+                        scope=unpivot_scope,
+                        scope_name=table,
+                        dialect=dialect,
+                        upstream=node,
+                        source_name=source_names.get(table) or source_name,
+                        reference_node_name=unpivot_source.name
+                        if unpivot_scope.scope_type == ScopeType.CTE and unpivot_source
+                        else None,
+                        trim_selects=trim_selects,
+                        _cache=_cache,
+                        _scope_meta=_scope_meta,
+                        on_node=on_node,
+                    )
+                else:
+                    unpivot_leaf = Node(
+                        name=downstream_column.sql(comments=False),
+                        source=unpivot_scope or exp.Placeholder(),
+                        expression=unpivot_scope or exp.Placeholder(),
+                    )
+                    node.downstream.append(unpivot_leaf)
+                    if on_node:
+                        on_node(unpivot_leaf)
+        elif isinstance(col_source, Scope):
             reference_node_name = None

diff --git a/tests/test_parser.py b/tests/test_parser.py
index 321703828..696fa19f6 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -13,6 +13,20 @@ class TestParser(unittest.TestCase):
         with self.assertRaises(ParseError):
             parse_one("")
 
+    def test_max_nodes(self):
+        wide = "SELECT " + ", ".join(f"c{i}" for i in range(500)) + " FROM t"
+        self.assertEqual(len(parse_one(wide).expressions), 500)
+        self.assertEqual(len(parse_one(wide, max_nodes=100_000).expressions), 500)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=100)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse("SELECT 1; " + wide, max_nodes=200)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, into=exp.Select, max_nodes=100)
+
     def test_parse_into(self):
         self.assertIsInstance(parse_one("(1)", into=exp.Tuple), exp.Tuple)
         self.assertIsInstance(parse_one("(1,)", into=exp.Tuple), exp.Tuple)

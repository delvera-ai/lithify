diff --git a/tests/test_lineage.py b/tests/test_lineage.py
index 13577bb2f..8a97a70e6 100644
--- a/tests/test_lineage.py
+++ b/tests/test_lineage.py
@@ -862,3 +862,47 @@ class TestLineage(unittest.TestCase):
         )
         downstream_names = sorted(d.name for d in node.downstream)
         self.assertEqual(downstream_names, ["s1.a", "s2.a"])
+
+    def test_lineage_all_columns(self) -> None:
+        nodes = lineage(
+            None,
+            "SELECT a, b + 1 AS c FROM x",
+            schema={"x": {"a": "int", "b": "int"}},
+        )
+        self.assertEqual(list(nodes), ["a", "c"])
+        self.assertEqual(nodes["a"].name, "a")
+        self.assertEqual(nodes["c"].name, "c")
+        self.assertEqual(
+            [d.name for d in nodes["c"].downstream],
+            ["x.b"],
+        )
+
+    def test_lineage_all_columns_set_operation(self) -> None:
+        nodes = lineage(
+            None,
+            "SELECT a FROM x UNION SELECT a FROM x",
+            schema={"x": {"a": "int"}},
+        )
+        self.assertEqual(list(nodes), ["a"])
+        self.assertEqual(nodes["a"].name, "UNION")
+
+    def test_lineage_on_node(self) -> None:
+        seen = []
+
+        def on_node(node):
+            node.payload["position"] = len(seen)
+            seen.append(node)
+
+        root = lineage(
+            "a",
+            "WITH z AS (SELECT a FROM x) SELECT z.a AS a FROM z",
+            schema={"x": {"a": "int"}},
+            on_node=on_node,
+        )
+        self.assertIs(seen[-1], root)
+        self.assertEqual(root.payload, {"position": len(seen) - 1})
+        self.assertEqual(
+            {id(node) for node in root.walk()},
+            {id(node) for node in seen},
+        )
+        self.assertEqual(len({id(node) for node in seen}), len(seen))

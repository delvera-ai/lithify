     def sort_sql(self, expression: exp.Sort) -> str:
         return self.op_expressions("SORT BY", expression)
 
+    def _unambiguous_order_key(self, expression: exp.Ordered) -> exp.Expression:
+        # A bare ORDER BY alias may resolve to a column that is ambiguous across FROM sources when
+        # repeated in an expression, so reference the aliased (qualified) column instead
+        key = expression.this
+        order = expression.parent
+        if (
+            isinstance(key, exp.Column)
+            and not key.table
+            and isinstance(order, exp.Order)
+            and isinstance(order.parent, exp.Select)
+        ):
+            for projection in order.parent.expressions:
+                if (
+                    isinstance(projection, exp.Alias)
+                    and projection.alias == key.name
+                    and isinstance(projection.this, exp.Column)
+                ):
+                    return projection.this
+        return key
+

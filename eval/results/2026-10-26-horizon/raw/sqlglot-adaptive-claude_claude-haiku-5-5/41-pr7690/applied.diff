+    def _parse_create(self) -> exp.Create | exp.Command:
+        create = super()._parse_create()
+        if (
+            not isinstance(create, exp.Create)
+            or create.args.get("kind") != "MACRO"
+            or not self._match(TokenType.COMMA)
+        ):
+            return create
+
+        this = create.this
+        params = this.expressions if isinstance(this, exp.UserDefinedFunction) else []
+        name = this.this if isinstance(this, exp.UserDefinedFunction) else this
+        properties = create.args.get("properties")
+        is_table = bool(properties and any(p.args.get("is_table") for p in properties.expressions))
+
+        overloads = [
+            exp.MacroOverload(expressions=params, expression=create.expression, is_table=is_table),
+            self._parse_macro_overload(),
+        ]
+        while self._match(TokenType.COMMA):
+            overloads.append(self._parse_macro_overload())
+
+        create.set("this", name)
+        create.set("expression", exp.MacroOverloads(expressions=overloads))
+        create.set("properties", None)
+        return create
+
+    def _parse_macro_overload(self) -> exp.MacroOverload:
+        params = self._parse_wrapped_csv(self._parse_function_parameter)
+        self._match(TokenType.ALIAS)
+        is_table = bool(self._match(TokenType.TABLE))
+        return self.expression(
+            exp.MacroOverload(
+                expressions=params, expression=self._parse_statement(), is_table=is_table
+            )
+        )

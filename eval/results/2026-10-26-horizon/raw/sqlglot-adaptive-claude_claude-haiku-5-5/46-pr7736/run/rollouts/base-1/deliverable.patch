+    def test_unpivot_with_multiple_value_columns(self) -> None:
+        sql = """
+        SELECT id, q, amt, qty
+        FROM sales UNPIVOT ((amt, qty) FOR q IN ((jan, feb) AS 'Q1', (feb, jan) AS 'Q2'))
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int"}}
+
+        node = lineage("amt", sql, schema=schema, dialect="oracle")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+
+        node = lineage("qty", sql, schema=schema, dialect="oracle")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.FEB", "SALES.JAN"])
+
+        node = lineage("q", sql, schema=schema, dialect="oracle")
+        self.assertEqual(
+            [d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB", "SALES.FEB", "SALES.JAN"]
+        )
+
+    def test_unpivot_with_multiple_sources(self) -> None:
+        sql = """
+        SELECT u.score, v.price, u.id
+        FROM sales UNPIVOT (score FOR metric_name IN (jan, feb)) AS u
+        JOIN prices UNPIVOT (price FOR month IN (mar, apr)) AS v ON u.id = v.id
+        """
+        schema = {
+            "sales": {"id": "int", "jan": "int", "feb": "int"},
+            "prices": {"id": "int", "mar": "int", "apr": "int"},
+        }
+
+        node = lineage("score", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+
+        node = lineage("price", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["PRICES.MAR", "PRICES.APR"])
+
+        node = lineage("id", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.ID"])
+

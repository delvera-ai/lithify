         return super()._parse_id_var(any_token=any_token, tokens=tokens)
 
+    def _parse_function(
+        self,
+        functions: dict[str, t.Callable] | None = None,
+        anonymous: bool = False,
+        optional_parens: bool = True,
+        any_token: bool = False,
+    ) -> exp.Expr | None:
+        func = super()._parse_function(
+            functions=functions,
+            anonymous=anonymous,
+            optional_parens=optional_parens,
+            any_token=any_token,
+        )
+
+        if isinstance(func, exp.DynamicIdentifier) and self._match(TokenType.L_PAREN):
+            call = self.expression(
+                exp.Anonymous(this=func, expressions=self._parse_function_args())
+            )
+            self._match_r_paren(call)
+            return call
+
+        return func
+

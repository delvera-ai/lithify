diff --git a/sqlglot/parser.py b/sqlglot/parser.py
index 42f98dec9..4d93998a0 100644
--- a/sqlglot/parser.py
+++ b/sqlglot/parser.py
@@ -6679,7 +6679,9 @@ class Parser:
                 if isinstance(field, exp.Column) and self._match(TokenType.DOT, advance=False):
                     field = self._parse_column_ops(field)
             else:
-                field = self._parse_field(any_token=True, anonymous_func=True)
+                field = self._parse_field(
+                    any_token=True, anonymous_func=True, optional_parens=False
+                )
 
             # Function calls can be qualified, e.g., x.y.FOO()
             # This converts the final AST to a series of Dots leading to the function call
@@ -6781,15 +6783,18 @@ class Parser:
         any_token: bool = False,
         tokens: t.Collection[TokenType] | None = None,
         anonymous_func: bool = False,
+        optional_parens: bool = True,
     ) -> exp.Expr | None:
         if anonymous_func:
             field = (
-                self._parse_function(anonymous=anonymous_func, any_token=any_token)
+                self._parse_function(
+                    anonymous=anonymous_func, optional_parens=optional_parens, any_token=any_token
+                )
                 or self._parse_primary()
             )
         else:
             field = self._parse_primary() or self._parse_function(
-                anonymous=anonymous_func, any_token=any_token
+                anonymous=anonymous_func, optional_parens=optional_parens, any_token=any_token
             )
         return field or self._parse_id_var(any_token=any_token, tokens=tokens)
 
diff --git a/tests/test_parser.py b/tests/test_parser.py
index c13ad3f84..f21d1ddf5 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -97,6 +97,19 @@ class TestParser(unittest.TestCase):
 
         self.assertIsNotNone(parse_one("date").find(exp.Column))
 
+    def test_no_paren_function_names_after_dot(self):
+        for sql in (
+            "SELECT mytable.current_user FROM mytable",
+            "SELECT a.current_date, b.x FROM a JOIN b ON a.current_date = b.current_date",
+            "SELECT db.t.current_timestamp FROM db.t",
+            "SELECT x.current_user.y FROM x",
+        ):
+            with self.subTest(sql):
+                self.assertEqual(parse_one(sql).sql(), sql)
+
+        self.assertIsInstance(parse_one("SELECT CURRENT_USER FROM x").selects[0], exp.CurrentUser)
+        self.assertEqual(parse_one("SELECT x.CURRENT_DATE()").sql(), "SELECT x.CURRENT_DATE()")
+
     def test_tuple(self):
         parse_one("(a,)").assert_is(exp.Tuple)
 

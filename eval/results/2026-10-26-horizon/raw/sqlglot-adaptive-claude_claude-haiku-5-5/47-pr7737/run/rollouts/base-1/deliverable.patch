+    def test_lateral_explode_unqualified_column_missing_table(self):
+        # The exploded column's base table is absent from a non-empty schema, so resolving it
+        # must not recurse back into the same LATERAL source
+        schema = {"other": {"id": "INT"}}
+        for sql in (
+            "SELECT x FROM t LATERAL VIEW EXPLODE(arr) u AS x",
+            "SELECT x FROM (SELECT * FROM t LATERAL VIEW EXPLODE(arr) u AS x)",
+        ):
+            with self.subTest(sql):
+                with self.assertRaisesRegex(OptimizeError, "Column 'arr' could not be resolved"):
+                    qualify(parse_one(sql, read="spark"), schema=schema, dialect="spark")
+
+        self.assertEqual(
+            qualify(
+                parse_one("SELECT x FROM t LATERAL VIEW EXPLODE(arr) u AS x", read="spark"),
+                schema={},
+                dialect="spark",
+            ).sql("spark"),
+            "SELECT `u`.`x` AS `x` FROM `t` AS `t` LATERAL VIEW EXPLODE(`t`.`arr`) u AS `x`",
+        )
+

diff --git a/sqlglot/generators/clickhouse.py b/sqlglot/generators/clickhouse.py
index eef1a97ad..9a6136945 100644
--- a/sqlglot/generators/clickhouse.py
+++ b/sqlglot/generators/clickhouse.py
@@ -584,6 +584,14 @@ class ClickHouseGenerator(generator.Generator):
 
         return f"{create_sql}{comment_sql}"
 
+    def groupconcat_sql(self, expression: exp.GroupConcat) -> str:
+        separator = expression.args.get("separator")
+        if separator:
+            args = f"({self.sql(expression, 'this')})"
+            return self.func("groupConcat", separator) + args
+
+        return self.func("groupConcat", expression.this)
+
     def prewhere_sql(self, expression: exp.PreWhere) -> str:
         this = self.indent(self.sql(expression, "this"))
         return f"{self.seg('PREWHERE')}{self.sep()}{this}"
diff --git a/sqlglot/parsers/clickhouse.py b/sqlglot/parsers/clickhouse.py
index 592ecc70c..2ee4a12e9 100644
--- a/sqlglot/parsers/clickhouse.py
+++ b/sqlglot/parsers/clickhouse.py
@@ -715,6 +715,22 @@ class ClickHouseParser(parser.Parser):
                 expr = self._parse_window(func)
             else:
                 expr = func
+        elif isinstance(func, exp.Anonymous) and func.name == "groupConcat":
+            # groupConcat(<separator>)(<expr>) -> the separator is the parameter, the column the argument
+            params = self._parse_func_params(func)
+            if params and len(params) == 1 and len(func.expressions) == 1:
+                func = self.expression(
+                    exp.GroupConcat(this=params[0], separator=func.expressions[0])
+                )
+                expr = self._parse_window(func)
+            elif params:
+                # e.g. groupConcat(<separator>, <max_size>)(<expr>)
+                func = self.expression(
+                    exp.ParameterizedAgg(
+                        this=func.this, expressions=func.expressions, params=params
+                    )
+                )
+                expr = self._parse_window(func)
 
         return expr
 

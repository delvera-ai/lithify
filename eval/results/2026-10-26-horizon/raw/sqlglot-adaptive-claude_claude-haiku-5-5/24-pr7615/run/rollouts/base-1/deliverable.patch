diff --git a/tests/test_schema.py b/tests/test_schema.py
index 2963af231..ed56dfc20 100644
--- a/tests/test_schema.py
+++ b/tests/test_schema.py
@@ -340,3 +340,28 @@ class TestSchema(unittest.TestCase):
         self.assertEqual(found, {"c": "int"})
         found = schema.find(exp.to_table("x"), ensure_data_types=True)
         self.assertEqual(found, {"c": exp.DataType.build("int")})
+
+    def test_find_cache(self):
+        schema = MappingSchema({"x": {"c": "int"}})
+        self.assertIsNone(schema.find(exp.to_table("y"), raise_on_missing=False))
+        self.assertEqual(schema.find(exp.to_table("x")), {"c": "int"})
+        self.assertEqual(
+            schema.find(exp.to_table("x"), ensure_data_types=True),
+            {"c": exp.DataType.build("int")},
+        )
+        self.assertEqual(schema.find(exp.to_table("x")), {"c": "int"})
+
+        ambiguous = MappingSchema({"db1": {"x": {"c": "int"}}, "db2": {"x": {"c": "int"}}})
+        self.assertIsNone(ambiguous.find(exp.to_table("x"), raise_on_missing=False))
+        with self.assertRaises(SchemaError):
+            ambiguous.find(exp.to_table("x"))
+
+        schema.add_table("y", {"d": "text"})
+        self.assertEqual(schema.find(exp.to_table("y"), raise_on_missing=False), {"d": "text"})
+        self.assertEqual(
+            schema.find(exp.to_table("y"), ensure_data_types=True),
+            {"d": exp.DataType.build("text")},
+        )
+
+        schema.add_table("y", {"d": "int", "e": "int"})
+        self.assertEqual(schema.find(exp.to_table("y")), {"d": "int", "e": "int"})

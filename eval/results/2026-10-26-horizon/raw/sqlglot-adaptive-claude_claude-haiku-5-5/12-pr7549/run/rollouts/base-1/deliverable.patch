index e2b7a6548..5f82e0c3e 100644
--- a/sqlglot/optimizer/resolver.py
+++ b/sqlglot/optimizer/resolver.py
@@ -365,6 +365,29 @@ class Resolver:
         source = scope.sources.get(table_name)
         return self._get_column_type_from_scope(source, column) if source else None
 
+    def get_lateral_element_type(self, lateral_scope: Scope) -> exp.DataType | None:
+        """
+        Get the element type of the array exploded by a `LATERAL VIEW EXPLODE(<column>)`.
+
+        Args:
+            lateral_scope: The scope of the `Lateral` expression.
+        Returns:
+            The element DataType of the exploded array, or None if it cannot be determined.
+        """
+        explode = lateral_scope.expression.this
+        column = explode.this if isinstance(explode, exp.Explode) else None
+
+        if not isinstance(column, exp.Column) or not column.table:
+            return None
+
+        source = lateral_scope.sources.get(column.table)
+        col_type = self._get_column_type_from_scope(source, column) if source else None
+
+        if col_type and col_type.is_type(exp.DType.ARRAY) and col_type.expressions:
+            return col_type.expressions[0]
+
+        return None
+

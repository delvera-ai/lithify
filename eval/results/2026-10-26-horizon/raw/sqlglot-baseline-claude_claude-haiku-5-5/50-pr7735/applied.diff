+            return self._parse_undrop()
+        return super()._parse_statement()
+
+    def _parse_undrop(self) -> exp.Undrop | exp.Command:
+        start = self._prev
+        kind = next(
+            (kind for kind in self.UNDROP_KINDS if self._match_text_seq(*kind.split(" "))),
+            None,
+        )
+        if not kind:
+            return self._parse_as_command(start)
+
+        this = self._parse_table_parts(schema=True) if self._curr else None
+        return self.expression(exp.Undrop(this=this, kind=kind))

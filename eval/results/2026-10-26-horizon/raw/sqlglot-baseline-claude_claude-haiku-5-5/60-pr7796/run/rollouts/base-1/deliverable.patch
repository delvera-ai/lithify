     def select_sql(self, expression: exp.Select) -> str:
         limit = expression.args.get("limit")
         offset = expression.args.get("offset")
diff --git a/sqlglot/parsers/snowflake.py b/sqlglot/parsers/snowflake.py
index 99dbb2759..c767dc753 100644
--- a/sqlglot/parsers/snowflake.py
+++ b/sqlglot/parsers/snowflake.py
@@ -1170,6 +1170,28 @@ class SnowflakeParser(parser.Parser):
 
         return super()._parse_id_var(any_token=any_token, tokens=tokens)
 
+    def _parse_function(
+        self,
+        functions: dict[str, t.Callable] | None = None,
+        anonymous: bool = False,
+        optional_parens: bool = True,
+        any_token: bool = False,
+    ) -> exp.Expr | None:
+        func = super()._parse_function(
+            functions=functions,
+            anonymous=anonymous,
+            optional_parens=optional_parens,
+            any_token=any_token,
+        )
+
+        # Dynamic invocation, e.g. IDENTIFIER($fn)(41)
+        if not isinstance(func, exp.DynamicIdentifier) or not self._match(TokenType.L_PAREN):
+            return func
+
+        call = self.expression(exp.Anonymous(this=func, expressions=self._parse_function_args()))
+        self._match_r_paren(call)
+        return call
+
     def _parse_show_snowflake(
         self, this: str, terse: bool = False, iceberg: bool = False
     ) -> exp.Show:

diff --git a/sqlglot/parsers/mysql.py b/sqlglot/parsers/mysql.py
index 9e12db747..85f124ae2 100644
--- a/sqlglot/parsers/mysql.py
+++ b/sqlglot/parsers/mysql.py
@@ -303,6 +303,19 @@ class MySQLParser(parser.Parser):
     VALUES_FOLLOWED_BY_PAREN = False
     SUPPORTS_PARTITION_SELECTION = True
 
+    def _parse_join(
+        self, skip_join_token: bool = False, parse_bracket: bool = False
+    ) -> exp.Join | None:
+        # Comma-separated tables in a multi-table UPDATE, where SET must not be parsed as an alias
+        if self._match(TokenType.COMMA, advance=False):
+            self._advance()
+            table = self._try_parse(
+                lambda: self._parse_table(alias_tokens=self.UPDATE_ALIAS_TOKENS)
+            )
+            return self.expression(exp.Join(this=table)) if table else None
+
+        return super()._parse_join(skip_join_token=skip_join_token, parse_bracket=parse_bracket)
+
     def _parse_alter_table_rename(self):
         if self._match_texts(("INDEX", "KEY")):
             old = self._parse_field(any_token=True)

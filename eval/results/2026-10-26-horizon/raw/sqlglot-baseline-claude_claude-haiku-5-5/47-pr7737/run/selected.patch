+    def test_qualify_unnest_unqualified_column_missing_table(self):
+        # The unnested column's table is absent from the schema, which used to recurse without bound
+        for read, sql in (
+            ("spark", "SELECT x FROM t LATERAL VIEW EXPLODE(arr) v AS x"),
+            ("snowflake", "SELECT f.value FROM t, LATERAL FLATTEN(input => arr) f"),
+            ("bigquery", "SELECT x FROM t, UNNEST(arr) AS x"),
+        ):
+            with self.subTest(sql):
+                with self.assertRaisesRegex(OptimizeError, "could not be resolved"):
+                    optimizer.qualify.qualify(
+                        parse_one(sql, read=read),
+                        schema={"s": {"x": {"a": "int"}}},
+                        dialect=read,
+                    )
+
     def test_qualify_columns__with_invisible(self):

+    def test_no_paren_function_names_as_column_identifiers(self):
+        for sql in (
+            "SELECT mytable.current_user FROM mytable",
+            "SELECT t.sysdate, t.current_date FROM t",
+        ):
+            with self.subTest(sql=sql):
+                self.assertEqual(parse_one(sql).sql(), sql)
+                for column in parse_one(sql).find_all(exp.Column):
+                    self.assertIsInstance(column.this, exp.Identifier)
+                self.assertFalse(list(parse_one(sql).find_all(exp.CurrentUser, exp.CurrentDate)))
+
     def test_tuple(self):

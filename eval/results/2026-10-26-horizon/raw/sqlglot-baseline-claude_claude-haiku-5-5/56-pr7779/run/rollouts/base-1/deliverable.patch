@@ -4,11 +4,13 @@ from __future__ import annotations
 from sqlglot import exp, transforms
 from sqlglot.dialects.dialect import (
     approx_count_distinct_sql,
+    arg_max_or_min_no_count,
     arrow_json_extract_sql,
     rename_func,
     unit_to_str,
     inline_array_sql,
     property_sql,
+    var_map_sql,
 )
 from sqlglot.generators.mysql import MySQLGenerator
 
@@ -38,6 +40,29 @@ def _eliminate_between_in_delete(expression: exp.Expr) -> exp.Expr:
     return expression
 
 
+def _var_map_sql(self: StarRocksGenerator, expression: exp.Map | exp.VarMap) -> str:
+    keys = expression.args.get("keys")
+    values = expression.args.get("values")
+
+    # MAP(k1, v1, ...) is StarRocks' variadic constructor; MAP_FROM_ARRAYS takes two arrays
+    if isinstance(keys, exp.Array) and isinstance(values, exp.Array):
+        return var_map_sql(self, expression)
+    return self.func("MAP_FROM_ARRAYS", keys, values)
+
+
+# https://docs.starrocks.io/docs/sql-reference/sql-functions/string-functions/trim/
+def _trim_sql(self: StarRocksGenerator, expression: exp.Trim) -> str:
+    chars = expression.expression
+    if not chars:
+        return self.trim_sql(expression)
+
+    if expression.args.get("collation"):
+        self.unsupported("TRIM collation is not supported")
+
+    func_name = {"LEADING": "LTRIM", "TRAILING": "RTRIM"}.get(expression.text("position"), "TRIM")
+    return self.func(func_name, expression.this, chars)
+
+
 # https://docs.starrocks.io/docs/sql-reference/sql-functions/spatial-functions/st_distance_sphere/
 def st_distance_sphere(self, expression: exp.StDistance) -> str:
     point1 = expression.this

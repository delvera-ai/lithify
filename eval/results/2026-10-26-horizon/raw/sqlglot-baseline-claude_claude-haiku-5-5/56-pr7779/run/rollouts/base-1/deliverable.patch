diff --git a/tests/dialects/test_starrocks.py b/tests/dialects/test_starrocks.py
index b6b27b254..ad3f6b750 100644
--- a/tests/dialects/test_starrocks.py
+++ b/tests/dialects/test_starrocks.py
@@ -333,3 +333,60 @@ class TestStarrocks(Validator):
         self.validate_identity(
             "CREATE TABLE test_table (col1 DATE) PARTITION BY RANGE (col1) (START ('2019-01-01') END ('2021-01-01') EVERY (INTERVAL 1 YEAR), START ('2021-01-01') END ('2021-05-01') EVERY (INTERVAL 1 MONTH), START ('2021-05-01') END ('2021-05-04') EVERY (INTERVAL 1 DAY))"
         )
+
+    def test_native_functions(self):
+        # MIN_BY / MAX_BY, including the window form
+        self.validate_identity("SELECT MIN_BY(a, b), MAX_BY(a, b) FROM t")
+        self.validate_identity("SELECT MIN_BY(a, b) OVER (PARTITION BY c) FROM t")
+        self.validate_all(
+            "SELECT MAX_BY(a, b) FROM t",
+            read={"duckdb": "SELECT ARG_MAX(a, b) FROM t"},
+        )
+        self.validate_all(
+            "SELECT MIN_BY(a, b) OVER (PARTITION BY c) FROM t",
+            read={"duckdb": "SELECT ARG_MIN(a, b) OVER (PARTITION BY c) FROM t"},
+        )
+        self.validate_all(
+            "SELECT MIN_BY(a, b)",
+            read={"duckdb": "SELECT ARG_MIN(a, b, 2)"},
+        )
+
+        # MAP is variadic; two-array maps from other dialects are rewritten
+        self.validate_identity("SELECT MAP('a', 1, 'b', 2)")
+        self.validate_identity("SELECT MAP()")
+        self.validate_all(
+            "SELECT MAP('a', 1, 'b', 2)",
+            read={
+                "duckdb": "SELECT MAP(['a', 'b'], [1, 2])",
+                "presto": "SELECT MAP(ARRAY['a', 'b'], ARRAY[1, 2])",
+                "snowflake": "SELECT MAP(['a', 'b'], [1, 2])",
+            },
+        )
+        self.validate_all(
+            "SELECT MAP_FROM_ARRAYS(k, v)",
+            read={"duckdb": "SELECT MAP(k, v)"},
+        )
+
+        # Array containment uses a function, not the Postgres @> operator
+        self.validate_identity("SELECT ARRAY_CONTAINS_ALL([1, 2], [1])")
+        self.validate_all(
+            "SELECT ARRAY_CONTAINS_ALL([1, 2], [1])",
+            read={"postgres": "SELECT ARRAY[1, 2] @> ARRAY[1]"},
+        )
+
+        # TRIM takes the characters as a second argument, not via TRIM(... FROM ...)
+        self.validate_identity("SELECT TRIM('  a  ')")
+        self.validate_identity("SELECT TRIM('xax', 'x')")
+        self.validate_identity("SELECT LTRIM('xax', 'x'), RTRIM('xax', 'x')")
+        self.validate_all(
+            "SELECT TRIM('xax', 'x')",
+            read={"mysql": "SELECT TRIM(BOTH 'x' FROM 'xax')"},
+        )
+        self.validate_all(
+            "SELECT LTRIM('xax', 'x')",
+            read={"postgres": "SELECT TRIM(LEADING 'x' FROM 'xax')"},
+        )
+        self.validate_all(
+            "SELECT RTRIM('xax', 'x')",
+            read={"spark": "SELECT TRIM(TRAILING 'x' FROM 'xax')"},
+        )

+
+    def test_lineage_all_columns(self) -> None:
+        sql = "SELECT a, b + 1 AS c FROM x"
+        schema = {"x": {"a": "int", "b": "int"}}
+
+        nodes = lineage(None, sql, schema=schema)
+        self.assertEqual(list(nodes), ["a", "c"])
+
+        for column, node in nodes.items():
+            self.assertIsInstance(node, Node)
+            self.assertEqual(
+                node.source.sql(),
+                lineage(column, sql, schema=schema).source.sql(),
+            )
+
+    def test_lineage_all_columns_union(self) -> None:
+        nodes = lineage(
+            None,
+            "SELECT a FROM x UNION ALL SELECT a FROM y",
+            schema={"x": {"a": "int"}, "y": {"a": "int"}},
+        )
+        self.assertEqual(list(nodes), ["a"])
+        self.assertEqual(nodes["a"].name, "UNION")
+        leaves = sorted(n.name for n in nodes["a"].walk() if not n.downstream)
+        self.assertEqual(leaves, ["x.a", "y.a"])
+
+    def test_lineage_on_node(self) -> None:
+        sql = "WITH c AS (SELECT a FROM x) SELECT s1.a + s2.a AS combined FROM c s1, c s2"
+        seen: list[Node] = []
+        downstream_sizes: dict[int, int] = {}
+
+        def on_node(node: Node) -> None:
+            seen.append(node)
+            downstream_sizes[id(node)] = len(node.downstream)
+
+        node = lineage("combined", sql, schema={"x": {"a": "int"}}, on_node=on_node)
+
+        # every node in the graph is reported exactly once
+        seen_ids = [id(n) for n in seen]
+        self.assertEqual(len(seen_ids), len(set(seen_ids)))
+        self.assertEqual({id(n) for n in node.walk()}, set(seen_ids))
+
+        # downstream nodes are already populated when the callback runs
+        for n in seen:
+            self.assertEqual(downstream_sizes[id(n)], len(n.downstream))
+
+    def test_lineage_on_node_payload(self) -> None:
+        def on_node(node: Node) -> None:
+            node.payload["name"] = node.name
+
+        node = lineage(
+            "a",
+            "SELECT a FROM (SELECT a FROM x) AS s",
+            schema={"x": {"a": "int"}},
+            on_node=on_node,
+        )
+        self.assertEqual(node.payload, {"name": "a"})
+        self.assertEqual(node.downstream[0].payload, {"name": "s.a"})
+        self.assertEqual(node.downstream[0].downstream[0].payload, {"name": "x.a"})
+
+    def test_lineage_node_payload_default(self) -> None:
+        first = Node(name="a", expression=exp.null(), source=exp.null())
+        second = Node(name="b", expression=exp.null(), source=exp.null())
+        first.payload["k"] = 1
+        self.assertEqual(second.payload, {})

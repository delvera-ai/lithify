+    def _parse_macro_overloads(
+        self,
+        this: exp.UserDefinedFunction,
+        expression: exp.Expr | None,
+        properties: exp.Properties | None,
+    ) -> tuple[exp.UserDefinedFunction, exp.MacroOverloads]:
+        # The first overload's TABLE marker is parsed as a RETURNS property,
+        # so move it onto that overload
+        returns = properties.find(exp.ReturnsProperty) if properties else None
+        table = bool(returns and returns.args.get("is_table"))
+        if returns and table:
+            returns.pop()
+
+        overloads = [
+            self.expression(
+                exp.MacroOverload(expressions=this.expressions, expression=expression, table=table)
+            )
+        ]
+
+        while self._match(TokenType.COMMA):
+            if not self._match(TokenType.L_PAREN):
+                self.raise_error("Expected ( to start a macro overload")
+
+            params = self._parse_csv(self._parse_function_parameter)
+            self._match_r_paren()
+
+            if not self._match(TokenType.ALIAS):
+                self.raise_error("Expected AS in macro overload")
+
+            table = bool(self._match(TokenType.TABLE))
+            body = self._parse_user_defined_function_expression()
+            overloads.append(
+                self.expression(exp.MacroOverload(expressions=params, expression=body, table=table))
+            )
+
+        return exp.UserDefinedFunction(this=this.this), self.expression(
+            exp.MacroOverloads(expressions=overloads)
+        )

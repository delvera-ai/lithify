index ea09866bc..f87e30ee3 100644
--- a/sqlglot/optimizer/qualify_columns.py
+++ b/sqlglot/optimizer/qualify_columns.py
@@ -199,6 +199,11 @@ def _unpivot_columns(unpivot: exp.Pivot) -> Iterator[exp.Column]:
     return itertools.chain(name_columns, value_columns)
 
 
+def _is_unpivot_output_column(column: exp.Column) -> bool:
+    pivot = column.find_ancestor(exp.Pivot)
+    return bool(pivot and pivot.unpivot and any(column is c for c in _unpivot_columns(pivot)))
+
+
 def _pop_table_column_aliases(derived_tables: Iterable[exp.Expr]) -> None:
     """
     Remove table column aliases.
@@ -617,6 +622,9 @@ def _qualify_columns(
                 raise OptimizeError(f"Unknown column: {column_name}")
 
         if not column_table:
+            if _is_unpivot_output_column(column):
+                continue
+
             if scope.pivots and not column.find_ancestor(exp.Pivot):
                 # If the column is under the Pivot expression, we need to qualify it
                 # using the name of the pivoted source instead of the pivot's alias
@@ -645,7 +653,11 @@ def _qualify_columns(
 
     for pivot in scope.pivots:
         for column in pivot.find_all(exp.Column):
-            if not column.table and column.name in resolver.all_columns:
+            if (
+                not column.table
+                and column.name in resolver.all_columns
+                and not _is_unpivot_output_column(column)
+            ):
                 table = resolver.get_table(column.name)
                 if table:
                     column.set("table", table)

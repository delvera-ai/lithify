-        unpivot_columns = [
-            col
+        # UNPIVOT(val FOR name IN (a, b)): the name column is derived from every IN-list source column.
+        # UNPIVOT((x, y) FOR name IN ((a, b) AS 'p', (c, d) AS 'q')): the i-th value column is derived
+        # from the i-th source column of each IN-list tuple, e.g. x <- a, c and y <- b, d.
+        in_sources = [
+            (e.this if isinstance(e, exp.PivotAlias) else e)
             for field in pivot.fields
             for e in field.expressions
-            for col in e.find_all(exp.Column)
         ]
-        for value_column in pivot.expressions:
-            for identifier in value_column.find_all(exp.Identifier):
-                mapping[identifier.name] = unpivot_columns
+        unpivot_columns = [col for source in in_sources for col in source.find_all(exp.Column)]
+
+        value_columns = (
+            pivot.expressions[0].expressions
+            if isinstance(pivot.expressions[0], exp.Tuple)
+            else pivot.expressions
+        )
+        for i, value_column in enumerate(value_columns):
+            mapping[value_column.name] = [
+                col
+                for source in in_sources
+                for col in (
+                    source.expressions[i] if isinstance(source, exp.Tuple) else source
+                ).find_all(exp.Column)
+            ]
+
         for field in pivot.fields:
             if isinstance(field, exp.In):
                 mapping[field.this.name] = unpivot_columns

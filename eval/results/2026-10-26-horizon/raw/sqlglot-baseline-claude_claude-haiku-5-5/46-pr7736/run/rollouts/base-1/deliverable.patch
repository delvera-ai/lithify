+    def test_unpivot_multiple_value_columns(self) -> None:
+        sql = """
+        SELECT a, b, nm
+        FROM sales UNPIVOT ((a, b) FOR nm IN ((jan, mar) AS 'x', (feb, apr) AS 'y'))
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int", "mar": "int", "apr": "int"}}
+
+        node = lineage("a", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+
+        node = lineage("b", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.MAR", "SALES.APR"])
+
+        node = lineage("nm", sql, schema=schema, dialect="snowflake")
+        self.assertEqual(
+            [d.name for d in node.downstream], ["SALES.JAN", "SALES.MAR", "SALES.FEB", "SALES.APR"]
+        )
+
+    def test_unpivot_aliased_in_list_and_expression(self) -> None:
+        sql = """
+        SELECT metric_name AS m, score * 2 AS x
+        FROM sales UNPIVOT (score FOR metric_name IN (jan AS 'J', feb AS 'F'))
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int"}}
+
+        node = lineage("m", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+
+        node = lineage("x", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+

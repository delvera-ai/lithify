diff --git a/tests/dialects/test_pipe_syntax.py b/tests/dialects/test_pipe_syntax.py
index 73e10e7d4..57eff513b 100644
--- a/tests/dialects/test_pipe_syntax.py
+++ b/tests/dialects/test_pipe_syntax.py
@@ -463,3 +463,13 @@ WHERE
             "FROM x |> TABLESAMPLE SYSTEM (1 PERCENT) |> WHERE x.x1 > 0 |> SELECT x1, x2",
             "WITH __tmp1 AS (SELECT x1, x2 FROM x WHERE x.x1 > 0 TABLESAMPLE SYSTEM (1 PERCENT)) SELECT * FROM __tmp1",
         )
+
+    def test_leading_with(self):
+        self.validate_identity(
+            "WITH x AS (SELECT 1 AS x1) FROM x |> SELECT x1, 2 AS x2",
+            "WITH x AS (SELECT 1 AS x1), __tmp1 AS (SELECT x1, 2 AS x2 FROM x) SELECT * FROM __tmp1",
+        )
+        self.validate_identity(
+            "WITH x AS (SELECT 1 AS x1), y AS (SELECT 2 AS y1) FROM x |> SELECT x1 |> WHERE x1 > 0",
+            "WITH x AS (SELECT 1 AS x1), y AS (SELECT 2 AS y1), __tmp1 AS (SELECT x1 FROM x) SELECT * FROM __tmp1 WHERE x1 > 0",
+        )

+    def _parse_create_type(self, start: Token, replace: bool) -> exp.Create | exp.Command:
+        this = self._parse_table_parts()
+        if not this or not self._match_text_seq("AS"):
+            return self._parse_as_command(start)
+
+        if self._match_text_seq("ENUM"):
+            values = self._try_parse(lambda: self._parse_wrapped_csv(self._parse_string))
+            expression = values and exp.DataType(this=exp.DataType.Type.ENUM, expressions=values)
+        else:
+            expression = self._parse_schema()
+
+        if not expression or not expression.expressions or self._curr:
+            return self._parse_as_command(start)
+
+        return self.expression(
+            exp.Create(this=this, kind="TYPE", replace=replace, expression=expression)
+        )

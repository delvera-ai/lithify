+    def _parse_listagg(self) -> exp.GroupConcat:
+        # LISTAGG([DISTINCT] value [, separator]) [WITHIN GROUP (ORDER BY ...)]
+        distinct = self._match(TokenType.DISTINCT)
+        this: exp.Expr = self._parse_lambda()
+        if distinct:
+            this = self.expression(exp.Distinct(expressions=[this]))
+        separator = self._parse_lambda() if self._match(TokenType.COMMA) else None
+        return self.expression(exp.GroupConcat(this=this, separator=separator))
+
     def _parse_json_extract(self) -> exp.JSONExtract:
         args = self._parse_expressions()
         self._match_r_paren()

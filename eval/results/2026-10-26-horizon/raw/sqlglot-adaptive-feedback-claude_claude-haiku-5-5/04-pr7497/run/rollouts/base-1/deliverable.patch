diff --git a/tests/dialects/test_duckdb.py b/tests/dialects/test_duckdb.py
index b0b0ee73c..1df7332a1 100644
--- a/tests/dialects/test_duckdb.py
+++ b/tests/dialects/test_duckdb.py
@@ -1951,6 +1951,18 @@ class TestDuckDB(Validator):
         self.validate_identity("ARRAY(SELECT id FROM t)")
         self.validate_identity("ARRAY((SELECT id FROM t))")
 
+    def test_json_array(self):
+        expr = self.validate_identity("SELECT JSON_ARRAY('a', 'b', 'c')")
+        self.assertIsInstance(expr.selects[0], exp.JSONArray)
+        self.validate_all(
+            "SELECT JSON_ARRAY('a', 'b', 'c')",
+            write={
+                "duckdb": "SELECT JSON_ARRAY('a', 'b', 'c')",
+                "mysql": "SELECT JSON_ARRAY('a', 'b', 'c')",
+                "snowflake": "SELECT ['a', 'b', 'c']",
+            },
+        )
+
     def test_cast(self):
         self.validate_identity("x::int[3]", "CAST(x AS INT[3])")
         self.validate_identity("CAST(x AS REAL)")

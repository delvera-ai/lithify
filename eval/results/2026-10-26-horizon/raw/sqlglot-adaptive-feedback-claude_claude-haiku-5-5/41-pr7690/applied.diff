+    def _parse_create(self) -> exp.Create | exp.Command:
+        create = super()._parse_create()
+        if not (
+            isinstance(create, exp.Create)
+            and isinstance(create.this, exp.UserDefinedFunction)
+            and self._match(TokenType.COMMA, advance=False)
+        ):
+            return create
+
+        properties = create.args.get("properties")
+        returns = properties.find(exp.ReturnsProperty) if properties else None
+        is_table = returns is not None
+        if properties and returns:
+            returns.pop()
+            if not properties.expressions:
+                create.set("properties", None)
+
+        overloads = [
+            self.expression(
+                exp.MacroOverload(
+                    expressions=create.this.expressions,
+                    expression=create.expression,
+                    table=is_table,
+                )
+            )
+        ]
+        while self._match(TokenType.COMMA):
+            overloads.append(self._parse_macro_overload())
+
+        create.set(
+            "this",
+            self.expression(exp.MacroOverloads(this=create.this.this, expressions=overloads)),
+        )
+        create.set("expression", None)
+        return create
+
+    def _parse_user_defined_function_expression(self) -> exp.Expr | None:
+        return self._parse_expression() or self._parse_statement()
+
+    def _parse_macro_overload(self) -> exp.MacroOverload:
+        params = self._parse_wrapped_csv(self._parse_function_parameter)
+        if not self._match(TokenType.ALIAS):
+            self.raise_error("Expected AS after macro parameters")
+
+        table = self._match(TokenType.TABLE)
+        body = self._parse_user_defined_function_expression()
+        return self.expression(exp.MacroOverload(expressions=params, expression=body, table=table))

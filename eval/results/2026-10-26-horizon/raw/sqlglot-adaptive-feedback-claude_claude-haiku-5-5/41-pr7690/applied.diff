+    def test_macro_overloads(self):
+        ast = self.validate_identity(
+            "CREATE MACRO add_x(a, b) AS a + b, (a, b, c) AS a + b + c"
+        ).assert_is(exp.Create)
+        self.assertIsInstance(ast.this, exp.MacroOverloads)
+        self.assertEqual(ast.this.this.sql(), "add_x")
+        self.assertEqual(
+            [len(overload.expressions) for overload in ast.this.expressions],
+            [2, 3],
+        )
+
+        self.assertEqual(
+            parse_one(
+                """
+                CREATE MACRO add_x
+                    (a, b) AS a + b,
+                    (a, b, c) AS a + b + c;""",
+                read="duckdb",
+            ).sql("duckdb"),
+            "CREATE MACRO add_x(a, b) AS a + b, (a, b, c) AS a + b + c",
+        )
+        self.validate_identity("CREATE OR REPLACE FUNCTION f(a) AS a + 1, () AS 0")
+        self.validate_identity("CREATE MACRO IF NOT EXISTS m(a) AS a, (b) AS (SELECT b)")
+        self.validate_identity("CREATE MACRO m(a) AS a + 1, (b) AS TABLE SELECT b")
+        self.validate_identity("CREATE MACRO m(a) AS TABLE (SELECT a), (b) AS (SELECT b)")
+
+        ast = self.validate_identity(
+            "CREATE MACRO m(a) AS (SELECT a), (b) AS TABLE (SELECT b)"
+        ).assert_is(exp.Create)
+        self.assertEqual(
+            [overload.args.get("table") for overload in ast.this.expressions], [False, True]
+        )

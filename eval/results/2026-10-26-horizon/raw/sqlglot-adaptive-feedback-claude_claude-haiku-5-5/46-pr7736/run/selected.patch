+    def test_unpivot_multiple_value_columns(self) -> None:
+        sql = """
+        SELECT a, b, id, n
+        FROM sales UNPIVOT ((a, b) FOR n IN ((jan, mar) AS 'Q1', (feb, apr) AS 'Q2'))
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int", "mar": "int", "apr": "int"}}
+
+        node = lineage("a", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+
+        node = lineage("b", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.MAR", "SALES.APR"])
+
+        node = lineage("n", sql, schema=schema, dialect="snowflake")
+        self.assertEqual(
+            [d.name for d in node.downstream], ["SALES.JAN", "SALES.MAR", "SALES.FEB", "SALES.APR"]
+        )
+
+        node = lineage("id", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.ID"])
+

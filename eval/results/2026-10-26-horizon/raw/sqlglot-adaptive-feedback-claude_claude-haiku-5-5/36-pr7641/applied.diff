         )
+
+    def test_null_ordering_mysql_ambiguous_columns(self):
+        self.validate_all(
+            "SELECT a.x, b.y FROM a JOIN b ON a.id = b.id ORDER BY x",
+            write={
+                "mysql": "SELECT a.x, b.y FROM a JOIN b ON a.id = b.id ORDER BY CASE WHEN a.x IS NULL THEN 1 ELSE 0 END, x",
+            },
+        )
+        self.validate_all(
+            "SELECT a.x AS v, b.y FROM a JOIN b ON a.id = b.id ORDER BY v",
+            write={
+                "mysql": "SELECT a.x AS v, b.y FROM a JOIN b ON a.id = b.id ORDER BY CASE WHEN a.x IS NULL THEN 1 ELSE 0 END, v",
+            },
+        )
+        self.validate_all(
+            "SELECT a.x, b.x FROM a JOIN b ON a.id = b.id ORDER BY b.x",
+            write={
+                "mysql": "SELECT a.x, b.x FROM a JOIN b ON a.id = b.id ORDER BY CASE WHEN b.x IS NULL THEN 1 ELSE 0 END, b.x",
+            },
+        )

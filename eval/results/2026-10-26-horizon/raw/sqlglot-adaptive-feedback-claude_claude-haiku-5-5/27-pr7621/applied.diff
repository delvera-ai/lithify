diff --git a/tests/test_parser.py b/tests/test_parser.py
index c13ad3f84..a04558d6e 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -1045,6 +1045,22 @@ class TestParser(unittest.TestCase):
         assert not any(isinstance(n, exp.Column) for n in ast.walk())
         assert len(list(ast.find_all(exp.Dot))) == 7
 
+    def test_dotted_no_paren_function_names_are_identifiers(self):
+        for column_sql in (
+            "mytable.current_user",
+            "mytable.current_date",
+            "db.mytable.current_user",
+        ):
+            with self.subTest(column_sql=column_sql):
+                ast = parse_one(f"SELECT {column_sql} FROM mytable")
+                self.assertIsInstance(ast.selects[0], exp.Column)
+                self.assertEqual(ast.sql(), f"SELECT {column_sql} FROM mytable")
+
+        self.assertIsInstance(
+            parse_one("SELECT mytable.current_user() FROM mytable").selects[0], exp.Dot
+        )
+        self.assertIsInstance(parse_one("SELECT current_user FROM t").selects[0], exp.CurrentUser)
+
     def test_pivot_missing_agg_func(self):
         with self.assertRaises(ParseError) as ctx:
             parse_one("select * from tbl pivot(col1 for col2 in (val1, val1))")

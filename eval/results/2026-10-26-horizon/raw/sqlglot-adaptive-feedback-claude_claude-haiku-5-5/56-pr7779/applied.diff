@@ -333,3 +333,63 @@ class TestStarrocks(Validator):
         self.validate_identity(
             "CREATE TABLE test_table (col1 DATE) PARTITION BY RANGE (col1) (START ('2019-01-01') END ('2021-01-01') EVERY (INTERVAL 1 YEAR), START ('2021-01-01') END ('2021-05-01') EVERY (INTERVAL 1 MONTH), START ('2021-05-01') END ('2021-05-04') EVERY (INTERVAL 1 DAY))"
         )
+
+    def test_aggregate_and_array_functions(self):
+        self.validate_identity("SELECT MIN_BY(a, b) FROM t").expressions[0].assert_is(exp.ArgMin)
+        self.validate_identity("SELECT MAX_BY(a, b) OVER (PARTITION BY c) FROM t")
+        self.validate_all(
+            "SELECT MAX_BY(a, b) FROM t",
+            read={"duckdb": "SELECT ARG_MAX(a, b) FROM t"},
+        )
+        self.validate_all(
+            "SELECT MIN_BY(a, b) FROM t",
+            read={"duckdb": "SELECT ARG_MIN(a, b) FROM t"},
+        )
+
+        self.validate_identity("SELECT ARRAY_CONTAINS_ALL(a, b)")
+        self.validate_all(
+            "SELECT ARRAY_CONTAINS_ALL(a, b)",
+            read={"postgres": "SELECT a @> b", "duckdb": "SELECT ARRAY_HAS_ALL(a, b)"},
+        )
+
+    def test_map_constructor(self):
+        self.validate_identity("SELECT MAP()")
+        self.validate_identity("SELECT MAP('a', 1, 'b', 2)").selects[0].assert_is(exp.Map)
+        self.validate_identity("SELECT MAP(a, b)")
+        self.validate_identity("SELECT MAP_FROM_ARRAYS([1, 2], ['x', 'y'])")
+
+        self.validate_all(
+            "SELECT MAP('a', 1, 'b', 2)",
+            read={
+                "duckdb": "SELECT MAP(['a', 'b'], [1, 2])",
+                "presto": "SELECT MAP(ARRAY['a', 'b'], ARRAY[1, 2])",
+                "spark": "SELECT MAP('a', 1, 'b', 2)",
+            },
+        )
+        self.validate_all(
+            "SELECT MAP_FROM_ARRAYS(k, v)",
+            read={"duckdb": "SELECT MAP(k, v)"},
+        )
+
+    def test_trim(self):
+        self.validate_identity("SELECT TRIM(a)")
+        self.validate_identity("SELECT TRIM(a, 'x')")
+        self.validate_identity("SELECT LTRIM(a, 'x')")
+        self.validate_identity("SELECT RTRIM(a)")
+
+        self.validate_all(
+            "SELECT TRIM(a, 'x')",
+            read={
+                "mysql": "SELECT TRIM(BOTH 'x' FROM a)",

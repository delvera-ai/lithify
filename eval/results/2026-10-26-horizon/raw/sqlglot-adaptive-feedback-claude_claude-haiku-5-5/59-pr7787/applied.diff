+    def _parse_property_before(self) -> exp.Expr | list[exp.Expr] | None:
+        index = self._index
+        prop = super()._parse_property_before()
+        if prop:
+            return prop
+
+        # Snowflake accepts generic KEY=VALUE properties between the table name and the schema
+        self._retreat(index)
+        if not self._match(TokenType.L_PAREN, advance=False):
+            return self._parse_property()
+        return None

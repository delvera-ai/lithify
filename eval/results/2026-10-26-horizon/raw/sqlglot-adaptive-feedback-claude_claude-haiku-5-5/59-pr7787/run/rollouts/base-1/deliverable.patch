index c19a6c8e4..6f32eec15 100644
--- a/sqlglot/parsers/snowflake.py
+++ b/sqlglot/parsers/snowflake.py
@@ -1027,6 +1027,18 @@ class SnowflakeParser(parser.Parser):
 
         return self.expression(exp.RowAccessProperty(this=policy, expressions=expressions))
 
+    def _parse_property_before(self) -> exp.Expr | list[exp.Expr] | None:
+        index = self._index
+        prop = super()._parse_property_before()
+        if prop:
+            return prop
+
+        # Snowflake accepts generic KEY=VALUE properties between the table name and the schema
+        self._retreat(index)
+        if not self._match(TokenType.L_PAREN, advance=False):
+            return self._parse_property()
+        return None
+
     def _parse_create(self) -> exp.Create | exp.Command:
         expression = super()._parse_create()
         if isinstance(expression, exp.Create) and expression.kind in self.NON_TABLE_CREATABLES:

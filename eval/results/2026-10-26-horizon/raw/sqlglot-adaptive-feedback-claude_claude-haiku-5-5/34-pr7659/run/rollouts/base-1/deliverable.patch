diff --git a/sqlglot/parser.py b/sqlglot/parser.py
index 163baa77d..5a6662113 100644
--- a/sqlglot/parser.py
+++ b/sqlglot/parser.py
@@ -3812,6 +3812,9 @@ class Parser:
 
             assert this is not None
             if "with_" in this.arg_types:
+                if existing := this.args.get("with_"):
+                    # e.g. pipe syntax generates CTEs that must follow the leading ones
+                    cte.set("expressions", cte.expressions + existing.expressions)
                 this.set("with_", cte)
             else:
                 self.raise_error(f"{this.key} does not support CTE")
diff --git a/tests/dialects/test_pipe_syntax.py b/tests/dialects/test_pipe_syntax.py
index 73e10e7d4..693ebc876 100644
--- a/tests/dialects/test_pipe_syntax.py
+++ b/tests/dialects/test_pipe_syntax.py
@@ -463,3 +463,13 @@ WHERE
             "FROM x |> TABLESAMPLE SYSTEM (1 PERCENT) |> WHERE x.x1 > 0 |> SELECT x1, x2",
             "WITH __tmp1 AS (SELECT x1, x2 FROM x WHERE x.x1 > 0 TABLESAMPLE SYSTEM (1 PERCENT)) SELECT * FROM __tmp1",
         )
+
+    def test_with(self):
+        self.validate_identity(
+            "WITH x AS (SELECT 1 AS x1) FROM x |> SELECT x1, 2 AS x2",
+            "WITH x AS (SELECT 1 AS x1), __tmp1 AS (SELECT x1, 2 AS x2 FROM x) SELECT * FROM __tmp1",
+        )
+        self.validate_identity(
+            "WITH x AS (SELECT 1 AS x1) SELECT * FROM x |> SELECT x1",
+            "WITH x AS (SELECT 1 AS x1), __tmp1 AS (SELECT x1 FROM x) SELECT * FROM __tmp1",
+        )

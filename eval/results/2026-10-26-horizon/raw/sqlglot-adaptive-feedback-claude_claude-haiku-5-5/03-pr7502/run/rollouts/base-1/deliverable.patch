diff --git a/tests/test_parser.py b/tests/test_parser.py
index 321703828..4d38abf7a 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -1084,3 +1084,22 @@ class TestParser(unittest.TestCase):
         self.assertIsInstance(
             parse_one("ALL PRIVILEGES", into=exp.GrantPrivilege), exp.GrantPrivilege
         )
+
+    def test_max_nodes(self):
+        wide = "SELECT " + ", ".join(f"c{i}" for i in range(500)) + " FROM t"
+        self.assertEqual(len(parse_one(wide).expressions), 500)
+        self.assertEqual(len(parse_one(wide, max_nodes=10000).expressions), 500)
+
+        node_count = sum(1 for _ in parse_one(wide).walk())
+        self.assertEqual(len(parse_one(wide, max_nodes=node_count).expressions), 500)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=node_count - 1)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one("SELECT 1 + " + " + ".join(["1"] * 300), max_nodes=50)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=100, error_level=ErrorLevel.IGNORE)
+
+        self.assertEqual(len(parse("SELECT 1; SELECT 2", max_nodes=5)), 2)

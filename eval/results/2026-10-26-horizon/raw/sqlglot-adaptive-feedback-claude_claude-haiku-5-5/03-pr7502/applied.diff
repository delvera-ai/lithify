diff --git a/tests/test_parser.py b/tests/test_parser.py
index 321703828..a13dcdd73 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -1084,3 +1084,21 @@ class TestParser(unittest.TestCase):
         self.assertIsInstance(
             parse_one("ALL PRIVILEGES", into=exp.GrantPrivilege), exp.GrantPrivilege
         )
+
+    def test_max_nodes(self):
+        wide = f"SELECT {', '.join(f'c{i}' for i in range(500))} FROM t"
+
+        self.assertEqual(len(parse_one(wide).expressions), 500)
+        self.assertEqual(len(parse_one(wide, max_nodes=10_000).expressions), 500)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=100)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one("SELECT " + " + ".join(["a"] * 300), read="duckdb", max_nodes=50)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, into=exp.Select, max_nodes=100)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse(wide, max_nodes=100)

+    def test_for_json(self):
+        json_possible_options = [
+            "AUTO",
+            "AUTO, ROOT",
+            "AUTO, ROOT('RootName')",
+            "AUTO, INCLUDE_NULL_VALUES",
+            "AUTO, WITHOUT_ARRAY_WRAPPER",
+            "AUTO, ROOT('RootName'), INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER",
+            "PATH",
+            "PATH, ROOT",
+            "PATH, ROOT('RootName')",
+            "PATH, INCLUDE_NULL_VALUES",
+            "PATH, WITHOUT_ARRAY_WRAPPER",
+            "PATH, ROOT('RootName'), INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER",
+        ]
+
+        for json_option in json_possible_options:
+            with self.subTest(f"Testing FOR JSON option: {json_option}"):
+                self.validate_identity(f"SELECT * FROM t FOR JSON {json_option}")
+
+        self.validate_identity(
+            "SELECT * FROM t FOR JSON AUTO, ROOT('RootName'), WITHOUT_ARRAY_WRAPPER",
+            """SELECT
+  *
+FROM t
+FOR JSON
+  AUTO,
+  ROOT('RootName'),
+  WITHOUT_ARRAY_WRAPPER""",
+            pretty=True,
+        )
+
+        options = parse_one("SELECT * FROM t FOR JSON PATH, ROOT('RootName')", read="tsql").args[
+            "for_json"
+        ]
+        self.assertEqual(len(options), 2)
+        self.assertEqual(options[0].this.name, "PATH")
+        self.assertIsInstance(options[1].this, exp.XMLKeyValueOption)
+
+        for invalid in (
+            "SELECT * FROM t FOR JSON",
+            "SELECT * FROM t FOR JSON FOO",
+            "SELECT * FROM t FOR JSON PATH, FOO",
+            "SELECT * FROM t FOR JSON PATH,",
+        ):
+            with self.subTest(invalid):
+                with self.assertRaises(ParseError):
+                    parse_one(invalid, read="tsql")
+
+        with self.assertLogs(helper_logger) as cm:
+            self.assertEqual(
+                parse_one("SELECT * FROM t FOR JSON PATH", read="tsql").sql("duckdb"),
+                "SELECT * FROM t",
+            )
+
+        self.assertIn("Unsupported query option.", cm.output[0])
+
     def test_types(self):

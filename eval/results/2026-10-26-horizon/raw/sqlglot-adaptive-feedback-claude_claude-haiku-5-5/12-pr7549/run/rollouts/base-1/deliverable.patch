+    def _get_explode_element_type(self, column: exp.Column) -> exp.DataType | None:
+        """Get the element type of an ARRAY column being exploded in this scope's FROM."""
+        if not isinstance(column, exp.Column):
+            return None
+
+        # not self.get_table(): that resolves against every source, including the lateral being resolved
+        source = self.scope.sources.get(column.table) if column.table else self.scope
+        col_type = self._get_column_type_from_scope(source, column) if source else None
+        if col_type and col_type.is_type(exp.DType.ARRAY) and col_type.expressions:
+            return col_type.expressions[0]
+        return None
+

index bfe0d74f4..89dab7860 100644
--- a/sqlglot/generators/redshift.py
+++ b/sqlglot/generators/redshift.py
@@ -12,7 +12,7 @@ from sqlglot.dialects.dialect import (
     no_tablesample_sql,
     rename_func,
 )
-from sqlglot.generator import Generator
+from sqlglot.generator import Generator, unsupported_args
 from sqlglot.generators.postgres import PostgresGenerator
 from sqlglot.helper import seq_get
 
@@ -336,6 +336,12 @@ class RedshiftGenerator(PostgresGenerator):
         self.unsupported("Unsupported EXPLODE() function")
         return ""
 
+    @unsupported_args("accuracy", "weight", "error_tolerance")
+    def approxquantile_sql(self, expression: exp.ApproxQuantile) -> str:
+        percentile = exp.PercentileDisc(this=expression.args["quantile"])
+        order = exp.Order(expressions=[exp.Ordered(this=expression.this)])
+        return f"APPROXIMATE {self.sql(exp.WithinGroup(this=percentile, expression=order))}"
+
     def _unix_to_time_sql(self, expression: exp.UnixToTime) -> str:
         scale = expression.args.get("scale")
         this = self.sql(expression.this)
diff --git a/sqlglot/parsers/redshift.py b/sqlglot/parsers/redshift.py
index 874ddfea2..f4b95bbaf 100644
--- a/sqlglot/parsers/redshift.py
+++ b/sqlglot/parsers/redshift.py
@@ -96,12 +96,26 @@ class RedshiftParser(PostgresParser):
         this = self._parse_bitwise()
         return self.expression(exp.TryCast(this=this, to=to, safe=safe))
 
-    def _parse_approximate_count(self) -> exp.ApproxDistinct | None:
+    def _parse_approximate_count(self) -> exp.ApproxDistinct | exp.ApproxQuantile | None:
         index = self._index - 1
         func = self._parse_function()
 
         if isinstance(func, exp.Count) and isinstance(func.this, exp.Distinct):
             return self.expression(exp.ApproxDistinct(this=seq_get(func.this.expressions, 0)))
+
+        # Only an ascending single-key ordering maps onto ApproxQuantile
+        if (
+            isinstance(func, exp.WithinGroup)
+            and isinstance(func.this, exp.PercentileDisc)
+            and isinstance(func.expression, exp.Order)
+            and len(func.expression.expressions) == 1
+            and not func.expression.expressions[0].args.get("desc")
+        ):
+            return self.expression(
+                exp.ApproxQuantile(
+                    this=func.expression.expressions[0].this, quantile=func.this.this
+                )
+            )
         self._retreat(index)
         return None
 

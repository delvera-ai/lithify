+    def test_qualify_columns__unnest_unqualified_column(self):
+        # resolving the type of an unqualified UNNEST / LATERAL column must not re-enter itself
+        sql = "SELECT x FROM t1 LATERAL VIEW EXPLODE(arr) v AS x"
+        expected = (
+            "SELECT `v`.`x` AS `x` FROM `t1` AS `t1` LATERAL VIEW EXPLODE(`t1`.`arr`) v AS `x`"
+        )
+        self.assertEqual(
+            qualify(
+                parse_one(sql, read="spark"),
+                schema={"t1": {"arr": "array<int>"}},
+                dialect="spark",
+            ).sql("spark"),
+            expected,
+        )
+
+        for dialect, sql in (
+            ("spark", "SELECT x FROM t1 LATERAL VIEW EXPLODE(arr) v AS x"),
+            ("hive", "SELECT x FROM t1 LATERAL VIEW EXPLODE(arr) v AS x"),
+            (
+                "spark",
+                "SELECT x FROM t1 LATERAL VIEW EXPLODE(arr) v AS x LATERAL VIEW EXPLODE(x) w AS y",
+            ),
+            ("bigquery", "SELECT x FROM t1, UNNEST(arr) AS x"),
+        ):
+            with self.subTest(sql):
+                with self.assertRaises(OptimizeError):
+                    qualify(
+                        parse_one(sql, read=dialect),
+                        schema={"other": {"a": "int"}},
+                        dialect=dialect,
+                    )
+

diff --git a/tests/dialects/test_exasol.py b/tests/dialects/test_exasol.py
index 4c13e18a6..7b504dc6b 100644
--- a/tests/dialects/test_exasol.py
+++ b/tests/dialects/test_exasol.py
@@ -1017,3 +1017,38 @@ class TestExasol(Validator):
             read={"mysql": "SELECT COUNT(*) AS cnt FROM t HAVING cnt > 1"},
             write={"exasol": "SELECT COUNT(*) AS cnt FROM t HAVING LOCAL.cnt > 1"},
         )
+
+    def test_local_prefix_for_alias_case_insensitive(self):
+        # Unquoted identifiers fold to upper case in Exasol, so the case of the reference does not matter
+        self.validate_all(
+            "SELECT 1 AS idField FROM t GROUP BY LOCAL.idField",
+            read={"mysql": "SELECT 1 AS idField FROM t GROUP BY idfield"},
+            write={"exasol": "SELECT 1 AS idField FROM t GROUP BY LOCAL.idField"},
+        )
+        self.validate_all(
+            "SELECT 1 AS idField FROM t WHERE LOCAL.idField > 1",
+            read={"mysql": "SELECT 1 AS idField FROM t WHERE IDFIELD > 1"},
+            write={"exasol": "SELECT 1 AS idField FROM t WHERE LOCAL.idField > 1"},
+        )
+        self.validate_all(
+            "SELECT COUNT(*) AS idField FROM t HAVING LOCAL.idField > 1",
+            read={"mysql": "SELECT COUNT(*) AS idField FROM t HAVING idfield > 1"},
+            write={"exasol": "SELECT COUNT(*) AS idField FROM t HAVING LOCAL.idField > 1"},
+        )
+        # Quoted identifiers are case-sensitive, so only the exact spelling matches
+        self.validate_all(
+            'SELECT 1 AS "idField" FROM t GROUP BY LOCAL."idField"',
+            read={"mysql": "SELECT 1 AS `idField` FROM t GROUP BY `idField`"},
+            write={"exasol": 'SELECT 1 AS "idField" FROM t GROUP BY LOCAL."idField"'},
+        )
+        self.validate_all(
+            'SELECT 1 AS "idField" FROM t GROUP BY idfield',
+            read={"mysql": "SELECT 1 AS `idField` FROM t GROUP BY idfield"},
+            write={"exasol": 'SELECT 1 AS "idField" FROM t GROUP BY idfield'},
+        )
+        # A quoted reference to an unquoted alias matches its folded upper case name
+        self.validate_all(
+            "SELECT 1 AS idField FROM t GROUP BY LOCAL.idField",
+            read={"mysql": "SELECT 1 AS idField FROM t GROUP BY `IDFIELD`"},
+            write={"exasol": "SELECT 1 AS idField FROM t GROUP BY LOCAL.idField"},
+        )

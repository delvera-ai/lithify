+    def _parse_listagg(self) -> exp.GroupConcat:
+        listagg = self._parse_string_agg()
+        # Exasol's default delimiter is an empty string, not the "," used when no separator is given
+        if not listagg.args.get("separator"):
+            listagg.set("separator", exp.Literal.string(""))
+        return listagg
+
     def _parse_json_extract(self) -> exp.JSONExtract:
         args = self._parse_expressions()
         self._match_r_paren()

@@ -340,3 +340,24 @@ class TestSchema(unittest.TestCase):
         self.assertEqual(found, {"c": "int"})
         found = schema.find(exp.to_table("x"), ensure_data_types=True)
         self.assertEqual(found, {"c": exp.DataType.build("int")})
+
+    def test_find_cache(self):
+        schema = MappingSchema({"x": {"c": "int"}})
+        self.assertIsNone(schema.find(exp.to_table("y"), raise_on_missing=False))
+        self.assertIsNone(schema.find(exp.to_table("y")))
+
+        self.assertEqual(schema.find(exp.to_table("x")), {"c": "int"})
+        self.assertEqual(
+            schema.find(exp.to_table("x"), ensure_data_types=True), {"c": exp.DataType.build("int")}
+        )
+        self.assertEqual(schema.find(exp.to_table("x")), {"c": "int"})
+
+        schema.add_table("y", {"d": "text"})
+        self.assertEqual(schema.find(exp.to_table("y")), {"d": "text"})
+
+        schema.add_table("x", {"c": "text", "e": "int"})
+        self.assertEqual(schema.find(exp.to_table("x")), {"c": "text", "e": "int"})
+        self.assertEqual(
+            schema.find(exp.to_table("x"), ensure_data_types=True),
+            {"c": exp.DataType.build("text"), "e": exp.DataType.build("int")},
+        )

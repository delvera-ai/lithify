   "_0"."EMPID";
 
+# title: unpivoted CTE source, the unpivot's value and name columns are new output columns
+# execute: false
+WITH c AS (SELECT empid, jan, feb FROM m_sales) SELECT * FROM c UNPIVOT(sales FOR month IN (jan, feb));
+WITH "c" AS (
+  SELECT
+    "m_sales"."empid" AS "empid",
+    "m_sales"."jan" AS "jan",
+    "m_sales"."feb" AS "feb"
+  FROM "m_sales" AS "m_sales"
+)
+SELECT
+  "c"."empid" AS "empid",
+  "c"."month" AS "month",
+  "c"."sales" AS "sales"
+FROM "c" AS "c"
+UNPIVOT("sales" FOR "month" IN ("c"."jan", "c"."feb")) AS "c";
+
 # title: unpivoted table source with a single value column, unpivot columns can be qualified
 # execute: false
 # dialect: bigquery

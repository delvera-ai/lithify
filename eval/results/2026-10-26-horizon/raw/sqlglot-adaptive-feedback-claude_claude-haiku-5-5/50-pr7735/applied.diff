diff --git a/tests/dialects/test_snowflake.py b/tests/dialects/test_snowflake.py
index 8eccf066c..f649aedca 100644
--- a/tests/dialects/test_snowflake.py
+++ b/tests/dialects/test_snowflake.py
@@ -5201,6 +5201,32 @@ MATCH_RECOGNIZE (
                             pretty=True,
                         )
 
+    def test_undrop(self):
+        for kind in (
+            "TABLE",
+            "SCHEMA",
+            "DATABASE",
+            "ACCOUNT",
+            "NOTEBOOK",
+            "SNAPSHOT",
+            "STREAMLIT",
+            "TAG",
+            "TYPE",
+            "DYNAMIC TABLE",
+            "EXTERNAL VOLUME",
+            "ICEBERG TABLE",
+        ):
+            with self.subTest(f"UNDROP {kind}"):
+                expr = self.validate_identity(f"UNDROP {kind} x")
+                self.assertIsInstance(expr, exp.Undrop)
+                self.assertEqual(expr.args["kind"], kind)
+
+        self.validate_identity("UNDROP TABLE db.s.t")
+        self.validate_identity("UNDROP SCHEMA db.s")
+        self.validate_identity("UNDROP TABLE IDENTIFIER('\"01a2b3\"')")
+        self.validate_identity("UNDROP DYNAMIC TABLE IDENTIFIER('\"01a2b3\"')")
+        self.assertIsInstance(parse_one("UNDROP FOO x", read="snowflake"), exp.Command)
+
     def test_show_users(self):
         self.validate_identity("SHOW USERS")
         self.validate_identity("SHOW TERSE USERS")

diff --git a/tests/test_lineage.py b/tests/test_lineage.py
index 13577bb2f..da7aa3f5c 100644
--- a/tests/test_lineage.py
+++ b/tests/test_lineage.py
@@ -3,7 +3,7 @@ from __future__ import annotations
 import unittest
 
 import sqlglot
-from sqlglot.lineage import lineage
+from sqlglot.lineage import Node, lineage
 from sqlglot.schema import MappingSchema
 
 
@@ -862,3 +862,64 @@ class TestLineage(unittest.TestCase):
         )
         downstream_names = sorted(d.name for d in node.downstream)
         self.assertEqual(downstream_names, ["s1.a", "s2.a"])
+
+    def test_lineage_all_output_columns(self) -> None:
+        sql = "WITH z AS (SELECT a, b FROM x) SELECT z.a AS a, z.b + 1 AS c FROM z"
+        schema = {"x": {"a": "int", "b": "int"}}
+
+        nodes = lineage(None, sql, schema=schema)
+
+        self.assertEqual(list(nodes), ["a", "c"])
+        for name, node in nodes.items():
+            single = lineage(name, sql, schema=schema)
+            self.assertEqual(node.name, single.name)
+            self.assertEqual(node.source.sql(), single.source.sql())
+            self.assertEqual(
+                sorted(n.name for n in node.walk()),
+                sorted(n.name for n in single.walk()),
+            )
+
+    def test_lineage_on_node_called_for_every_node(self) -> None:
+        sql = "SELECT a, b FROM x UNION ALL SELECT a, b FROM x"
+        schema = {"x": {"a": "int", "b": "int"}}
+        created: list[Node] = []
+
+        nodes = lineage(None, sql, schema=schema, on_node=created.append)
+
+        self.assertEqual(len({id(n) for n in created}), len(created))
+        walked = {id(n) for root in nodes.values() for n in root.walk()}
+        self.assertEqual({id(n) for n in created}, walked)
+
+        node = lineage("a", sql, schema=schema, on_node=created.append)
+        self.assertEqual(len({id(n) for n in created}), len(created))
+        self.assertIn(id(node), {id(n) for n in created})
+
+    def test_lineage_on_node_sees_populated_downstream(self) -> None:
+        sql = "WITH z AS (SELECT a FROM x) SELECT z.a AS a FROM z JOIN y ON z.a = y.a"
+        schema = {"x": {"a": "int"}, "y": {"a": "int"}}
+        seen: list[tuple[Node, int]] = []
+
+        node = lineage(
+            "a",
+            sql,
+            schema=schema,
+            on_node=lambda n: seen.append((n, len(n.downstream))),
+        )
+
+        self.assertTrue(seen)
+        for seen_node, downstream_count in seen:
+            self.assertEqual(len(seen_node.downstream), downstream_count)
+        self.assertIn(node, [n for n, _ in seen])
+
+    def test_lineage_node_payload(self) -> None:
+        sql = "WITH z AS (SELECT a FROM x) SELECT z.a AS a FROM z"
+        schema = {"x": {"a": "int"}}
+
+        def tag(node: Node) -> None:
+            node.payload["table"] = node.expression.sql()
+
+        nodes = lineage(None, sql, schema=schema, on_node=tag)
+
+        for node in nodes["a"].walk():
+            self.assertEqual(node.payload["table"], node.expression.sql())
+        self.assertEqual(nodes["a"].payload, {"table": nodes["a"].expression.sql()})

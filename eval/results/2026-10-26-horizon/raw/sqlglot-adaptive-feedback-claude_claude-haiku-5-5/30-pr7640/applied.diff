+    def test_window_clause_without_from(self):
+        self.validate_identity("SELECT 1 WINDOW a AS (PARTITION BY x)")
+        self.validate_identity("SELECT SUM(1) OVER a WINDOW a AS (PARTITION BY x)")
+
+        window = self.parse_one("SELECT 1 WINDOW a AS (PARTITION BY x)").args["windows"][0]
+        self.assertIsInstance(window, exp.Window)
+        self.assertEqual(window.name, "a")
+        self.assertEqual(window.args["partition_by"][0].sql(), "x")
+
+        self.assertEqual(self.parse_one("SELECT 1 window FROM t").expressions[0].alias, "window")
+

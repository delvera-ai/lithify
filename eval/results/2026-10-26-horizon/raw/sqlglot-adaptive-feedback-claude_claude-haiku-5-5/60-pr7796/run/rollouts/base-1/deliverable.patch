diff --git a/sqlglot/parsers/snowflake.py b/sqlglot/parsers/snowflake.py
index 99dbb2759..3ca9430f2 100644
--- a/sqlglot/parsers/snowflake.py
+++ b/sqlglot/parsers/snowflake.py
@@ -1156,6 +1156,32 @@ class SnowflakeParser(parser.Parser):
 
         return table
 
+    def _parse_function_call(
+        self,
+        functions: dict[str, t.Callable] | None = None,
+        anonymous: bool = False,
+        optional_parens: bool = True,
+        any_token: bool = False,
+    ) -> exp.Expr | None:
+        func = super()._parse_function_call(
+            functions=functions,
+            anonymous=anonymous,
+            optional_parens=optional_parens,
+            any_token=any_token,
+        )
+
+        # In a table part (optional_parens=False), a following paren list is a column alias
+        if (
+            optional_parens
+            and isinstance(func, exp.DynamicIdentifier)
+            and self._match(TokenType.L_PAREN)
+        ):
+            args = self._parse_function_args()
+            self._match_r_paren()
+            return self.expression(exp.DynamicFunction(this=func, expressions=args))
+
+        return func
+
     def _parse_id_var(
         self,
         any_token: bool = True,

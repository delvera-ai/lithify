diff --git a/sqlglot/generators/postgres.py b/sqlglot/generators/postgres.py
index 15baf8b7e..b53e6bf46 100644
--- a/sqlglot/generators/postgres.py
+++ b/sqlglot/generators/postgres.py
@@ -487,6 +487,18 @@ class PostgresGenerator(generator.Generator):
 
         return super().datatype_sql(expression)
 
+    def create_sql(self, expression: exp.Create) -> str:
+        if expression.kind != "TYPE":
+            return super().create_sql(expression)
+
+        this = expression.this
+        if isinstance(this, exp.Schema):
+            attributes = self.wrap(self.expressions(this, flat=True))
+            return f"CREATE TYPE {self.sql(this, 'this')} AS {attributes}"
+
+        values = self.wrap(self.expressions(expression.expression, flat=True))
+        return f"CREATE TYPE {self.sql(this)} AS ENUM {values}"
+
     def cast_sql(self, expression: exp.Cast, safe_prefix: str | None = None) -> str:
         this = expression.this
 
diff --git a/sqlglot/parsers/postgres.py b/sqlglot/parsers/postgres.py
index 2fac62242..6d6780c10 100644
--- a/sqlglot/parsers/postgres.py
+++ b/sqlglot/parsers/postgres.py
@@ -341,3 +341,33 @@ class PostgresParser(parser.Parser):
                 udt_type = exp.Dot(this=udt_type, expression=part)
 
         return exp.DataType.build(udt_type, udt=True)
+
+    def _parse_create(self) -> exp.Create | exp.Command:
+        start = self._prev
+
+        if not self._match_text_seq("TYPE"):
+            return super()._parse_create()
+
+        this: exp.Expr | None = self._parse_table_parts()
+        if not this or not self._match(TokenType.ALIAS):
+            return self._parse_as_command(start)
+
+        expression: exp.DataType | None = None
+        if self._match_text_seq("ENUM"):
+            # CREATE TYPE t AS ENUM ('a', 'b')
+            expression = exp.DataType(
+                this=exp.DType.ENUM, expressions=self._parse_wrapped_csv(self._parse_string)
+            )
+        elif self._match(TokenType.L_PAREN, advance=False):
+            # CREATE TYPE t AS (name type, ...)
+            attributes = self._parse_wrapped_csv(
+                lambda: self._parse_column_def(self._parse_id_var())
+            )
+            this = exp.Schema(this=this, expressions=attributes)
+        else:
+            return self._parse_as_command(start)
+
+        if self._curr:
+            return self._parse_as_command(start)
+
+        return self.expression(exp.Create(this=this, kind="TYPE", expression=expression))
diff --git a/tests/dialects/test_postgres.py b/tests/dialects/test_postgres.py
index 420db449b..019a8f203 100644
--- a/tests/dialects/test_postgres.py
+++ b/tests/dialects/test_postgres.py
@@ -1701,6 +1701,27 @@ CROSS JOIN JSON_ARRAY_ELEMENTS(CAST(JSON_EXTRACT_PATH(tbox, 'boxes') AS JSON)) A
             "ROUND(CAST(x AS DECIMAL(18, 3)), 4)", read={"duckdb": "ROUND(x::DECIMAL, 4)"}
         )
 
+    def test_create_type(self):
+        self.validate_identity("CREATE TYPE book_type AS ENUM ('FICTION', 'NONFICTION')")
+        self.validate_identity("CREATE TYPE book_type AS ENUM ()")
+        self.validate_identity(
+            "CREATE TYPE public.complex AS (r DOUBLE PRECISION, i DOUBLE PRECISION)"
+        )
+
+        enum = self.parse_one("CREATE TYPE book_type AS ENUM ('FICTION', 'NONFICTION')")
+        self.assertIsInstance(enum, exp.Create)
+        self.assertEqual(enum.kind, "TYPE")
+        self.assertIsInstance(enum.this, exp.Table)
+        self.assertTrue(enum.expression.is_type(exp.DType.ENUM))
+        self.assertEqual([v.name for v in enum.expression.expressions], ["FICTION", "NONFICTION"])
+
+        composite = self.parse_one("CREATE TYPE complex AS (r INT, i TEXT)")
+        self.assertIsInstance(composite.this, exp.Schema)
+        self.assertEqual([cdef.name for cdef in composite.this.expressions], ["r", "i"])
+        self.assertIsNone(composite.expression)
+
+        self.assertIsInstance(self.parse_one("CREATE TYPE shell_type"), exp.Command)
+
     def test_datatype(self):
         self.assertEqual(exp.DataType.build("XML", dialect="postgres").sql("postgres"), "XML")
         self.validate_identity("CREATE TABLE foo (data XML)")

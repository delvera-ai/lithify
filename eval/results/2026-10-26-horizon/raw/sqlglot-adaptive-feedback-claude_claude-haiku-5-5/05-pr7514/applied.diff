--- a/tests/dialects/test_doris.py
+++ b/tests/dialects/test_doris.py
@@ -1,3 +1,4 @@
+from sqlglot import exp
 from tests.dialects.test_dialect import Validator
 
 
@@ -252,3 +253,19 @@ class TestDoris(Validator):
         self.validate_identity(
             "CREATE MATERIALIZED VIEW mv BUILD DEFERRED REFRESH AUTO ON SCHEDULE EVERY 10 MINUTE AS SELECT 1"
         )
+
+    def test_date_add_days(self):
+        self.assertIsInstance(
+            self.validate_identity("SELECT DATE_ADD('2025-01-01', 1)").selects[0], exp.TsOrDsAdd
+        )
+        self.assertIsInstance(self.parse_one("SELECT DATE_SUB(x, 1)").selects[0], exp.TsOrDsAdd)
+        self.validate_all("SELECT DATE_ADD(x, -1)", read={"doris": "SELECT DATE_SUB(x, 1)"})
+        self.validate_all(
+            "SELECT DATE_ADD(x, 1)",
+            write={
+                "doris": "SELECT DATE_ADD(x, 1)",
+                "duckdb": "SELECT CAST(x AS DATE) + INTERVAL 1 DAY",
+                "hive": "SELECT DATE_ADD(x, 1)",
+                "mysql": "SELECT DATE_ADD(x, INTERVAL 1 DAY)",
+            },
+        )

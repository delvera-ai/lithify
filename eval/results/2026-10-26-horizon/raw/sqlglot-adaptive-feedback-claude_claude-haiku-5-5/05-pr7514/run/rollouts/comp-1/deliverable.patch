diff --git a/tests/dialects/test_doris.py b/tests/dialects/test_doris.py
index a33fed3aa..9585dbffe 100644
--- a/tests/dialects/test_doris.py
+++ b/tests/dialects/test_doris.py
@@ -252,3 +252,20 @@ class TestDoris(Validator):
         self.validate_identity(
             "CREATE MATERIALIZED VIEW mv BUILD DEFERRED REFRESH AUTO ON SCHEDULE EVERY 10 MINUTE AS SELECT 1"
         )
+
+    def test_date_add_days(self):
+        from sqlglot import exp
+
+        self.validate_identity("SELECT DATE_ADD(x, 1)").selects[0].assert_is(exp.TsOrDsAdd)
+        self.validate_identity("SELECT DATE_ADD(x, -1)")
+        self.validate_identity(
+            "SELECT DATE_ADD(x, INTERVAL 1 DAY)", "SELECT DATE_ADD(x, INTERVAL '1' DAY)"
+        ).selects[0].assert_is(exp.DateAdd)
+        self.validate_all(
+            "SELECT DATE_ADD('2025-01-01', -1)",
+            read={"doris": "SELECT DATE_SUB('2025-01-01', 1)"},
+        )
+        self.validate_all(
+            "SELECT DATE_ADD(x, INTERVAL 1 MONTH)",
+            read={"redshift": "SELECT DATEADD(MONTH, 1, x)"},
+        )

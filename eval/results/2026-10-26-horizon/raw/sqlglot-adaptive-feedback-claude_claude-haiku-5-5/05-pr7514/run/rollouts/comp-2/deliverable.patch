diff --git a/tests/dialects/test_doris.py b/tests/dialects/test_doris.py
index a33fed3aa..58708b4f9 100644
--- a/tests/dialects/test_doris.py
+++ b/tests/dialects/test_doris.py
@@ -1,3 +1,4 @@
+from sqlglot import exp, parse_one
 from tests.dialects.test_dialect import Validator
 
 
@@ -252,3 +253,22 @@ class TestDoris(Validator):
         self.validate_identity(
             "CREATE MATERIALIZED VIEW mv BUILD DEFERRED REFRESH AUTO ON SCHEDULE EVERY 10 MINUTE AS SELECT 1"
         )
+
+    def test_date_add_days(self):
+        self.validate_identity("DATE_ADD(x, 1)").assert_is(exp.TsOrDsAdd)
+        self.validate_identity("DATE_SUB(x, 1)", "DATE_ADD(x, -1)").assert_is(exp.TsOrDsAdd)
+        self.assertIsInstance(
+            parse_one("DATE_ADD(x, INTERVAL 1 DAY)", read=self.dialect), exp.DateAdd
+        )
+        self.assertIsInstance(
+            parse_one("DATE_SUB(x, INTERVAL 1 DAY)", read=self.dialect), exp.DateSub
+        )
+        self.validate_all(
+            "DATE_ADD(x, 1)",
+            read={"spark": "DATE_ADD(x, 1)"},
+            write={"doris": "DATE_ADD(x, 1)", "mysql": "DATE_ADD(x, INTERVAL 1 DAY)"},
+        )
+        self.validate_all(
+            "DATE_ADD(x, INTERVAL 1 MONTH)",
+            read={"redshift": "DATEADD(MONTH, 1, x)"},
+        )

@@ -88,6 +89,12 @@ class TestDoris(Validator):
 
         self.validate_identity("L2_DISTANCE(x, y)")
 
+        self.validate_identity("DATE_ADD('2025-01-01', 1)").assert_is(exp.TsOrDsAdd)

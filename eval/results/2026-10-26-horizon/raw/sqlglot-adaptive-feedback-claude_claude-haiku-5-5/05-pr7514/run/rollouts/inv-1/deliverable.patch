diff --git a/tests/dialects/test_doris.py b/tests/dialects/test_doris.py
index a33fed3aa..0aa022495 100644
--- a/tests/dialects/test_doris.py
+++ b/tests/dialects/test_doris.py
@@ -1,3 +1,4 @@
+from sqlglot import exp
 from tests.dialects.test_dialect import Validator
 
 
@@ -252,3 +253,29 @@ class TestDoris(Validator):
         self.validate_identity(
             "CREATE MATERIALIZED VIEW mv BUILD DEFERRED REFRESH AUTO ON SCHEDULE EVERY 10 MINUTE AS SELECT 1"
         )
+
+    def test_date_add_sub_days(self):
+        expr = self.validate_identity("SELECT DATE_ADD('2025-01-01', 1)").selects[0]
+        self.assertIsInstance(expr, exp.TsOrDsAdd)
+        self.assertEqual(expr.text("unit"), "DAY")
+
+        self.validate_identity("SELECT DATE_ADD(x, -n)")
+        self.validate_identity("SELECT DATE_ADD(x, INTERVAL '1' DAY)")
+        self.validate_all(
+            "SELECT DATE_SUB('2025-01-01', 1)",
+            write={
+                "doris": "SELECT DATE_ADD('2025-01-01', -1)",
+                "duckdb": "SELECT CAST('2025-01-01' AS DATE) + INTERVAL (-1) DAY",
+            },
+        )
+        self.validate_all(
+            "SELECT DATE_ADD('2025-01-01', 1)",
+            write={
+                "doris": "SELECT DATE_ADD('2025-01-01', 1)",
+                "duckdb": "SELECT CAST('2025-01-01' AS DATE) + INTERVAL 1 DAY",
+            },
+        )
+        self.validate_all(
+            "SELECT DATE_ADD(x, INTERVAL '1' HOUR)",
+            write={"doris": "SELECT DATE_ADD(x, INTERVAL '1' HOUR)"},
+        )

diff --git a/sqlglot/generators/mysql.py b/sqlglot/generators/mysql.py
index 0a47bb8bc..870576c2d 100644
--- a/sqlglot/generators/mysql.py
+++ b/sqlglot/generators/mysql.py
@@ -84,6 +84,13 @@ def date_add_sql(
     return func
 
 
+def ts_or_ds_add_sql(self: MySQLGenerator, expression: exp.TsOrDsAdd) -> str:
+    # Doris/StarRocks accept DATE_ADD(date, days) without INTERVAL for day arithmetic
+    if expression.text("unit").upper() in ("", "DAY"):
+        return self.func("DATE_ADD", expression.this, expression.expression)
+    return date_add_sql("ADD")(self, expression)
+
+
 def _ts_or_ds_to_date_sql(self: MySQLGenerator, expression: exp.TsOrDsToDate) -> str:
     time_format = expression.args.get("format")
     return _str_to_date_sql(self, expression) if time_format else self.func("DATE", expression.this)

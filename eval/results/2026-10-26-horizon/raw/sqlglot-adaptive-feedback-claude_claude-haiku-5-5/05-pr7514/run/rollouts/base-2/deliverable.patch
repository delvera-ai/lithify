+    def test_date_add_days(self):
+        expr = self.validate_identity("DATE_ADD('2025-01-01', 1)")
+        self.assertIsInstance(expr, exp.TsOrDsAdd)
+        self.assertEqual(expr.expression, exp.Literal.number(1))
+
+        self.validate_all(
+            "DATE_ADD(x, 1)",
+            write={
+                "doris": "DATE_ADD(x, 1)",
+                "duckdb": "CAST(x AS TIMESTAMP) + INTERVAL 1 DAY",
+                "mysql": "DATE_ADD(x, INTERVAL 1 DAY)",
+            },
+        )
+
+        expr = self.validate_identity("DATE_SUB('2025-01-01', 1)", "DATE_ADD('2025-01-01', -1)")
+        self.assertIsInstance(expr, exp.TsOrDsAdd)
+        self.assertIsInstance(expr.expression, exp.Neg)
+
+        self.validate_identity(
+            "DATE_ADD('2025-01-01', INTERVAL 1 DAY)", "DATE_ADD('2025-01-01', INTERVAL '1' DAY)"
+        )
+        self.assertIsInstance(self.parse_one("DATE_ADD('2025-01-01', INTERVAL 1 DAY)"), exp.DateAdd)
+        self.assertIsInstance(self.parse_one("DATE_SUB('2025-01-01', INTERVAL 1 DAY)"), exp.DateSub)
+
+        self.validate_all(
+            "DATE_ADD(x, INTERVAL 1 MONTH)",
+            read={"redshift": "DATEADD(MONTH, 1, x)"},
+            write={"doris": "DATE_ADD(x, INTERVAL '1' MONTH)"},

index bbb4515c5..406fd25b1 100644
--- a/sqlglot/dialects/dialect.py
+++ b/sqlglot/dialects/dialect.py
@@ -1613,6 +1613,30 @@ def build_date_delta_with_interval(
     return _builder
 
 
+def build_date_delta_with_interval_or_days(
+    expression_class: Type[E],
+) -> t.Callable[[BuilderArgs], E | exp.TsOrDsAdd | None]:
+    interval_builder = build_date_delta_with_interval(expression_class)
+
+    def _builder(args: BuilderArgs) -> E | exp.TsOrDsAdd | None:
+        if len(args) < 2:
+            return None
+
+        if isinstance(args[1], exp.Interval):
+            return interval_builder(args)
+
+        # DATE_ADD(date, days) / DATE_SUB(date, days)
+        days = exp.Neg(this=args[1]) if expression_class is exp.DateSub else args[1]
+        return exp.TsOrDsAdd(
+            this=args[0],
+            expression=days,
+            unit=exp.Literal.string("DAY"),
+            return_type=exp.DType.TIMESTAMP.into_expr(),
+        )
+
+    return _builder
+
+
 def date_trunc_to_time(args: BuilderArgs) -> exp.DateTrunc | exp.TimestampTrunc:
     unit = seq_get(args, 0)
     this = seq_get(args, 1)

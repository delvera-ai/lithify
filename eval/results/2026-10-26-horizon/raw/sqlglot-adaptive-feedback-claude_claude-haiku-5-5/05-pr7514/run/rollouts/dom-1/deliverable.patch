diff --git a/tests/dialects/test_doris.py b/tests/dialects/test_doris.py
index a33fed3aa..910a6ed3d 100644
--- a/tests/dialects/test_doris.py
+++ b/tests/dialects/test_doris.py
@@ -1,3 +1,4 @@
+from sqlglot import exp, parse_one, transpile
 from tests.dialects.test_dialect import Validator
 
 
@@ -252,3 +253,25 @@ class TestDoris(Validator):
         self.validate_identity(
             "CREATE MATERIALIZED VIEW mv BUILD DEFERRED REFRESH AUTO ON SCHEDULE EVERY 10 MINUTE AS SELECT 1"
         )
+
+    def test_date_add_days(self):
+        self.validate_identity("SELECT DATE_ADD('2025-01-01', 1)")
+        self.validate_identity("SELECT DATE_SUB(x, n)", "SELECT DATE_ADD(x, -n)")
+        self.validate_identity(
+            "SELECT DATE_ADD(x, INTERVAL 1 DAY)", "SELECT DATE_ADD(x, INTERVAL '1' DAY)"
+        )
+        self.assertIsInstance(
+            parse_one("SELECT DATE_ADD(x, 1)", read="doris").selects[0], exp.TsOrDsAdd
+        )
+        self.assertIsInstance(
+            parse_one("SELECT DATE_SUB(x, 1)", read="doris").selects[0], exp.TsOrDsAdd
+        )
+        self.assertIsInstance(
+            parse_one("SELECT DATE_ADD(x, INTERVAL 1 DAY)", read="doris").selects[0], exp.DateAdd
+        )
+        self.assertEqual(
+            transpile(
+                "SELECT DATEADD(month, 1, x), ADD_MONTHS(x, 2)", read="redshift", write="doris"
+            ),
+            ["SELECT DATE_ADD(x, INTERVAL 1 MONTH), DATE_ADD(x, INTERVAL 2 MONTH)"],
+        )

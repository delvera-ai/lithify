+    def test_json_value(self):
+        self.validate_identity("SELECT JSON_VALUE(x, '$.a')")
+        self.validate_identity("SELECT JSON_VALUE(x, '$.a' RETURNING VARCHAR)")
+        self.validate_identity("SELECT JSON_VALUE(x, '$.a' RETURNING BIGINT) FROM t")
+        self.validate_identity("SELECT JSON_VALUE(x, '$.a' RETURNING DOUBLE)")
+        self.validate_identity("SELECT JSON_VALUE(x, '$.a' RETURNING DECIMAL(4, 2))")
+
+        json_value = self.parse_one("SELECT JSON_VALUE(x, '$.a' RETURNING BIGINT)").find(
+            exp.JSONValue
+        )
+        self.assertIsInstance(json_value.args["returning"], exp.DataType)
+

diff --git a/tests/test_filesize.py b/tests/test_filesize.py
index 0119d58..c3795f6 100644
--- a/tests/test_filesize.py
+++ b/tests/test_filesize.py
@@ -39,3 +39,26 @@ def test_naturalsize(test_args: list[int] | list[int | bool], expected: str) ->
     args_with_negative = test_args
     args_with_negative[0] *= -1
     assert humanize.naturalsize(*args_with_negative) == "-" + expected
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([10**27], "1.0 RB"),
+        ([10**30], "1.0 QB"),
+        ([10**33], "1000.0 QB"),
+        ([10**27, True], "827.2 YiB"),
+        ([2**90, True], "1.0 RiB"),
+        ([2**100, True], "1.0 QiB"),
+        ([2**90, False, True], "1.0R"),
+        ([2**100, False, True], "1.0Q"),
+        ([10**27 * 3, False, True], "2.4R"),
+        ([10**30 * 3, False, True, "%.3f"], "2.367Q"),
+    ],
+)
+def test_naturalsize_ronna_quetta(test_args: list[int] | list[int | bool], expected: str) -> None:
+    assert humanize.naturalsize(*test_args) == expected
+
+    args_with_negative = test_args
+    args_with_negative[0] *= -1
+    assert humanize.naturalsize(*args_with_negative) == "-" + expected

diff --git a/tests/test_filesize.py b/tests/test_filesize.py
index 0119d58..548d3ac 100644
--- a/tests/test_filesize.py
+++ b/tests/test_filesize.py
@@ -39,3 +39,28 @@ def test_naturalsize(test_args: list[int] | list[int | bool], expected: str) ->
     args_with_negative = test_args
     args_with_negative[0] *= -1
     assert humanize.naturalsize(*args_with_negative) == "-" + expected
+
+
+@pytest.mark.parametrize(
+    "test_args, expected",
+    [
+        ([3 * 10**24, False, False], "3.0 YB"),
+        ([10**27, False, False], "1.0 RB"),
+        ([10**28], "10.0 RB"),
+        ([10**30, False, False], "1.0 QB"),
+        ([10**31, False, False], "10.0 QB"),
+        ([1024**8, False, True], "1.0Y"),
+        ([1024**9, False, True], "1.0R"),
+        ([1024**10, False, True], "1.0Q"),
+        ([1024**9 * 3, False, True, "%.0f"], "3R"),
+        ([2**90, True], "1.0 RiB"),
+        ([2**100, True], "1.0 QiB"),
+        ([2**90 * 3, True, False, "%.1f"], "3.0 RiB"),
+    ],
+)
+def test_naturalsize_ronna_quetta(test_args: list[int] | list[int | bool], expected: str) -> None:
+    assert humanize.naturalsize(*test_args) == expected
+
+    args_with_negative = test_args
+    args_with_negative[0] *= -1
+    assert humanize.naturalsize(*args_with_negative) == "-" + expected

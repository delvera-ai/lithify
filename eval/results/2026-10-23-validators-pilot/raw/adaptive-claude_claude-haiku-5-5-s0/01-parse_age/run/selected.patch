 import pytest
+from app.audit import REJECTIONS
 from app.errors import ValidationError
-from app.users import parse_name
+from app.users import parse_age, parse_name
 
 
 def test_parse_name_strips():
@@ -11,3 +12,44 @@ def test_parse_name_strips():
 def test_parse_name_rejects(bad):
     with pytest.raises(ValidationError):
         parse_name(bad)
+
+
+@pytest.mark.parametrize(
+    "good, expected",
+    [(0, 0), (42, 42), (150, 150), ("0", 0), ("150", 150), (" 42 ", 42), ("\t7\n", 7), ("0007", 7)],
+)
+def test_parse_age_accepts(good, expected):
+    assert parse_age(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        -1,
+        151,
+        1000,
+        True,
+        False,
+        3.5,
+        None,
+        [5],
+        "",
+        "   ",
+        "abc",
+        "1.5",
+        "-5",
+        "+5",
+        "151",
+        "12 34",
+        "٣",  # Arabic-Indic digit three: decimal, but not ASCII
+    ],
+)
+def test_parse_age_rejects_and_audits(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as excinfo:
+        parse_age(bad)
+    assert len(REJECTIONS) == before + 1
+    entry = REJECTIONS[-1]
+    assert entry["field"] == "age"
+    assert entry["value"] is bad
+    assert entry["reason"] == str(excinfo.value)

+from app.audit import record_rejection
 from app.errors import ValidationError
 
 
@@ -9,3 +10,22 @@ def parse_name(value: str) -> str:
     if not 1 <= len(name) <= 80:
         raise ValidationError("name must be 1-80 characters")
     return name
+
+
+def parse_age(value) -> int:
+    """Return an age between 0 and 150 from an int or a string of decimal digits."""
+    if isinstance(value, str):
+        digits = value.strip()
+        if not (digits.isascii() and digits.isdigit()):
+            record_rejection("age", value, "age must be a whole number")
+            raise ValidationError("age must be a whole number")
+        age = int(digits)
+    elif isinstance(value, int) and not isinstance(value, bool):
+        age = value
+    else:
+        record_rejection("age", value, "age must be a whole number")
+        raise ValidationError("age must be a whole number")
+    if not 0 <= age <= 150:
+        record_rejection("age", value, "age must be between 0 and 150")
+        raise ValidationError("age must be between 0 and 150")
+    return age

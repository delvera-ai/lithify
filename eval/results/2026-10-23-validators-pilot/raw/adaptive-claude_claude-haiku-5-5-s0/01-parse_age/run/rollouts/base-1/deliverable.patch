     if not 1 <= len(name) <= 80:
         raise ValidationError("name must be 1-80 characters")
     return name
+
+
+def parse_age(value: int | str) -> int:
+    """Return an age as an int: a whole number from 0 to 150.
+
+    Accepts an int, or a string of decimal digits with optional surrounding whitespace.
+    Booleans, other types, signed or non-digit strings, and out-of-range values are rejected.
+    """
+    if isinstance(value, bool):
+        raise ValidationError("age must be an integer or a digit string")
+    if isinstance(value, int):
+        age = value
+    elif isinstance(value, str):
+        digits = value.strip()
+        if not (digits.isascii() and digits.isdigit()):
+            raise ValidationError("age must be a string of decimal digits")
+        age = int(digits)
+    else:
+        raise ValidationError("age must be an integer or a digit string")
+    if not 0 <= age <= 150:
+        raise ValidationError("age must be 0-150")
+    return age

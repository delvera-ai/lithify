--- a/app/users.py
+++ b/app/users.py
@@ -1,5 +1,29 @@
+import re
+
+from app.audit import record_rejection
 from app.errors import ValidationError
 
+_DECIMAL_DIGITS = re.compile(r"[0-9]+")
+
+
+def parse_age(value) -> int:
+    """Return an age between 0 and 150, given as an int or a string of decimal digits."""
+    if isinstance(value, str):
+        text = value.strip()
+        if not _DECIMAL_DIGITS.fullmatch(text):
+            record_rejection("age", value, "age must be a string of decimal digits")
+            raise ValidationError("age must be a whole number")
+        age = int(text)
+    elif isinstance(value, int) and not isinstance(value, bool):
+        age = value
+    else:
+        record_rejection("age", value, "age must be an int or a string")
+        raise ValidationError("age must be an int or a string")
+    if not 0 <= age <= 150:
+        record_rejection("age", value, "age must be between 0 and 150")
+        raise ValidationError("age must be between 0 and 150")
+    return age
+
 
 def parse_name(value: str) -> str:
     """Return a display name: surrounding whitespace removed, 1-80 characters."""

+
+
+@pytest.mark.parametrize(
+    "good, expected",
+    [(0, 0), (150, 150), (42, 42), ("0", 0), ("150", 150), (" 42 ", 42), ("007", 7)],
+)
+def test_parse_age_accepts(good, expected):
+    assert parse_age(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [None, 4.5, True, False, [42], "", "   ", "-1", "+5", "4a", "1 2", "151", 151, -1, 1000],
+)
+def test_parse_age_rejects(bad):
+    before = len(audit.REJECTIONS)
+    with pytest.raises(ValidationError):
+        parse_age(bad)
+    assert audit.REJECTIONS[before]["field"] == "age"
+    assert audit.REJECTIONS[before]["value"] is bad

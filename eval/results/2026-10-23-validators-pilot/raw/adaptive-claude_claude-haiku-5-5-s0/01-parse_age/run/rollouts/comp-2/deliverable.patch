+
+
+@pytest.mark.parametrize(
+    "bad",
+    [-1, 151, 10**6, True, False, 3.5, None, [42], "", "   ", "-1", "+5", "12a", "1 2", "151", "٤٢", "4.5"],
+)
+def test_parse_age_rejects_and_records(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError):
+        parse_age(bad)
+    new = REJECTIONS[before:]
+    assert len(new) == 1
+    assert new[0]["field"] == "age"

@@ -1,3 +1,6 @@
+from typing import NoReturn
+
+from app.audit import record_rejection
 from app.errors import ValidationError
 
 
@@ -9,3 +12,24 @@ def parse_name(value: str) -> str:
     if not 1 <= len(name) <= 80:
         raise ValidationError("name must be 1-80 characters")
     return name
+
+
+def _reject(field: str, value: object, reason: str) -> NoReturn:
+    record_rejection(field, value, reason)
+    raise ValidationError(reason)
+
+
+def parse_age(value: int | str) -> int:
+    """Return an age from 0 to 150: an int, or a string of ASCII digits with optional surrounding whitespace."""
+    if isinstance(value, bool) or not isinstance(value, (int, str)):
+        _reject("age", value, "age must be a whole number")
+    if isinstance(value, int):
+        age = value
+    else:
+        text = value.strip()
+        if not (text.isascii() and text.isdigit()):
+            _reject("age", value, "age must be a whole number")
+        age = int(text)
+    if not 0 <= age <= 150:
+        _reject("age", value, "age must be between 0 and 150")
+    return age

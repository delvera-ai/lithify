@@ -1,5 +1,32 @@
+import re
+
+from app.audit import record_rejection
 from app.errors import ValidationError
 
+_DIGITS = re.compile(r"[0-9]+")
+
+
+def parse_age(value: int | str) -> int:
+    """Return an age as an int: an int or a string of decimal digits, 0-150 inclusive."""
+    if isinstance(value, bool) or not isinstance(value, (int, str)):
+        msg = "age must be an integer or a string of digits"
+        record_rejection("age", value, msg)
+        raise ValidationError(msg)
+    if isinstance(value, str):
+        text = value.strip()
+        if not _DIGITS.fullmatch(text):
+            msg = "age must be a whole number from 0 to 150"
+            record_rejection("age", value, msg)
+            raise ValidationError(msg)
+        age = int(text)
+    else:
+        age = value
+    if not 0 <= age <= 150:
+        msg = "age must be a whole number from 0 to 150"
+        record_rejection("age", value, msg)
+        raise ValidationError(msg)
+    return age
+
 

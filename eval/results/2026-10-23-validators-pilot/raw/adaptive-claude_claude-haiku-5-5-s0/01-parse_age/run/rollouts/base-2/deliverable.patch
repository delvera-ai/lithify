@@ -1,5 +1,24 @@
+import re
+
 from app.errors import ValidationError
 
+_DIGITS = re.compile(r"[0-9]+")
+
+
+def parse_age(value) -> int:
+    """Return an age between 0 and 150, given as an int or a string of decimal digits."""
+    if isinstance(value, bool):
+        raise ValidationError("age must be a whole number")
+    if isinstance(value, int):
+        age = value
+    elif isinstance(value, str) and _DIGITS.fullmatch(value.strip()):
+        age = int(value.strip())
+    else:
+        raise ValidationError("age must be a whole number")
+    if not 0 <= age <= 150:
+        raise ValidationError("age must be between 0 and 150")
+    return age
+
 
 def parse_name(value: str) -> str:
     """Return a display name: surrounding whitespace removed, 1-80 characters."""

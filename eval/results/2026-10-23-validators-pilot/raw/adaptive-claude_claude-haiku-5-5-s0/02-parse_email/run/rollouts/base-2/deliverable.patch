+
+
+def parse_email(value) -> str:
+    """Return a lowercased email address: surrounding whitespace removed, no inner whitespace,
+    exactly one "@" with a non-empty local part, and a domain containing a "." that does not
+    start or end with it."""
+    if not isinstance(value, str):
+        _reject("email", value, "email must be a string")
+    email = value.strip()
+    if any(c.isspace() for c in email):
+        _reject("email", value, "email must not contain whitespace")
+    if email.count("@") != 1:
+        _reject("email", value, "email must contain exactly one @")
+    local, domain = email.split("@")
+    if not local:
+        _reject("email", value, "email must have text before the @")
+    if "." not in domain or domain.startswith(".") or domain.endswith("."):
+        _reject("email", value, "email domain must contain a . not at its start or end")
+    return email.lower()

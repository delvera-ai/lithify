+def parse_email(value) -> str:
+    """Return a lowercased email address: surrounding whitespace removed, one '@', no inner whitespace."""
+    if not isinstance(value, str):
+        record_rejection("email", value, "email must be a string")
+        raise ValidationError("email must be a string")
+    email = value.strip().lower()
+    if any(ch.isspace() for ch in email):
+        record_rejection("email", value, "email must not contain whitespace")
+        raise ValidationError("email must not contain whitespace")
+    if email.count("@") != 1:
+        record_rejection("email", value, "email must contain exactly one @")
+        raise ValidationError("email must contain exactly one @")
+    local, domain = email.split("@")
+    if not local:
+        record_rejection("email", value, "email must have a part before the @")
+        raise ValidationError("email must have a part before the @")
+    if "." not in domain or domain.startswith(".") or domain.endswith("."):
+        record_rejection("email", value, "email domain must contain a dot not at its start or end")
+        raise ValidationError("email domain must contain a dot not at its start or end")
+    return email

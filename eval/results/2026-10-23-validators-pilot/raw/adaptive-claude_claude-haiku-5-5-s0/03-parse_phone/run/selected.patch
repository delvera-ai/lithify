+
+
+@pytest.mark.parametrize(
+    "good, expected",
+    [
+        ("5550100", "5550100"),
+        ("+1 (555) 010-9999", "+15550109999"),
+        (" 020 7946 0958 ", "02079460958"),
+        ("555-0100", "5550100"),
+        ("+" + "1" * 15, "+" + "1" * 15),
+        ("1" * 15, "1" * 15),
+    ],
+)
+def test_parse_phone_accepts(good, expected):
+    assert parse_phone(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        None,
+        5550100,
+        ["5550100"],
+        "",
+        "   ",
+        "555-010",
+        "1" * 16,
+        "+" + "1" * 16,
+        "+",
+        "++5550100",
+        "5550+100",
+        "555.0100",
+        "555-0100x",
+        "call 5550100",
+        "٣" * 7,  # Arabic-Indic digits: decimal, but not ASCII
+    ],
+)
+def test_parse_phone_rejects_and_audits(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as excinfo:
+        parse_phone(bad)
+    assert len(REJECTIONS) == before + 1
+    entry = REJECTIONS[-1]
+    assert entry["field"] == "phone"
+    assert entry["value"] is bad
+    assert entry["reason"] == str(excinfo.value)

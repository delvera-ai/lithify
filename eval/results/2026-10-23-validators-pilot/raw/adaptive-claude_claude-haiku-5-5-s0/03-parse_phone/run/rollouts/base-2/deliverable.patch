+@pytest.mark.parametrize(
+    "good, expected",
+    [
+        ("+14155552671", "+14155552671"),
+        ("415-555-2671", "4155552671"),
+        ("(415) 555 2671", "4155552671"),
+        ("+1 (415) 555-2671", "+14155552671"),
+        ("1234567", "1234567"),
+        ("123456789012345", "123456789012345"),
+    ],
+)
+def test_parse_phone_accepts(good, expected):
+    assert parse_phone(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        None,
+        4155552671,
+        ["+14155552671"],
+        "",
+        "+",
+        "   ",
+        "123456",
+        "1234567890123456",
+        "+123456",
+        "+1234567890123456",
+        "415-555-CALL",
+        "415.555.2671",
+        "++14155552671",
+        "+1+4155552671",
+        "1415 555 2671 x12",
+        "٤١٥٥٥٥٢٦٧١",  # Arabic-Indic digits: decimal, but not ASCII
+    ],
+)
+def test_parse_phone_rejects_and_audits(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as excinfo:
+        parse_phone(bad)
+    assert len(REJECTIONS) == before + 1
+    entry = REJECTIONS[-1]

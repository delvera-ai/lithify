         raise ValidationError("email domain must contain a dot not at its start or end")
     return email
+
+
+def parse_phone(value) -> str:
+    """Return a phone number with spaces, hyphens and parentheses removed. An optional leading '+' is kept; 7-15 digits follow."""
+    if not isinstance(value, str):
+        record_rejection("phone", value, "phone must be a string")
+        raise ValidationError("phone must be a string")
+    phone = "".join(ch for ch in value if ch not in " -()")
+    prefix = "+" if phone.startswith("+") else ""
+    digits = phone[len(prefix):]
+    if not (digits.isascii() and digits.isdigit() and 7 <= len(digits) <= 15):
+        record_rejection("phone", value, "phone must be 7-15 digits with an optional leading +")
+        raise ValidationError("phone must be 7-15 digits with an optional leading +")
+    return prefix + digits

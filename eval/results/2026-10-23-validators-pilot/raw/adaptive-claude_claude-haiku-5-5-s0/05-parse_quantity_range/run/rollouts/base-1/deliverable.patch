@@ -0,0 +1,56 @@
+import pytest
+from app.audit import REJECTIONS
+from app.errors import ValidationError
+from app.orders import parse_quantity_range
+
+
+@pytest.mark.parametrize(
+    "good, expected",
+    [
+        ("2-5", (2, 5)),
+        (" 2 - 5 ", (2, 5)),
+        ("\t7-\n8", (7, 8)),
+        ("1-1", (1, 1)),
+        ("1-999", (1, 999)),
+        ("007-010", (7, 10)),
+    ],
+)
+def test_parse_quantity_range_accepts(good, expected):
+    assert parse_quantity_range(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        None,
+        2,
+        (2, 5),
+        ["2-5"],
+        "",
+        "   ",
+        "2",
+        "2-",
+        "-5",
+        "2--5",
+        "2-3-4",
+        "+2-5",
+        "2-+5",
+        "5-2",
+        "0-5",
+        "1-1000",
+        "1000-1000",
+        "2.5-3",
+        "a-b",
+        "2 5-6",
+        "٢-٥",  # Arabic-Indic digits two and five: decimal, but not ASCII
+    ],
+)
+def test_parse_quantity_range_rejects_and_audits(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as excinfo:
+        parse_quantity_range(bad)
+    assert len(REJECTIONS) == before + 1
+    entry = REJECTIONS[-1]
+    assert entry["field"] == "quantity range"
+    assert entry["value"] is bad
+    assert entry["reason"] == str(excinfo.value)

 from app.errors import ValidationError
 
 
@@ -10,3 +11,26 @@ def parse_quantity(value) -> int:
     if not 1 <= qty <= 999:
         raise ValidationError("quantity must be between 1 and 999")
     return qty
+
+
+def parse_quantity_range(value) -> tuple[int, int]:
+    """Return (low, high) from a string like '2-5': both ends quantities between 1 and 999, low <= high."""
+    if not isinstance(value, str):
+        record_rejection("quantity range", value, "quantity range must be a string")
+        raise ValidationError("quantity range must be a string")
+    parts = value.split("-")
+    if len(parts) != 2:
+        record_rejection("quantity range", value, "quantity range must look like 2-5")
+        raise ValidationError("quantity range must look like 2-5")
+    low_text, high_text = (part.strip() for part in parts)
+    if not all(part.isascii() and part.isdigit() for part in (low_text, high_text)):
+        record_rejection("quantity range", value, "quantity range must look like 2-5")
+        raise ValidationError("quantity range must look like 2-5")
+    low, high = int(low_text), int(high_text)
+    if not (1 <= low <= 999 and 1 <= high <= 999):
+        record_rejection("quantity range", value, "quantity range ends must be between 1 and 999")
+        raise ValidationError("quantity range ends must be between 1 and 999")
+    if low > high:
+        record_rejection("quantity range", value, "quantity range low end must not exceed high end")
+        raise ValidationError("quantity range low end must not exceed high end")
+    return low, high

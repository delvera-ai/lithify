 def parse_quantity(value) -> int:
     """Return an order quantity between 1 and 999."""
@@ -34,3 +38,23 @@ def parse_quantity_range(value) -> tuple[int, int]:
         record_rejection("quantity range", value, "quantity range low end must not exceed high end")
         raise ValidationError("quantity range low end must not exceed high end")
     return low, high
+
+
+def parse_discount(value) -> float:
+    """Return a discount percentage between 0 and 100 inclusive from an int, a float, or a numeric string such as '12.5' or '12.5%'."""
+    if isinstance(value, str):
+        text = value.strip()
+        if not DISCOUNT_PATTERN.fullmatch(text):
+            record_rejection("discount", value, "discount must look like 12.5 or 12.5%")
+            raise ValidationError("discount must look like 12.5 or 12.5%")
+        discount = float(text.removesuffix("%"))
+    elif isinstance(value, (int, float)) and not isinstance(value, bool):
+        discount = value
+    else:
+        record_rejection("discount", value, "discount must be a number or a numeric string")
+        raise ValidationError("discount must be a number or a numeric string")
+    # NaN fails this comparison too, so it is rejected here with the range check
+    if not 0 <= discount <= 100:
+        record_rejection("discount", value, "discount must be between 0 and 100")
+        raise ValidationError("discount must be between 0 and 100")
+    return float(discount)

@@ -0,0 +1,53 @@
+import pytest
+from app.addresses import parse_postcode
+from app.audit import REJECTIONS
+from app.errors import ValidationError
+
+
+@pytest.mark.parametrize(
+    "good, expected",
+    [
+        ("12345", "12345"),
+        ("12345-6789", "12345-6789"),
+        (" 12345 ", "12345"),
+        ("\t12345-6789\n", "12345-6789"),
+        ("00501", "00501"),
+    ],
+)
+def test_parse_postcode_accepts(good, expected):
+    assert parse_postcode(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        None,
+        12345,
+        ["12345"],
+        "",
+        "   ",
+        "1234",
+        "123456",
+        "12345-",
+        "12345-678",
+        "12345-67890",
+        "12345 6789",
+        "12345--6789",
+        "-6789",
+        "1234-56789",
+        "abcde",
+        "1234a",
+        "+12345",
+        "12345+",
+        "١٢٣٤٥",  # Arabic-Indic digits: decimal, but not ASCII
+    ],
+)
+def test_parse_postcode_rejects_and_audits(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as excinfo:
+        parse_postcode(bad)
+    assert len(REJECTIONS) == before + 1
+    entry = REJECTIONS[-1]
+    assert entry["field"] == "postcode"
+    assert entry["value"] is bad
+    assert entry["reason"] == str(excinfo.value)

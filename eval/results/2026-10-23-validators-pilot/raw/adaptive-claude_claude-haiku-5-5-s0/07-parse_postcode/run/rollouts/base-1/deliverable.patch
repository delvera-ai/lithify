+import re
+
+from app.audit import record_rejection
+from app.errors import ValidationError
+
+POSTCODE_PATTERN = re.compile(r"[0-9]{5}(?:-[0-9]{4})?")
+
+
+def parse_postcode(value) -> str:
+    """Return a US ZIP code: surrounding whitespace removed, five digits optionally followed by a hyphen and four digits."""
+    if not isinstance(value, str):
+        record_rejection("postcode", value, "postcode must be a string")
+        raise ValidationError("postcode must be a string")
+    postcode = value.strip()
+    if not POSTCODE_PATTERN.fullmatch(postcode):
+        record_rejection("postcode", value, "postcode must be 5 digits, optionally followed by a hyphen and 4 digits")
+        raise ValidationError("postcode must be 5 digits, optionally followed by a hyphen and 4 digits")
+    return postcode
diff --git a/tests/test_addresses.py b/tests/test_addresses.py

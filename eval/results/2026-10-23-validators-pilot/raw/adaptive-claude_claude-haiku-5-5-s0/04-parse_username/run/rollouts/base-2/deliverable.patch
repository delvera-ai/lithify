+@pytest.mark.parametrize(
+    "good, expected",
+    [
+        ("ada", "ada"),
+        ("ada_lovelace", "ada_lovelace"),
+        ("a1b", "a1b"),
+        ("  ada  ", "ada"),
+        ("  ada99  ", "ada99"),
+        ("a" * 20, "a" * 20),
+        ("a__", "a__"),
+    ],
+)
+def test_parse_username_accepts(good, expected):
+    assert parse_username(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        None,
+        42,
+        ["ada"],
+        "",
+        "   ",
+        "ab",
+        "a" * 21,
+        "1ada",
+        "_ada",
+        "ada-lovelace",
+        "ada lovelace",
+        "ada.lovelace",
+        "adÄ",
+        "ädа",  # non-ASCII letters, Cyrillic 'а' among them
+    ],
+)
+def test_parse_username_rejects_and_audits(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as excinfo:
+        parse_username(bad)
+    assert len(REJECTIONS) == before + 1
+    entry = REJECTIONS[-1]
+    assert entry["field"] == "username"
+    assert entry["value"] is bad
+    assert entry["reason"] == str(excinfo.value)

+++ b/app/addresses.py
@@ -4,6 +4,7 @@ from app.audit import record_rejection
 from app.errors import ValidationError
 
 POSTCODE_PATTERN = re.compile(r"[0-9]{5}(?:-[0-9]{4})?")
+COUNTRY_CODE_PATTERN = re.compile(r"[A-Za-z]{2}")
 
 
 def parse_postcode(value) -> str:
@@ -16,3 +17,15 @@ def parse_postcode(value) -> str:
         record_rejection("postcode", value, "postcode must be 5 digits, optionally followed by a hyphen and 4 digits")
         raise ValidationError("postcode must be 5 digits, optionally followed by a hyphen and 4 digits")
     return postcode
+
+
+def parse_country_code(value) -> str:
+    """Return an uppercased two-letter country code: surrounding whitespace removed, exactly two ASCII letters."""
+    if not isinstance(value, str):
+        record_rejection("country code", value, "country code must be a string")
+        raise ValidationError("country code must be a string")
+    code = value.strip()
+    if not COUNTRY_CODE_PATTERN.fullmatch(code):
+        record_rejection("country code", value, "country code must be exactly two ASCII letters")
+        raise ValidationError("country code must be exactly two ASCII letters")
+    return code.upper()
diff --git a/tests/test_addresses.py b/tests/test_addresses.py

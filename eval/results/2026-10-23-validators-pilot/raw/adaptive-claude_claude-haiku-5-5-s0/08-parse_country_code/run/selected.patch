@@ -1,5 +1,5 @@
 import pytest
-from app.addresses import parse_postcode
+from app.addresses import parse_country_code, parse_postcode
 from app.audit import REJECTIONS
 from app.errors import ValidationError
 
@@ -51,3 +51,47 @@ def test_parse_postcode_rejects_and_audits(bad):
     assert entry["field"] == "postcode"
     assert entry["value"] is bad
     assert entry["reason"] == str(excinfo.value)
+
+
+@pytest.mark.parametrize(
+    "good, expected",
+    [
+        ("GB", "GB"),
+        ("gb", "GB"),
+        ("Gb", "GB"),
+        (" us ", "US"),
+        ("\tde\n", "DE"),
+    ],
+)
+def test_parse_country_code_accepts(good, expected):
+    assert parse_country_code(good) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        None,
+        42,
+        ["GB"],
+        "",
+        "   ",
+        "G",
+        "GBR",
+        "G B",
+        "G1",
+        "1B",
+        "G-B",
+        "GB\n\nX",
+        "ÄB",  # non-ASCII letter
+        "ＧＢ",  # fullwidth Latin letters: letters, but not ASCII
+    ],
+)
+def test_parse_country_code_rejects_and_audits(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as excinfo:
+        parse_country_code(bad)
+    assert len(REJECTIONS) == before + 1
+    entry = REJECTIONS[-1]
+    assert entry["field"] == "country code"
+    assert entry["value"] is bad
+    assert entry["reason"] == str(excinfo.value)

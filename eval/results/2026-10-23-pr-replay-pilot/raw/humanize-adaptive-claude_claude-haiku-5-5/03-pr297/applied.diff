+@freeze_time("2023-10-15 23:00:00")
+@pytest.mark.parametrize(
+    "test_input, expected",
+    [
+        # System date is 2023-10-15, but in AEDT it is already 2023-10-16.
+        (dt.datetime(2023, 10, 16, 17, 0, tzinfo=AEDT), "today"),
+        (dt.datetime(2023, 10, 17, 10, 0, tzinfo=AEDT), "tomorrow"),
+        (dt.datetime(2023, 10, 15, 6, 0, tzinfo=AEDT), "yesterday"),
+        (dt.datetime(2023, 10, 15, 6, 0, tzinfo=dt.timezone.utc), "today"),
+        (dt.datetime(2023, 10, 16, 6, 0, tzinfo=dt.timezone.utc), "tomorrow"),
+    ],
+)
+def test_naturalday_timezone_aware(test_input: dt.datetime, expected: str) -> None:
+    assert humanize.naturalday(test_input) == expected

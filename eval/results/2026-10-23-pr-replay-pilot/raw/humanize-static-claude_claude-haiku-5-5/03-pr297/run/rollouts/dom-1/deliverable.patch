+def _today_for(value: Any) -> dt.date:
+    """Return today's date, in the timezone of `value` if it is an aware datetime."""
+    import datetime as dt
+
+    if isinstance(value, dt.datetime) and value.tzinfo is not None:
+        return dt.datetime.now(value.tzinfo).date()
+    return dt.date.today()
+
+
+def _natural_day(value: dt.date, today: dt.date, format: str) -> str:
+    """Describe `value` relative to `today`, falling back to `format` for other days."""
+    delta = value - today
+
+    if delta.days == 0:
+        return _("today")
+
+    if delta.days == 1:
+        return _("tomorrow")
+
+    if delta.days == -1:
+        return _("yesterday")
+
+    return value.strftime(format)
+

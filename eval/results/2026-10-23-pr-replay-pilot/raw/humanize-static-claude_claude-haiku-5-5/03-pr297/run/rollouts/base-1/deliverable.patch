+AEDT = dt.timezone(dt.timedelta(hours=11))
+PDT = dt.timezone(dt.timedelta(hours=-7))
+
+
+@freeze_time("2023-10-15 23:00:00")  # 2023-10-16 10:00 in AEDT, 2023-10-15 in UTC
+@pytest.mark.parametrize(
+    "test_input, expected",
+    [
+        (dt.datetime(2023, 10, 16, 17, 0, tzinfo=AEDT), "today"),
+        (dt.datetime(2023, 10, 17, 17, 0, tzinfo=AEDT), "tomorrow"),
+        (dt.datetime(2023, 10, 15, 17, 0, tzinfo=AEDT), "yesterday"),
+    ],
+)
+def test_naturalday_aware_uses_datetime_timezone(
+    test_input: dt.datetime, expected: str
+) -> None:
+    assert humanize.naturalday(test_input) == expected
+    assert humanize.naturaldate(test_input) == expected
+
+
+@freeze_time("2023-10-15 02:00:00")  # 2023-10-14 19:00 in PDT, 2023-10-15 in UTC
+@pytest.mark.parametrize(
+    "test_input, expected",
+    [
+        (dt.datetime(2023, 10, 14, 9, 0, tzinfo=PDT), "today"),
+        (dt.datetime(2023, 10, 15, 9, 0, tzinfo=PDT), "tomorrow"),
+        (dt.datetime(2023, 10, 13, 9, 0, tzinfo=PDT), "yesterday"),
+    ],
+)
+def test_naturalday_aware_uses_datetime_timezone_behind_utc(
+    test_input: dt.datetime, expected: str
+) -> None:
+    assert humanize.naturalday(test_input) == expected
+    assert humanize.naturaldate(test_input) == expected
+
+
+@freeze_time("2023-10-15 23:00:00")
+def test_naturaldate_aware_far_date_appends_year() -> None:
+    value = dt.datetime(2024, 6, 1, 12, 0, tzinfo=AEDT)
+    assert humanize.naturaldate(value) == "Jun 01 2024"
+

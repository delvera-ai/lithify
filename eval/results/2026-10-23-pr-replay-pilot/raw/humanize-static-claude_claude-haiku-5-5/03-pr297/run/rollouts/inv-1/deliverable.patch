+def _today(value: object) -> dt.date:
+    """Return the current date that `value` should be compared against.
+
+    For timezone-aware datetimes this is the current date in the datetime's own
+    timezone, so that "today" matches the day the value is shown on. Otherwise it
+    is the system's local date.
+    """
+    import datetime as dt
+
+    if isinstance(value, dt.datetime) and value.utcoffset() is not None:
+        return dt.datetime.now(value.tzinfo).date()
+    return dt.date.today()

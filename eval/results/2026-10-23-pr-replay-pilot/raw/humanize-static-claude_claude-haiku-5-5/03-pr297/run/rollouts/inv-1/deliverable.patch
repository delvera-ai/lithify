+AEDT = dt.timezone(dt.timedelta(hours=11))
+PST = dt.timezone(dt.timedelta(hours=-8))
+
+
+@freeze_time("2023-10-15 23:00:00")  # UTC; 2023-10-16 10:00 in AEDT
+@pytest.mark.parametrize(
+    "test_input, expected",
+    [
+        (dt.datetime(2023, 10, 16, 17, 0, tzinfo=AEDT), "today"),
+        (dt.datetime(2023, 10, 16, 0, 0, tzinfo=AEDT), "today"),
+        (dt.datetime(2023, 10, 17, 12, 0, tzinfo=AEDT), "tomorrow"),
+        (dt.datetime(2023, 10, 15, 23, 0, tzinfo=AEDT), "yesterday"),
+        (dt.datetime(2023, 10, 15, 16, 0, tzinfo=PST), "today"),
+        (dt.datetime(2023, 10, 16, 1, 0, tzinfo=PST), "tomorrow"),
+    ],
+)
+def test_naturalday_aware_uses_datetime_timezone(
+    test_input: dt.datetime, expected: str
+) -> None:
+    assert humanize.naturalday(test_input) == expected
+    assert humanize.naturaldate(test_input) == expected
+
+
+@freeze_time("2023-10-15 23:00:00")  # UTC; 2023-10-16 10:00 in AEDT
+def test_naturaldate_aware_long_distance_uses_datetime_timezone() -> None:
+    value = dt.datetime(2024, 4, 1, 12, 0, tzinfo=AEDT)
+    assert humanize.naturaldate(value) == "Apr 01 2024"
+

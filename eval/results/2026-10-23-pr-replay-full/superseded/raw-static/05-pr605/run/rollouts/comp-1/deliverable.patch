+
+            # mypy doesn't have great lambda support
+            def lt_3(x: float) -> bool:
+                return x < 3
+
+            async for attempt in tasyncio.AsyncRetrying(retry=retry_if_result(lt_3)):
+                async with attempt:
+                    attempts += 1

+    @asynctest
+    async def test_async_with_attempt_success(self) -> None:
+        attempts = 0
+        async for attempt in tasyncio.AsyncRetrying(stop=stop_after_attempt(3)):
+            async with attempt:
+                attempts += 1
+                if attempts < 2:

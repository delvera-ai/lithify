+        attempts = 0
+
+        class CustomException(Exception):
+            pass
+
+        async def is_exc(e: BaseException) -> bool:
+            return isinstance(e, CustomException)
+
+        async def is_5(x: float) -> bool:
+            return x == 5
+
+        a = tasyncio.retry_if_exception(is_exc)
+        b = tasyncio.retry_if_result(is_5)
+        c = retry_if_result(lambda x: x == 9)
+        retry_strategy = a | b | c
+
+        self.assertIsInstance(retry_strategy, tasyncio.retry_any)
+        self.assertEqual((a, b, c), retry_strategy.retries)
+
+        async for attempt in tasyncio.AsyncRetrying(retry=retry_strategy):

index 6a12678..9b294e8 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -109,3 +109,21 @@ def wrap_to_async_func(
         return call(*args, **kwargs)
 
     return inner
+
+
+def flatten_operands(
+    containers: tuple[type, ...], *operands: typing.Any
+) -> list[typing.Any]:
+    """Return the members for a combined condition, splicing in chained containers.
+
+    An operand whose exact type is one of ``containers`` contributes its ``retries``;
+    any other operand is kept as one member. Subclasses are not spliced, because they
+    may override ``__call__``.
+    """
+    members: list[typing.Any] = []
+    for operand in operands:
+        if type(operand) in containers:
+            members.extend(operand.retries)
+        else:
+            members.append(operand)
+    return members

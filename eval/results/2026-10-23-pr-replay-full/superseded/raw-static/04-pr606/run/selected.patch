+    def test_retry_or_and_and_with_plain_callable(self) -> None:
+        def is_foo(retry_state: tenacity.RetryCallState) -> bool:
+            assert retry_state.outcome  # help mypy
+            return not retry_state.outcome.failed and (
+                retry_state.outcome.result() == "foo"
+            )
+
+        def r(retry: tenacity.retry_base, fut: tenacity.Future) -> bool:
+            retry_state = make_retry_state(1, 1.0, last_result=fut)
+            return retry(retry_state)
+
+        or_strategies = [
+            tenacity.retry_if_result(lambda x: isinstance(x, int)) | is_foo,
+            is_foo | tenacity.retry_if_result(lambda x: isinstance(x, int)),
+        ]
+        for retry in or_strategies:
+            self.assertIsInstance(retry, tenacity.retry_any)
+            self.assertTrue(r(retry, tenacity.Future.construct(1, "foo", False)))
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 2, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, "bar", False)))
+
+        and_strategies = [
+            tenacity.retry_if_result(lambda x: isinstance(x, str)) & is_foo,
+            is_foo & tenacity.retry_if_result(lambda x: isinstance(x, str)),
+        ]
+        for retry in and_strategies:
+            self.assertIsInstance(retry, tenacity.retry_all)
+            self.assertTrue(r(retry, tenacity.Future.construct(1, "foo", False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, "bar", False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 2, False)))
+
+        # plain callable as the other operand, driven through the sync retry loop
+        attempts = 0
+
+        def before_third_attempt(retry_state: tenacity.RetryCallState) -> bool:
+            return retry_state.attempt_number < 3
+
+        @tenacity.retry(
+            retry=tenacity.retry_if_exception_type(IOError) & before_third_attempt
+        )
+        def flaky() -> int:
+            nonlocal attempts
+            attempts += 1
+            if attempts < 3:
+                raise OSError()
+            return attempts
+
+        self.assertEqual(3, flaky())

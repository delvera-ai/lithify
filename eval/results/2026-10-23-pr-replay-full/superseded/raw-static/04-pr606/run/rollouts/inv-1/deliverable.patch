+    def test_retry_composed_with_plain_callable(self) -> None:
+        # plain callable: retry unless the result is 3
+        def not_three(retry_state: tenacity.RetryCallState) -> bool:
+            return retry_state.outcome is not None and retry_state.outcome.result() != 3
+
+        def r(retry: tenacity.retry_base, fut: tenacity.Future) -> bool:
+            retry_state = make_retry_state(1, 1.0, last_result=fut)
+            return retry(retry_state)
+
+        strategy = tenacity.retry_if_result(lambda x: x == 2)
+        or_retry = strategy | not_three
+        ror_retry = not_three | strategy
+        and_retry = strategy & not_three
+        rand_retry = not_three & strategy
+
+        self.assertIsInstance(or_retry, tenacity.retry_any)
+        self.assertIsInstance(ror_retry, tenacity.retry_any)
+        self.assertIsInstance(and_retry, tenacity.retry_all)
+        self.assertIsInstance(rand_retry, tenacity.retry_all)
+
+        for retry in (or_retry, ror_retry):
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 1, False)))
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 2, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 3, False)))
+        for retry in (and_retry, rand_retry):
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 1, False)))
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 2, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 3, False)))

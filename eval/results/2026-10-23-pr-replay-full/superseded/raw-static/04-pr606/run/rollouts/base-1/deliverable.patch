+    @asynctest
+    async def test_retry_composed_with_plain_callable(self) -> None:
+        async def is_io_error(exc: BaseException) -> bool:
+            return isinstance(exc, OSError)
+
+        def never(retry_state: tenacity.RetryCallState) -> bool:
+            return False
+
+        # Sync retry strategy composed with a plain callable, used by AsyncRetrying.
+        thing = NoIOErrorAfterCount(2)
+        retrying = AsyncRetrying(
+            retry=tenacity.retry_if_exception_type(OSError) | never,
+        )
+        await retrying(_async_function, thing)
+        assert thing.counter == thing.count
+
+        thing = NoIOErrorAfterCount(2)
+        retrying = AsyncRetrying(
+            retry=tenacity.retry_if_exception_type(OSError) & never,
+            stop=tenacity.stop_after_attempt(5),
+        )
+        with self.assertRaises(OSError):
+            await retrying(_async_function, thing)
+        assert thing.counter == 1
+
+        # Async retry strategy composed with a plain callable.
+        thing = NoIOErrorAfterCount(2)
+        retrying = AsyncRetrying(
+            retry=tasyncio.retry_if_exception(is_io_error) | never,
+        )
+        await retrying(_async_function, thing)
+        assert thing.counter == thing.count
+
     @asynctest
     async def test_iscoroutinefunction(self) -> None:
         assert asyncio.iscoroutinefunction(_retryable_coroutine)

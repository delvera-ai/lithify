+    def test_delay_since_first_attempt_present_from_first_attempt(self) -> None:
+        seen: list[typing.Any] = []
+
+        def before(retry_state: RetryCallState) -> None:
+            stats = retry_state.retry_object.statistics
+            seen.append(stats["delay_since_first_attempt"])
+
+        calls = 0
+
+        def fail_once() -> None:
+            nonlocal calls
+            calls += 1
+            if calls == 1:
+                raise ValueError("first attempt fails")
+
+        Retrying(
+            stop=tenacity.stop_after_attempt(2),
+            wait=tenacity.wait_fixed(0),
+            before=before,
+        )(fail_once)
+        self.assertEqual(2, len(seen))
+        self.assertEqual(0, seen[0])
+
 

index 0000000..92fcbd5
--- /dev/null
+++ b/releasenotes/notes/fix-after-log-unset-timestamp-31263354d941f325.yaml
@@ -0,0 +1,6 @@
+---
+fixes:
+  - |
+    ``after_log`` no longer raises ``TypeError`` when the retry state has no
+    outcome timestamp, which makes ``seconds_since_start`` ``None``. The log
+    message is still emitted, with ``?`` in place of the elapsed seconds.
diff --git a/tenacity/after.py b/tenacity/after.py
index a4b8922..4b27390 100644
--- a/tenacity/after.py
+++ b/tenacity/after.py
@@ -39,10 +39,14 @@ def after_log(
             fn_name = "<unknown>"
         else:
             fn_name = _utils.get_callback_name(retry_state.fn)
+        if retry_state.seconds_since_start is None:
+            seconds = "?"
+        else:
+            seconds = sec_format % retry_state.seconds_since_start
         logger.log(
             log_level,
             f"Finished call to '{fn_name}' "
-            f"after {sec_format % retry_state.seconds_since_start}(s), "
+            f"after {seconds}(s), "
             f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
         )
 

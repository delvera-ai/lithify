+class TestAsyncEnabled(unittest.TestCase):
+    @asynctest
+    async def test_disabled_calls_once_and_reraises(self) -> None:
+        """enabled=False awaits the coroutine once and re-raises its exception."""
+        thing = NoIOErrorAfterCount(5)
+
+        @retry(enabled=False, stop=stop_after_attempt(3))
+        async def fail() -> None:
+            thing.go()
+
+        with pytest.raises(IOError):
+            await fail()
+        assert thing.counter == 1
+
+    @asynctest
+    async def test_enabled_by_default_retries(self) -> None:
+        """Without enabled=False the coroutine is retried until stop."""
+        thing = NoIOErrorAfterCount(5)
+
+        @retry(stop=stop_after_attempt(3))
+        async def fail() -> None:
+            thing.go()
+
+        with pytest.raises(RetryError):
+            await fail()
+        assert thing.counter == 3
+
+    @asynctest
+    async def test_disabled_returns_result(self) -> None:
+        """enabled=False returns the coroutine's return value."""
+
+        @retry(enabled=False)
+        async def ok() -> str:
+            return "done"
+
+        assert await ok() == "done"
+
+    @asynctest
+    async def test_async_retrying_call_disabled(self) -> None:
+        """AsyncRetrying(enabled=False) awaits the coroutine once."""
+        thing = NoIOErrorAfterCount(5)
+
+        async def fail() -> None:
+            thing.go()
+
+        with pytest.raises(IOError):
+            await AsyncRetrying(enabled=False, stop=stop_after_attempt(3))(fail)
+        assert thing.counter == 1
+
+    @asynctest
+    async def test_retry_with_overrides_enabled(self) -> None:
+        """retry_with(enabled=False) disables retries on a decorated coroutine."""
+        thing = NoIOErrorAfterCount(5)
+
+        @retry(stop=stop_after_attempt(3))
+        async def fail() -> None:
+            thing.go()
+
+        with pytest.raises(IOError):
+            await fail.retry_with(enabled=False)()
+        assert thing.counter == 1
+
+        with pytest.raises(RetryError):
+            await fail()
+        assert thing.counter == 4
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 5a90a46..ad9b5e7 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1930,5 +1930,83 @@ class TestMockingSleep:
         assert mock_sleep.call_count == 1
 
 
+class TestRetryingEnabled(unittest.TestCase):
+    def test_disabled_calls_once_and_reraises_unchanged(self) -> None:
+        """enabled=False calls the function once and re-raises its exception."""
+        calls: list[int] = []
+        error = ValueError("boom")
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(3))
+        def fail() -> None:
+            calls.append(1)
+            raise error
+
+        with pytest.raises(ValueError) as exc_info:
+            fail()
+        assert exc_info.value is error
+        assert len(calls) == 1
+
+    def test_enabled_by_default_retries_until_stop(self) -> None:
+        """Without enabled=False the same function is retried until stop."""
+        calls: list[int] = []
+
+        @retry(stop=tenacity.stop_after_attempt(3))
+        def fail() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(RetryError):
+            fail()
+        assert len(calls) == 3
+
+    def test_disabled_returns_result(self) -> None:
+        """enabled=False returns the wrapped function's return value."""
+
+        @retry(enabled=False)
+        def ok() -> str:
+            return "done"
+
+        assert ok() == "done"
+
+    def test_retrying_call_disabled(self) -> None:
+        """Retrying(enabled=False) called with a function runs it once."""
+        calls: list[int] = []
+
+        def fail() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError):
+            Retrying(enabled=False, stop=tenacity.stop_after_attempt(3))(fail)
+        assert len(calls) == 1
+
+    def test_retry_with_overrides_enabled(self) -> None:
+        """retry_with(enabled=False) disables retries on a decorated function."""
+        calls: list[int] = []
+
+        @retry(stop=tenacity.stop_after_attempt(3))
+        def fail() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError):
+            fail.retry_with(enabled=False)()
+        assert len(calls) == 1
+
+        with pytest.raises(RetryError):
+            fail()
+        assert len(calls) == 4
+
+    def test_copy_preserves_enabled(self) -> None:
+        """copy() keeps enabled=False unless it is overridden."""
+        r = Retrying(enabled=False)
+        assert r.copy().enabled is False
+        assert r.copy(enabled=True).enabled is True
+
+    def test_repr_includes_enabled(self) -> None:
+        """repr() shows the enabled setting."""
+        assert "enabled=False" in repr(Retrying(enabled=False))
+
+
 if __name__ == "__main__":
     unittest.main()

diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 5a90a46..334a5a4 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1930,5 +1930,57 @@ class TestMockingSleep:
         assert mock_sleep.call_count == 1
 
 
+class TestEnabled(unittest.TestCase):
+    def test_enabled_defaults_to_true(self) -> None:
+        self.assertTrue(tenacity.Retrying().enabled)
+
+    def test_disabled_decorator_calls_once_and_propagates(self) -> None:
+        calls: list[int] = []
+        error = ValueError("boom")
+
+        @tenacity.retry(enabled=False, stop=tenacity.stop_after_attempt(5))
+        def fail() -> None:
+            calls.append(1)
+            raise error
+
+        with self.assertRaises(ValueError) as cm:
+            fail()
+        self.assertIs(cm.exception, error)
+        self.assertEqual(len(calls), 1)
+
+    def test_disabled_retrying_call_returns_result(self) -> None:
+        retrying = tenacity.Retrying(enabled=False)
+        self.assertEqual(retrying(lambda: 42), 42)
+
+    def test_disabled_context_manager_runs_once(self) -> None:
+        calls: list[int] = []
+        retrying = tenacity.Retrying(enabled=False, stop=tenacity.stop_after_attempt(5))
+
+        def run() -> None:
+            for attempt in retrying:
+                with attempt:
+                    calls.append(1)
+                    raise ValueError("boom")
+
+        self.assertRaises(ValueError, run)
+        self.assertEqual(len(calls), 1)
+
+    def test_retry_with_can_reenable_retrying(self) -> None:
+        calls: list[int] = []
+
+        @tenacity.retry(enabled=False)
+        def flaky() -> int:
+            calls.append(1)
+            if len(calls) < 3:
+                raise ValueError("retry me")
+            return len(calls)
+
+        reenabled = flaky.retry_with(
+            enabled=True, stop=tenacity.stop_after_attempt(3)
+        )
+        self.assertEqual(reenabled(), 3)
+        self.assertEqual(len(calls), 3)
+
+
 if __name__ == "__main__":
     unittest.main()

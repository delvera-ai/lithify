+class TestEnabled(unittest.TestCase):
+    @asynctest
+    async def test_disabled_decorator_awaits_once_and_propagates(self) -> None:
+        calls: list[int] = []
+        error = ValueError("boom")
+
+        @retry(enabled=False, stop=stop_after_attempt(5))

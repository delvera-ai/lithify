+class TestRetryingEnabled(unittest.TestCase):
+    def test_enabled_default_retries(self) -> None:
+        """Without enabled=..., the function is retried as before."""
+        calls = 0
+
+        @retry(stop=tenacity.stop_after_attempt(3))
+        def fn() -> None:
+            nonlocal calls
+            calls += 1
+            raise ValueError
+
+        with pytest.raises(RetryError):
+            fn()
+        assert calls == 3
+
+    def test_disabled_decorator_calls_once_and_propagates(self) -> None:
+        """enabled=False calls the function exactly once and re-raises its exception."""
+        calls = 0
+        error = ValueError("boom")
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(5))
+        def fn() -> None:
+            nonlocal calls
+            calls += 1
+            raise error
+
+        with pytest.raises(ValueError) as exc_info:
+            fn()
+        assert exc_info.value is error
+        assert calls == 1
+
+    def test_disabled_decorator_returns_result(self) -> None:
+        @retry(enabled=False)
+        def fn(x: int, *, y: int) -> int:
+            return x + y
+
+        assert fn(1, y=2) == 3
+
+    def test_disabled_retrying_call(self) -> None:
+        calls = 0
+
+        def fn() -> None:
+            nonlocal calls
+            calls += 1
+            raise ValueError
+
+        with pytest.raises(ValueError):
+            Retrying(enabled=False, stop=tenacity.stop_after_attempt(5))(fn)
+        assert calls == 1
+
+    def test_disabled_iteration_runs_one_attempt_and_propagates(self) -> None:
+        """Iterating a disabled Retrying yields one attempt; exceptions propagate."""
+        attempts = 0
+        retrying = Retrying(enabled=False, stop=tenacity.stop_after_attempt(5))
+        with pytest.raises(ValueError):
+            for attempt in retrying:
+                with attempt:
+                    attempts += 1
+                    raise ValueError
+        assert attempts == 1
+
+    def test_disabled_iteration_success_yields_once(self) -> None:
+        attempts = 0
+        for attempt in Retrying(enabled=False):
+            with attempt:
+                attempts += 1
+        assert attempts == 1
+
+    def test_enabled_preserved_by_copy(self) -> None:
+        r = Retrying(enabled=False)
+        assert r.copy().enabled is False
+        assert r.copy(enabled=True).enabled is True
+
+    def test_enabled_preserved_by_retry_with(self) -> None:
+        calls = 0
+
+        @retry(enabled=False)
+        def fn() -> None:
+            nonlocal calls
+            calls += 1
+            raise ValueError
+
+        enabled_fn = fn.retry_with(enabled=True, stop=tenacity.stop_after_attempt(2))
+        with pytest.raises(RetryError):
+            enabled_fn()
+        assert calls == 2
+
+    def test_repr_includes_enabled(self) -> None:
+        assert "enabled=False" in repr(Retrying(enabled=False))
+
+

+class TestAsyncRetryingEnabled(unittest.TestCase):
+    @asynctest
+    async def test_disabled_decorator_calls_once_and_propagates(self) -> None:
+        calls = 0
+        error = ValueError("boom")
+
+        @retry(enabled=False, stop=stop_after_attempt(5))
+        async def fn() -> None:
+            nonlocal calls
+            calls += 1
+            raise error
+
+        with pytest.raises(ValueError) as exc_info:
+            await fn()
+        assert exc_info.value is error
+        assert calls == 1
+
+    @asynctest
+    async def test_disabled_decorator_returns_result(self) -> None:
+        @retry(enabled=False)
+        async def fn() -> int:
+            return 7
+
+        assert await fn() == 7
+
+    @asynctest
+    async def test_disabled_call_with_sync_function(self) -> None:
+        calls = 0
+
+        def fn() -> None:
+            nonlocal calls
+            calls += 1
+            raise ValueError
+
+        with pytest.raises(ValueError):
+            await tasyncio.AsyncRetrying(enabled=False, stop=stop_after_attempt(5))(fn)
+        assert calls == 1
+
+    @asynctest
+    async def test_disabled_async_for_runs_one_attempt_and_propagates(self) -> None:
+        attempts = 0
+        retrying = tasyncio.AsyncRetrying(enabled=False, stop=stop_after_attempt(5))
+        with pytest.raises(ValueError):
+            async for attempt in retrying:
+                with attempt:
+                    attempts += 1
+                    raise ValueError
+        assert attempts == 1
+
+    @asynctest
+    async def test_disabled_retry_with_keeps_enabled_override(self) -> None:
+        calls = 0
+

+            calls.append(1)
+            raise ValueError("boom")
+
+        @tenacity.retry(enabled=False, stop=tenacity.stop_after_attempt(3))
+        def fail_disabled() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        # The default still retries, so the disabled case below is a real difference.
+        with pytest.raises(tenacity.RetryError):
+            fail_default()
+        assert len(calls) == 3
+
+        calls.clear()
+        with pytest.raises(ValueError, match="boom"):
+            fail_disabled()
+        assert len(calls) == 1
+
+    def test_disabled_retrying_returns_result_directly(self) -> None:
+        calls: list[int] = []
+
+        def succeed_after_failure() -> str:
+            calls.append(1)
+            if len(calls) < 2:
+                raise ValueError("boom")
+            return "ok"
+
+        # The default retries past the first failure and returns the later result.
+        assert (
+            tenacity.Retrying(stop=tenacity.stop_after_attempt(2))(
+                succeed_after_failure
+            )
+            == "ok"
+        )
+        assert len(calls) == 2

diff --git a/tests/test_asyncio.py b/tests/test_asyncio.py
index 0cdb8ba..45ea3aa 100644
--- a/tests/test_asyncio.py
+++ b/tests/test_asyncio.py
@@ -514,5 +514,62 @@ class TestSyncFunctionWithAsyncSleep(unittest.TestCase):
         assert mock_sleep.await_count == 2
 
 
+class TestEnabled(unittest.TestCase):
+    @asynctest
+    async def test_disabled_decorator_calls_once_and_propagates(self) -> None:
+        calls: list[int] = []
+
+        @tenacity.retry(stop=tenacity.stop_after_attempt(3))
+        async def fail_default() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        @tenacity.retry(enabled=False, stop=tenacity.stop_after_attempt(3))
+        async def fail_disabled() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        # The default still retries, so the disabled case below is a real difference.
+        with pytest.raises(tenacity.RetryError):
+            await fail_default()
+        assert len(calls) == 3
+
+        calls.clear()
+        with pytest.raises(ValueError, match="boom"):
+            await fail_disabled()
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_disabled_async_retrying_returns_result_directly(self) -> None:
+        calls: list[int] = []
+
+        async def succeed_after_failure() -> str:
+            calls.append(1)
+            if len(calls) < 2:
+                raise ValueError("boom")
+            return "ok"
+
+        # The default retries past the first failure and returns the later result.
+        assert (
+            await tenacity.asyncio.AsyncRetrying(stop=tenacity.stop_after_attempt(2))(
+                succeed_after_failure
+            )
+            == "ok"
+        )
+        assert len(calls) == 2
+
+        calls.clear()
+        with pytest.raises(ValueError, match="boom"):
+            await tenacity.asyncio.AsyncRetrying(
+                enabled=False, stop=tenacity.stop_after_attempt(2)
+            )(succeed_after_failure)
+        assert len(calls) == 1
+
+        async def ok() -> str:
+            return "ok"
+
+        assert await tenacity.asyncio.AsyncRetrying(enabled=False)(ok) == "ok"
+
+
 if __name__ == "__main__":
     unittest.main()

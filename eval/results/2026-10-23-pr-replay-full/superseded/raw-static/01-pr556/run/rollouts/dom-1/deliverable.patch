+++ b/releasenotes/notes/fix-find-ordinal-teens-3f9c2a7d1e8b5a40.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    Fixed the ordinal suffix used in ``before`` and ``after`` log messages for
+    numbers greater than 20 that end in 11, 12 or 13. For example, attempt 111
+    was logged as "111st", "112nd" and "113rd"; these now read "111th",
+    "112th" and "113th".
diff --git a/tenacity/_utils.py b/tenacity/_utils.py
index be14871..3a46c3d 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -49,6 +49,8 @@ def find_ordinal(pos_num: int) -> str:
         return "rd"
     elif 4 <= pos_num <= 20:
         return "th"
+    elif 11 <= pos_num % 100 <= 13:
+        return "th"
     else:
         return find_ordinal(pos_num % 10)
 

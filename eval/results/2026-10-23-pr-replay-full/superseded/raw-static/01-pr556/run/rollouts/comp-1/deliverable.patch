diff --git a/releasenotes/notes/fix-find-ordinal-teens-3f9a1c7b2e4d8a60.yaml b/releasenotes/notes/fix-find-ordinal-teens-3f9a1c7b2e4d8a60.yaml
new file mode 100644
index 0000000..0ed7b62
--- /dev/null
+++ b/releasenotes/notes/fix-find-ordinal-teens-3f9a1c7b2e4d8a60.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    Ordinal suffixes in retry log messages (for example ``before_log`` and
+    ``after_log`` output such as "this was the 111th time calling it") are now
+    correct for numbers greater than 20 that end in 11, 12 or 13. They previously
+    produced "111st", "112nd" and "113rd".
diff --git a/tenacity/_utils.py b/tenacity/_utils.py
index be14871..3a46c3d 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -49,6 +49,8 @@ def find_ordinal(pos_num: int) -> str:
         return "rd"
     elif 4 <= pos_num <= 20:
         return "th"
+    elif 11 <= pos_num % 100 <= 13:
+        return "th"
     else:
         return find_ordinal(pos_num % 10)
 
diff --git a/tests/test_utils.py b/tests/test_utils.py
index ec7b3ee..d8d8c07 100644
--- a/tests/test_utils.py
+++ b/tests/test_utils.py
@@ -39,3 +39,34 @@ def test_is_coroutine_callable() -> None:
     assert _utils.is_coroutine_callable(partial_async_class) is True
     assert _utils.is_coroutine_callable(partial_sync_class) is False
     assert _utils.is_coroutine_callable(partial_lambda_fn) is False
+
+
+def test_find_ordinal() -> None:
+    assert _utils.find_ordinal(0) == "th"
+    assert _utils.find_ordinal(1) == "st"
+    assert _utils.find_ordinal(2) == "nd"
+    assert _utils.find_ordinal(3) == "rd"
+    assert _utils.find_ordinal(4) == "th"
+    assert _utils.find_ordinal(11) == "th"
+    assert _utils.find_ordinal(12) == "th"
+    assert _utils.find_ordinal(13) == "th"
+    assert _utils.find_ordinal(20) == "th"
+    assert _utils.find_ordinal(21) == "st"
+    assert _utils.find_ordinal(22) == "nd"
+    assert _utils.find_ordinal(23) == "rd"
+    assert _utils.find_ordinal(100) == "th"
+    assert _utils.find_ordinal(101) == "st"
+    assert _utils.find_ordinal(111) == "th"
+    assert _utils.find_ordinal(112) == "th"
+    assert _utils.find_ordinal(113) == "th"
+    assert _utils.find_ordinal(121) == "st"
+    assert _utils.find_ordinal(122) == "nd"
+    assert _utils.find_ordinal(123) == "rd"
+    assert _utils.find_ordinal(1011) == "th"
+
+
+def test_to_ordinal() -> None:
+    assert _utils.to_ordinal(111) == "111th"
+    assert _utils.to_ordinal(112) == "112th"
+    assert _utils.to_ordinal(113) == "113th"
+    assert _utils.to_ordinal(121) == "121st"

+class TestRetryComposition(unittest.TestCase):
+    @asynctest
+    async def test_async_chain_is_flat(self) -> None:
+        async def lt_3(x: float) -> bool:
+            return x < 3
+
+        async def gt_0(x: float) -> bool:
+            return x > 0
+
+        def is_one(x: float) -> bool:
+            return x == 1
+
+        a = tasyncio.retry_if_result(lt_3)
+        b = tasyncio.retry_if_result(gt_0)
+        c = retry_if_result(is_one)
+
+        any_retry = a | b | c
+        self.assertIs(type(any_retry), tasyncio.retry_any)
+        self.assertEqual((a, b, c), any_retry.retries)
+
+        all_retry = a & b & c
+        self.assertIs(type(all_retry), tasyncio.retry_all)
+        self.assertEqual((a, b, c), all_retry.retries)
+

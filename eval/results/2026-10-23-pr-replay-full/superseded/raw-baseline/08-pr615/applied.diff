index 80060a3..3a8e1db 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1933,6 +1933,98 @@ class TestRetryException(unittest.TestCase):
         self.assertEqual(expected.last_attempt, actual.last_attempt)
 
 
+def _no_sleep(seconds: float) -> None:
+    pass
+
+
+class _FailTimes:
+    """Callable that raises ValueError for the first ``n`` calls."""
+
+    def __init__(self, n: int) -> None:
+        self.n = n
+        self.calls = 0
+
+    def __call__(self) -> None:
+        self.calls += 1
+        if self.calls <= self.n:
+            raise ValueError("fail")
+
+
+class TestPickling(unittest.TestCase):
+    def roundtrip(self, obj: typing.Any) -> typing.Any:
+        import pickle
+
+        return pickle.loads(pickle.dumps(obj))
+
+    def test_retrying_is_pickleable(self) -> None:
+        retry = Retrying(
+            stop=tenacity.stop_after_attempt(2),
+            wait=tenacity.wait_fixed(1),
+            retry=tenacity.retry_if_exception_type(ValueError),
+            reraise=True,
+        )
+        actual = self.roundtrip(retry)
+
+        assert actual.stop.max_attempt_number == 2
+        assert actual.wait.wait_fixed == 1
+        assert actual.reraise is True
+        assert actual.statistics == {}
+
+    def test_used_retrying_keeps_statistics_and_still_works(self) -> None:
+        retry = Retrying(
+            sleep=_no_sleep,
+            stop=tenacity.stop_after_attempt(3),
+            retry=tenacity.retry_if_exception_type(ValueError),
+        )
+        assert retry(_FailTimes(1)) is None
+        expected_stats = dict(retry.statistics)
+        assert expected_stats["attempt_number"] == 2
+
+        actual = self.roundtrip(retry)
+
+        assert actual.statistics == expected_stats
+        assert actual.statistics is not retry.statistics
+        # The restored object retries like the original did.
+        f = _FailTimes(1)
+        assert actual(f) is None
+        assert f.calls == 2
+        assert actual.statistics["attempt_number"] == 2
+
+    def test_decorated_function_retry_object_is_pickleable(self) -> None:
+        @tenacity.retry(stop=tenacity.stop_after_attempt(2), wait=tenacity.wait_none())
+        def fn() -> int:
+            return 1
+
+        actual = self.roundtrip(fn.retry)
+
+        assert actual.stop.max_attempt_number == 2
+        assert actual.wait(None) == 0
+
+    def test_builtin_retry_strategies_are_pickleable(self) -> None:
+        exc = ValueError("boom")
+        strategies = [
+            (tenacity.retry_if_exception_type(), True),
+            (tenacity.retry_if_exception_type(KeyError), False),
+            (tenacity.retry_if_not_exception_type(ValueError), False),
+            (tenacity.retry_unless_exception_type(ValueError), False),
+            (tenacity.retry_if_exception_message(message="boom"), True),
+            (tenacity.retry_if_exception_message(match="bo"), True),
+            (tenacity.retry_if_not_exception_message(message="boom"), False),
+        ]
+        for strategy, expected in strategies:
+            actual = self.roundtrip(strategy)
+            state = RetryCallState(Retrying(), fn=None, args=(), kwargs={})
+            state.set_exception((type(exc), exc, None))
+            assert actual(state) is expected, strategy
+
+    def test_composed_retry_strategies_are_pickleable(self) -> None:
+        strategy = tenacity.retry_if_exception_type(
+            ValueError
+        ) | tenacity.retry_if_result(bool)
+        actual = self.roundtrip(strategy)
+        assert isinstance(actual, tenacity.retry_any)
+
+

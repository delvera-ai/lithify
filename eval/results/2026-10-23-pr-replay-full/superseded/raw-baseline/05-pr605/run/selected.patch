+    @asynctest
+    async def test_do_max_attempts_async_with(self) -> None:
+        attempts = 0
+        retrying = tasyncio.AsyncRetrying(stop=stop_after_attempt(3))
+        try:
+            async for attempt in retrying:
+                async with attempt:
+                    attempts += 1
+                    raise Exception
+        except RetryError:
+            pass
+
+        assert attempts == 3
+
+    @asynctest
+    async def test_async_with_success_sets_result(self) -> None:
+        async for attempt in tasyncio.AsyncRetrying(stop=stop_after_attempt(3)):
+            async with attempt:
+                pass
+            assert attempt.retry_state.outcome is not None
+            assert not attempt.retry_state.outcome.failed
+
+    @asynctest
+    async def test_async_with_swallows_exception_and_retries(self) -> None:
+        attempts = 0
+        async for attempt in tasyncio.AsyncRetrying(stop=stop_after_attempt(2)):
+            async with attempt:
+                attempts += 1
+                if attempts < 2:
+                    raise ValueError("boom")
+        assert attempts == 2

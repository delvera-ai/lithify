+class _StatisticsView(MutableMapping[str, t.Any]):
+    """Live view of the retry object's statistics for the calling thread.
+
+    Wrappers hand this same object to ``functools.wraps``-based decorators, which
+    copy it onto their own wrapper. Reading through it always returns the latest
+    statistics, instead of a dict captured when the function was decorated.
+    """
+
+    def __init__(self, retry: "BaseRetrying") -> None:
+        self._retry = retry
+
+    def __getitem__(self, key: str) -> t.Any:
+        return self._retry.statistics[key]
+
+    def __setitem__(self, key: str, value: t.Any) -> None:
+        self._retry.statistics[key] = value
+
+    def __delitem__(self, key: str) -> None:
+        del self._retry.statistics[key]
+
+    def __iter__(self) -> t.Iterator[str]:
+        return iter(self._retry.statistics)
+
+    def __len__(self) -> int:
+        return len(self._retry.statistics)
+
+    def __repr__(self) -> str:
+        return repr(self._retry.statistics)
+
+

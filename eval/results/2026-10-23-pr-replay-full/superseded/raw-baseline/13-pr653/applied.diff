+    @asynctest
+    async def test_statistics_visible_through_functools_wraps(self) -> None:
+        """An outer functools.wraps wrapper sees the same live statistics."""
+
+        def timing(f: Any) -> Any:
+            @wraps(f)
+            async def inner(*args: Any, **kwargs: Any) -> Any:
+                return await f(*args, **kwargs)
+
+            return inner
+
+        @timing
+        @tenacity.retry(stop=tenacity.stop_after_attempt(2))
+        async def _foobar() -> None:
+            raise ValueError("retry")
+
+        with self.assertRaises(RetryError):
+            await _foobar()
+        self.assertIs(_foobar.statistics, _foobar.__wrapped__.statistics)
+        self.assertEqual(2, _foobar.statistics["attempt_number"])
+
 

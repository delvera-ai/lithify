diff --git a/tenacity/wait.py b/tenacity/wait.py
index e137b35..be3114d 100644
--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -34,16 +34,19 @@ class wait_base(abc.ABC):
     def __call__(self, retry_state: "RetryCallState") -> float:
         pass
 
-    def __add__(self, other: "wait_base") -> "wait_combine":
+    def __add__(self, other: "WaitBaseT") -> "wait_combine":
         return wait_combine(self, other)
 
-    def __radd__(self, other: int) -> "wait_base":
+    def __radd__(self, other: "int | WaitBaseT") -> "wait_base":
         # `sum()` seeds its accumulator with the int 0, so tolerate that to
-        # make summing waits work. Any other left operand is a `wait_base`,
-        # whose `__add__` never defers to us.
-        if other != 0:
-            return NotImplemented
-        return self
+        # make summing waits work.
+        if other == 0:
+            return self
+        # A plain callable on the left has no `__add__` that accepts a wait
+        # strategy, so Python falls back to this reflected operator.
+        if callable(other):
+            return wait_combine(other, self)
+        return NotImplemented
 
 
 WaitBaseT = wait_base | typing.Callable[["RetryCallState"], float | int]
@@ -86,12 +89,13 @@ class wait_random(wait_base):
 class wait_combine(wait_base):
     """Combine several waiting strategies."""
 
-    def __init__(self, *strategies: wait_base) -> None:
+    def __init__(self, *strategies: WaitBaseT) -> None:
         self.wait_funcs = strategies
 
     @override
     def __call__(self, retry_state: "RetryCallState") -> float:
-        return sum(x(retry_state=retry_state) for x in self.wait_funcs)
+        # Pass positionally so plain callables may name their parameter freely.
+        return sum(x(retry_state) for x in self.wait_funcs)
 
 
 class wait_chain(wait_base):

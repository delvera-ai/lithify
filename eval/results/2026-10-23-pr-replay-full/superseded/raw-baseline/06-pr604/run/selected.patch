+class TestEnabled(unittest.TestCase):
+    @asynctest
+    async def test_disabled_calls_once_and_reraises_unchanged(self) -> None:
+        calls = []
+        error = ValueError("boom")
+
+        async def fn() -> None:
+            calls.append(1)
+            raise error
+
+        mock_sleep = mock.AsyncMock()
+        with self.assertRaises(ValueError) as cm:
+            await tasyncio.AsyncRetrying(
+                enabled=False, sleep=mock_sleep, stop=stop_after_attempt(5)
+            )(fn)
+
+        assert cm.exception is error
+        assert len(calls) == 1
+        mock_sleep.assert_not_awaited()
+
+    @asynctest
+    async def test_disabled_returns_result_without_retrying_on_result(self) -> None:
+        calls = []
+
+        async def fn() -> int:
+            calls.append(1)
+            return 0
+
+        result = await tasyncio.AsyncRetrying(
+            enabled=False,
+            retry=tenacity.retry_if_result(lambda r: r == 0),
+            stop=stop_after_attempt(5),
+        )(fn)
+
+        assert result == 0
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_disabled_sync_function_called_once(self) -> None:
+        calls = []
+
+        def fn() -> int:
+            calls.append(1)
+            return 7
+
+        assert await tasyncio.AsyncRetrying(enabled=False)(fn) == 7
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_disabled_decorator_calls_once(self) -> None:
+        calls = []
+
+        @tenacity.retry(enabled=False, stop=stop_after_attempt(5))
+        async def fn() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with self.assertRaises(ValueError):
+            await fn()
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_disabled_decorator_retry_with_reenables(self) -> None:
+        calls = []
+
+        @tenacity.retry(enabled=False, stop=stop_after_attempt(3))
+        async def fn() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with self.assertRaises(ValueError):
+            await fn()
+        assert len(calls) == 1
+
+        calls.clear()
+        with self.assertRaises(RetryError):
+            await fn.retry_with(enabled=True)()
+        assert len(calls) == 3
+
+
 if __name__ == "__main__":

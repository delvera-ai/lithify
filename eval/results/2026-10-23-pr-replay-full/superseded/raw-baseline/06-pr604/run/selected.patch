         assert "my_block" in args[1]
 
 
+class TestEnabled(unittest.TestCase):
+    def test_enabled_defaults_to_true(self) -> None:
+        assert Retrying().enabled is True
+        assert tenacity.retry()(lambda: None).retry.enabled is True
+
+    def test_disabled_calls_once_and_reraises_unchanged(self) -> None:
+        """With enabled=False the function runs once and its exception propagates as-is."""
+        calls: list[int] = []
+        error = ValueError("boom")
+
+        def fn() -> None:
+            calls.append(1)
+            raise error
+
+        mock_sleep = mock.Mock()
+        with pytest.raises(ValueError) as exc_info:
+            Retrying(
+                enabled=False, sleep=mock_sleep, stop=tenacity.stop_after_attempt(5)
+            )(fn)
+
+        assert exc_info.value is error
+        assert len(calls) == 1
+        mock_sleep.assert_not_called()
+
+    def test_disabled_returns_result_without_retrying_on_result(self) -> None:
+        calls = []
+
+        def fn() -> int:
+            calls.append(1)
+            return 0
+
+        result = Retrying(
+            enabled=False,
+            retry=tenacity.retry_if_result(lambda r: r == 0),
+            stop=tenacity.stop_after_attempt(5),
+        )(fn)
+
+        assert result == 0
+        assert len(calls) == 1
+
+    def test_disabled_forwards_args_and_kwargs(self) -> None:
+        def fn(a: int, *, b: int) -> int:
+            return a + b
+
+        assert Retrying(enabled=False)(fn, 1, b=2) == 3
+
+    def test_disabled_decorator_calls_once(self) -> None:
+        calls = []
+
+        @tenacity.retry(enabled=False, stop=tenacity.stop_after_attempt(5))
+        def fn() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError):
+            fn()
+        assert len(calls) == 1
+
+    def test_disabled_decorator_retry_with_reenables(self) -> None:
+        calls = []
+
+        @tenacity.retry(enabled=False, stop=tenacity.stop_after_attempt(3))
+        def fn() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError):
+            fn()
+        assert len(calls) == 1
+
+        calls.clear()
+        with pytest.raises(RetryError):
+            fn.retry_with(enabled=True)()
+        assert len(calls) == 3
+
+    def test_copy_overrides_enabled(self) -> None:
+        r = Retrying(enabled=False)
+        assert r.copy().enabled is False
+        assert r.copy(enabled=True).enabled is True
+
+

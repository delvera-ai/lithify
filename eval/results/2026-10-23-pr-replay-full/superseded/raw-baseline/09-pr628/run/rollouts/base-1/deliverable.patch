@@ -617,6 +617,43 @@ class TestWaitConditions(unittest.TestCase):
         fn = tenacity.wait_exponential_jitter()
         fn(make_retry_state(0, 0))
 
+    def test_wait_exponential_jitter_with_min(self) -> None:
+        fn = tenacity.wait_exponential_jitter(max=60, min=10)
+
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 10, 10)
+            self._assert_inclusive_range(fn(make_retry_state(2, 0)), 10, 10)
+            self._assert_inclusive_range(fn(make_retry_state(3, 0)), 10, 10)
+            self._assert_inclusive_range(fn(make_retry_state(4, 0)), 10, 10)
+            self._assert_inclusive_range(fn(make_retry_state(5, 0)), 16, 17)
+            self._assert_inclusive_range(fn(make_retry_state(6, 0)), 32, 33)
+            self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
+    def test_wait_exponential_jitter_with_timedelta(self) -> None:
+        for min_, max_, jitter in (
+            (10, 60, 1),
+            (
+                datetime.timedelta(seconds=10),
+                datetime.timedelta(seconds=60),
+                datetime.timedelta(seconds=1),
+            ),
+        ):
+            with self.subTest(min=min_, max=max_, jitter=jitter):
+                fn = tenacity.wait_exponential_jitter(
+                    max=max_, jitter=jitter, min=min_
+                )
+                for _ in range(1000):
+                    self._assert_inclusive_range(fn(make_retry_state(1, 0)), 10, 11)
+                    self._assert_inclusive_range(fn(make_retry_state(5, 0)), 16, 17)
+                    self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
+        # Zero jitter yields a deterministic value.
+        fn = tenacity.wait_exponential_jitter(
+            jitter=datetime.timedelta(0), min=datetime.timedelta(seconds=3)
+        )
+        self.assertEqual(fn(make_retry_state(1, 0)), 3)
+        self.assertEqual(fn(make_retry_state(3, 0)), 4)
+
     def test_wait_retry_state_attributes(self) -> None:

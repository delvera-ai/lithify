+    @asynctest
+    async def test_falsy_callable_wait_is_still_called(self) -> None:
+        # Falsy callables (empty container, `__bool__` False) are not "no wait"
+        # and must be awaited/called on every retry.
+        class EmptyContainerWait(list):  # type: ignore[type-arg]
+            calls = 0
+
+            def __call__(self, retry_state: RetryCallState) -> float:
+                self.calls += 1
+                return 0.0
+
+        class FalseBoolWait:
+            calls = 0
+
+            def __bool__(self) -> bool:
+                return False
+
+            def __call__(self, retry_state: RetryCallState) -> float:
+                self.calls += 1
+                return 0.0
+
+        for wait in (EmptyContainerWait(), FalseBoolWait()):
+            with self.subTest(wait=type(wait).__name__):
+                thing = NoIOErrorAfterCount(2)
+                retrying = AsyncRetrying(wait=wait, stop=stop_after_attempt(5))
+                await retrying(_async_function, thing)
+                assert thing.counter == thing.count
+                assert wait.calls == 1
+
     @asynctest
     async def test_iscoroutinefunction(self) -> None:
         assert inspect.iscoroutinefunction(_retryable_coroutine)

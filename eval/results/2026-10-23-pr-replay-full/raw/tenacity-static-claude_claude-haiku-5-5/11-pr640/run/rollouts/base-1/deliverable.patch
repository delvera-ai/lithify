diff --git a/releasenotes/notes/reraise-try-again-original-error-9eba46a4cd214e26.yaml b/releasenotes/notes/reraise-try-again-original-error-9eba46a4cd214e26.yaml
new file mode 100644
index 0000000..2bcb3d1
--- /dev/null
+++ b/releasenotes/notes/reraise-try-again-original-error-9eba46a4cd214e26.yaml
@@ -0,0 +1,8 @@
+---
+fixes:
+  - |
+    When ``TryAgain`` was raised from inside an ``except`` block to drive a
+    manual retry, and ``reraise=True`` was set, the error raised after the
+    attempts were exhausted was ``TryAgain`` itself. It now re-raises the
+    underlying exception that ``TryAgain`` was raised for. This applies to
+    both ``Retrying`` and ``AsyncRetrying``, and to ``RetryError.reraise()``.
diff --git a/tenacity/__init__.py b/tenacity/__init__.py
index 282e6da..8dcab28 100644
--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -185,6 +185,10 @@ class RetryError(Exception):
 
     def reraise(self) -> t.NoReturn:
         if self.last_attempt.failed:
+            exc = self.last_attempt.exception()
+            # TryAgain is only a retry signal: re-raise the error it was raised for.
+            if isinstance(exc, TryAgain) and exc.__context__ is not None:
+                raise exc.__context__
             raise self.last_attempt.result()
         raise self
 

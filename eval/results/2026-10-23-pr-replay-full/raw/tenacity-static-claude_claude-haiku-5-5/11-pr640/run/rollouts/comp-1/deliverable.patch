diff --git a/releasenotes/notes/fix-tryagain-reraise-5c2e9d7a1f384b06.yaml b/releasenotes/notes/fix-tryagain-reraise-5c2e9d7a1f384b06.yaml
new file mode 100644
index 0000000..ca66a42
--- /dev/null
+++ b/releasenotes/notes/fix-tryagain-reraise-5c2e9d7a1f384b06.yaml
@@ -0,0 +1,8 @@
+---
+fixes:
+  - |
+    When ``TryAgain`` was raised from an ``except`` block and ``reraise=True`` was set,
+    giving up now re-raises the underlying exception that caused the retry, instead of
+    the ``TryAgain`` sentinel. This applies to sync and async retrying, and to
+    ``RetryError.reraise()``. A bare ``TryAgain`` with no underlying error still raises
+    ``TryAgain``.
diff --git a/tenacity/__init__.py b/tenacity/__init__.py
index 282e6da..e6c8112 100644
--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -185,7 +185,14 @@ class RetryError(Exception):
 
     def reraise(self) -> t.NoReturn:
         if self.last_attempt.failed:
-            raise self.last_attempt.result()
+            exc = self.last_attempt.exception()
+            # A TryAgain raised from an except block carries the real error only
+            # as its cause/context; re-raise that instead of the sentinel.
+            if isinstance(exc, TryAgain):
+                underlying = exc.__cause__ or exc.__context__
+                if underlying is not None:
+                    raise underlying
+            raise exc
         raise self
 
     def __str__(self) -> str:

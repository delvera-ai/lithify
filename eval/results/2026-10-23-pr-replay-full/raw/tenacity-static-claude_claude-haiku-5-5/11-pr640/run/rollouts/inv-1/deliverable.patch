index 0000000..ff068fa
--- /dev/null
+++ b/releasenotes/notes/tryagain-reraise-underlying-error-3c9e1f0a7b2d4e68.yaml
@@ -0,0 +1,6 @@
+---
+fixes:
+  - |
+    With ``reraise=True``, a ``TryAgain`` raised while handling an exception now
+    re-raises that underlying exception once the retries are exhausted, instead
+    of the ``TryAgain`` sentinel. This applies to sync and async retrying.
diff --git a/tenacity/__init__.py b/tenacity/__init__.py
index 282e6da..1b1f19d 100644
--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -185,6 +185,11 @@ class RetryError(Exception):
 
     def reraise(self) -> t.NoReturn:
         if self.last_attempt.failed:
+            exc = self.last_attempt.exception()
+            # A TryAgain raised while handling an error is only a retry signal:
+            # re-raise the error that caused it.
+            if isinstance(exc, TryAgain) and exc.__context__ is not None:
+                raise exc.__context__
             raise self.last_attempt.result()
         raise self
 

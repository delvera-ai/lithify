index 0000000..f4adb4c
--- /dev/null
+++ b/releasenotes/notes/tryagain-reraise-underlying-3f9a1c7e5b2d8046.yaml
@@ -0,0 +1,8 @@
+---
+fixes:
+  - |
+    With ``reraise=True``, a ``TryAgain`` raised from an ``except`` block (or
+    ``raise TryAgain from exc``) no longer escapes after the last attempt. The
+    underlying exception is re-raised instead, for both ``Retrying`` and
+    ``AsyncRetrying``. ``RetryError.reraise()`` follows the same rule when the
+    last attempt failed with a ``TryAgain`` that has a cause or context.
diff --git a/tenacity/__init__.py b/tenacity/__init__.py
index 282e6da..0579ebe 100644
--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -185,6 +185,14 @@ class RetryError(Exception):
 
     def reraise(self) -> t.NoReturn:
         if self.last_attempt.failed:
+            exc = self.last_attempt.exception()
+            # A bare TryAgain says nothing about the failure; the error that
+            # prompted it is its cause (`raise X from e`) or context (`raise X`
+            # inside an except block).
+            if isinstance(exc, TryAgain) and (
+                underlying := exc.__cause__ or exc.__context__
+            ):
+                raise underlying
             raise self.last_attempt.result()
         raise self
 

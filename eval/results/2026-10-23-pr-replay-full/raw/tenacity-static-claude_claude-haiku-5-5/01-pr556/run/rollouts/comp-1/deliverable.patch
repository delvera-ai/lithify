@@ -0,0 +1,6 @@
+---
+fixes:
+  - |
+    Fix the ordinal suffix of numbers greater than 20 ending in 11, 12 or 13
+    used in log messages, e.g. "111th" instead of "111st", "112th" instead of
+    "112nd" and "113th" instead of "113rd".
diff --git a/tenacity/_utils.py b/tenacity/_utils.py
index be14871..d673b24 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -47,7 +47,7 @@ def find_ordinal(pos_num: int) -> str:
         return "nd"
     elif pos_num == 3:
         return "rd"
-    elif 4 <= pos_num <= 20:
+    elif 4 <= pos_num <= 20 or 11 <= pos_num % 100 <= 13:
         return "th"
     else:
         return find_ordinal(pos_num % 10)

         self.assertFalse(r(tenacity.Future.construct(1, 42, True)))
 
+    def test_retry_composed_with_plain_callable(self) -> None:
+        def is_foo(retry_state: tenacity.RetryCallState) -> bool:
+            assert retry_state.outcome is not None  # help mypy
+            return retry_state.outcome.result() == "foo"
+
+        def r(retry: tenacity.retry_base, value: str) -> bool:
+            retry_state = make_retry_state(
+                1, 1.0, last_result=tenacity.Future.construct(1, value, False)
+            )
+            return retry(retry_state)
+
+        or_retry = tenacity.retry_if_result(lambda x: x == "bar") | is_foo
+        ror_retry = is_foo | tenacity.retry_if_result(lambda x: x == "bar")
+        self.assertTrue(r(or_retry, "foo"))
+        self.assertTrue(r(or_retry, "bar"))
+        self.assertFalse(r(or_retry, "baz"))
+        self.assertTrue(r(ror_retry, "foo"))
+        self.assertTrue(r(ror_retry, "bar"))
+        self.assertFalse(r(ror_retry, "baz"))
+
+        and_retry = tenacity.retry_if_result(lambda x: isinstance(x, str)) & is_foo
+        rand_retry = is_foo & tenacity.retry_if_result(lambda x: isinstance(x, str))
+        self.assertTrue(r(and_retry, "foo"))
+        self.assertFalse(r(and_retry, "bar"))
+        self.assertFalse(r(and_retry, "baz"))
+        self.assertTrue(r(rand_retry, "foo"))
+        self.assertFalse(r(rand_retry, "bar"))
+        self.assertFalse(r(rand_retry, "baz"))
+

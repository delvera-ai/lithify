         self.assertEqual(3, result)
 
+    @asynctest
+    async def test_sync_retry_composed_with_plain_callable(self) -> None:
+        def lt_3(x: float) -> bool:
+            return x < 3
+
+        def under_five_attempts(retry_state: RetryCallState) -> bool:
+            return retry_state.attempt_number < 5
+
+        async def run(retry_strategy: Any) -> int:
+            attempts = 0
+            async for attempt in tasyncio.AsyncRetrying(retry=retry_strategy):
+                with attempt:
+                    attempts += 1
+                attempt.retry_state.set_result(attempts)
+
+            return attempts
+
+        # "or" keeps retrying while either condition holds
+        self.assertEqual(5, await run(retry_if_result(lt_3) | under_five_attempts))
+        self.assertEqual(5, await run(under_five_attempts | retry_if_result(lt_3)))
+        # "and" stops as soon as either condition fails
+        self.assertEqual(3, await run(retry_if_result(lt_3) & under_five_attempts))
+        self.assertEqual(3, await run(under_five_attempts & retry_if_result(lt_3)))
+
     @asynctest

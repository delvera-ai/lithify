+    @asynctest
+    async def test_retry_composes_with_plain_callable(self) -> None:
+        async def is_one(value: object) -> bool:
+            return value == 1
+
+        def is_two(retry_state: tenacity.RetryCallState) -> bool:
+            assert retry_state.outcome is not None
+            return retry_state.outcome.result() == 2
+
+        attempts = 0
+
+        async def _attempt() -> int:
+            nonlocal attempts
+            attempts += 1
+            return attempts
+
+        for retry in (
+            tasyncio.retry_if_result(is_one) | is_two,
+            is_two | tasyncio.retry_if_result(is_one),
+        ):
+            attempts = 0
+            retrying = AsyncRetrying(retry=retry, stop=tenacity.stop_after_attempt(5))
+            assert await retrying(_attempt) == 3
+            assert attempts == 3
+
     def test_repr(self) -> None:
         repr(tasyncio.AsyncRetrying())
 

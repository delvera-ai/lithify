+    def test_retry_composes_with_plain_callable(self) -> None:
+        def is_two(retry_state: RetryCallState) -> bool:
+            assert retry_state.outcome is not None
+            return retry_state.outcome.result() == 2
+
+        retry_or = tenacity.retry_if_result(lambda x: x == 1) | is_two
+        retry_ror = is_two | tenacity.retry_if_result(lambda x: x == 1)
+        retry_and = tenacity.retry_if_result(lambda x: x == 2) & is_two
+        retry_rand = is_two & tenacity.retry_if_result(lambda x: x == 2)
+
+        def r(retry: tenacity.retry_base, fut: tenacity.Future) -> bool:
+            retry_state = make_retry_state(1, 1.0, last_result=fut)
+            return retry(retry_state)
+
+        for retry in (retry_or, retry_ror):
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 1, False)))
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 2, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 3, False)))
+
+        for retry in (retry_and, retry_rand):
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 2, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 1, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 3, False)))

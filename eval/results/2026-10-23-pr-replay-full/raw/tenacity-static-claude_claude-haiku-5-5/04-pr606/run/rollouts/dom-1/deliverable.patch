+    def test_retry_or_and_with_plain_callable(self) -> None:
+        def is_two(retry_state: tenacity.RetryCallState) -> bool:
+            outcome = retry_state.outcome
+            return outcome is not None and not outcome.failed and outcome.result() == 2
+
+        def r(
+            retry: typing.Callable[[tenacity.RetryCallState], bool],
+            fut: tenacity.Future,
+        ) -> bool:
+            retry_state = make_retry_state(1, 1.0, last_result=fut)
+            return retry(retry_state)
+
+        retry_or_left = tenacity.retry_if_exception_type(IOError) | is_two
+        retry_or_right = is_two | tenacity.retry_if_exception_type(IOError)
+        self.assertIsInstance(retry_or_left, tenacity.retry_any)
+        self.assertIsInstance(retry_or_right, tenacity.retry_any)
+        for retry in (retry_or_left, retry_or_right):
+            self.assertTrue(r(retry, tenacity.Future.construct(1, IOError(), True)))
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 2, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 3, False)))
+
+        retry_and_left = tenacity.retry_if_result(lambda x: isinstance(x, int)) & is_two
+        retry_and_right = is_two & tenacity.retry_if_result(
+            lambda x: isinstance(x, int)
+        )
+        self.assertIsInstance(retry_and_left, tenacity.retry_all)
+        self.assertIsInstance(retry_and_right, tenacity.retry_all)
+        for retry in (retry_and_left, retry_and_right):
+            self.assertTrue(r(retry, tenacity.Future.construct(1, 2, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 3, False)))
+            self.assertFalse(r(retry, tenacity.Future.construct(1, 2, True)))

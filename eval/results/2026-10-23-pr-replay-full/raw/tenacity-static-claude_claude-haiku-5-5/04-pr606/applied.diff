+        def is_int_result(retry_state: RetryCallState) -> bool:
+            return (
+                retry_state.outcome is not None
+                and not retry_state.outcome.failed
+                and isinstance(retry_state.outcome.result(), int)
+            )
+
+        retry = tenacity.retry_if_exception_type(OSError) | is_int_result

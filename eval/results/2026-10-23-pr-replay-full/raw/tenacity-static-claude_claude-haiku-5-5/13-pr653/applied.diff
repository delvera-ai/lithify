+class _SharedStatistics(dict[str, t.Any]):
+    """Statistics of one call, mirrored into the decorated function's shared dict.
+
+    ``functools.wraps`` copies the function's ``statistics`` object onto outer wrappers
+    once, at decoration time, so that object must never be rebound. Each call keeps its
+    own dict (per-call isolation) and mirrors every change into the shared one.
+    """
+
+    def __init__(self, shared: dict[str, t.Any]) -> None:
+        super().__init__()
+        self._shared = shared
+
+    def __setitem__(self, key: str, value: t.Any) -> None:
+        super().__setitem__(key, value)
+        self._shared[key] = value
+
+    def clear(self) -> None:
+        super().clear()
+        self._shared.clear()
+
+

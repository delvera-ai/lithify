+class TestStatisticsThroughWrapper(unittest.IsolatedAsyncioTestCase):
+    async def test_stats_visible_through_wrapping_decorator(self) -> None:
+        """An async function wrapped by functools.wraps exposes live statistics."""
+
+        def timing(f: Callable[..., Any]) -> Callable[..., Any]:
+            @wraps(f)
+            async def wrapper(*args: Any, **kwargs: Any) -> Any:
+                return await f(*args, **kwargs)
+
+            return wrapper
+
+        @timing
+        @retry(stop=tenacity.stop_after_attempt(2))
+        async def _foobar() -> None:
+            raise ValueError(42)
+
+        self.assertIs(_foobar.__wrapped__.statistics, _foobar.statistics)
+        with contextlib.suppress(tenacity.RetryError):
+            await _foobar()
+        self.assertIs(_foobar.__wrapped__.statistics, _foobar.statistics)
+        self.assertEqual(2, _foobar.statistics["attempt_number"])
+

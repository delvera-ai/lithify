+class _StatisticsView(collections.abc.MutableMapping[str, t.Any]):
+    """Live view of the statistics of the calling thread's most recent run.
+
+    ``functools.wraps`` copies a wrapper's ``__dict__`` when another decorator wraps
+    it, so an outer wrapper keeps the object that was there at that moment. Giving
+    every wrapper one stable view keeps the outer wrapper reading the current run.
+    """
+
+    def __init__(self, retry: "BaseRetrying") -> None:
+        self._retry = retry
+
+    def __getitem__(self, key: str) -> t.Any:
+        return self._retry.statistics[key]
+
+    def __setitem__(self, key: str, value: t.Any) -> None:
+        self._retry.statistics[key] = value
+
+    def __delitem__(self, key: str) -> None:
+        del self._retry.statistics[key]
+
+    def __iter__(self) -> t.Iterator[str]:
+        return iter(self._retry.statistics)
+
+    def __len__(self) -> int:
+        return len(self._retry.statistics)
+
+    def __repr__(self) -> str:
+        return repr(self._retry.statistics)
+
+

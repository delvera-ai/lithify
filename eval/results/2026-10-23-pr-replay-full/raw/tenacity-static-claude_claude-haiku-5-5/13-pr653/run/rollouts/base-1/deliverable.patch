 class TestDecoratorWrapper(unittest.TestCase):
+    @asynctest
+    async def test_statistics_visible_through_functools_wraps(self) -> None:
+        calls: list[int] = []
+
+        @tenacity.retry(
+            stop=tenacity.stop_after_attempt(2),
+            retry=tenacity.retry_if_exception_type(ValueError),
+            reraise=True,
+        )
+
+        async def _inner() -> int:
+            calls.append(1)
+            if len(calls) < 2:
+                raise ValueError("retry")
+            return 42
+
+        @wraps(_inner)
+        async def _timed(*args: Any, **kwargs: Any) -> int:
+            return await _inner(*args, **kwargs)
+
+        self.assertEqual(42, await _timed())
+        self.assertIs(_inner.statistics, _timed.statistics)
+        self.assertEqual(2, _timed.statistics["attempt_number"])
+

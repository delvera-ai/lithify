+class _StatisticsMirror(dict[str, t.Any]):
+    """Per-call statistics that also refresh a shared dict on every write.
+
+    Each call keeps its own dict, so concurrent or nested calls do not clear each
+    other's values. The shared dict is the one ``wraps`` exposes as ``fn.statistics``.
+    """
+
+    def __init__(self, shared: dict[str, t.Any]) -> None:
+        super().__init__()
+        self._shared = shared
+
+    def __setitem__(self, key: str, value: t.Any) -> None:
+        super().__setitem__(key, value)
+        self._publish()
+
+    def clear(self) -> None:
+        super().clear()
+        self._publish()
+
+    def _publish(self) -> None:
+        self._shared.clear()
+        self._shared.update(self)
+
+

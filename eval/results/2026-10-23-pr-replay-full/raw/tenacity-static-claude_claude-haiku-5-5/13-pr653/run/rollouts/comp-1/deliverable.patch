 class TestDecoratorWrapper(unittest.TestCase):
+    @asynctest
+    async def test_statistics_visible_through_functools_wraps(self) -> None:
+        """An outer functools.wraps decorator must expose the real statistics."""
+
+        def timing(
+            f: Callable[..., Any],
+        ) -> Callable[..., Any]:
+            @wraps(f)
+            async def wrapper(*args: Any, **kwargs: Any) -> Any:
+                return await f(*args, **kwargs)
+
+            return wrapper
+
+        attempts = 0
+
+        @retry(stop=stop_after_attempt(3))
+        async def _foobar() -> int:
+            nonlocal attempts
+            attempts += 1
+            if attempts < 3:
+                raise ValueError("fail")
+            return attempts
+
+        outer = timing(_foobar)
+        self.assertEqual(3, await outer())
+        self.assertIs(_foobar.statistics, outer.statistics)
+        self.assertEqual(3, outer.statistics["attempt_number"])
+

@@ -190,6 +190,32 @@ class TestContextManager(unittest.TestCase):
 
         assert attempts == 3
 
+    @asynctest
+    async def test_do_max_attempts_async_with(self) -> None:
+        attempts = 0
+        try:
+            async for attempt in tasyncio.AsyncRetrying(stop=stop_after_attempt(3)):
+                async with attempt:
+                    attempts += 1
+                    raise Exception
+        except RetryError:
+            pass
+
+        assert attempts == 3
+
+    @asynctest
+    async def test_async_with_retry_if_result(self) -> None:
+        result = None
+        async for attempt in tasyncio.AsyncRetrying(
+            retry=retry_if_result(lambda x: x < 3)
+        ):
+            async with attempt:
+                result = 1 if attempt.retry_state.attempt_number == 1 else 3
+            if not attempt.retry_state.outcome.failed:
+                attempt.retry_state.set_result(result)
+
+        assert result == 3
+

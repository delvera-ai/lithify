         assert attempts == 3
 
+    @asynctest
+    async def test_do_max_attempts_async_with(self) -> None:
+        attempts = 0
+        retrying = tasyncio.AsyncRetrying(stop=stop_after_attempt(3))
+        try:
+            async for attempt in retrying:
+                async with attempt:
+                    attempts += 1
+                    raise Exception
+        except RetryError:
+            pass
+
+        assert attempts == 3
+
+    @asynctest
+    async def test_retry_until_success_async_with(self) -> None:
+        attempts = 0
+        async for attempt in tasyncio.AsyncRetrying(stop=stop_after_attempt(5)):
+            async with attempt:
+                attempts += 1
+                if attempts < 3:
+                    raise ValueError("not yet")
+
+        assert attempts == 3
+

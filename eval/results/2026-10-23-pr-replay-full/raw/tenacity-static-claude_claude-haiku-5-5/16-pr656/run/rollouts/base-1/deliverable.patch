                 self.assertEqual(r.wait(make_retry_state(20, 0)), 100)
 
+    def test_exponential_with_max_below_multiplier_underflow(self) -> None:
+        # max / multiplier underflows to 0.0; the cap must still be returned.
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=1e300, max=1e-100))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 1e-100)
+        self.assertEqual(r.wait(make_retry_state(2, 0)), 1e-100)
+        self.assertEqual(r.wait(make_retry_state(50, 0)), 1e-100)
+
+    def test_exponential_with_infinite_multiplier(self) -> None:
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=float("inf"), max=40))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 40)
+        self.assertEqual(r.wait(make_retry_state(50, 0)), 40)
+
     def test_legacy_explicit_wait_type(self) -> None:

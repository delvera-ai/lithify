diff --git a/releasenotes/notes/wait-exponential-underflow-24362740e3ef10d9.yaml b/releasenotes/notes/wait-exponential-underflow-24362740e3ef10d9.yaml
new file mode 100644
index 0000000..847b6af
--- /dev/null
+++ b/releasenotes/notes/wait-exponential-underflow-24362740e3ef10d9.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    ``wait_exponential`` no longer raises ``ValueError: math domain error`` when
+    ``multiplier`` is infinite or ``max / multiplier`` underflows to zero (for
+    example ``wait_exponential(multiplier=1e300, max=1e-100)``). It now returns
+    the capped wait time, as it does for other values above the maximum.
diff --git a/tenacity/wait.py b/tenacity/wait.py
index a662eef..a0b7878 100644
--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -208,7 +208,12 @@ class wait_exponential(wait_base):
             and self.max > 0
             and self.exp_base > 1
             and math.isfinite(self.max)
-            and exponent > math.log(self.max / self.multiplier, self.exp_base)
+            # max / multiplier can underflow to 0.0 (e.g. multiplier=inf), which
+            # math.log rejects; then multiplier > max, so the cap always applies.
+            and (
+                self.max / self.multiplier == 0
+                or exponent > math.log(self.max / self.multiplier, self.exp_base)
+            )
         ):
             return max(max(0, self.min), self.max)
         try:

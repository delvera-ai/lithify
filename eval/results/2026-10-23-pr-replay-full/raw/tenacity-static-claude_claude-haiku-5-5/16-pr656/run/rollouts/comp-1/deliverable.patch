diff --git a/releasenotes/notes/wait-exponential-domain-error-16d4b7be609b0fd0.yaml b/releasenotes/notes/wait-exponential-domain-error-16d4b7be609b0fd0.yaml
new file mode 100644
index 0000000..13479ea
--- /dev/null
+++ b/releasenotes/notes/wait-exponential-domain-error-16d4b7be609b0fd0.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    `wait_exponential` no longer raises ``ValueError: math domain error`` when
+    ``multiplier`` is infinite or ``max / multiplier`` underflows to zero. The
+    wait is now capped at ``max`` from the first attempt, as it already was for
+    other values where the cap is reached immediately.
diff --git a/tenacity/wait.py b/tenacity/wait.py
index a662eef..0d9fc30 100644
--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -208,7 +208,12 @@ class wait_exponential(wait_base):
             and self.max > 0
             and self.exp_base > 1
             and math.isfinite(self.max)
-            and exponent > math.log(self.max / self.multiplier, self.exp_base)
+            and (
+                # A 0.0 ratio (multiplier is inf, or max / multiplier underflowed)
+                # means multiplier > max, so the cap applies from the first attempt.
+                self.max / self.multiplier == 0
+                or exponent > math.log(self.max / self.multiplier, self.exp_base)
+            )
         ):
             return max(max(0, self.min), self.max)
         try:

diff --git a/releasenotes/notes/wait-exponential-underflowing-ratio-a6fc4e01b570a337.yaml b/releasenotes/notes/wait-exponential-underflowing-ratio-a6fc4e01b570a337.yaml
new file mode 100644
index 0000000..3a2f9f3
--- /dev/null
+++ b/releasenotes/notes/wait-exponential-underflowing-ratio-a6fc4e01b570a337.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    ``wait_exponential`` no longer raises ``ValueError: math domain error`` when
+    ``max / multiplier`` underflows to ``0.0`` (for example ``multiplier=1e300``
+    with ``max=1e-100``) or when ``multiplier`` is infinite. It now returns the
+    capped wait, as it does for other values past the cap.
diff --git a/tenacity/wait.py b/tenacity/wait.py
index a662eef..edc3dff 100644
--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -208,7 +208,13 @@ class wait_exponential(wait_base):
             and self.max > 0
             and self.exp_base > 1
             and math.isfinite(self.max)
-            and exponent > math.log(self.max / self.multiplier, self.exp_base)
+            # max / multiplier underflows to 0.0 for a huge or infinite multiplier;
+            # every exponent >= 0 is already past the cap then
+            and (
+                exponent >= 0
+                if self.max / self.multiplier == 0
+                else exponent > math.log(self.max / self.multiplier, self.exp_base)
+            )
         ):
             return max(max(0, self.min), self.max)
         try:

diff --git a/releasenotes/notes/fix-wait-exponential-domain-error-3e9b1d7a5c2f8064.yaml b/releasenotes/notes/fix-wait-exponential-domain-error-3e9b1d7a5c2f8064.yaml
new file mode 100644
index 0000000..1bc3861
--- /dev/null
+++ b/releasenotes/notes/fix-wait-exponential-domain-error-3e9b1d7a5c2f8064.yaml
@@ -0,0 +1,6 @@
+---
+fixes:
+  - |
+    ``wait_exponential`` no longer raises ``ValueError: math domain error`` when
+    ``multiplier`` is infinite or ``max / multiplier`` underflows to zero; it now
+    returns the capped wait time.
diff --git a/tenacity/wait.py b/tenacity/wait.py
index a662eef..0895b02 100644
--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -208,7 +208,12 @@ class wait_exponential(wait_base):
             and self.max > 0
             and self.exp_base > 1
             and math.isfinite(self.max)
-            and exponent > math.log(self.max / self.multiplier, self.exp_base)
+            # A ratio of 0.0 (max / multiplier underflows, or multiplier is inf)
+            # means multiplier > max, so the cap applies from the first attempt.
+            and (
+                self.max / self.multiplier == 0
+                or exponent > math.log(self.max / self.multiplier, self.exp_base)
+            )
         ):
             return max(max(0, self.min), self.max)
         try:
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index f6c15ce..135fd1a 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -367,6 +367,17 @@ class TestWaitConditions(unittest.TestCase):
         r = Retrying(wait=tenacity.wait_exponential(max=40, exp_base=ExplodingPower(2)))
         self.assertEqual(r.wait(make_retry_state(50, 0)), 40)
 
+    def test_exponential_multiplier_much_larger_than_max(self) -> None:
+        # max / multiplier underflows to 0.0; the cap applies from the first attempt.
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=1e300, max=1e-100))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 1e-100)
+        self.assertEqual(r.wait(make_retry_state(5, 0)), 1e-100)
+
+    def test_exponential_infinite_multiplier(self) -> None:
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=float("inf"), max=40))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 40)
+        self.assertEqual(r.wait(make_retry_state(5, 0)), 40)
+
     def test_exponential_with_min_wait(self) -> None:
         r = Retrying(wait=tenacity.wait_exponential(min=20))
         self.assertEqual(r.wait(make_retry_state(1, 0)), 20)

+    def test_exponential_multiplier_much_larger_than_max(self) -> None:
+        # max / multiplier underflows to 0.0; the cap applies from the first attempt.
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=1e300, max=1e-100))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 1e-100)
+        self.assertEqual(r.wait(make_retry_state(5, 0)), 1e-100)
+
+    def test_exponential_infinite_multiplier(self) -> None:
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=float("inf"), max=40))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 40)
+        self.assertEqual(r.wait(make_retry_state(5, 0)), 40)
+
     def test_exponential_with_min_wait(self) -> None:

+class TestAsyncNoWaitValues(unittest.TestCase):
+    @asynctest
+    async def test_no_wait_values_mean_no_sleep_on_retry(self) -> None:
+        # None, 0 and sum([]) (which is the int 0) all mean "no wait".
+        for wait in (None, 0, sum([])):
+            with self.subTest(wait=wait):
+                sleeps: list[float] = []
+                attempts = 0
+
+                async def record_sleep(seconds: float) -> None:
+                    sleeps.append(seconds)
+
+                async def fails_once() -> str:
+                    nonlocal attempts
+                    attempts += 1
+                    if attempts == 1:
+                        raise ValueError
+                    return "ok"
+
+                retrying = tasyncio.AsyncRetrying(sleep=record_sleep, wait=wait)
+                self.assertEqual(await retrying(fails_once), "ok")
+                self.assertEqual(sleeps, [0])
+

+class TestNoWaitValues(unittest.TestCase):
+    @asynctest
+    async def test_wait_none_values_mean_no_wait(self) -> None:
+        # None, 0 and sum([]) (the int 0) all mean "no wait". Fail once so a
+        # retry actually runs the wait.
+        waits: list[Any] = [None, 0, sum([])]
+        for wait in waits:
+            mock_sleep = mock.AsyncMock()
+            attempts: list[int] = []
+
+            async def fail_once() -> None:
+                attempts.append(1)
+                if len(attempts) < 2:
+                    raise ValueError
+
+            await AsyncRetrying(
+                sleep=mock_sleep, wait=wait, stop=stop_after_attempt(2)
+            )(fail_once)
+            mock_sleep.assert_awaited_once_with(0)
+
+
 if __name__ == "__main__":
     unittest.main()

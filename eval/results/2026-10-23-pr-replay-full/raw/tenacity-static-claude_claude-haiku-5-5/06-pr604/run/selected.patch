+class TestEnabled:
+    def test_decorator_disabled_calls_once_and_propagates_exception(self) -> None:
+        calls: list[int] = []
+        error = ValueError("raised for test purposes")
+
+        @retry(stop=tenacity.stop_after_attempt(5), enabled=False)
+        def _retryable() -> None:
+            calls.append(1)
+            raise error
+
+        with pytest.raises(ValueError) as exc_ctx:
+            _retryable()
+
+        assert exc_ctx.value is error
+        assert len(calls) == 1
+
+    def test_decorator_disabled_returns_result(self) -> None:
+        @retry(enabled=False)
+        def _retryable() -> str:
+            return "ok"
+
+        assert _retryable() == "ok"
+
+    def test_retrying_disabled_calls_once_without_before_callbacks(self) -> None:
+        calls: list[int] = []
+        before_calls: list[int] = []
+
+        def _fails() -> None:
+            calls.append(1)
+            raise ValueError("raised for test purposes")
+
+        retryer = tenacity.Retrying(
+            stop=tenacity.stop_after_attempt(5),
+            before=lambda rs: before_calls.append(1),
+            enabled=False,
+        )
+        with pytest.raises(ValueError):
+            retryer(_fails)
+
+        assert len(calls) == 1
+        assert before_calls == []
+
+    def test_retry_with_enabled_false_disables_decorated_retry(self) -> None:
+        calls: list[int] = []
+
+        @retry(stop=tenacity.stop_after_attempt(5))
+        def _retryable() -> None:
+            calls.append(1)
+            raise ValueError("raised for test purposes")
+
+        with pytest.raises(ValueError):
+            _retryable.retry_with(enabled=False)()
+
+        assert len(calls) == 1
+
+    def test_default_is_enabled(self) -> None:
+        calls: list[int] = []
+
+        @retry(stop=tenacity.stop_after_attempt(3))
+        def _retryable() -> None:
+            calls.append(1)
+            raise ValueError("raised for test purposes")
+
+        with pytest.raises(RetryError):
+            _retryable()
+
+        assert len(calls) == 3
+
+    def test_iteration_disabled_runs_one_attempt_and_propagates_exception(
+        self,
+    ) -> None:
+        attempts: list[int] = []
+

+class TestEnabled(unittest.TestCase):
+    @asynctest
+    async def test_decorator_disabled_calls_once_and_propagates_exception(
+        self,
+    ) -> None:
+        calls: list[int] = []
+        error = ValueError("raised for test purposes")
+
+        @retry(stop=stop_after_attempt(5), enabled=False)
+        async def _retryable() -> None:
+            calls.append(1)
+            raise error
+
+        with pytest.raises(ValueError) as exc_ctx:
+            await _retryable()
+
+        assert exc_ctx.value is error
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_sync_function_disabled_calls_once(self) -> None:
+        calls: list[int] = []
+
+        @retry(stop=stop_after_attempt(5), sleep=_async_noop, enabled=False)
+        def _retryable() -> None:
+            calls.append(1)
+            raise ValueError("raised for test purposes")
+
+        with pytest.raises(ValueError):
+            await _retryable()
+
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_async_retrying_disabled_calls_once(self) -> None:
+        calls: list[int] = []
+
+        async def _fails() -> None:
+            calls.append(1)
+            raise ValueError("raised for test purposes")
+
+        retryer = AsyncRetrying(stop=stop_after_attempt(5), enabled=False)
+        with pytest.raises(ValueError):
+            await retryer(_fails)
+
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_async_iteration_disabled_runs_one_attempt(self) -> None:
+        attempts: list[int] = []
+
+        retryer = AsyncRetrying(stop=stop_after_attempt(5), enabled=False)
+        with pytest.raises(ValueError):
+            async for attempt in retryer:
+                with attempt:
+                    attempts.append(1)
+                    raise ValueError("raised for test purposes")
+
+        assert len(attempts) == 1
+
+
+async def _async_noop(seconds: float) -> None:
+    return None
+

+class TestEnabled:
+    def test_disabled_calls_once_and_propagates_exception(self) -> None:
+        calls: list[int] = []
+
+        def _fails() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError, match="boom"):
+            tenacity.Retrying(enabled=False, stop=tenacity.stop_after_attempt(5))(
+                _fails
+            )
+        assert len(calls) == 1
+
+    def test_disabled_decorator_calls_once_and_returns_value(self) -> None:
+        calls: list[int] = []
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(5))
+        def _returns_none() -> None:
+            calls.append(1)
+
+        assert _returns_none() is None
+        assert len(calls) == 1
+
+    def test_disabled_decorator_does_not_retry_on_exception(self) -> None:
+        calls: list[int] = []
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(5))
+        def _fails() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError, match="boom"):
+            _fails()
+        assert len(calls) == 1
+
+    def test_retry_with_can_disable(self) -> None:
+        calls: list[int] = []
+
+        @retry(stop=tenacity.stop_after_attempt(5))
+        def _fails() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError, match="boom"):
+            _fails.retry_with(enabled=False)()
+        assert len(calls) == 1
+
+    def test_enabled_by_default_still_retries(self) -> None:

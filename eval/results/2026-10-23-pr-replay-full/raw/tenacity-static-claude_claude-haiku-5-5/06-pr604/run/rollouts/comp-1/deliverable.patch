+class TestEnabled(unittest.TestCase):
+    @asynctest
+    async def test_decorator_disabled_calls_once_and_propagates(self) -> None:
+        calls: list[int] = []
+
+        @retry(enabled=False, stop=stop_after_attempt(3))
+        async def fail() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with self.assertRaises(ValueError):
+            await fail()
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_async_retrying_disabled_call(self) -> None:
+        calls: list[int] = []
+
+        async def fail() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with self.assertRaises(ValueError):
+            await AsyncRetrying(enabled=False, stop=stop_after_attempt(3))(fail)
+        assert len(calls) == 1
+
+    @asynctest
+    async def test_async_retrying_disabled_async_for(self) -> None:
+        attempts = 0
+        with self.assertRaises(ValueError):
+            async for attempt in AsyncRetrying(
+                enabled=False, stop=stop_after_attempt(3)
+            ):
+                with attempt:
+                    attempts += 1
+                    raise ValueError("boom")
+        assert attempts == 1
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 5a90a46..cdda77c 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1930,5 +1930,69 @@ class TestMockingSleep:
         assert mock_sleep.call_count == 1
 
 
+class TestEnabled(unittest.TestCase):
+    def test_decorator_disabled_calls_once_and_propagates(self) -> None:
+        calls: list[int] = []
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(3))
+        def fail() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with self.assertRaises(ValueError) as cm:
+            fail()
+        assert str(cm.exception) == "boom"
+        assert len(calls) == 1
+
+    def test_decorator_disabled_returns_result(self) -> None:
+        @retry(enabled=False)
+        def ok() -> int:
+            return 42
+
+        assert ok() == 42
+
+    def test_disabled_skips_retry_callbacks(self) -> None:
+        seen: list[str] = []
+        retrying = Retrying(
+            enabled=False,
+            stop=tenacity.stop_after_attempt(3),
+            before=lambda rs: seen.append("before"),
+            after=lambda rs: seen.append("after"),
+            before_sleep=lambda rs: seen.append("before_sleep"),
+        )
+
+        with self.assertRaises(ValueError):
+            retrying(_raise_value_error)
+        assert seen == []
+
+    def test_disabled_iteration_runs_body_once(self) -> None:
+        attempts = 0
+        with self.assertRaises(ValueError):
+            for attempt in Retrying(enabled=False, stop=tenacity.stop_after_attempt(3)):
+                with attempt:
+                    attempts += 1
+                    raise ValueError("boom")
+        assert attempts == 1
+
+    def test_retry_with_keeps_disabled(self) -> None:
+        calls: list[int] = []
+
+        @retry(enabled=False)
+        def fail() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with self.assertRaises(ValueError):
+            fail.retry_with(stop=tenacity.stop_after_attempt(3))()
+        assert len(calls) == 1
+
+    def test_enabled_defaults_to_true(self) -> None:
+        assert Retrying().enabled is True
+
+
+def _raise_value_error() -> None:
+    raise ValueError("boom")
+
+
 if __name__ == "__main__":
     unittest.main()

+class TestEnabled:
+    def test_disabled_decorator_calls_once_and_propagates(self) -> None:
+        calls: list[int] = []
+
+        @retry(stop=tenacity.stop_after_attempt(3), enabled=False)
+        def fail() -> None:
+            calls.append(1)
+            raise CustomError("boom")
+
+        with pytest.raises(CustomError):
+            fail()
+        assert len(calls) == 1
+
+    def test_disabled_retrying_returns_result_without_retry(self) -> None:
+        calls: list[int] = []
+
+        def succeed() -> str:
+            calls.append(1)
+            return "ok"
+
+        assert Retrying(enabled=False)(succeed) == "ok"
+        assert len(calls) == 1
+
+    def test_retry_with_enabled_false_disables_retry(self) -> None:
+        calls: list[int] = []
+
+        @retry(stop=tenacity.stop_after_attempt(3))
+        def fail() -> None:
+            calls.append(1)
+            raise CustomError("boom")
+
+        with pytest.raises(RetryError):
+            fail()
+        assert len(calls) == 3
+
+        calls.clear()
+        with pytest.raises(CustomError):
+            fail.retry_with(enabled=False)()
+        assert len(calls) == 1
+
+    def test_enabled_defaults_to_true(self) -> None:
+        assert Retrying().enabled is True
+        assert retry(lambda: None).retry.enabled is True
+
+
 if __name__ == "__main__":

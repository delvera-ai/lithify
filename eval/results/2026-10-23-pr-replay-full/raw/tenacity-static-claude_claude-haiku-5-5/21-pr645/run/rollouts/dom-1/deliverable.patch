+++ b/tests/test_asyncio.py
@@ -243,6 +243,37 @@ class TestAsyncEnabled(unittest.TestCase):
                 call_count += 1
         assert call_count == 1
 
+    @asynctest
+    async def test_enabled_false_direct_call_raises_original_exception(self) -> None:
+        """When enabled=False, awaiting the AsyncRetrying object with a coroutine
+        function runs it once and propagates its exception unchanged."""
+        call_count = 0
+
+        async def always_fails() -> None:
+            nonlocal call_count
+            call_count += 1
+            raise ValueError("fail")
+
+        retrying = AsyncRetrying(enabled=False, stop=stop_after_attempt(3))
+        with pytest.raises(ValueError, match="fail"):
+            await retrying(always_fails)
+        assert call_count == 1
+
+    @asynctest
+    async def test_enabled_false_direct_call_sync_fn_returns_result(self) -> None:
+        """When enabled=False, awaiting the AsyncRetrying object with a plain sync
+        function calls it once and returns its result."""
+        call_count = 0
+
+        def succeeds() -> str:
+            nonlocal call_count
+            call_count += 1
+            return "ok"
+
+        retrying = AsyncRetrying(enabled=False, stop=stop_after_attempt(3))
+        assert await retrying(succeeds) == "ok"
+        assert call_count == 1
+
 

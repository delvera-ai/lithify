+    def test_enabled_false_call_raises_original_exception(self) -> None:
+        """When enabled=False, calling the Retrying object with a function calls
+        it once and raises its exception unchanged, not a RetryError."""
+        call_count = 0
+
+        def always_fails() -> None:
+            nonlocal call_count
+            call_count += 1
+            raise ValueError("fail")
+
+        retrying = Retrying(enabled=False, stop=tenacity.stop_after_attempt(3))
+        with pytest.raises(ValueError, match="fail"):
+            retrying(always_fails)
+        assert call_count == 1
+
+    def test_enabled_false_call_returns_result(self) -> None:
+        """When enabled=False, calling the Retrying object returns the function's
+        result from a single call."""
+        call_count = 0
+
+        def succeeds() -> str:
+            nonlocal call_count
+            call_count += 1
+            return "ok"
+
+        retrying = Retrying(enabled=False, stop=tenacity.stop_after_attempt(3))
+        assert retrying(succeeds) == "ok"

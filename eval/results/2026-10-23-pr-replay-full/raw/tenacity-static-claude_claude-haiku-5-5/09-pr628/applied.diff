+    def test_wait_exponential_jitter_min(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, min=5, jitter=0)
+
+        self.assertEqual(fn(make_retry_state(1, 0)), 5)
+        self.assertEqual(fn(make_retry_state(2, 0)), 5)
+        self.assertEqual(fn(make_retry_state(3, 0)), 5)
+        self.assertEqual(fn(make_retry_state(4, 0)), 8)
+
+    def test_wait_exponential_jitter_timedelta_max(self) -> None:
+        fn = tenacity.wait_exponential_jitter(max=datetime.timedelta(seconds=60))
+
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 1, 2)
+            self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
+    def test_wait_exponential_jitter_timedelta_jitter(self) -> None:
+        fn = tenacity.wait_exponential_jitter(jitter=datetime.timedelta(seconds=5))
+
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 1, 6)
+
+    def test_wait_exponential_jitter_timedelta_min(self) -> None:

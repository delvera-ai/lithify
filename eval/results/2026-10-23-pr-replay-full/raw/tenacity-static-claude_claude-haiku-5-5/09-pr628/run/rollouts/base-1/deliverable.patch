@@ -617,6 +617,36 @@ class TestWaitConditions(unittest.TestCase):
         fn = tenacity.wait_exponential_jitter()
         fn(make_retry_state(0, 0))
 
+    def test_wait_exponential_jitter_min(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, min=10, max=60)
+
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 10)
+            self.assertEqual(fn(make_retry_state(2, 0)), 10)
+            self.assertEqual(fn(make_retry_state(3, 0)), 10)
+            self.assertEqual(fn(make_retry_state(4, 0)), 10)
+            self._assert_inclusive_range(fn(make_retry_state(5, 0)), 16, 17)
+            self.assertEqual(fn(make_retry_state(9, 0)), 60)
+
+    def test_wait_exponential_jitter_timedelta_args(self) -> None:
+        for max_, jitter, min_ in (
+            (60, 1, 10),
+            (
+                datetime.timedelta(seconds=60),
+                datetime.timedelta(seconds=1),
+                datetime.timedelta(seconds=10),
+            ),
+        ):
+            with self.subTest(max=max_, jitter=jitter, min=min_):
+                fn = tenacity.wait_exponential_jitter(
+                    max=max_, jitter=jitter, min=min_
+                )
+
+                for _ in range(1000):
+                    self.assertEqual(fn(make_retry_state(1, 0)), 10)
+                    self._assert_inclusive_range(fn(make_retry_state(6, 0)), 32, 33)
+                    self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
     def test_wait_retry_state_attributes(self) -> None:
         class ExtractCallState(Exception):

@@ -617,6 +617,43 @@ class TestWaitConditions(unittest.TestCase):
         fn = tenacity.wait_exponential_jitter()
         fn(make_retry_state(0, 0))
 
+    def test_wait_exponential_jitter_min(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, max=60, jitter=0, min=5)
+        self.assertEqual(fn(make_retry_state(1, 0)), 5)
+        self.assertEqual(fn(make_retry_state(2, 0)), 5)
+        self.assertEqual(fn(make_retry_state(4, 0)), 8)
+        self.assertEqual(fn(make_retry_state(8, 0)), 60)
+
+        fn = tenacity.wait_exponential_jitter(min=3)
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 3)
+            self._assert_inclusive_range(fn(make_retry_state(3, 0)), 4, 5)
+
+    def test_wait_exponential_jitter_timedelta(self) -> None:
+        expected = tenacity.wait_exponential_jitter(max=60, jitter=0)
+        fn = tenacity.wait_exponential_jitter(
+            max=datetime.timedelta(seconds=60),
+            jitter=datetime.timedelta(seconds=0),
+        )
+        for attempt in range(1, 10):
+            with self.subTest(attempt=attempt):
+                self.assertEqual(
+                    fn(make_retry_state(attempt, 0)),
+                    expected(make_retry_state(attempt, 0)),
+                )
+
+        fn = tenacity.wait_exponential_jitter(jitter=datetime.timedelta(seconds=2))
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 1, 3)
+
+        fn = tenacity.wait_exponential_jitter(
+            max=datetime.timedelta(seconds=60),
+            jitter=0,
+            min=datetime.timedelta(seconds=5),
+        )
+        self.assertEqual(fn(make_retry_state(1, 0)), 5)
+        self.assertEqual(fn(make_retry_state(8, 0)), 60)
+
     def test_wait_retry_state_attributes(self) -> None:
         class ExtractCallState(Exception):

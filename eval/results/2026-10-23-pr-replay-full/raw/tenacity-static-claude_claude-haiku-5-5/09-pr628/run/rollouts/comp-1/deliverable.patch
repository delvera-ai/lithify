diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index efefba8..bec4f71 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -617,6 +617,35 @@ class TestWaitConditions(unittest.TestCase):
         fn = tenacity.wait_exponential_jitter()
         fn(make_retry_state(0, 0))
 
+    def test_wait_exponential_jitter_max_timedelta(self) -> None:
+        fn = tenacity.wait_exponential_jitter(max=datetime.timedelta(seconds=60))
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 1, 2)
+            self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
+    def test_wait_exponential_jitter_jitter_timedelta(self) -> None:
+        for jitter in (1, datetime.timedelta(seconds=1)):
+            with self.subTest():
+                fn = tenacity.wait_exponential_jitter(max=60, jitter=jitter)
+                for _ in range(1000):
+                    self._assert_inclusive_range(fn(make_retry_state(1, 0)), 1, 2)
+                    self._assert_inclusive_range(fn(make_retry_state(3, 0)), 4, 5)
+
+    def test_wait_exponential_jitter_min(self) -> None:
+        fn = tenacity.wait_exponential_jitter(max=60, min=5)
+        for _ in range(1000):
+            # 1 + jitter and 4 + jitter are raised to the floor of 5
+            self.assertEqual(fn(make_retry_state(1, 0)), 5)
+            self.assertEqual(fn(make_retry_state(3, 0)), 5)
+            self._assert_inclusive_range(fn(make_retry_state(4, 0)), 8, 9)
+
+    def test_wait_exponential_jitter_min_timedelta(self) -> None:
+        fn = tenacity.wait_exponential_jitter(
+            max=60, min=datetime.timedelta(seconds=5)
+        )
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 5)
+
     def test_wait_retry_state_attributes(self) -> None:
         class ExtractCallState(Exception):
             pass

+def _is_value_error(exc: BaseException) -> bool:
+    return isinstance(exc, ValueError)
+
+
+def _failed_state(exc: BaseException) -> RetryCallState:
+    retry_state = RetryCallState(None, None, (), {})  # type: ignore[arg-type]
+    retry_state.set_exception((type(exc), exc, None))
+    return retry_state
+
+
+def _succeeded_state(value: object) -> RetryCallState:
+    retry_state = RetryCallState(None, None, (), {})  # type: ignore[arg-type]
+    retry_state.set_result(value)
+    return retry_state
+
+
+class TestPickling(unittest.TestCase):
+    def test_retrying_is_pickleable(self) -> None:
+        import pickle
+
+        expected = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            wait=tenacity.wait_fixed(0),
+            retry=tenacity.retry_if_exception_type(ValueError),
+            reraise=True,
+            name="pickled",
+        )
+        actual = pickle.loads(pickle.dumps(expected))
+
+        self.assertEqual(str(actual), "pickled")
+        self.assertTrue(actual.reraise)
+        self.assertEqual(
+            actual.stop.max_attempt_number,  # type: ignore[attr-defined]
+            3,
+        )
+
+        calls: list[int] = []
+
+        def fails_once() -> str:
+            calls.append(1)
+            if len(calls) < 2:
+                raise ValueError("boom")
+            return "ok"
+
+        self.assertEqual(actual(fails_once), "ok")
+
+    def test_used_retrying_keeps_statistics_and_still_runs(self) -> None:
+        import pickle
+
+        calls: list[int] = []
+
+        def fails_once() -> str:
+            calls.append(1)
+            if len(calls) < 2:
+                raise ValueError("boom")
+            return "ok"
+
+        retrying = Retrying(
+            stop=tenacity.stop_after_attempt(5),
+            wait=tenacity.wait_fixed(0),
+            retry=tenacity.retry_if_exception_type(ValueError),
+        )
+        self.assertEqual(retrying(fails_once), "ok")
+        self.assertEqual(retrying.statistics["attempt_number"], 2)
+
+        actual = pickle.loads(pickle.dumps(retrying))
+
+        self.assertEqual(actual.statistics, retrying.statistics)
+        self.assertIsNot(actual.statistics, retrying.statistics)
+        self.assertEqual(actual(lambda: "again"), "again")
+        self.assertEqual(actual.statistics["attempt_number"], 1)
+
+    def test_retry_strategies_pickle_and_behave_the_same(self) -> None:
+        import pickle
+
+        strategies: list[tenacity.retry_base] = [
+            tenacity.retry_if_exception_type(),
+            tenacity.retry_if_exception_type((ValueError, KeyError)),
+            tenacity.retry_if_not_exception_type(ValueError),
+            tenacity.retry_unless_exception_type(ValueError),
+            tenacity.retry_if_exception(_is_value_error),
+            tenacity.retry_if_exception_message(message="boom"),
+            tenacity.retry_if_exception_message(match="bo"),
+            tenacity.retry_if_not_exception_message(message="boom"),
+            tenacity.retry_if_not_exception_message(match="bo"),
+            tenacity.retry_always,
+            tenacity.retry_never,
+            tenacity.retry_if_exception_type(ValueError)
+            | tenacity.retry_if_exception_message(message="boom"),
+            tenacity.retry_if_exception_type(ValueError)
+            & tenacity.retry_if_not_exception_message(match="bo"),
+        ]
+        exceptions = [ValueError("boom"), KeyError("boom"), ValueError("other")]
+        states = [_failed_state(exc) for exc in exceptions] + [_succeeded_state(1)]
+
+        for strategy in strategies:
+            restored = pickle.loads(pickle.dumps(strategy))
+            for retry_state in states:
+                with self.subTest(strategy=repr(strategy), outcome=retry_state.outcome):
+                    self.assertEqual(restored(retry_state), strategy(retry_state))
+
+    def test_stop_and_wait_strategies_pickle_and_behave_the_same(self) -> None:
+        import pickle
+
+        strategies: list[typing.Any] = [
+            tenacity.stop_after_attempt(2),
+            tenacity.stop_after_delay(10),
+            tenacity.stop_before_delay(10),
+            tenacity.stop_never,
+            tenacity.stop_after_attempt(2) | tenacity.stop_after_delay(10),
+            tenacity.wait_fixed(2),
+            tenacity.wait_none(),
+            tenacity.wait_exponential(),
+            tenacity.wait_incrementing(),
+            tenacity.wait_chain(tenacity.wait_fixed(1), tenacity.wait_fixed(2)),
+            tenacity.wait_fixed(1) + tenacity.wait_fixed(2),
+        ]
+        retry_state = _failed_state(ValueError("boom"))
+
+        for strategy in strategies:
+            restored = pickle.loads(pickle.dumps(strategy))
+            with self.subTest(strategy=repr(strategy)):
+                self.assertEqual(restored(retry_state), strategy(retry_state))
+
+

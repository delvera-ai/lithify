 import contextlib
 import datetime
 import logging
+import pickle
 import re
 import time
 import typing
@@ -2009,5 +2010,105 @@ class TestMockingSleep:
         assert mock_sleep.call_count == 1
 
 
+def _is_none(value: typing.Any) -> bool:
+    return value is None
+
+
+@tenacity.retry(
+    stop=tenacity.stop_after_attempt(2),
+    retry=tenacity.retry_if_exception_type(ValueError),
+)
+def _pickle_double(x: int) -> int:
+    return x * 2
+
+
+PICKLABLE_STRATEGIES: list[typing.Any] = [
+    tenacity.retry_if_exception_type(),
+    tenacity.retry_if_exception_type((ValueError, KeyError)),
+    tenacity.retry_if_not_exception_type(ValueError),
+    tenacity.retry_unless_exception_type(ValueError),
+    tenacity.retry_if_exception_message(message="boom"),
+    tenacity.retry_if_exception_message(match=r"bo+m"),
+    tenacity.retry_if_not_exception_message(message="boom"),
+    tenacity.retry_if_not_exception_message(match=r"bo+m"),
+    tenacity.retry_if_result(_is_none),
+    tenacity.retry_if_not_result(_is_none),
+    tenacity.retry_never,
+    tenacity.retry_always,
+    tenacity.retry_any(
+        tenacity.retry_if_exception_type(), tenacity.retry_if_result(_is_none)
+    ),
+    tenacity.retry_all(
+        tenacity.retry_if_exception_type(), tenacity.retry_if_result(_is_none)
+    ),
+    tenacity.stop_after_attempt(3),
+    tenacity.stop_after_delay(1),
+    tenacity.stop_before_delay(1),
+    tenacity.stop_never,
+    tenacity.stop_any(tenacity.stop_after_attempt(3)),
+    tenacity.stop_all(tenacity.stop_after_attempt(3)),
+    tenacity.wait_fixed(1),
+    tenacity.wait_none(),
+    tenacity.wait_exponential(),
+    tenacity.wait_random_exponential(),
+    tenacity.wait_exponential_jitter(),
+    tenacity.wait_incrementing(),
+    tenacity.wait_random(0, 1),
+    tenacity.wait_chain(tenacity.wait_fixed(1)),
+    tenacity.wait_combine(tenacity.wait_fixed(1), tenacity.wait_none()),
+]
+
+
+class TestPickling:
+    """Retrying objects and strategies must survive pickle (for multiprocessing)."""
+
+    @pytest.mark.parametrize("strategy", PICKLABLE_STRATEGIES)
+    def test_strategy_round_trip(self, strategy: typing.Any) -> None:
+        restored = pickle.loads(pickle.dumps(strategy))
+        assert type(restored) is type(strategy)
+        assert restored.__dict__.keys() == strategy.__dict__.keys()
+
+    def test_message_strategy_round_trip_keeps_behaviour(self) -> None:
+        strategy = pickle.loads(
+            pickle.dumps(tenacity.retry_if_not_exception_message(match=r"bo+m"))
+        )
+        state = RetryCallState(retry_object=Retrying(), fn=None, args=(), kwargs={})
+        state.set_exception((ValueError, ValueError("boom"), None))
+        assert strategy(state) is False
+        state.set_exception((ValueError, ValueError("other"), None))
+        assert strategy(state) is True
+
+    def test_default_retrying_round_trip(self) -> None:
+        restored = pickle.loads(pickle.dumps(Retrying()))
+        assert isinstance(restored, Retrying)
+        assert restored.statistics == {}
+
+    def test_used_retrying_round_trip_keeps_statistics(self) -> None:
+        def fail() -> None:
+            raise ValueError("boom")
+
+        r = Retrying(
+            stop=tenacity.stop_after_attempt(2),
+            retry=tenacity.retry_if_exception_type(ValueError),
+        )
+        with contextlib.suppress(RetryError):
+            r(fail)
+        assert r.statistics["attempt_number"] == 2
+
+        restored = pickle.loads(pickle.dumps(r))
+        assert restored.statistics == r.statistics
+        assert restored.statistics is not r.statistics
+        assert isinstance(restored.stop, tenacity.stop_after_attempt)
+
+        with contextlib.suppress(RetryError):
+            restored(fail)
+        assert restored.statistics["attempt_number"] == 2
+
+    def test_decorated_function_retry_round_trip(self) -> None:
+        restored: typing.Any = pickle.loads(pickle.dumps(_pickle_double.retry))
+        assert isinstance(restored, Retrying)
+        assert restored(_pickle_double.__wrapped__, 3) == 6
+
+

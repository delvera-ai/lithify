@@ -306,6 +306,20 @@ class BaseRetrying(ABC):
             f"name={self._name!r})>"
         )
 
+    def __getstate__(self) -> dict[str, t.Any]:
+        state = self.__dict__.copy()
+        # threading.local cannot be pickled: keep this thread's statistics and
+        # rebuild the local storage in __setstate__. Per-run iter_state is dropped.
+        del state["_local"]
+        state["_statistics"] = dict(self.statistics)
+        return state
+
+    def __setstate__(self, state: dict[str, t.Any]) -> None:
+        statistics = state.pop("_statistics")
+        self.__dict__.update(state)
+        self._local = threading.local()
+        self.statistics.update(statistics)
+

+@tenacity.retry(
+    stop=tenacity.stop_after_attempt(2),
+    retry=tenacity.retry_if_exception_type(ValueError),
+)
+def _pickle_double(x: int) -> int:
+    return x * 2
+
+
+def _pickle_is_boom(exc: BaseException) -> bool:
+    return str(exc) == "boom"
+
+
+class TestPickle(unittest.TestCase):
+    def test_retrying_round_trip(self) -> None:
+        original = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            wait=tenacity.wait_fixed(1),
+            retry=tenacity.retry_if_exception_type(ValueError),
+            name="pickled",
+        )
+        restored: typing.Any = pickle.loads(pickle.dumps(original))
+        assert isinstance(restored, Retrying)
+        assert str(restored) == "pickled"
+        assert restored.stop.max_attempt_number == 3
+        assert restored.wait.wait_fixed == 1
+        assert restored.statistics == {}
+
+    def test_used_retrying_keeps_statistics_and_still_runs(self) -> None:
+        calls: list[int] = []
+
+        def flaky() -> str:
+            calls.append(1)
+            if len(calls) < 3:
+                raise ValueError("retry me")
+            return "ok"
+
+        original = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            retry=tenacity.retry_if_exception_type(ValueError),
+        )
+        assert original(flaky) == "ok"
+
+        restored = pickle.loads(pickle.dumps(original))
+        assert restored.statistics["attempt_number"] == 3
+        assert restored(lambda: "again") == "again"
+        assert restored.statistics["attempt_number"] == 1
+
+    def test_decorated_function_round_trip(self) -> None:
+        restored = pickle.loads(pickle.dumps(_pickle_double))
+        assert restored(3) == 6
+
+    def test_retry_strategies_round_trip(self) -> None:
+        strategies: list[typing.Any] = [
+            tenacity.retry_if_exception_type(ValueError),
+            tenacity.retry_if_not_exception_type(ValueError),
+            tenacity.retry_unless_exception_type(ValueError),
+            tenacity.retry_if_exception_cause_type(ValueError),
+            tenacity.retry_if_exception_message(message="boom"),
+            tenacity.retry_if_exception_message(match="bo.*"),
+            tenacity.retry_if_not_exception_message(message="boom"),
+            tenacity.retry_if_not_exception_message(match="bo.*"),
+            tenacity.retry_if_result(bool),
+            tenacity.retry_if_not_result(bool),
+            tenacity.retry_if_exception(_pickle_is_boom),
+            tenacity.retry_any(
+                tenacity.retry_if_exception_type(), tenacity.retry_never
+            ),
+            tenacity.retry_all(
+                tenacity.retry_if_exception_type(), tenacity.retry_always
+            ),
+        ]
+        for strategy in strategies:
+            with self.subTest(strategy=strategy):
+                restored = pickle.loads(pickle.dumps(strategy))
+                assert type(restored) is type(strategy)
+
+    def test_retry_message_predicates_keep_behaviour(self) -> None:
+        rs = RetryCallState(None, None, (), {})  # type: ignore[arg-type]
+        rs.set_exception((ValueError, ValueError("boom"), None))
+        for strategy in [
+            tenacity.retry_if_exception_message(message="boom"),
+            tenacity.retry_if_exception_message(match="bo.*"),
+        ]:
+            restored = pickle.loads(pickle.dumps(strategy))
+            assert restored(rs) is True
+        restored_not = pickle.loads(
+            pickle.dumps(tenacity.retry_if_not_exception_message(message="boom"))
+        )
+        assert restored_not(rs) is False
+
+    def test_stop_and_wait_strategies_round_trip(self) -> None:
+        strategies: list[typing.Any] = [
+            tenacity.stop_after_attempt(2),
+            tenacity.stop_after_delay(1),
+            tenacity.stop_before_delay(1),
+            tenacity.stop_any(tenacity.stop_after_attempt(2)),
+            tenacity.stop_all(tenacity.stop_after_attempt(2)),
+            tenacity.stop_never,
+            tenacity.wait_fixed(1),
+            tenacity.wait_none(),
+            tenacity.wait_random(0, 1),
+            tenacity.wait_exponential(),
+            tenacity.wait_fixed(1) + tenacity.wait_fixed(2),
+        ]
+        for strategy in strategies:
+            with self.subTest(strategy=strategy):
+                restored = pickle.loads(pickle.dumps(strategy))
+                assert type(restored) is type(strategy)
+
+

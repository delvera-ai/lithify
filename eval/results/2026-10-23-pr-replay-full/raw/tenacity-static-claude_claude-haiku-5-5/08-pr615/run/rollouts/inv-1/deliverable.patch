+# Predicates are built from these module-level functions (via functools.partial)
+# rather than lambdas or closures, so that the retry strategies can be pickled.
+def _is_instance_of(
+    exception_types: type[BaseException] | tuple[type[BaseException], ...],
+    exception: BaseException,
+) -> bool:
+    return isinstance(exception, exception_types)
+
+
+def _is_not_instance_of(
+    exception_types: type[BaseException] | tuple[type[BaseException], ...],
+    exception: BaseException,
+) -> bool:
+    return not isinstance(exception, exception_types)
+
+
+def _is_message_equal(message: str, exception: BaseException) -> bool:
+    return message == str(exception)
+
+
+def _is_message_match(prog: re.Pattern[str], exception: BaseException) -> bool:
+    return bool(prog.match(str(exception)))
+
+
+def _negate(
+    predicate: typing.Callable[..., bool], *args: typing.Any, **kwargs: typing.Any
+) -> bool:
+    return not predicate(*args, **kwargs)
+
+

--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -291,6 +291,17 @@ class BaseRetrying(ABC):
             enabled=_first_set(enabled, self.enabled),
         )
 
+    def __getstate__(self) -> dict[str, t.Any]:
+        # threading.local cannot be pickled. Statistics and iter_state are per-run
+        # state, so only the configuration is kept and a restored object starts fresh.
+        state = self.__dict__.copy()
+        del state["_local"]
+        return state
+
+    def __setstate__(self, state: dict[str, t.Any]) -> None:
+        self.__dict__.update(state)
+        self._local = threading.local()
+
     def __str__(self) -> str:
         return self._name if self._name is not None else "<unknown>"
 

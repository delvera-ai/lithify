+class TestPickling(unittest.TestCase):
+    def _count_attempts(self, strategy: typing.Any, exc: BaseException) -> int:
+        attempts = 0
+
+        def fn() -> None:
+            nonlocal attempts
+            attempts += 1
+            raise exc
+
+        # A non-retried exception propagates raw, so it is suppressed by its own type.
+        with contextlib.suppress(RetryError, type(exc)):
+            Retrying(
+                retry=strategy,
+                stop=tenacity.stop_after_attempt(3),
+                wait=tenacity.wait_none(),
+            )(fn)
+        return attempts
+
+    def test_retrying_is_pickleable(self) -> None:
+        retrying = Retrying(
+            stop=tenacity.stop_after_attempt(2),
+            wait=tenacity.wait_fixed(0),
+            retry=tenacity.retry_if_exception_type(ValueError),
+            reraise=True,
+            name="flaky",
+        )
+        restored = pickle.loads(pickle.dumps(retrying))
+
+        self.assertIsInstance(restored, Retrying)
+        self.assertEqual("flaky", str(restored))
+        attempts = 0
+
+        def fn() -> None:
+            nonlocal attempts
+            attempts += 1
+            raise ValueError("boom")
+
+        with self.assertRaises(ValueError):
+            restored(fn)
+        self.assertEqual(2, attempts)
+
+    def test_used_retrying_is_pickleable(self) -> None:
+        retrying = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            wait=tenacity.wait_fixed(0),
+            retry=tenacity.retry_if_exception_type(ValueError),
+        )
+        calls = 0
+
+        def flaky() -> str:
+            nonlocal calls
+            calls += 1
+            if calls < 2:
+                raise ValueError("not yet")
+            return "done"
+
+        self.assertEqual("done", retrying(flaky))
+        self.assertEqual(2, retrying.statistics["attempt_number"])
+
+        restored = pickle.loads(pickle.dumps(retrying))
+        # Runtime statistics are per-run state, so the restored object starts fresh.
+        self.assertEqual({}, restored.statistics)
+        self.assertEqual("done", restored(flaky))
+        # flaky succeeds from its second call on, so the restored run needs one attempt.
+        self.assertEqual(1, restored.statistics["attempt_number"])
+
+    def test_decorated_function_retry_is_pickleable(self) -> None:
+        @retry(stop=tenacity.stop_after_attempt(2), wait=tenacity.wait_fixed(0))
+        def fn() -> int:
+            return 1
+
+        restored = pickle.loads(pickle.dumps(fn.retry))
+
+        self.assertIsInstance(restored, Retrying)
+        self.assertEqual(1, restored(lambda: 1))
+
+    def test_builtin_retry_strategies_are_pickleable(self) -> None:
+        cases: list[tuple[typing.Any, BaseException, int]] = [
+            (tenacity.retry_if_exception_type(ValueError), ValueError("boom"), 3),
+            (tenacity.retry_if_not_exception_type(ValueError), ValueError("boom"), 1),
+            (tenacity.retry_unless_exception_type(ValueError), ValueError("boom"), 1),
+            (
+                tenacity.retry_if_exception_message(message="boom"),
+                ValueError("boom"),
+                3,
+            ),
+            (tenacity.retry_if_exception_message(match="bo"), ValueError("boom"), 3),
+            (
+                tenacity.retry_if_not_exception_message(message="boom"),
+                ValueError("boom"),
+                1,
+            ),
+            (
+                tenacity.retry_if_not_exception_message(match="bo"),
+                ValueError("boom"),
+                1,
+            ),
+        ]
+        for strategy, exc, expected in cases:
+            with self.subTest(strategy=strategy):
+                restored = pickle.loads(pickle.dumps(strategy))
+                self.assertEqual(expected, self._count_attempts(restored, exc))
+
+    def test_builtin_stop_and_wait_strategies_are_pickleable(self) -> None:
+        strategies: list[typing.Any] = [
+            tenacity.stop_never,
+            tenacity.stop_after_attempt(2),
+            tenacity.stop_after_delay(1),
+            tenacity.stop_before_delay(1),
+            tenacity.wait_none(),
+            tenacity.wait_fixed(1),
+            tenacity.wait_random(0, 1),
+            tenacity.wait_incrementing(1),
+            tenacity.wait_exponential(),
+        ]
+        for strategy in strategies:
+            with self.subTest(strategy=strategy):
+                restored = pickle.loads(pickle.dumps(strategy))
+                self.assertIs(type(strategy), type(restored))
+
+

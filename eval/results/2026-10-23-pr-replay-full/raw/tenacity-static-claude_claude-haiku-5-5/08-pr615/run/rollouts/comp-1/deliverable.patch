+# Predicate helpers are module-level so that functools.partial objects built from
+# them pickle; lambdas and nested functions cannot be pickled.
+def _is_instance(
+    exception_types: type[BaseException] | tuple[type[BaseException], ...],
+    exception: BaseException,
+) -> bool:
+    return isinstance(exception, exception_types)
+
+
+def _is_not_instance(
+    exception_types: type[BaseException] | tuple[type[BaseException], ...],
+    exception: BaseException,
+) -> bool:
+    return not isinstance(exception, exception_types)
+
+
+def _message_equals(message: str, exception: BaseException) -> bool:
+    return message == str(exception)
+
+
+def _message_matches(prog: re.Pattern[str], exception: BaseException) -> bool:
+    return bool(prog.match(str(exception)))
+
+
+def _negate(
+    predicate: typing.Callable[..., bool], *args: typing.Any, **kwargs: typing.Any
+) -> bool:
+    return not predicate(*args, **kwargs)
+
+

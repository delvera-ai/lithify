@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    ``Retrying`` objects, including ones that have already run, and the built-in
+    retry strategies can now be pickled, so ``@retry``-decorated functions can be used
+    with ``multiprocessing`` (e.g. ``Pool.map``). A restored ``Retrying`` keeps the
+    statistics of the thread that pickled it.
diff --git a/tenacity/__init__.py b/tenacity/__init__.py
index 591f970..64bb6c2 100644
--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -291,6 +291,20 @@ class BaseRetrying(ABC):
             enabled=_first_set(enabled, self.enabled),
         )
 
+    def __getstate__(self) -> dict[str, t.Any]:
+        state = self.__dict__.copy()
+        # threading.local cannot be pickled; keep the statistics of the calling
+        # thread instead. iter_state is per-run and is rebuilt on demand.
+        del state["_local"]
+        state["_statistics"] = dict(self.statistics)
+        return state
+
+    def __setstate__(self, state: dict[str, t.Any]) -> None:
+        statistics = state.pop("_statistics")
+        self.__dict__.update(state)
+        self._local = threading.local()
+        self._local.statistics = statistics
+
     def __str__(self) -> str:
         return self._name if self._name is not None else "<unknown>"
 

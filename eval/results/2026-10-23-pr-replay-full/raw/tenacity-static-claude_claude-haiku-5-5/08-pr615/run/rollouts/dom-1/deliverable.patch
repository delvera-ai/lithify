+# Predicates below are module-level so that strategies built from them can be
+# pickled (lambdas and nested functions cannot be).
+def _is_instance_of(exception_types: typing.Any, exception: BaseException) -> bool:
+    return isinstance(exception, exception_types)
+
+
+def _is_not_instance_of(exception_types: typing.Any, exception: BaseException) -> bool:
+    return not isinstance(exception, exception_types)
+
+
+def _message_equals(message: str, exception: BaseException) -> bool:
+    return message == str(exception)
+
+
+def _message_matches(prog: re.Pattern[str], exception: BaseException) -> bool:
+    return bool(prog.match(str(exception)))
+
+
+def _negated(
+    predicate: typing.Callable[[BaseException], bool], exception: BaseException
+) -> bool:
+    return not predicate(exception)
+
+

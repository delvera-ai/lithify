+    def test_exponential_does_not_compute_power_past_max(self) -> None:
+        powers: list[typing.Any] = []
+
+        class CountingBase(int):
+            def __pow__(
+                self, other: typing.Any, modulo: typing.Any = None
+            ) -> typing.Any:
+                powers.append(other)
+                return int(self) ** int(other)
+
+        r = Retrying(wait=tenacity.wait_exponential(exp_base=CountingBase(2), max=40))
+        self.assertEqual(r.wait(make_retry_state(10_000, 0)), 40)
+        self.assertEqual(powers, [])

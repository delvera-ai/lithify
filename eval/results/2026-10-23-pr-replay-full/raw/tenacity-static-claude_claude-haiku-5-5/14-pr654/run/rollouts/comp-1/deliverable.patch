@@ -15,6 +15,7 @@
 # limitations under the License.
 
 import abc
+import math
 import random
 import typing
 import warnings
@@ -200,9 +201,26 @@ class wait_exponential(wait_base):
         self.max = _utils.to_seconds(max)
         self.exp_base = exp_base
 
+    def _cap_reached(self, exponent: int) -> bool:
+        # With an int base >= 2 and an int multiplier >= 1, the power is at least
+        # 2 ** exponent, so the result is above max once exponent exceeds
+        # log2(max / multiplier) + 1. Skipping the power there avoids an ever-growing
+        # int. Float arguments can overflow, so they keep the full computation.
+        return (
+            isinstance(self.exp_base, int)
+            and isinstance(self.multiplier, int)
+            and self.exp_base >= 2
+            and self.multiplier >= 1
+            and 0 < self.max < math.inf
+            and exponent > math.log2(self.max) - math.log2(self.multiplier) + 1
+        )
+
     def __call__(self, retry_state: "RetryCallState") -> float:
+        exponent = retry_state.attempt_number - 1
+        if self._cap_reached(exponent):
+            return max(max(0, self.min), self.max)
         try:
-            exp = self.exp_base ** (retry_state.attempt_number - 1)
+            exp = self.exp_base ** exponent
             result = self.multiplier * exp
         except OverflowError:
             return self.max

 import typing
 import warnings
 
@@ -201,13 +203,48 @@ class wait_exponential(wait_base):
         self.exp_base = exp_base
 
     def __call__(self, retry_state: "RetryCallState") -> float:
+        exponent = retry_state.attempt_number - 1
+        capped = self._capped_result(exponent)
+        if capped is not None:
+            return capped
         try:
-            exp = self.exp_base ** (retry_state.attempt_number - 1)
+            exp = self.exp_base ** exponent
             result = self.multiplier * exp
         except OverflowError:
             return self.max
         return max(max(0, self.min), min(result, self.max))
 
+    def _capped_result(self, exponent: int) -> typing.Optional[float]:
+        """Return the wait for an exponent past ``max``, without computing the power.
+
+        Returns None when the power has to be computed: the wait is not past ``max``,
+        or it is too close to a boundary to decide from logarithms.
+        """
+        base, multiplier, cap = self.exp_base, self.multiplier, self.max
+        for value in (base, multiplier, cap):
+            if not isinstance(value, (int, float)):
+                return None
+            if isinstance(value, float) and not math.isfinite(value):
+                return None
+        if not (base > 1 and multiplier > 0 and cap > 0):
+            return None
+
+        log_power = exponent * math.log(base)
+        log_cap = math.log(cap) - math.log(multiplier)
+        if isinstance(base, float) or isinstance(multiplier, float):
+            # The power (or its conversion to float) raises OverflowError past the float
+            # range, and the old code returned self.max unclamped in that case.
+            log_float_max = math.log(sys.float_info.max)
+            if abs(log_power - log_float_max) <= 1e-9 * (1 + log_float_max):
+                return None
+            if log_power > log_float_max:
+                return self.max
+        if abs(log_power - log_cap) <= 1e-9 * (1 + abs(log_cap)):
+            return None
+        if log_power > log_cap:
+            return max(max(0, self.min), cap)
+        return None
+
 

+    def test_exponential_does_not_compute_power_past_max(self) -> None:
+        pow_calls: typing.List[int] = []
+
+        class CountingBase(float):
+            def __pow__(self, other: typing.Any) -> typing.Any:
+                pow_calls.append(1)
+                return super().__pow__(other)
+
+        r = Retrying(wait=tenacity.wait_exponential(max=40, exp_base=CountingBase(2)))
+        self.assertEqual(r.wait(make_retry_state(100, 0)), 40)
+        self.assertEqual(pow_calls, [])

--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -15,6 +15,7 @@
 # limitations under the License.
 
 import abc
+import math
 import random
 import typing
 import warnings
@@ -200,7 +201,22 @@ class wait_exponential(wait_base):
         self.max = _utils.to_seconds(max)
         self.exp_base = exp_base
 
+    def _is_past_max(self, exponent: int) -> bool:
+        # True when multiplier * exp_base ** exponent is above max, so the power
+        # need not be computed. Checked in log space with a relative margin of
+        # 1e-9, so float rounding cannot flip the answer; only values within that
+        # margin of max still compute the power. Only applies when max >= max(0,
+        # min): then both exits of __call__ return max.
+        if not (self.exp_base > 1 and self.multiplier > 0):
+            return False
+        if not (0 < self.max and self.max >= max(0, self.min)):
+            return False
+        log_result = exponent * math.log(self.exp_base) + math.log(self.multiplier)
+        return log_result >= math.log(self.max) + 1e-9
+
     def __call__(self, retry_state: "RetryCallState") -> float:
+        if self._is_past_max(retry_state.attempt_number - 1):
+            return self.max
         try:
             exp = self.exp_base ** (retry_state.attempt_number - 1)
             result = self.multiplier * exp

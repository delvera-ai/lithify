+    def test_stats_delay_since_first_attempt_present_from_start(self) -> None:
+        seen: list[typing.Any] = []
+
+        def _record(retry_state: RetryCallState) -> None:
+            seen.append(retry_state.retry_object.statistics["delay_since_first_attempt"])
+
+        retrying = Retrying(
+            stop=tenacity.stop_after_attempt(2),
+            wait=tenacity.wait_fixed(0),
+            before=_record,
+            retry=tenacity.retry_if_exception_type(ValueError),
+        )
+
+        def _fail() -> None:
+            raise ValueError(42)
+
+        with contextlib.suppress(RetryError):
+            retrying(_fail)
+        self.assertEqual([0, mock.ANY], seen)
+
 

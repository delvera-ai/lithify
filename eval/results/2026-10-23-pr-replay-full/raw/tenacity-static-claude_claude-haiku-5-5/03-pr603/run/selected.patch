+    def test_stats_delay_since_first_attempt_present_from_start(self) -> None:
+        seen: list[typing.Any] = []
+
+        def _record(retry_state: RetryCallState) -> None:
+            stats = retry_state.retry_object.statistics
+            seen.append(stats["delay_since_first_attempt"])
+
+        @retry(stop=tenacity.stop_after_attempt(2), before=_record)
+        def _foobar() -> None:
+            raise ValueError(42)
+
+        with contextlib.suppress(tenacity.RetryError):
+            _foobar()
+        self.assertEqual(0, seen[0])

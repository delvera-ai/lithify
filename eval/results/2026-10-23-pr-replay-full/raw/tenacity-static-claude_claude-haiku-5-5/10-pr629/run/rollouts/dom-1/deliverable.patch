@@ -0,0 +1,11 @@
+---
+features:
+  - |
+    ``wait_exponential_jitter`` accepts a ``multiplier`` argument (default 1),
+    matching ``wait_exponential``. It is the base wait that ``initial`` used to set.
+deprecations:
+  - |
+    The ``initial`` argument of ``wait_exponential_jitter`` is deprecated in favour
+    of ``multiplier``. Passing it, by keyword or positionally, still works but emits
+    a ``DeprecationWarning``. Passing both ``initial`` and ``multiplier`` raises
+    ``ValueError``. The ``initial`` attribute is still readable.
diff --git a/tenacity/wait.py b/tenacity/wait.py
index 92fa1f4..62c0836 100644
--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -17,6 +17,7 @@
 import abc
 import random
 import typing
+import warnings
 
 from tenacity import _utils
 
@@ -240,34 +241,54 @@ class wait_random_exponential(wait_exponential):
 class wait_exponential_jitter(wait_base):
     """Wait strategy that applies exponential backoff and jitter.
 
-    It allows for a customized initial wait, maximum wait, jitter and minimum.
+    It allows for a customized multiplier, maximum wait, jitter and minimum.
 
     This implements the strategy described here:
     https://cloud.google.com/storage/docs/retry-strategy
 
-    The wait time is max(min, min(initial * 2**n + random.uniform(0, jitter), maximum))
+    The wait time is
+    max(min, min(multiplier * 2**n + random.uniform(0, jitter), maximum))
     where n is the retry count.
+
+    The ``initial`` argument is deprecated in favour of ``multiplier``; it still
+    works but emits a DeprecationWarning, and passing both raises ValueError.
     """
 
     def __init__(
         self,
-        initial: float = 1,
+        initial: float | None = None,
         max: _utils.time_unit_type = _utils.MAX_WAIT,
         exp_base: float = 2,
         jitter: _utils.time_unit_type = 1,
         min: _utils.time_unit_type = 0,
+        multiplier: float | None = None,
     ) -> None:
-        self.initial = initial
+        if initial is not None:
+            if multiplier is not None:
+                raise ValueError("pass either 'multiplier' or 'initial', not both")
+            warnings.warn(
+                "wait_exponential_jitter 'initial' is deprecated, "
+                "use 'multiplier' instead",
+                DeprecationWarning,
+                stacklevel=2,
+            )
+            multiplier = initial
+        self.multiplier = 1 if multiplier is None else multiplier
         self.max = _utils.to_seconds(max)
         self.exp_base = exp_base
         self.jitter = _utils.to_seconds(jitter)
         self.min = _utils.to_seconds(min)
 
+    @property
+    def initial(self) -> float:
+        """Read-only alias of ``multiplier``, for code that reads the old name."""
+        return self.multiplier
+
     def __call__(self, retry_state: "RetryCallState") -> float:
         jitter = random.uniform(0, self.jitter)
         try:
             exp = self.exp_base ** (retry_state.attempt_number - 1)
-            result = self.initial * exp + jitter
+            result = self.multiplier * exp + jitter
         except OverflowError:
             result = self.max
         return max(max(0, self.min), min(result, self.max))

--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -109,3 +109,20 @@ def wrap_to_async_func(
         return call(*args, **kwargs)
 
     return inner
+
+
+def flatten_operands(
+    kinds: tuple[type, ...], operands: tuple[typing.Any, ...]
+) -> tuple[typing.Any, ...]:
+    """Replace each operand whose exact type is in ``kinds`` by its ``retries``.
+
+    Used by the ``|`` and ``&`` operators so that a chain builds one container.
+    Subclasses are left alone because they may override ``__call__``.
+    """
+    members: list[typing.Any] = []
+    for operand in operands:
+        if type(operand) in kinds:
+            members.extend(operand.retries)
+        else:
+            members.append(operand)
+    return tuple(members)

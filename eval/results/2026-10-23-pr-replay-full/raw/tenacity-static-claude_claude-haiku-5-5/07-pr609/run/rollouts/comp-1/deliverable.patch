@@ -0,0 +1,7 @@
+---
+other:
+  - |
+    Chaining retry conditions with ``|`` or ``&`` now builds one ``retry_any`` or
+    ``retry_all`` container, so ``a | b | c`` holds ``a``, ``b`` and ``c`` in its
+    ``retries`` instead of nesting them. This applies to the async retry strategies
+    too. The retry behaviour is unchanged.
diff --git a/tenacity/_utils.py b/tenacity/_utils.py
index 6a12678..5211c27 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -109,3 +109,21 @@ def wrap_to_async_func(
         return call(*args, **kwargs)
 
     return inner
+
+
+def merge_operands(
+    kinds: tuple[type, ...], *operands: typing.Any
+) -> tuple[typing.Any, ...]:
+    """Members for a new container built from ``operands``.
+
+    An operand whose exact type is in ``kinds`` contributes its own members, so
+    ``a | b | c`` yields one container rather than nested ones. Exact types only:
+    a subclass may override ``__call__``, so its members must stay grouped.
+    """
+    members: list[typing.Any] = []
+    for operand in operands:
+        if type(operand) in kinds:
+            members.extend(operand.retries)
+        else:
+            members.append(operand)
+    return tuple(members)

+def flatten_operands(
+    containers: tuple[type, ...], *operands: typing.Any
+) -> tuple[typing.Any, ...]:
+    """Splice the members of container operands in place, so `a | b | c` is flat.
+
+    Only instances of exactly one of `containers` are spliced: a subclass may
+    override `__call__`, so it must stay a member of its own.
+    """
+    members: list[typing.Any] = []
+    for operand in operands:
+        if type(operand) in containers:
+            members.extend(operand.retries)
+        else:
+            members.append(operand)
+    return tuple(members)
+

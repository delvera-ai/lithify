@@ -0,0 +1,6 @@
+---
+other:
+  - |
+    Chaining retry conditions with ``|`` or ``&`` now builds a single ``retry_any`` or
+    ``retry_all`` whose ``retries`` holds every member, instead of nesting one container
+    per operator. The combined condition's behaviour is unchanged.
diff --git a/tenacity/_utils.py b/tenacity/_utils.py
index 6a12678..a0c901d 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -109,3 +109,18 @@ def wrap_to_async_func(
         return call(*args, **kwargs)
 
     return inner
+
+
+def flatten_retries(kind: type, *operands: typing.Any) -> list[typing.Any]:
+    """Return the members for ``kind(*...)``, splicing in operands of exactly ``kind``.
+
+    Only the exact type is spliced: a subclass may override ``__call__``, so it is kept
+    as a single member.
+    """
+    members: list[typing.Any] = []
+    for operand in operands:
+        if type(operand) is kind:
+            members.extend(operand.retries)
+        else:
+            members.append(operand)
+    return members

diff --git a/releasenotes/notes/after-log-none-seconds-since-start-2745525d1ed582e5.yaml b/releasenotes/notes/after-log-none-seconds-since-start-2745525d1ed582e5.yaml
new file mode 100644
index 0000000..deb9fc3
--- /dev/null
+++ b/releasenotes/notes/after-log-none-seconds-since-start-2745525d1ed582e5.yaml
@@ -0,0 +1,5 @@
+---
+fixes:
+  - |
+    :func:`after_log` no longer raises ``TypeError`` when ``retry_state.seconds_since_start``
+    is ``None``. The log message is now emitted with ``?`` in place of the elapsed seconds.
diff --git a/tenacity/after.py b/tenacity/after.py
index a4b8922..7732146 100644
--- a/tenacity/after.py
+++ b/tenacity/after.py
@@ -39,10 +39,14 @@ def after_log(
             fn_name = "<unknown>"
         else:
             fn_name = _utils.get_callback_name(retry_state.fn)
+        if retry_state.seconds_since_start is None:
+            elapsed = "?"
+        else:
+            elapsed = sec_format % retry_state.seconds_since_start
         logger.log(
             log_level,
             f"Finished call to '{fn_name}' "
-            f"after {sec_format % retry_state.seconds_since_start}(s), "
+            f"after {elapsed}(s), "
             f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
         )
 
diff --git a/tests/test_after.py b/tests/test_after.py
index 25d8a7c..ead1a74 100644
--- a/tests/test_after.py
+++ b/tests/test_after.py
@@ -74,3 +74,21 @@ class TestAfterLogFormat(unittest.TestCase):
             f"after {sec_format % retry_state.seconds_since_start}(s), "
             f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
         )
+
+    def test_03_seconds_since_start_is_none(self) -> None:
+        """Test log formatting when no outcome timestamp has been set."""
+        log = unittest.mock.MagicMock(spec="logging.Logger.log")
+        logger = unittest.mock.MagicMock(spec="logging.Logger", log=log)
+
+        retry_state = test_tenacity.make_retry_state(self.previous_attempt_number, 0.1)
+        retry_state.outcome_timestamp = None
+        assert retry_state.seconds_since_start is None
+
+        fun = after_log(logger=logger, log_level=self.log_level)
+        fun(retry_state)
+        log.assert_called_once_with(
+            self.log_level,
+            "Finished call to '<unknown>' "
+            "after ?(s), "
+            f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
+        )

@@ -3,6 +3,8 @@ import random
 import unittest.mock
 
 from tenacity import (
+    RetryCallState,
+    Retrying,
     _utils,
     after_log,
 )
@@ -74,3 +76,22 @@ class TestAfterLogFormat(unittest.TestCase):
             f"after {sec_format % retry_state.seconds_since_start}(s), "
             f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
         )
+
+    def test_03_seconds_since_start_unset(self) -> None:
+        """Test log formatting when the outcome timestamp is not set yet."""
+        log = unittest.mock.MagicMock(spec="logging.Logger.log")
+        logger = unittest.mock.MagicMock(spec="logging.Logger", log=log)
+
+        retry_state = RetryCallState(Retrying(), None, (), {})
+        retry_state.attempt_number = self.previous_attempt_number
+        assert retry_state.seconds_since_start is None
+
+        fun = after_log(logger=logger, log_level=self.log_level)
+        fun(retry_state)
+        log.assert_called_once_with(
+            self.log_level,
+            "Finished call to '<unknown>' "
+            "after ?(s), "
+            f"this was the {_utils.to_ordinal(self.previous_attempt_number)} time "
+            "calling it.",
+        )

diff --git a/releasenotes/notes/after-log-unset-seconds-since-start-4b001996ec37c458.yaml b/releasenotes/notes/after-log-unset-seconds-since-start-4b001996ec37c458.yaml
new file mode 100644
index 0000000..3c55d4e
--- /dev/null
+++ b/releasenotes/notes/after-log-unset-seconds-since-start-4b001996ec37c458.yaml
@@ -0,0 +1,6 @@
+---
+fixes:
+  - |
+    ``after_log`` no longer raises ``TypeError`` when ``retry_state.seconds_since_start``
+    is ``None``. The log message is still emitted, showing ``?`` in place of the elapsed
+    seconds.
diff --git a/tenacity/after.py b/tenacity/after.py
index a4b8922..7732146 100644
--- a/tenacity/after.py
+++ b/tenacity/after.py
@@ -39,10 +39,14 @@ def after_log(
             fn_name = "<unknown>"
         else:
             fn_name = _utils.get_callback_name(retry_state.fn)
+        if retry_state.seconds_since_start is None:
+            elapsed = "?"
+        else:
+            elapsed = sec_format % retry_state.seconds_since_start
         logger.log(
             log_level,
             f"Finished call to '{fn_name}' "
-            f"after {sec_format % retry_state.seconds_since_start}(s), "
+            f"after {elapsed}(s), "
             f"this was the {_utils.to_ordinal(retry_state.attempt_number)} time calling it.",
         )
 

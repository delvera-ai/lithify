+def optional_import_names(tree: ast.Module) -> set[str]:
+    """Names bound to None in an `except ImportError` handler at module level."""
+    names: set[str] = set()
+    for node in tree.body:
+        if not isinstance(node, ast.Try):
+            continue
+        for h in node.handlers:
+            for st in h.body:
+                if (
+                    isinstance(st, ast.Assign)
+                    and isinstance(st.value, ast.Constant)
+                    and st.value.value is None
+                ):
+                    names.update(t.id for t in st.targets if isinstance(t, ast.Name))
+    return names
+
+
+def check_optional_imports(path: str, src: str, changed: set[int]) -> list[str]:
+    """mypy proxy: a None/truthiness test of an optional import in a condition."""
+    try:
+        tree = ast.parse(src)
+    except SyntaxError:
+        return []
+    names = optional_import_names(tree)
+    if not names:
+        return []
+    conds: list[ast.expr] = []
+    for node in ast.walk(tree):
+        if isinstance(node, (ast.If, ast.While, ast.IfExp, ast.Assert)):
+            conds.append(node.test)
+        elif isinstance(node, ast.BoolOp):
+            conds.extend(node.values)
+        elif isinstance(node, ast.UnaryOp) and isinstance(node.op, ast.Not):
+            conds.append(node.operand)
+        elif isinstance(node, ast.comprehension):
+            conds.extend(node.ifs)
+    errs: list[str] = []

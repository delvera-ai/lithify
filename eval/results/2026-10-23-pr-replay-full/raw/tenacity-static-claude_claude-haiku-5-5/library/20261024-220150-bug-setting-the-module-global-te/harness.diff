+        name = None
+        if isinstance(c, ast.Name):
+            name = c.id
+        elif (
+            isinstance(c, ast.Compare)
+            and isinstance(c.left, ast.Name)
+            and len(c.ops) == 1
+            and isinstance(c.ops[0], (ast.Is, ast.IsNot))
+            and isinstance(c.comparators[0], ast.Constant)
+            and c.comparators[0].value is None
+        ):
+            name = c.left.id
+        if name in names:

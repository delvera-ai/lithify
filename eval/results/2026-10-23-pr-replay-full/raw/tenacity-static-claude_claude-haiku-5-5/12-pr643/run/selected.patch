index c6d2786..66725df 100644
--- a/tests/test_asyncio.py
+++ b/tests/test_asyncio.py
@@ -176,6 +176,24 @@ class TestAsyncEnabled(unittest.TestCase):
             await always_fails()
         assert call_count == 1
 
+    @asynctest
+    async def test_enabled_false_iterator_propagates_exception_unchanged(
+        self,
+    ) -> None:
+        """When enabled=False, `async for` runs the body once and re-raises."""
+        call_count = 0
+        error = ValueError("fail")
+
+        with pytest.raises(ValueError) as exc_info:
+            async for attempt in tasyncio.AsyncRetrying(
+                enabled=False, stop=stop_after_attempt(3)
+            ):
+                with attempt:
+                    call_count += 1
+                    raise error
+        assert exc_info.value is error
+        assert call_count == 1
+
 

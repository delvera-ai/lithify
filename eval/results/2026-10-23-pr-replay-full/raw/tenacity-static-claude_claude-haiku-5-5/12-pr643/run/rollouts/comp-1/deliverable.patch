+++ b/tests/test_asyncio.py
@@ -176,6 +176,36 @@ class TestAsyncEnabled(unittest.TestCase):
             await always_fails()
         assert call_count == 1
 
+    @asynctest
+    async def test_enabled_false_async_iterator_runs_body_once(self) -> None:
+        """When enabled=False, the async iterator form runs the body once."""
+        call_count = 0
+        error = ValueError("fail")
+        retrying = tasyncio.AsyncRetrying(
+            enabled=False, stop=stop_after_attempt(3)
+        )
+
+        with pytest.raises(ValueError, match="fail") as exc_info:
+            async for attempt in retrying:
+                with attempt:
+                    call_count += 1
+                    raise error
+        assert exc_info.value is error
+        assert call_count == 1
+
+    @asynctest
+    async def test_enabled_false_async_iterator_success_runs_body_once(self) -> None:
+        """When enabled=False, a successful async iterator body runs once."""
+        call_count = 0
+        retrying = tasyncio.AsyncRetrying(
+            enabled=False, stop=stop_after_attempt(3)
+        )
+
+        async for attempt in retrying:
+            with attempt:
+                call_count += 1
+        assert call_count == 1
+
 

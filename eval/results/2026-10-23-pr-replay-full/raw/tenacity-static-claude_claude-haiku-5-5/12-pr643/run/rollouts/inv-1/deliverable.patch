@@ -176,6 +176,21 @@ class TestAsyncEnabled(unittest.TestCase):
             await always_fails()
         assert call_count == 1
 
+    @asynctest
+    async def test_enabled_false_async_iterator_runs_once(self) -> None:
+        """When enabled=False, `async for` runs the body once and re-raises."""
+        call_count = 0
+        error = ValueError("fail")
+
+        retrying = AsyncRetrying(enabled=False, stop=stop_after_attempt(3))
+        with pytest.raises(ValueError) as exc_info:
+            async for attempt in retrying:
+                with attempt:
+                    call_count += 1
+                    raise error
+        assert call_count == 1
+        assert exc_info.value is error
+
 

+    def test_retry_if_exception_cause_type_cycle_returns_direct(self) -> None:
+        # Call the strategy directly in a thread so a hang fails the test
+        # instead of stalling the whole run.
+        exc = ValueError("self cause")
+        exc.__cause__ = exc
+        rs = make_retry_state(1, 0)
+        rs.set_exception((type(exc), exc, None))
+        strategy = tenacity.retry_if_exception_cause_type(IOError)
+        result: list[bool] = []
+        thread = threading.Thread(
+            target=lambda: result.append(strategy(rs)), daemon=True
+        )
+        thread.start()
+        thread.join(timeout=5)
+        self.assertFalse(thread.is_alive())
+        self.assertEqual(result, [False])
+
+    def test_retry_if_exception_cause_type_self_cause_terminates(self) -> None:
+        # `raise e from e` leaves e.__cause__ pointing at e itself.
+        def raise_self_cause() -> typing.Any:
+            e = ValueError("self cause")
+            e.__cause__ = e
+            raise e
+
+        retrying = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            retry=tenacity.retry_if_exception_cause_type(IOError),
+            reraise=True,
+        )
+        with self.assertRaises(ValueError):
+            retrying(raise_self_cause)
+
+    def test_retry_if_exception_cause_type_mutual_cause_terminates(self) -> None:
+        # Two exceptions whose causes point at each other, no matching type.
+        def raise_mutual_cause() -> typing.Any:
+            a = ValueError("a")
+            b = KeyError("b")
+            a.__cause__ = b
+            b.__cause__ = a
+            raise a
+
+        retrying = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            retry=tenacity.retry_if_exception_cause_type(IOError),
+            reraise=True,
+        )
+        with self.assertRaises(ValueError):
+            retrying(raise_mutual_cause)
+
+    def test_retry_if_exception_cause_type_match_inside_cycle(self) -> None:
+        # A matching cause is still found when the chain also contains a cycle.
+        attempts = []
+
+        def raise_cycle_with_match() -> typing.Any:
+            attempts.append(1)
+            a = ValueError("a")
+            b = IOError("b")
+            a.__cause__ = b
+            b.__cause__ = a
+            raise a
+
+        retrying = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            retry=tenacity.retry_if_exception_cause_type(IOError),
+            reraise=True,
+        )
+        with self.assertRaises(ValueError):
+            retrying(raise_cycle_with_match)
+        self.assertEqual(len(attempts), 3)
+

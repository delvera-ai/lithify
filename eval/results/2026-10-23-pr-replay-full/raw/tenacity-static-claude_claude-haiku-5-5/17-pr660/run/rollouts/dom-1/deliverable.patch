index 0000000..c3a1e98
--- /dev/null
+++ b/releasenotes/notes/fix-retry-if-exception-cause-type-cycle-2c9d4e1a7b6f3085.yaml
@@ -0,0 +1,8 @@
+---
+fixes:
+  - |
+    Fix ``retry_if_exception_cause_type`` hanging forever (100% CPU) when the
+    exception's ``__cause__`` chain is cyclic, for example ``raise e from e`` or
+    two exceptions whose causes point at each other. The cause walk now stops
+    when it revisits an exception, and still matches a cause of the wanted type
+    anywhere in a non-cyclic chain.
diff --git a/tenacity/retry.py b/tenacity/retry.py
index e59f4c0..23feaf4 100644
--- a/tenacity/retry.py
+++ b/tenacity/retry.py
@@ -177,7 +177,10 @@ class retry_if_exception_cause_type(retry_base):
 
         if retry_state.outcome.failed:
             exc = retry_state.outcome.exception()
-            while exc is not None:
+            # Track visited exceptions so a cyclic __cause__ chain terminates.
+            seen: set[int] = set()
+            while exc is not None and id(exc) not in seen:
+                seen.add(id(exc))
                 if isinstance(exc.__cause__, self.exception_cause_types):
                     return True
                 exc = exc.__cause__

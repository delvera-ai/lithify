diff --git a/releasenotes/notes/retry-if-exception-cause-type-cycle-21a7c9c3ea330386.yaml b/releasenotes/notes/retry-if-exception-cause-type-cycle-21a7c9c3ea330386.yaml
new file mode 100644
index 0000000..4d1cdfa
--- /dev/null
+++ b/releasenotes/notes/retry-if-exception-cause-type-cycle-21a7c9c3ea330386.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    ``retry_if_exception_cause_type`` no longer hangs when an exception's
+    ``__cause__`` chain is cyclic (e.g. ``raise e from e``). The chain walk now stops at
+    an exception it has already visited, and still matches a cause type found anywhere
+    earlier in the chain.
diff --git a/tenacity/retry.py b/tenacity/retry.py
index e59f4c0..23feaf4 100644
--- a/tenacity/retry.py
+++ b/tenacity/retry.py
@@ -177,7 +177,10 @@ class retry_if_exception_cause_type(retry_base):
 
         if retry_state.outcome.failed:
             exc = retry_state.outcome.exception()
-            while exc is not None:
+            # Track visited exceptions so a cyclic __cause__ chain terminates.
+            seen: set[int] = set()
+            while exc is not None and id(exc) not in seen:
+                seen.add(id(exc))
                 if isinstance(exc.__cause__, self.exception_cause_types):
                     return True
                 exc = exc.__cause__
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index ba44b0c..6be169a 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1441,6 +1441,38 @@ class TestDecoratorWrapper(unittest.TestCase):
         except NameError:
             pass
 
+    def test_retry_if_exception_cause_type_self_cycle(self) -> None:
+        # `raise e from e` sets e.__cause__ to e itself.
+        error = ValueError("boom")
+        error.__cause__ = error
+
+        def fn() -> None:
+            raise error
+
+        retrying = Retrying(
+            retry=tenacity.retry_if_exception_cause_type(NameError),
+            stop=tenacity.stop_after_attempt(3),
+        )
+        with self.assertRaises(ValueError):
+            retrying(fn)
+
+    def test_retry_if_exception_cause_type_mutual_cycle(self) -> None:
+        # Two exceptions whose causes point at each other.
+        first = ValueError("first")
+        second = ValueError("second")
+        first.__cause__ = second
+        second.__cause__ = first
+
+        def fn() -> None:
+            raise first
+
+        retrying = Retrying(
+            retry=tenacity.retry_if_exception_cause_type(NameError),
+            stop=tenacity.stop_after_attempt(3),
+        )
+        with self.assertRaises(ValueError):
+            retrying(fn)
+
     def test_retry_preserves_argument_defaults(self) -> None:
         def function_with_defaults(a: int = 1) -> int:
             return a

@@ -2369,5 +2369,18 @@ class TestPickle(unittest.TestCase):
         assert calls == 3
 
 
+class TestTornadoAvailabilityAtDecoration(unittest.TestCase):
+    def test_retry_decorates_sync_function_when_tornado_global_is_none(self) -> None:
+        # Tests hide tornado by setting the module global to None; decoration
+        # must read that live value rather than the import-time snapshot.
+        with mock.patch.object(tenacity, "tornado", None):
+
+            @retry(stop=tenacity.stop_after_attempt(2))
+            def succeed() -> str:
+                return "ok"
+
+        assert succeed() == "ok"
+
+
 if __name__ == "__main__":
     unittest.main()

+class TestTornadoUnavailableAtDecoration(unittest.TestCase):
+    def test_retry_when_tornado_global_is_none(self) -> None:
+        # Tests exercise the non-tornado path by setting the module global to None
+        # rather than uninstalling tornado; decoration must read it at call time.
+        original = tenacity.tornado
+        tenacity.tornado = None  # type: ignore[assignment]
+        try:
+
+            @tenacity.retry
+            def retryable() -> None:
+                pass
+
+        finally:
+            tenacity.tornado = original
+
+        assert type(retryable.retry) is tenacity.Retrying
+
+
 if __name__ == "__main__":
     unittest.main()

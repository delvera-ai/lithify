+++ b/releasenotes/notes/tornado-global-none-decoration-6ba344291b11c6ea.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    Decorating a function with ``@retry`` no longer raises
+    ``AttributeError: 'NoneType' object has no attribute 'gen'`` after
+    ``tenacity.tornado`` has been set to ``None``. Whether tornado is
+    available is now read from the module at decoration time.
diff --git a/tenacity/__init__.py b/tenacity/__init__.py
index 51925ef..bbd8e0f 100644
--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -94,6 +94,12 @@ except ImportError:
 # Keep the availability answer in a plain bool instead.
 _HAS_TORNADO = tornado is not None
 
+
+def _has_tornado() -> bool:
+    # Read the live `tornado` global, so tests that set it to None take effect.
+    return tornado is not None
+
+
 if t.TYPE_CHECKING:
     if sys.version_info >= (3, 11):
         from typing import Self
@@ -786,7 +792,7 @@ def retry(*dargs: t.Any, **dkw: t.Any) -> t.Any:
         ):
             r = AsyncRetrying(*dargs, **dkw)
         elif (
-            _HAS_TORNADO
+            _has_tornado()
             and hasattr(tornado.gen, "is_coroutine_function")
             and tornado.gen.is_coroutine_function(f)
         ):

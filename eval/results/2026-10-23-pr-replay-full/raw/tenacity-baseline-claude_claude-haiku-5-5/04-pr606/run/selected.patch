diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 0645a83..d7caca2 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -743,6 +743,40 @@ class TestRetryConditions(unittest.TestCase):
         self.assertFalse(r(tenacity.Future.construct(1, 2.2, False)))
         self.assertFalse(r(tenacity.Future.construct(1, 42, True)))
 
+    def test_retry_composed_with_plain_callable(self) -> None:
+        # Plain callables in a composed strategy receive the RetryCallState.
+        def is_bad(retry_state: tenacity.RetryCallState) -> bool:
+            assert retry_state.outcome is not None
+            exc = retry_state.outcome.exception()
+            return exc is not None and "bad" in str(exc)
+
+        retry_or = tenacity.retry_if_exception_type(IOError) | is_bad
+        retry_or_reversed = is_bad | tenacity.retry_if_exception_type(IOError)
+        retry_and = tenacity.retry_if_exception_type(IOError) & is_bad
+        retry_and_reversed = is_bad & tenacity.retry_if_exception_type(IOError)
+
+        def r(retry: tenacity.retry_base, exc: BaseException) -> bool:
+            retry_state = make_retry_state(
+                1, 1.0, last_result=tenacity.Future.construct(1, exc, True)
+            )
+            return retry(retry_state)
+
+        self.assertIsInstance(retry_or, tenacity.retry_any)
+        self.assertIsInstance(retry_or_reversed, tenacity.retry_any)
+        self.assertIsInstance(retry_and, tenacity.retry_all)
+        self.assertIsInstance(retry_and_reversed, tenacity.retry_all)
+
+        for retry in (retry_or, retry_or_reversed):
+            self.assertTrue(r(retry, IOError("bad")))
+            self.assertTrue(r(retry, IOError("fine")))
+            self.assertTrue(r(retry, ValueError("bad")))
+            self.assertFalse(r(retry, ValueError("fine")))
+
+        for retry in (retry_and, retry_and_reversed):
+            self.assertTrue(r(retry, IOError("bad")))
+            self.assertFalse(r(retry, IOError("fine")))
+            self.assertFalse(r(retry, ValueError("bad")))
+

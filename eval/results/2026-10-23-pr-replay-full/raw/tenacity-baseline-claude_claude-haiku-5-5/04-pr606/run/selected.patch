+    @asynctest
+    async def test_retry_with_plain_callable_composition(self) -> None:
+        async def test(retry_strategy: tenacity.retry_base) -> int:
+            attempts = 0
+            async for attempt in tasyncio.AsyncRetrying(retry=retry_strategy):
+                with attempt:
+                    attempts += 1
+                attempt.retry_state.set_result(attempts)
+            return attempts
+
+        # Plain callables in a composed strategy receive the RetryCallState.
+        def gt_0(retry_state: tenacity.RetryCallState) -> bool:
+            assert retry_state.outcome is not None
+            return retry_state.outcome.result() > 0
+
+        async def lt_3(x: float) -> bool:
+            return x < 3
+
+        def is_five(retry_state: tenacity.RetryCallState) -> bool:
+            assert retry_state.outcome is not None
+            return retry_state.outcome.result() == 5
+
+        # "|" retries while x < 3 or x == 5, so it stops at 3.
+        self.assertEqual(3, await test(tasyncio.retry_if_result(lt_3) | is_five))
+        self.assertEqual(3, await test(is_five | tasyncio.retry_if_result(lt_3)))
+        # "&" retries while x < 3 and x > 0, so it stops at 3.
+        self.assertEqual(3, await test(tasyncio.retry_if_result(lt_3) & gt_0))
+        self.assertEqual(3, await test(gt_0 & tasyncio.retry_if_result(lt_3)))
+

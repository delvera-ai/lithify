+    def test_exponential_multiplier_ratio_underflows_to_zero(self) -> None:
+        # max / multiplier underflows to 0.0; this must cap rather than
+        # raise ValueError from math.log(0).
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=1e300, max=1e-100))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 1e-100)
+        self.assertEqual(r.wait(make_retry_state(2, 0)), 1e-100)
+        self.assertEqual(r.wait(make_retry_state(20, 0)), 1e-100)
+
+    def test_exponential_infinite_multiplier(self) -> None:
+        r = Retrying(wait=tenacity.wait_exponential(multiplier=math.inf, max=10))
+        self.assertEqual(r.wait(make_retry_state(1, 0)), 10)
+        self.assertEqual(r.wait(make_retry_state(5, 0)), 10)
+

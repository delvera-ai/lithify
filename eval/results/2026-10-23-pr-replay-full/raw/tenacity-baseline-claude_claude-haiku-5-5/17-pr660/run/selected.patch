diff --git a/tenacity/retry.py b/tenacity/retry.py
index e59f4c0..00336d0 100644
--- a/tenacity/retry.py
+++ b/tenacity/retry.py
@@ -177,7 +177,10 @@ class retry_if_exception_cause_type(retry_base):
 
         if retry_state.outcome.failed:
             exc = retry_state.outcome.exception()
-            while exc is not None:
+            # Track visited exceptions so that cyclic cause chains terminate.
+            seen: set[int] = set()
+            while exc is not None and id(exc) not in seen:
+                seen.add(id(exc))
                 if isinstance(exc.__cause__, self.exception_cause_types):
                     return True
                 exc = exc.__cause__
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index ba44b0c..3e9fe31 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1441,6 +1441,55 @@ class TestDecoratorWrapper(unittest.TestCase):
         except NameError:
             pass
 
+    def test_retry_if_exception_cause_type_cyclic_cause(self) -> None:
+        """A cyclic __cause__ chain terminates instead of looping forever."""
+
+        @retry(
+            retry=tenacity.retry_if_exception_cause_type(NameError),
+            stop=tenacity.stop_after_attempt(3),
+        )
+        def self_cause() -> None:
+            e = OSError("self cause")
+            e.__cause__ = e
+            raise e
+
+        with pytest.raises(OSError):
+            self_cause()
+        assert self_cause.statistics["attempt_number"] == 1
+
+        @retry(
+            retry=tenacity.retry_if_exception_cause_type(NameError),
+            stop=tenacity.stop_after_attempt(3),
+        )
+        def mutual_cause() -> None:
+            a = OSError("a")
+            b = OSError("b")
+            a.__cause__ = b
+            b.__cause__ = a
+            raise a
+
+        with pytest.raises(OSError):
+            mutual_cause()
+        assert mutual_cause.statistics["attempt_number"] == 1
+
+    def test_retry_if_exception_cause_type_cyclic_cause_with_match(self) -> None:
+        """A matching cause is still found when the chain also contains a cycle."""
+
+        @retry(
+            retry=tenacity.retry_if_exception_cause_type(NameError),
+            stop=tenacity.stop_after_attempt(2),
+        )
+        def cyclic_with_match() -> None:
+            name_error = NameError("match")
+            os_error = OSError("cycle")
+            os_error.__cause__ = name_error
+            name_error.__cause__ = os_error
+            raise os_error
+
+        with pytest.raises(tenacity.RetryError):
+            cyclic_with_match()
+        assert cyclic_with_match.statistics["attempt_number"] == 2
+
     def test_retry_preserves_argument_defaults(self) -> None:
         def function_with_defaults(a: int = 1) -> int:
             return a

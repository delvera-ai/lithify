+    @asynctest
+    async def test_do_max_attempts_async_with(self) -> None:
+        attempts = 0
+        retrying = tasyncio.AsyncRetrying(stop=stop_after_attempt(3))
+        try:
+            async for attempt in retrying:
+                async with attempt:
+                    attempts += 1
+                    raise Exception
+        except RetryError:
+            pass
+
+        assert attempts == 3
+
+    @asynctest
+    async def test_async_with_success_stops_retrying(self) -> None:
+        attempts = 0
+        async for attempt in tasyncio.AsyncRetrying(stop=stop_after_attempt(3)):
+            async with attempt:
+                attempts += 1
+                if attempts < 2:
+                    raise Exception
+
+        assert attempts == 2
+
+    @asynctest

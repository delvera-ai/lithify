diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index efefba8..ef3939f 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -617,6 +617,31 @@ class TestWaitConditions(unittest.TestCase):
         fn = tenacity.wait_exponential_jitter()
         fn(make_retry_state(0, 0))
 
+    def test_wait_exponential_jitter_min(self) -> None:
+        fn = tenacity.wait_exponential_jitter(initial=1, max=60, min=5)
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 5, 5)
+            self._assert_inclusive_range(fn(make_retry_state(3, 0)), 5, 5)
+            self._assert_inclusive_range(fn(make_retry_state(4, 0)), 8, 9)
+            self.assertEqual(fn(make_retry_state(9, 0)), 60)
+
+    def test_wait_exponential_jitter_timedelta(self) -> None:
+        fn = tenacity.wait_exponential_jitter(
+            max=datetime.timedelta(seconds=60),
+            jitter=datetime.timedelta(seconds=1),
+            min=datetime.timedelta(seconds=2),
+        )
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 2, 2)
+            self._assert_inclusive_range(fn(make_retry_state(4, 0)), 8, 9)
+            self.assertEqual(fn(make_retry_state(9, 0)), 60)
+
+        fn = tenacity.wait_exponential_jitter(
+            initial=10, max=datetime.timedelta(seconds=5)
+        )
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 5)
+
     def test_wait_retry_state_attributes(self) -> None:

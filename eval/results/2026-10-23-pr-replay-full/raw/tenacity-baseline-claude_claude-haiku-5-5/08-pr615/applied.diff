@@ -256,6 +256,20 @@ class BaseRetrying(ABC):
         self._name = name
         self.enabled = enabled
 
+    def __getstate__(self) -> dict[str, t.Any]:
+        state = self.__dict__.copy()
+        # threading.local() cannot be pickled, so keep the statistics of the
+        # calling thread and recreate the thread-local storage when unpickling.
+        del state["_local"]
+        state["_statistics"] = self.statistics
+        return state
+
+    def __setstate__(self, state: dict[str, t.Any]) -> None:
+        statistics = state.pop("_statistics")
+        self.__dict__.update(state)
+        self._local = threading.local()
+        self._local.statistics = statistics
+

+class TestPickle(unittest.TestCase):
+    def test_retrying_is_pickleable(self) -> None:
+        import pickle
+
+        retry = Retrying(
+            stop=tenacity.stop_after_attempt(3),
+            wait=tenacity.wait_fixed(1),
+            retry=tenacity.retry_if_exception_type(ValueError),
+            name="my-retry",
+        )
+        actual = pickle.loads(pickle.dumps(retry))
+
+        self.assertIsInstance(actual, Retrying)
+        self.assertEqual(actual._name, "my-retry")
+        self.assertEqual(actual.stop.max_attempt_number, 3)
+        self.assertEqual(actual.wait.wait_fixed, 1)
+        self.assertEqual(actual(lambda: "ok"), "ok")
+
+    def test_used_retrying_keeps_statistics(self) -> None:
+        import pickle
+
+        retry = Retrying(stop=tenacity.stop_after_attempt(2), wait=tenacity.wait_none())
+        with pytest.raises(RetryError):
+            retry(mock.Mock(side_effect=ValueError))
+        expected_statistics = dict(retry.statistics)
+        assert expected_statistics["attempt_number"] == 2
+
+        actual = pickle.loads(pickle.dumps(retry))
+
+        assert actual.statistics == expected_statistics
+        assert actual.iter_state.actions == []
+        with pytest.raises(RetryError):
+            actual(mock.Mock(side_effect=ValueError))
+
+    def test_decorated_function_retry_is_pickleable(self) -> None:
+        import pickle
+
+        @retry(stop=tenacity.stop_after_attempt(2))
+        def fn() -> str:
+            return "ok"
+
+        actual = pickle.loads(pickle.dumps(fn.retry))
+        assert actual.stop.max_attempt_number == 2
+        assert actual(lambda: "ok") == "ok"
+
+    def test_retry_strategies_are_pickleable(self) -> None:
+        import pickle
+
+        def failed(exc: BaseException) -> RetryCallState:
+            state = RetryCallState(retry_object=Retrying(), fn=None, args=(), kwargs={})
+            state.set_exception((type(exc), exc, None))
+            return state
+
+        def succeeded(result: typing.Any) -> RetryCallState:
+            state = RetryCallState(retry_object=Retrying(), fn=None, args=(), kwargs={})
+            state.set_result(result)
+            return state
+
+        caused = ValueError("boom")
+        caused.__cause__ = KeyError("cause")
+        cases: list[tuple[typing.Any, RetryCallState]] = [
+            (tenacity.retry_if_exception_type(ValueError), failed(ValueError("x"))),
+            (tenacity.retry_if_not_exception_type(ValueError), failed(TypeError())),
+            (tenacity.retry_unless_exception_type(ValueError), failed(ValueError())),
+            (
+                tenacity.retry_if_exception_message(message="boom"),
+                failed(ValueError("boom")),
+            ),
+            (
+                tenacity.retry_if_exception_message(match="bo.*"),
+                failed(ValueError("boom")),
+            ),
+            (
+                tenacity.retry_if_not_exception_message(message="boom"),
+                failed(ValueError("other")),
+            ),
+            (
+                tenacity.retry_if_not_exception_message(match="bo.*"),
+                failed(ValueError("boom")),
+            ),
+            (tenacity.retry_if_exception_cause_type(KeyError), failed(caused)),
+            (tenacity.retry_if_result(bool), succeeded(0)),
+            (tenacity.retry_if_not_result(bool), succeeded(0)),
+        ]
+        for strategy, state in cases:
+            actual = pickle.loads(pickle.dumps(strategy))
+            assert type(actual) is type(strategy)
+            assert actual(state) == strategy(state)
+
+    def test_composed_strategies_are_pickleable(self) -> None:
+        import pickle
+
+        strategy = tenacity.retry_any(
+            tenacity.retry_if_exception_type(ValueError),
+            tenacity.retry_all(tenacity.retry_if_result(bool), tenacity.retry_never),
+        )
+        actual = pickle.loads(pickle.dumps(strategy))
+        assert isinstance(actual, retry_any)
+        assert isinstance(actual.retries[1], retry_all)
+
+

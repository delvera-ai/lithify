diff --git a/tests/test_enabled.py b/tests/test_enabled.py
new file mode 100644
index 0000000..bd3ec66
--- /dev/null
+++ b/tests/test_enabled.py
@@ -0,0 +1,141 @@
+import asyncio
+
+import pytest
+
+from tenacity import AsyncRetrying, RetryError, Retrying, retry, stop_after_attempt
+
+
+def test_disabled_sync_calls_once_and_propagates_exception() -> None:
+    calls = []
+
+    @retry(enabled=False, stop=stop_after_attempt(5))
+    def fails() -> None:
+        calls.append(1)
+        raise ValueError("boom")
+
+    with pytest.raises(ValueError, match="boom"):
+        fails()
+    assert len(calls) == 1
+
+
+def test_disabled_sync_returns_result() -> None:
+    @retry(enabled=False)
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    assert add(1, 2) == 3
+
+
+def test_disabled_sync_retrying_object() -> None:
+    calls = []
+
+    def fails() -> None:
+        calls.append(1)
+        raise ValueError("boom")
+
+    r = Retrying(enabled=False, stop=stop_after_attempt(3))
+    with pytest.raises(ValueError):
+        r(fails)
+    assert len(calls) == 1
+
+
+def test_disabled_does_not_wrap_in_retry_error() -> None:
+    @retry(enabled=False, stop=stop_after_attempt(2), reraise=False)
+    def fails() -> None:
+        raise KeyError("k")
+
+    with pytest.raises(KeyError):
+        fails()
+
+
+def test_disabled_skips_sleep_and_callbacks() -> None:
+    sleeps = []
+    befores = []
+
+    def fails() -> None:
+        raise ValueError
+
+    r = Retrying(
+        enabled=False,
+        stop=stop_after_attempt(3),
+        sleep=sleeps.append,
+        before=befores.append,
+    )
+    with pytest.raises(ValueError):
+        r(fails)
+    assert sleeps == []
+    assert befores == []
+
+
+def test_disabled_async_calls_once_and_propagates_exception() -> None:
+    calls = []
+
+    @retry(enabled=False, stop=stop_after_attempt(5))
+    async def fails() -> None:
+        calls.append(1)
+        raise ValueError("boom")
+
+    with pytest.raises(ValueError, match="boom"):
+        asyncio.run(fails())
+    assert len(calls) == 1
+
+
+def test_disabled_async_returns_result() -> None:
+    @retry(enabled=False)
+    async def value() -> int:
+        return 42
+
+    assert asyncio.run(value()) == 42
+
+
+def test_disabled_async_retrying_object_with_sync_fn() -> None:
+    calls = []
+
+    def fails() -> None:
+        calls.append(1)
+        raise ValueError("boom")
+
+    r = AsyncRetrying(enabled=False, stop=stop_after_attempt(3))
+    with pytest.raises(ValueError):
+        asyncio.run(r(fails))
+    assert len(calls) == 1
+
+
+def test_enabled_default_still_retries() -> None:
+    calls = []
+
+    @retry(stop=stop_after_attempt(3))
+    def fails() -> None:
+        calls.append(1)
+        raise ValueError
+
+    with pytest.raises(RetryError):
+        fails()
+    assert len(calls) == 3
+
+
+def test_enabled_false_survives_retry_with() -> None:
+    calls = []
+
+    @retry(enabled=False)
+    def fails() -> None:
+        calls.append(1)
+        raise ValueError
+
+    with pytest.raises(ValueError):
+        fails.retry_with(stop=stop_after_attempt(5))()
+    assert len(calls) == 1
+
+
+def test_retry_with_can_enable_retrying() -> None:
+    calls = []
+
+    @retry(enabled=False)
+    def fails() -> None:
+        calls.append(1)
+        raise ValueError
+
+    with pytest.raises(RetryError):
+        fails.retry_with(enabled=True, stop=stop_after_attempt(2))()
+    assert len(calls) == 2
+

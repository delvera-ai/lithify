+def flatten_retry_operands(
+    container: type[_RetryT], *operands: typing.Any
+) -> _RetryT:
+    """Build a retry container for ``|`` / ``&``, splicing in same-type operands.
+
+    Without this, ``a | b | c`` would nest as ``retry_any(retry_any(a, b), c)``.
+    Only exact matches are spliced, so subclasses keep their own ``__call__``.
+    """
+    retries: list[typing.Any] = []
+    for operand in operands:
+        if type(operand) is container:
+            retries.extend(operand.retries)
+        else:
+            retries.append(operand)
+    return container(*retries)
+

diff --git a/tenacity/__init__.py b/tenacity/__init__.py
index 282e6da..c84868f 100644
--- a/tenacity/__init__.py
+++ b/tenacity/__init__.py
@@ -185,6 +185,11 @@ class RetryError(Exception):
 
     def reraise(self) -> t.NoReturn:
         if self.last_attempt.failed:
+            exc = self.last_attempt.exception()
+            # A TryAgain raised from an except block only exists to trigger a retry;
+            # the error that caused it is its context, which is what should surface.
+            if isinstance(exc, TryAgain) and exc.__context__ is not None:
+                raise exc.__context__
             raise self.last_attempt.result()
         raise self
 

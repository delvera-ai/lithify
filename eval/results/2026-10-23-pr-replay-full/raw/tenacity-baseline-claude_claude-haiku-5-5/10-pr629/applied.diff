+    def test_wait_exponential_jitter_multiplier(self) -> None:
+        fn = tenacity.wait_exponential_jitter(multiplier=2, max=60)
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 2, 3)
+            self._assert_inclusive_range(fn(make_retry_state(3, 0)), 8, 9)
+
+    def test_wait_exponential_jitter_initial_is_deprecated(self) -> None:
+        with self.assertWarns(DeprecationWarning):
+            fn = tenacity.wait_exponential_jitter(initial=2, max=60)
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 2, 3)
+
+        with self.assertWarns(DeprecationWarning):
+            fn = tenacity.wait_exponential_jitter(2, 60)
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 2, 3)
+
+    def test_wait_exponential_jitter_initial_and_multiplier_conflict(self) -> None:

+    def test_wait_falsy_callable_is_still_called(self) -> None:
+        # A callable wait strategy must be invoked even when it is falsy
+        # (empty container, or a `__bool__`/`__len__` returning False).
+        class FalsyWait:
+            def __init__(self) -> None:
+                self.calls = 0
+
+            def __bool__(self) -> bool:
+                return False
+
+            def __call__(self, retry_state: RetryCallState) -> float:
+                self.calls += 1
+                return 0.25
+
+        class EmptyContainerWait(FalsyWait):
+            def __bool__(self) -> bool:
+                return True
+
+            def __len__(self) -> int:
+                return 0
+
+        for wait in (FalsyWait(), EmptyContainerWait()):
+            with self.subTest(wait=type(wait).__name__):
+                attempts = []
+
+                def flaky() -> str:
+                    attempts.append(1)
+                    if len(attempts) < 2:
+                        raise ValueError("boom")
+                    return "ok"
+
+                r = Retrying(wait=wait, stop=tenacity.stop_after_attempt(3))  # type: ignore[arg-type]
+                self.assertEqual(r(flaky), "ok")
+                self.assertEqual(wait.calls, 1)
+

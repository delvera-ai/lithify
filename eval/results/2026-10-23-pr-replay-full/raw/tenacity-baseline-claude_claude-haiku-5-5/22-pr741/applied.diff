+    async def test_wait_falsy_callable_is_still_called(self) -> None:
+        # A falsy callable wait strategy must still be invoked by AsyncRetrying.
+        class FalsyWait:
+            def __init__(self) -> None:
+                self.calls = 0
+
+            def __bool__(self) -> bool:
+                return False
+
+            def __call__(self, retry_state: Any) -> float:
+                self.calls += 1
+                return 0.0
+
+        wait = FalsyWait()
+        thing = NoIOErrorAfterCount(2)
+        retrying = AsyncRetrying(wait=wait, stop=stop_after_attempt(5))  # type: ignore[arg-type]
+        await retrying(_async_function, thing)
+        assert thing.counter == thing.count
+        assert wait.calls == thing.count
+

@@ -201,13 +202,34 @@ class wait_exponential(wait_base):
         self.exp_base = exp_base
 
     def __call__(self, retry_state: "RetryCallState") -> float:
-        try:
-            exp = self.exp_base ** (retry_state.attempt_number - 1)
-            result = self.multiplier * exp
-        except OverflowError:
-            return self.max
+        if self._exceeds_max(retry_state.attempt_number - 1):
+            result = self.max
+        else:
+            try:
+                exp = self.exp_base ** (retry_state.attempt_number - 1)
+                result = self.multiplier * exp
+            except OverflowError:
+                return self.max
         return max(max(0, self.min), min(result, self.max))
 
+    def _exceeds_max(self, exponent: int) -> bool:
+        # Decide in log space whether multiplier * exp_base ** exponent is already
+        # above max, so the power is never evaluated once it has hit the cap. The
+        # margin keeps float rounding in the logs from flagging a value at or below
+        # max. With min above max, an overflowing power returns max unclamped, so
+        # keep the original path there to leave results unchanged.
+        if (
+            self.multiplier <= 0
+            or self.exp_base <= 1
+            or self.max <= 0
+            or self.min > self.max
+        ):
+            return False
+        return (
+            math.log(self.multiplier) + exponent * math.log(self.exp_base)
+            > math.log(self.max) + 1e-9
+        )
+
 

+    @asynctest
+    async def test_stats_through_functools_wraps_decorator(self) -> None:
+        """Statistics stay visible on an outer functools.wraps wrapper."""
+
+        def timing(f: Callable[..., Any]) -> Callable[..., Any]:
+            @wraps(f)
+            async def inner(*args: Any, **kwargs: Any) -> Any:
+                return await f(*args, **kwargs)
+
+            return inner
+
+        @timing
+        @retry(stop=tenacity.stop_after_attempt(2))
+        async def _foobar() -> None:
+            raise ValueError(42)
+
+        self.assertEqual({}, _foobar.statistics)
+        with self.assertRaises(RetryError):
+            await _foobar()
+        self.assertEqual(2, _foobar.statistics["attempt_number"])
+        self.assertIs(_foobar.__wrapped__.statistics, _foobar.statistics)
+
 

+class _StatisticsView(collections.abc.Mapping[str, t.Any]):
+    """Live, read-only view of a retry object's statistics.
+
+    Decorators built on ``functools.wraps`` copy the wrapper's ``__dict__`` when
+    they are applied, so a plain dict attribute would go stale on the outer
+    wrapper. This view is a single stable object that always reads the current
+    statistics of the retry object, so every wrapper layer sees the same data.
+    """
+
+    def __init__(self, retry: "BaseRetrying") -> None:
+        self._retry = retry
+
+    def __getitem__(self, key: str) -> t.Any:
+        return self._retry.statistics[key]
+
+    def __iter__(self) -> t.Iterator[str]:
+        return iter(self._retry.statistics)
+
+    def __len__(self) -> int:
+        return len(self._retry.statistics)
+
+    def __repr__(self) -> str:
+        return repr(self._retry.statistics)
+
+

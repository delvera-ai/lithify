+class _StatisticsView(Mapping[str, t.Any]):
+    """Live view of a retry object's statistics for the calling thread.
+
+    Wrappers hold one view and hand it on through :func:`functools.wraps`, so an
+    outer wrapper built on top of a retry-decorated function sees the same,
+    up-to-date statistics as the inner one.
+    """
+
+    def __init__(self, retry: "BaseRetrying") -> None:
+        self._retry = retry
+
+    def __getitem__(self, key: str) -> t.Any:
+        return self._retry.statistics[key]
+
+    def __iter__(self) -> t.Iterator[str]:
+        return iter(self._retry.statistics)
+
+    def __len__(self) -> int:
+        return len(self._retry.statistics)
+
+    def __repr__(self) -> str:
+        return repr(self._retry.statistics)
+
+

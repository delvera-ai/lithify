+class TestAsyncStatisticsWrapper(unittest.TestCase):
+    @asynctest
+    async def test_stats_visible_through_functools_wraps_wrapper(self) -> None:
+        """An outer async wrapper built with functools.wraps reports the live statistics."""
+
+        def timed(
+            f: Callable[..., Coroutine[Any, Any, Any]],
+        ) -> Callable[..., Coroutine[Any, Any, Any]]:
+            @wraps(f)
+            async def wrapper(*args: Any, **kwargs: Any) -> Any:
+                return await f(*args, **kwargs)
+
+            return wrapper
+
+        @retry(stop=stop_after_attempt(2))
+        async def _foobar() -> None:
+            raise ValueError(42)
+
+        outer = timed(_foobar)
+        self.assertEqual({}, outer.statistics)
+        with self.assertRaises(RetryError):
+            await outer()
+        self.assertIs(_foobar.statistics, outer.statistics)
+        self.assertEqual(2, outer.statistics["attempt_number"])
+

+class TestAsyncEnabled(unittest.TestCase):
+    def test_disabled_calls_coroutine_once(self) -> None:
+        """With enabled=False an async function is awaited exactly once."""
+        calls = []
+
+        async def fails() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        async def main() -> None:
+            with pytest.raises(ValueError, match="boom"):
+                await AsyncRetrying(enabled=False, stop=stop_after_attempt(5))(fails)
+
+        asyncio.run(main())
+        assert len(calls) == 1
+
+    def test_disabled_calls_sync_function_once(self) -> None:
+        """With enabled=False a sync function is called once and its result returned."""
+        fn = mock.Mock(return_value="ok")
+
+        async def main() -> Any:
+            return await AsyncRetrying(enabled=False)(fn, 1, k=2)
+
+        assert asyncio.run(main()) == "ok"
+        fn.assert_called_once_with(1, k=2)
+
+    def test_disabled_decorator(self) -> None:
+        """@retry(enabled=False) on a coroutine function calls it once."""
+        calls = []
+
+        @retry(enabled=False, stop=stop_after_attempt(5))
+        async def fails() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError, match="boom"):
+            asyncio.run(fails())
+        assert len(calls) == 1
+
+
 if __name__ == "__main__":
     unittest.main()
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 5a90a46..80221e8 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1930,5 +1930,66 @@ class TestMockingSleep:
         assert mock_sleep.call_count == 1
 
 
+class TestEnabled(unittest.TestCase):
+    def test_disabled_calls_once_and_returns_result(self) -> None:
+        """With enabled=False the function is called exactly once."""
+        fn = mock.Mock(return_value=42)
+        assert Retrying(enabled=False)(fn, 1, k=2) == 42
+        fn.assert_called_once_with(1, k=2)
+
+    def test_disabled_propagates_exception_unchanged(self) -> None:
+        """With enabled=False the original exception propagates, with no retry."""
+        exc = ValueError("boom")
+        fn = mock.Mock(side_effect=exc)
+        sleep = mock.Mock()
+        with pytest.raises(ValueError) as info:
+            Retrying(enabled=False, sleep=sleep, stop=tenacity.stop_after_attempt(5))(
+                fn
+            )
+        assert info.value is exc
+        assert fn.call_count == 1
+        assert sleep.call_count == 0
+
+    def test_disabled_decorator(self) -> None:
+        """@retry(enabled=False) calls the function directly, once."""
+        calls = []
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(5))
+        def fails() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError, match="boom"):
+            fails()
+        assert len(calls) == 1
+
+    def test_enabled_default_still_retries(self) -> None:
+        """The default enabled=True keeps retrying."""
+        fn = mock.Mock(side_effect=[ValueError(), 7])
+        r = Retrying(sleep=lambda _: None, stop=tenacity.stop_after_attempt(3))
+        assert r(fn) == 7
+        assert fn.call_count == 2
+
+    def test_enabled_preserved_and_overridden_by_copy(self) -> None:
+        """copy() keeps enabled unless it is passed explicitly."""
+        r = Retrying(enabled=False)
+        assert r.copy().enabled is False
+        assert r.copy(enabled=True).enabled is True
+
+    def test_enabled_preserved_by_retry_with(self) -> None:
+        """retry_with() keeps enabled unless it is passed explicitly."""
+
+        calls = []
+
+        @retry(enabled=False)
+        def fails() -> None:
+            calls.append(1)
+            raise ValueError("boom")
+
+        with pytest.raises(ValueError):
+            fails.retry_with(stop=tenacity.stop_after_attempt(3))()
+        assert len(calls) == 1
+
+
 if __name__ == "__main__":
     unittest.main()

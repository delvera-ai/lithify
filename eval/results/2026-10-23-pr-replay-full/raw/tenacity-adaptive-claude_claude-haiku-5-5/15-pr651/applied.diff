diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 61fd8db..f2be72a 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -925,6 +925,37 @@ class TestRetryConditions(unittest.TestCase):
         with self.assertRaises(TypeError):
             tenacity.retry_if_exception_message(message="negative", match="negative")
 
+    def test_retry_if_exception_message_negative_empty_message_and_match(self) -> None:
+        with self.assertRaises(TypeError):
+            tenacity.retry_if_exception_message(message="", match="negative")
+
+    def test_retry_if_exception_message_empty_message(self) -> None:
+        retry = tenacity.retry_if_exception_message(message="")
+        assert _call_with_exception(retry, RuntimeError()) is True
+        assert _call_with_exception(retry, RuntimeError("boom")) is False
+
+    def test_retry_if_not_exception_message_empty_message(self) -> None:
+        retry = tenacity.retry_if_not_exception_message(message="")
+        assert _call_with_exception(retry, RuntimeError()) is False
+        assert _call_with_exception(retry, RuntimeError("boom")) is True
+
+    def test_retry_if_exception_message_empty_match(self) -> None:
+        retry = tenacity.retry_if_exception_message(match="")
+        assert _call_with_exception(retry, RuntimeError()) is True
+        assert _call_with_exception(retry, RuntimeError("boom")) is True
+
+    def test_retry_if_not_exception_message_empty_match(self) -> None:
+        retry = tenacity.retry_if_not_exception_message(match="")
+        assert _call_with_exception(retry, RuntimeError()) is False
+        assert _call_with_exception(retry, RuntimeError("boom")) is False
+
+
+def _call_with_exception(retry: typing.Any, exc: BaseException) -> typing.Any:
+    """Invoke a retry predicate as if the attempt had raised ``exc``."""
+    retry_state = RetryCallState(None, None, (), {})  # type: ignore[arg-type]
+    retry_state.set_exception((type(exc), exc, None))
+    return retry(retry_state)
+
 
 class NoneReturnUntilAfterCount:

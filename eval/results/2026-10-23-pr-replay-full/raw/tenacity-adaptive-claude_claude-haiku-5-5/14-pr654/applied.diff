--- a/tenacity/wait.py
+++ b/tenacity/wait.py
@@ -15,6 +15,7 @@
 # limitations under the License.
 
 import abc
+import math
 import random
 import typing
 import warnings
@@ -200,7 +201,20 @@ class wait_exponential(wait_base):
         self.max = _utils.to_seconds(max)
         self.exp_base = exp_base
 
+    def _is_past_max(self, exponent: int) -> bool:
+        # Decide in log space whether multiplier * exp_base ** exponent is above
+        # max, so the power is never computed once the cap is reached. The small
+        # margin keeps borderline values on the exact path.
+        if not (self.multiplier > 0 and self.exp_base > 1 and 0 < self.max < math.inf):
+            return False
+        return (
+            math.log(self.multiplier) + exponent * math.log(self.exp_base)
+            > math.log(self.max) + 1e-9
+        )
+
     def __call__(self, retry_state: "RetryCallState") -> float:
+        if self._is_past_max(retry_state.attempt_number - 1):
+            return max(max(0, self.min), self.max)
         try:
             exp = self.exp_base ** (retry_state.attempt_number - 1)
             result = self.multiplier * exp
diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py

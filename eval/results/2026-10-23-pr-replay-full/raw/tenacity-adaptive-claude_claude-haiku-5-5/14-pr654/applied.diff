@@ -413,6 +413,20 @@ class TestWaitConditions(unittest.TestCase):
                 self.assertEqual(r.wait(make_retry_state(9, 0)), 100)
                 self.assertEqual(r.wait(make_retry_state(20, 0)), 100)
 
+    def test_exponential_past_max_skips_power(self) -> None:
+        class CountingBase(float):
+            pow_calls = 0
+
+            def __pow__(self, other: object) -> float:
+                CountingBase.pow_calls += 1
+                return float.__pow__(self, other)  # type: ignore[operator]
+
+        fn = tenacity.wait_exponential(max=60, exp_base=CountingBase(2))
+        for attempt in range(1, 1001):
+            expected = 60 if attempt > 6 else 2 ** (attempt - 1)
+            self.assertEqual(fn(make_retry_state(attempt, 0)), expected)
+        self.assertLess(CountingBase.pow_calls, 20)
+
     def test_legacy_explicit_wait_type(self) -> None:
         Retrying(wait="exponential_sleep")  # type: ignore[arg-type]
 

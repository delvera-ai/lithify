diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index efefba8..f5ae019 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -617,6 +617,35 @@ class TestWaitConditions(unittest.TestCase):
         fn = tenacity.wait_exponential_jitter()
         fn(make_retry_state(0, 0))
 
+    def test_wait_exponential_jitter_with_min(self) -> None:
+        fn = tenacity.wait_exponential_jitter(max=60, min=10)
+
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 10)
+            self.assertEqual(fn(make_retry_state(2, 0)), 10)
+            self._assert_inclusive_range(fn(make_retry_state(3, 0)), 10, 10)
+            self._assert_inclusive_range(fn(make_retry_state(4, 0)), 10, 10)
+            self._assert_inclusive_range(fn(make_retry_state(5, 0)), 16, 17)
+            self._assert_inclusive_range(fn(make_retry_state(6, 0)), 32, 33)
+            self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
+    def test_wait_exponential_jitter_with_timedelta(self) -> None:
+        fn = tenacity.wait_exponential_jitter(
+            max=datetime.timedelta(seconds=60),
+            jitter=datetime.timedelta(seconds=1),
+            min=datetime.timedelta(seconds=10),
+        )
+        expected = tenacity.wait_exponential_jitter(max=60, jitter=1, min=10)
+
+        self.assertEqual(fn.max, expected.max)
+        self.assertEqual(fn.jitter, expected.jitter)
+        self.assertEqual(fn.min, expected.min)
+
+        for _ in range(1000):
+            self.assertEqual(fn(make_retry_state(1, 0)), 10)
+            self._assert_inclusive_range(fn(make_retry_state(5, 0)), 16, 17)
+            self.assertEqual(fn(make_retry_state(7, 0)), 60)
+
     def test_wait_retry_state_attributes(self) -> None:

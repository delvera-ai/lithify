+    def test_wait_exponential_jitter_multiplier(self) -> None:
+        fn = tenacity.wait_exponential_jitter(multiplier=3, max=60)
+        for _ in range(1000):
+            self._assert_inclusive_range(fn(make_retry_state(1, 0)), 3, 4)

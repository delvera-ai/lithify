+class TestPickle:
+    def test_retrying_with_statistics_round_trip(self) -> None:
+        r = Retrying(stop=stop_after_attempt(3), wait=wait_fixed(0), sleep=_no_sleep)
+        r(lambda: "ok")
+        restored = pickle.loads(pickle.dumps(r))
+        assert restored.statistics == r.statistics
+        assert restored.statistics["attempt_number"] == 1
+        assert restored.stop.max_attempt_number == 3
+
+    def test_restored_retrying_is_usable(self) -> None:
+        attempts = []
+
+        def flaky() -> str:
+            attempts.append(1)
+            if len(attempts) < 3:
+                raise ValueError("boom")
+            return "ok"
+
+        r = Retrying(
+            stop=stop_after_attempt(5),
+            wait=wait_fixed(0),
+            retry=retry_if_exception_type(ValueError),
+            sleep=_no_sleep,
+        )
+        r(lambda: "warm-up")
+        restored = pickle.loads(pickle.dumps(r))
+        assert restored(flaky) == "ok"
+        assert restored.statistics["attempt_number"] == 3
+
+    def test_restored_statistics_visible_in_other_thread(self) -> None:
+        r = Retrying(stop=stop_after_attempt(2), sleep=_no_sleep)
+        r(lambda: "ok")
+        data = pickle.dumps(r)
+        results: list[dict[str, typing.Any]] = []
+        thread = threading.Thread(
+            target=lambda: results.append(pickle.loads(data).statistics)
+        )
+        thread.start()
+        thread.join()
+        assert results == [r.statistics]
+
+    def test_decorated_function_retry_object_round_trip(self) -> None:
+        @retry(stop=stop_after_attempt(4))
+        def fn() -> None:
+            pass
+
+        restored = pickle.loads(pickle.dumps(fn.retry))
+        assert restored.stop.max_attempt_number == 4
+
+    @pytest.mark.parametrize(
+        "strategy",
+        [
+            retry_if_exception_type(ValueError),
+            retry_if_not_exception_type(ValueError),
+            retry_unless_exception_type(ValueError),
+            retry_if_exception_message(message="boom"),
+            retry_if_exception_message(match="bo.*"),
+            retry_if_not_exception_message(message="boom"),
+            retry_any(retry_if_exception_type(KeyError), retry_if_exception_type()),
+            retry_all(retry_if_exception_type(), retry_if_exception_message("boom")),
+            stop_after_attempt(2),
+            tenacity.stop_after_delay(2),
+            tenacity.stop_never,
+            tenacity.wait_exponential(),
+            tenacity.wait_combine(wait_fixed(1), wait_none()),
+            tenacity.wait_random_exponential(),
+        ],
+    )
+    def test_strategy_round_trip(self, strategy: typing.Any) -> None:
+        restored = pickle.loads(pickle.dumps(strategy))
+        assert type(restored) is type(strategy)
+
+    def test_predicate_behaviour_survives_round_trip(self) -> None:
+        strategy = pickle.loads(
+            pickle.dumps(retry_if_not_exception_message(message="boom"))
+        )
+        assert strategy.predicate(ValueError("boom")) is False
+        assert strategy.predicate(ValueError("other")) is True

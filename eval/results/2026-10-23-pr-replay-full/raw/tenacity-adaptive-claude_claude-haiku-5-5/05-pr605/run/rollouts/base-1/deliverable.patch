+    @asynctest
+    async def test_do_max_attempts_async_with(self) -> None:
+        attempts = 0
+        retrying = tasyncio.AsyncRetrying(stop=stop_after_attempt(3))
+        try:
+            async for attempt in retrying:
+                async with attempt:
+                    attempts += 1
+                    raise Exception
+        except RetryError:
+            pass
+
+        assert attempts == 3
+
+    @asynctest
+    async def test_async_with_returns_result(self) -> None:
+        result = None
+        async for attempt in tasyncio.AsyncRetrying(stop=stop_after_attempt(3)):
+            async with attempt:
+                result = "ok"
+        assert result == "ok"

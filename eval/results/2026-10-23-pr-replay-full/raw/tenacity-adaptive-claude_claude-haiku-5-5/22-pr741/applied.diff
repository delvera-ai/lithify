+    @asynctest
+    async def test_falsy_callable_wait_is_called(self) -> None:
+        # A falsy wait strategy must be called, not treated as "no wait".
+        calls = []
+
+        class FalsyWait:
+            def __bool__(self) -> bool:
+                return False
+
+            def __call__(self, retry_state: RetryCallState) -> float:
+                calls.append(retry_state.attempt_number)
+                return 0.0
+
+        thing = NoIOErrorAfterCount(2)
+        retrying = AsyncRetrying(
+            wait=FalsyWait(),  # type: ignore[arg-type]
+            stop=stop_after_attempt(5),
+        )
+        await retrying(_async_function, thing)
+        assert thing.counter == thing.count
+        assert calls == list(range(1, thing.count + 1))
+

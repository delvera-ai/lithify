+    def test_falsy_callable_wait_is_called(self) -> None:
+        # A falsy wait strategy (empty container, or __bool__ -> False) is
+        # still a callable strategy and must be invoked, not skipped.
+        class FalsyWait:
+            def __init__(self) -> None:
+                self.calls = 0
+
+            def __bool__(self) -> bool:
+                return False
+
+            def __call__(self, retry_state: RetryCallState) -> float:
+                self.calls += 1
+                return 0.0
+
+        class EmptyContainerWait(FalsyWait):
+            def __len__(self) -> int:
+                return 0
+
+        for wait in (FalsyWait(), EmptyContainerWait()):
+            with self.subTest(wait=type(wait).__name__):
+                flaky = self._make_flaky_twice()
+                r = Retrying(
+                    wait=wait,  # type: ignore[arg-type]
+                    stop=tenacity.stop_after_attempt(3),
+                )
+                self.assertEqual(r(flaky), "ok")
+                self.assertEqual(wait.calls, 1)
+
+    @staticmethod
+    def _make_flaky_twice() -> typing.Callable[[], str]:
+        attempts = []
+
+        def flaky() -> str:
+            attempts.append(1)
+            if len(attempts) < 2:
+                raise ValueError("boom")
+            return "ok"
+
+        return flaky
+
     def test_wait_radd_plain_callable(self) -> None:

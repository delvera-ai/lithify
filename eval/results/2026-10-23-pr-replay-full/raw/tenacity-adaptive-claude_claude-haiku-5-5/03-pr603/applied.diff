+    def test_delay_since_first_attempt_present_before_first_retry(self) -> None:
+        seen: list[typing.Any] = []
+
+        def record_statistics(retry_state: RetryCallState) -> None:
+            seen.append(
+                retry_state.retry_object.statistics["delay_since_first_attempt"]
+            )
+
+        retrying = Retrying(
+            wait=tenacity.wait_fixed(0.01),
+            stop=tenacity.stop_after_attempt(2),
+            retry=tenacity.retry_if_result(lambda result: result is None),
+            before=record_statistics,
+        )
+        self.assertTrue(retrying(lambda c: c.go(), NoneReturnUntilAfterCount(1)))
+        self.assertEqual(seen[0], 0)
+        self.assertGreater(seen[1], 0)

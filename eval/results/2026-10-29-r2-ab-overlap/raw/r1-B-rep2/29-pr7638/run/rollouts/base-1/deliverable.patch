     ALTER_PARSERS = {
         **parser.Parser.ALTER_PARSERS,
         "MODIFY": lambda self: self._parse_alter_table_modify(),
+        "CHANGE": lambda self: self._parse_alter_table_change(),
         "AUTO_INCREMENT": lambda self: self._parse_property_assignment(exp.AutoIncrementProperty),
     }
 
@@ -328,6 +329,23 @@ class MySQLParser(parser.Parser):
 
         return self.expression(exp.ModifyColumn(this=column_def))
 
+    def _parse_alter_table_change(self) -> exp.Expr | None:
+        self._match(TokenType.COLUMN)
+
+        old_name = self._parse_field(any_token=True)
+        if old_name is None:
+            return None
+
+        column = self._parse_field(any_token=True)
+        if column is None:
+            return None
+
+        column_def = self._parse_column_def(column)
+        if not isinstance(column_def, exp.ColumnDef):
+            return None
+
+        return self.expression(exp.ChangeColumn(this=column_def, old_name=old_name))
+
     def _parse_generated_as_identity(
         self,
     ) -> (

diff --git a/sqlglot/parsers/snowflake.py b/sqlglot/parsers/snowflake.py
index 99dbb2759..4abf877a9 100644
--- a/sqlglot/parsers/snowflake.py
+++ b/sqlglot/parsers/snowflake.py
@@ -1170,6 +1170,24 @@ class SnowflakeParser(parser.Parser):
 
         return super()._parse_id_var(any_token=any_token, tokens=tokens)
 
+    def _parse_field(
+        self,
+        any_token: bool = False,
+        tokens: Collection[TokenType] | None = None,
+        anonymous_func: bool = False,
+    ) -> exp.Expr | None:
+        field = super()._parse_field(
+            any_token=any_token, tokens=tokens, anonymous_func=anonymous_func
+        )
+
+        # Dynamic invocation: IDENTIFIER(<name_expr>)(<args>) calls the function named by <name_expr>
+        if isinstance(field, exp.DynamicIdentifier) and self._match(TokenType.L_PAREN):
+            args = self._parse_function_args()
+            self._match_r_paren(field)
+            return self.expression(exp.Anonymous(this=field, expressions=args))
+
+        return field
+
     def _parse_show_snowflake(
         self, this: str, terse: bool = False, iceberg: bool = False
     ) -> exp.Show:

+    def test_max_nodes(self):
+        wide = "SELECT " + ", ".join(f"c{i}" for i in range(500)) + " FROM t"
+
+        self.assertEqual(len(parse_one(wide).expressions), 500)
+        self.assertEqual(len(parse_one(wide, max_nodes=10000).expressions), 500)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=100)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=100, error_level=ErrorLevel.IGNORE)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=100, into=exp.Select)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one("SELECT a + b + c + d + e + f + g", max_nodes=3)
+

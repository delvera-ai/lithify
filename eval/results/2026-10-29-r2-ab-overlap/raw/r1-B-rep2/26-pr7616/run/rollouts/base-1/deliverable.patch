diff --git a/sqlglot/parsers/postgres.py b/sqlglot/parsers/postgres.py
index 2fac62242..0038e863c 100644
--- a/sqlglot/parsers/postgres.py
+++ b/sqlglot/parsers/postgres.py
@@ -318,6 +318,32 @@ class PostgresParser(parser.Parser):
             )
         )
 
+    def _parse_create(self) -> exp.Create | exp.Command:
+        start = self._prev
+        if not self._match_text_seq("TYPE"):
+            return super()._parse_create()
+
+        this = self._parse_table_parts()
+        if not self._match(TokenType.ALIAS):
+            return self._parse_as_command(start)
+
+        if self._match_text_seq("ENUM"):
+            expression: exp.Expr = exp.DataType(
+                this=exp.DType.ENUM, expressions=self._parse_wrapped_csv(self._parse_string)
+            )
+        elif self._match(TokenType.L_PAREN, advance=False):
+            attributes = self._parse_wrapped_csv(self._parse_field_def)
+            if not attributes:
+                return self._parse_as_command(start)
+            expression = exp.Schema(expressions=attributes)
+        else:
+            return self._parse_as_command(start)
+
+        if self._curr:
+            return self._parse_as_command(start)
+
+        return self.expression(exp.Create(this=this, kind="TYPE", expression=expression))
+

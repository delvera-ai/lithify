+++ b/sqlglot/dialects/dialect.py
@@ -1613,6 +1613,21 @@ def build_date_delta_with_interval(
     return _builder
 
 
+def build_date_delta_with_interval_or_days(
+    expression_class: Type[E],
+) -> t.Callable[[BuilderArgs], E | None]:
+    # Also accepts the two-argument form DATE_ADD(date, days), where the second argument is a number of days
+    interval_builder = build_date_delta_with_interval(expression_class)
+    days_builder = build_date_delta(expression_class)
+
+    def _builder(args: BuilderArgs) -> E | None:
+        if len(args) == 2 and not isinstance(args[1], exp.Interval):
+            return days_builder(args)
+        return interval_builder(args)
+
+    return _builder
+
+
 def date_trunc_to_time(args: BuilderArgs) -> exp.DateTrunc | exp.TimestampTrunc:
     unit = seq_get(args, 0)
     this = seq_get(args, 1)

+    def test_unpivot_value_column(self) -> None:
+        sql = """
+        WITH src AS (SELECT id, jan, feb FROM sales)
+        SELECT id, metric_name, score
+        FROM src UNPIVOT (score FOR metric_name IN (jan, feb))
+        """
+        node = lineage("score", sql)
+
+        self.assertEqual(
+            [downstream.name for downstream in node.downstream], ["src.jan", "src.feb"]
+        )
+
+    def test_unpivot_name_column_and_implicit_column(self) -> None:
+        sql = """
+        SELECT id, metric_name
+        FROM sales UNPIVOT (score FOR metric_name IN (jan, feb))
+        """
+
+        node = lineage("metric_name", sql)
+        self.assertEqual(
+            [downstream.name for downstream in node.downstream], ["sales.jan", "sales.feb"]
+        )
+
+        node = lineage("id", sql)
+        self.assertEqual([downstream.name for downstream in node.downstream], ["sales.id"])

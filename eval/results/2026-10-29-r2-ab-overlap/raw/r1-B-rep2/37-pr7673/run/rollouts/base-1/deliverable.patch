+    def parsetime_sql(self, expression: exp.ParseTime) -> str:
+        formatted_time = self.format_time(expression)
+        return self.sql(
+            exp.cast(
+                self.func("STRPTIME", expression.this, formatted_time),
+                exp.DataType(this=exp.DType.TIME),
+            )
+        )

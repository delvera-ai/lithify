+    def test_qualify_unnest_unqualified_column_terminates(self):
+        # Typing the input of a lateral whose base table is missing used to recurse without bound
+        for sql, read, schema in (
+            ("SELECT x FROM t LATERAL VIEW EXPLODE(arr) v AS x", "spark", {"other": {"a": "INT"}}),
+            ("SELECT value FROM t, LATERAL FLATTEN(col)", "snowflake", {"other": {"a": "INT"}}),
+        ):
+            with self.subTest(sql):
+                with self.assertRaisesRegex(OptimizeError, "could not be resolved"):
+                    optimizer.qualify.qualify(
+                        parse_one(sql, read=read), schema=schema, dialect=read
+                    )
+
+        expression = optimizer.qualify.qualify(
+            parse_one("SELECT x FROM t LATERAL VIEW EXPLODE(arr) v AS x", read="spark"),
+            schema={"t": {"arr": "ARRAY<INT>"}},
+            dialect="spark",
+        )
+        self.assertEqual(
+            expression.sql(dialect="spark"),
+            "SELECT `v`.`x` AS `x` FROM `t` AS `t` LATERAL VIEW EXPLODE(`t`.`arr`) v AS `x`",
+        )
+
     def test_qualify_columns__with_invisible(self):
         schema = MappingSchema(self.schema, {"x": {"a"}, "y": {"b"}, "z": {"b"}})
         self.check_file("qualify_columns__with_invisible", qualify_columns, schema=schema)

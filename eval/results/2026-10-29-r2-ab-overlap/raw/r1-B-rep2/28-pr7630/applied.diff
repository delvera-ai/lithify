+    def test_collate_in_types(self):
+        for sql in (
+            'SELECT CAST(x AS VARCHAR(10) COLLATE "C")',
+            'SELECT CAST(x AS TEXT COLLATE "C")',
+            'SELECT CAST(x AS ARRAY<TEXT COLLATE "C">)',
+            'SELECT CAST(x AS ARRAY<VARCHAR(10) COLLATE "C">)',
+            'SELECT CAST(x AS MAP<TEXT COLLATE "C", TEXT>)',
+            'SELECT CAST(x AS ARRAY<STRUCT<a TEXT COLLATE "C">>)',
+            'CREATE TABLE t (a TEXT COLLATE "C", b ARRAY<TEXT COLLATE "C">)',
+            'SELECT CAST(x AS TEXT) COLLATE "C"',
+        ):
+            with self.subTest(sql=sql):
+                self.assertEqual(parse_one(sql).sql(), sql)
+
+        cast = parse_one('SELECT CAST(x AS TEXT COLLATE "C")').selects[0]
+        self.assertIsInstance(cast.to, exp.Collate)
+        self.assertIsInstance(cast.to.this, exp.DataType)
+
     def test_drop_column(self):
         ast = parse_one("ALTER TABLE tbl DROP COLUMN col")
         self.assertEqual(len(list(ast.find_all(exp.Table))), 1)

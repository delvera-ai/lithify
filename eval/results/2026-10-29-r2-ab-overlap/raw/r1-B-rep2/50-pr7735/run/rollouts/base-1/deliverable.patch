diff --git a/tests/dialects/test_snowflake.py b/tests/dialects/test_snowflake.py
index 8eccf066c..88a99a3ba 100644
--- a/tests/dialects/test_snowflake.py
+++ b/tests/dialects/test_snowflake.py
@@ -5356,6 +5356,32 @@ MATCH_RECOGNIZE (
         self.assertTrue(ast.args["restrict"])
         self.validate_identity("DROP ICEBERG TABLE IF EXISTS t RESTRICT")
 
+    def test_undrop(self):
+        ast = self.validate_identity("UNDROP TABLE db.s.t")
+        self.assertIsInstance(ast, exp.Undrop)
+        self.assertEqual(ast.args["kind"], "TABLE")
+
+        for kind in (
+            "ACCOUNT",
+            "DATABASE",
+            "DYNAMIC TABLE",
+            "EXTERNAL VOLUME",
+            "ICEBERG TABLE",
+            "NOTEBOOK",
+            "SCHEMA",
+            "SNAPSHOT",
+            "STREAMLIT",
+            "TABLE",
+            "TAG",
+            "TYPE",
+        ):
+            with self.subTest(kind=kind):
+                self.validate_identity(f"UNDROP {kind} x")
+
+        self.validate_identity("UNDROP TABLE IDENTIFIER('\"1234567\"')")
+        self.validate_identity("UNDROP DATABASE IDENTIFIER($id)")
+        self.validate_identity("undrop table t", "UNDROP TABLE t")
+
     def test_show_primary_keys(self):
         self.validate_identity("SHOW PRIMARY KEYS")
         self.validate_identity("SHOW PRIMARY KEYS IN ACCOUNT")

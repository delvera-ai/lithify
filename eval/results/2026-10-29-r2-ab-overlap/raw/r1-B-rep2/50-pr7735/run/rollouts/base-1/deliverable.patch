+    def _parse_undrop(self) -> exp.Undrop | exp.Command:
+        # https://docs.snowflake.com/en/sql-reference/sql/undrop-table
+        start = self._prev
+        kind = next(
+            (kind for kind in self.UNDROP_KINDS if self._match_text_seq(*kind.split())),
+            None,
+        )
+        if not kind:
+            return self._parse_as_command(start)
+
+        return self.expression(exp.Undrop(this=self._parse_table_parts(schema=True), kind=kind))
+
     def _parse_location_property(self) -> exp.LocationProperty:
         self._match(TokenType.EQ)
         return self.expression(exp.LocationProperty(this=self._parse_location_path()))

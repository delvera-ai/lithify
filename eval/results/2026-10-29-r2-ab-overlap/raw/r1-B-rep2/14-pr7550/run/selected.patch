@@ -141,6 +141,12 @@ class Resolver:
 
             if isinstance(source, exp.Table):
                 columns = self.schema.column_names(source, only_visible)
+
+                # An UNPIVOTed CTE is kept as a Table, so its columns come from the CTE's projections
+                cte = self.scope.cte_sources.get(source.name)
+                pivot = seq_get(source.args.get("pivots") or [], 0)
+                if cte and isinstance(pivot, exp.Pivot) and pivot.unpivot:

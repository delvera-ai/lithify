     allow_partial_qualification: bool,
 ) -> None:
     """Disambiguate columns, ensuring each column specifies a source"""
+    # The columns produced by an UNPIVOT are new output names, not references to source columns
+    unpivot_output_ids = {
+        id(c) for pivot in scope.pivots if pivot.unpivot for c in _unpivot_columns(pivot)
+    }
+
     for column in scope.columns:
         column_table = column.table
         column_name = column.name
 
+        if id(column) in unpivot_output_ids:
+            continue
+
         if column_table and column_table in scope.sources:
             source_columns = resolver.get_source_columns(column_table)
             if (
@@ -645,7 +653,11 @@ def _qualify_columns(
 
     for pivot in scope.pivots:
         for column in pivot.find_all(exp.Column):
-            if not column.table and column.name in resolver.all_columns:
+            if (
+                not column.table
+                and column.name in resolver.all_columns
+                and id(column) not in unpivot_output_ids
+            ):
                 table = resolver.get_table(column.name)
                 if table:
                     column.set("table", table)
diff --git a/sqlglot/optimizer/resolver.py b/sqlglot/optimizer/resolver.py

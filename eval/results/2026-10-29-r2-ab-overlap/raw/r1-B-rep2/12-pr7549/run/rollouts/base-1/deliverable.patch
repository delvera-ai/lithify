diff --git a/sqlglot/optimizer/resolver.py b/sqlglot/optimizer/resolver.py
index e2b7a6548..f1251b424 100644
--- a/sqlglot/optimizer/resolver.py
+++ b/sqlglot/optimizer/resolver.py
@@ -338,6 +338,38 @@ class Resolver:
 
         return unambiguous_columns
 
+    def is_lateral_struct_field(self, source_name: str, field_name: str) -> bool:
+        """
+        Whether `field_name` is a field of the STRUCT produced by a LATERAL VIEW EXPLODE source
+        `source_name` that exposes the struct under a column of the same name, e.g. `ci.name` for
+        `LATERAL VIEW EXPLODE(items) ci AS ci`, where `items` is an `ARRAY<STRUCT<name: ...>>`.
+        """
+        source = self.scope.sources.get(source_name)
+        if not isinstance(source, Scope) or not isinstance(source.expression, exp.Lateral):
+            return False
+
+        explode = source.expression.this
+        if not isinstance(explode, exp.Explode) or not isinstance(explode.this, exp.Column):
+            return False
+
+        if source_name not in source.expression.alias_column_names:
+            return False
+
+        column = explode.this
+        array_source = self.scope.sources.get(column.table)
+        array_type = (
+            self._get_column_type_from_scope(array_source, column) if array_source else None
+        )
+        if not array_type or not array_type.is_type(exp.DType.ARRAY) or not array_type.expressions:
+            return False
+
+        struct_type = array_type.expressions[0]
+        return (
+            isinstance(struct_type, exp.DataType)
+            and struct_type.is_type(exp.DType.STRUCT)
+            and any(field.name == field_name for field in struct_type.expressions)
+        )
+

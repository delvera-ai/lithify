         self.validate_identity(
             "CREATE TABLE test_table (col1 DATE) PARTITION BY RANGE (col1) (START ('2019-01-01') END ('2021-01-01') EVERY (INTERVAL 1 YEAR), START ('2021-01-01') END ('2021-05-01') EVERY (INTERVAL 1 MONTH), START ('2021-05-01') END ('2021-05-04') EVERY (INTERVAL 1 DAY))"
         )
+
+    def test_native_function_syntax(self):
+        self.validate_identity("SELECT MIN_BY(a, b) FROM t")
+        self.validate_identity("SELECT MAX_BY(a, b) OVER (PARTITION BY c ORDER BY d) FROM t")
+        self.validate_all(
+            "SELECT MIN_BY(a, b) FROM t",
+            read={"duckdb": "SELECT ARG_MIN(a, b) FROM t"},
+        )
+        self.validate_all(
+            "SELECT MAX_BY(a, b) FROM t",
+            read={"duckdb": "SELECT ARG_MAX(a, b) FROM t"},
+        )
+
+        self.validate_identity("SELECT MAP(1, 'a', 2, 'b')")
+        self.validate_identity("SELECT MAP()")
+        self.validate_identity("SELECT MAP(k, v) FROM t")
+        self.validate_all(
+            "SELECT MAP('a', 1, 'b', 2)",
+            read={"duckdb": "SELECT MAP(['a', 'b'], [1, 2])"},
+        )
+        self.validate_all(
+            "SELECT MAP_FROM_ARRAYS(k, v) FROM t",
+            read={"duckdb": "SELECT MAP(k, v) FROM t"},
+        )
+
+        self.validate_identity("SELECT ARRAY_CONTAINS_ALL(a, b) FROM t")
+        self.validate_all(
+            "SELECT ARRAY_CONTAINS_ALL(a, b)",
+            read={"postgres": "SELECT a @> b"},
+        )
+
+        self.validate_identity("SELECT TRIM(a, 'x') FROM t")
+        self.validate_all(
+            "SELECT TRIM(a, 'x')",
+            read={"": "SELECT TRIM(BOTH 'x' FROM a)"},
+        )
+        self.validate_all(
+            "SELECT LTRIM(a)",
+            read={"": "SELECT TRIM(LEADING FROM a)"},
+        )
+        self.validate_all(
+            "SELECT RTRIM(a)",
+            read={"": "SELECT TRIM(TRAILING FROM a)"},
+        )
+        with self.assertRaises(UnsupportedError):
+            parse_one("SELECT TRIM(LEADING 'x' FROM a)").sql(
+                "starrocks", unsupported_level=ErrorLevel.RAISE
+            )

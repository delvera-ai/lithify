         exp.TimeStrToDate: rename_func("TO_DATE"),
         exp.UnixToStr: lambda self, e: self.func("FROM_UNIXTIME", e.this, self.format_time(e)),
         exp.UnixToTime: rename_func("FROM_UNIXTIME"),
+        exp.VarMap: lambda self, e: self.map_sql(e),
     }
 
     # https://docs.starrocks.io/docs/sql-reference/sql-statements/keywords/#reserved-keywords
@@ -273,6 +280,36 @@ class StarRocksGenerator(MySQLGenerator):
         "with",
     }
 
+    def map_sql(self, expression: exp.Map | exp.VarMap) -> str:
+        keys = expression.args.get("keys")
+        values = expression.args.get("values")
+
+        if keys is None and values is None:
+            return self.func("MAP")
+
+        # MAP(k1, v1, k2, v2, ...) takes alternating keys and values, so literal arrays are interleaved.
+        # Column arrays can't be interleaved statically, so use MAP_FROM_ARRAYS instead.
+        if isinstance(keys, exp.Array) and isinstance(values, exp.Array):
+            args = [arg for pair in zip(keys.expressions, values.expressions) for arg in pair]
+            return self.func("MAP", *args)
+
+        return self.func("MAP_FROM_ARRAYS", keys, values)
+
+    def trim_sql(self, expression: exp.Trim) -> str:
+        position = expression.args.get("position")
+        chars = expression.expression
+
+        if expression.args.get("collation"):
+            self.unsupported("StarRocks TRIM does not support COLLATE")
+
+        # TRIM(str[, chars]) trims both ends, so one-sided trimming is only possible without chars
+        if position in ("LEADING", "TRAILING"):
+            if not chars:
+                return self.func("LTRIM" if position == "LEADING" else "RTRIM", expression.this)
+            self.unsupported(f"StarRocks TRIM cannot remove {position} characters only")
+
+        return self.func("TRIM", expression.this, chars)
+
     def create_sql(self, expression: exp.Create) -> str:
         # Starrocks' primary key is defined outside of the schema, so we need to move it there
         schema = expression.this

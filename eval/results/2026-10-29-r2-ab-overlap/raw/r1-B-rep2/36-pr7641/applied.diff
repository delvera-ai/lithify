     def sort_sql(self, expression: exp.Sort) -> str:
         return self.op_expressions("SORT BY", expression)
 
+    def _ordered_null_check_source(self, expression: exp.Ordered) -> exp.Expression:
+        # An unqualified ORDER BY column that names a qualified projection is checked through that
+        # projection, since the bare name may be ambiguous across the FROM / JOIN sources
+        column = expression.this
+        order = expression.parent
+        select = order.parent if isinstance(order, exp.Order) else None
+
+        if isinstance(column, exp.Column) and not column.table and isinstance(select, exp.Select):
+            for projection in select.expressions:
+                source = projection.this if isinstance(projection, exp.Alias) else projection
+                if (
+                    isinstance(source, exp.Column)
+                    and source.table
+                    and projection.output_name == column.name
+                ):
+                    return source
+
+        return column
+

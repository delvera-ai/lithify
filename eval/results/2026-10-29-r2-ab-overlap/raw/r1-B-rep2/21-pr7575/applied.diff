diff --git a/tests/test_lineage.py b/tests/test_lineage.py
index 13577bb2f..e4904ef61 100644
--- a/tests/test_lineage.py
+++ b/tests/test_lineage.py
@@ -862,3 +862,50 @@ class TestLineage(unittest.TestCase):
         )
         downstream_names = sorted(d.name for d in node.downstream)
         self.assertEqual(downstream_names, ["s1.a", "s2.a"])
+
+    def test_lineage_all_columns(self) -> None:
+        sql = "SELECT a, b + 1 AS c FROM x"
+        nodes = lineage(None, sql, schema={"x": {"a": "int", "b": "int"}})
+
+        self.assertEqual(list(nodes), ["a", "c"])
+        self.assertEqual(nodes["a"].name, "a")
+        self.assertEqual(nodes["c"].name, "c")
+        self.assertEqual(
+            nodes["c"].downstream[0].name,
+            "x.b",
+        )
+
+    def test_lineage_on_node(self) -> None:
+        sql = "SELECT a, b + 1 AS c FROM x"
+        schema = {"x": {"a": "int", "b": "int"}}
+        calls = []
+
+        def on_node(node):
+            node.payload["downstream_count"] = len(node.downstream)
+            calls.append(node)
+
+        nodes = lineage(None, sql, schema=schema, on_node=on_node)
+        walked = {id(n) for node in nodes.values() for n in node.walk()}
+
+        self.assertEqual(len(calls), len(walked))
+        self.assertEqual({id(n) for n in calls}, walked)
+        self.assertTrue(all(n.payload["downstream_count"] == len(n.downstream) for n in calls))
+
+        node = lineage(
+            "c", sql, schema=schema, on_node=lambda n: n.payload.setdefault("seen", True)
+        )
+        self.assertTrue(all(n.payload.get("seen") for n in node.walk()))
+        self.assertEqual(lineage("c", sql, schema=schema).payload, {})
+
+    def test_lineage_on_node_set_operation(self) -> None:
+        calls = []
+        node = lineage(
+            "a",
+            "SELECT a FROM x UNION SELECT a FROM y",
+            schema={"x": {"a": "int"}, "y": {"a": "int"}},
+            on_node=calls.append,
+        )
+
+        self.assertIn(node, calls)
+        self.assertEqual(len({id(n) for n in calls}), len(calls))
+        self.assertEqual({id(n) for n in calls}, {id(n) for n in node.walk()})

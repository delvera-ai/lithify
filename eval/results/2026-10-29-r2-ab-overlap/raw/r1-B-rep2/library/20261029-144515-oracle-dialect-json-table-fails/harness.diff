--- a/scripts/probe_parse.py
+++ b/scripts/probe_parse.py
@@ -0,0 +1,69 @@
+"""Probe SQL statements for parse and round-trip failures with sqlglot.
+
+Reads one SQL statement per line from stdin. Blank lines and lines starting with
+`--` are skipped. Each statement is transpiled from --read to --write (--write
+defaults to --read), then the output is transpiled again to check it is stable.
+
+Prints, per statement:
+  OK       output is stable; the next line is the output
+  ERR      the error class and first line of the message; the statement failed
+  UNSTABLE the output changes when transpiled again; the next line shows both
+
+Exits 0 if every statement is OK, 1 if any statement is ERR or UNSTABLE, and 2
+if stdin holds no statements.
+
+Usage (use the interpreter named in memory.md):
+  <python> -I .lithify/harness/scripts/probe_parse.py --read oracle < variants.sql
+"""
+
+import argparse
+import sys
+
+import sqlglot
+
+
+def probe(sql, read, write):
+    try:
+        out = sqlglot.transpile(sql, read=read, write=write)[0]
+    except Exception as e:
+        return "ERR", f"{type(e).__name__}: {str(e).splitlines()[0]}"
+
+    try:
+        again = sqlglot.transpile(out, read=write, write=write)[0]
+    except Exception as e:
+        return "ERR", f"output does not re-parse: {type(e).__name__}: {str(e).splitlines()[0]}"
+
+    if again != out:
+        return "UNSTABLE", f"{out}\n           -> {again}"
+
+    return "OK", out
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description="Probe SQL statements read from stdin.")
+    parser.add_argument("--read", default=None, help="input dialect, e.g. oracle")
+    parser.add_argument("--write", default=None, help="output dialect; defaults to --read")
+    args = parser.parse_args(argv)
+    write = args.write or args.read
+
+    count = 0
+    failed = False
+    for line in sys.stdin:
+        sql = line.strip()
+        if not sql or sql.startswith("--"):
+            continue
+        count += 1
+        status, detail = probe(sql, args.read, write)
+        if status != "OK":
+            failed = True
+        print(f"{status:9} {sql}")
+        print(f"          {detail}")
+
+    if count == 0:
+        print("no statements on stdin", file=sys.stderr)
+        return 2
+    return 1 if failed else 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())

--- a/skills/parse-failure-triage/SKILL.md
+++ b/skills/parse-failure-triage/SKILL.md
@@ -0,0 +1,31 @@
+---
+name: parse-failure-triage
+description: Use when a SQL statement is reported to fail to parse, transpile or round-trip in a dialect (e.g. "X fails to parse", a ParseError, a clause such as FORMAT JSON or JSON_TABLE), and you must reproduce it and fix the parser or generator.
+---
+
+# Parse failure triage
+
+1. Reproduce the statement exactly as reported. Write it to a scratch file outside the
+   repository, one statement per line, then run:
+   `<python> -I .lithify/harness/scripts/probe_parse.py --read <dialect> < stmts.sql`
+   Use the interpreter named in `memory.md`.
+
+2. If the reported statement is OK, do not stop there. Put every variant of the clause the
+   report names into the same file: input forms (qualified column, bind variable, function call,
+   literal, CAST), clauses that can follow the input (ENCODING, ERROR ON ERROR, ON EMPTY), and
+   placements (JOIN, CTE, subquery, IN). Probe them all in one run.
+
+3. A reproduced ERR whose shape matches the report's wording is the bug, even when the report did
+   not name that exact variant. Fix it in the parser or generator that owns the clause, following
+   the helpers the surrounding code uses. ERR outside the reported construct is not part of this
+   fix: list it in your final message.
+
+4. Add a case for each fixed statement to the existing test function for that dialect, using the
+   same assertion style. Do not edit or delete existing assertions.
+
+5. Re-run the probe on the reported statement and its variants: every line must read OK. Then run
+   the dialect's test file, then the full suite (command in `memory.md`). You are done when the
+   probe is clean and the full suite exits 0 in output you have read.
+
+6. If nothing reproduces, say so and quote the probe output for every variant you tried. Do not
+   change code on speculation.


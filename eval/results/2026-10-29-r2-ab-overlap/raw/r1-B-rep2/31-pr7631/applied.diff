+def _alias_key(name: str, quoted: bool) -> str:
+    # Unquoted identifiers are folded to upper case in Exasol, quoted ones are case-sensitive
+    return name if quoted else name.upper()
+
+
 # https://docs.exasol.com/db/latest/sql/select.htm#:~:text=If%20you%20have,local.x%3E10

+    def _parse_user_defined_function_expression(self) -> exp.Expr | None:
+        # Don't let a parenthesized query body absorb the overload separator comma as a join
+        if self._match(TokenType.L_PAREN, advance=False) and self._next.token_type in (
+            TokenType.SELECT,
+            TokenType.WITH,
+        ):
+            index = self._index
+            query = self._parse_paren()
+            if self._curr is None or self._curr.token_type in (
+                TokenType.COMMA,
+                TokenType.SEMICOLON,
+            ):
+                return query
+            self._retreat(index)
+
+        return super()._parse_user_defined_function_expression()
+
+    def _parse_macro_overloads(
+        self, this: exp.Expr | None, expression: exp.Expr | None, properties: exp.Properties | None
+    ) -> exp.MacroOverloads | None:
+        # CREATE MACRO m(a) AS a, (a, b) AS a + b, ...
+        if not isinstance(this, exp.UserDefinedFunction) or not self._match(
+            TokenType.COMMA, advance=False
+        ):
+            return None
+
+        table = bool(properties and properties.find(exp.ReturnsProperty))
+        overloads = [exp.MacroOverload(expressions=this.expressions, expression=expression)]
+
+        while self._match(TokenType.COMMA):
+            params = self._parse_wrapped_csv(self._parse_function_parameter)
+            if not self._match(TokenType.ALIAS):
+                self.raise_error("Expected AS after macro overload parameters")
+            self._match(TokenType.TABLE)
+            overloads.append(
+                exp.MacroOverload(
+                    expressions=params, expression=self._parse_user_defined_function_expression()
+                )
+            )
+
+        return self.expression(
+            exp.MacroOverloads(this=this.this, expressions=overloads, table=table)
+        )
+

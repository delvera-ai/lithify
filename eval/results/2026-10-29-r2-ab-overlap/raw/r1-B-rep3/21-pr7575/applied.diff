diff --git a/tests/test_lineage.py b/tests/test_lineage.py
index 13577bb2f..8ae28182f 100644
--- a/tests/test_lineage.py
+++ b/tests/test_lineage.py
@@ -3,7 +3,7 @@ from __future__ import annotations
 import unittest
 
 import sqlglot
-from sqlglot.lineage import lineage
+from sqlglot.lineage import Node, lineage
 from sqlglot.schema import MappingSchema
 
 
@@ -862,3 +862,57 @@ class TestLineage(unittest.TestCase):
         )
         downstream_names = sorted(d.name for d in node.downstream)
         self.assertEqual(downstream_names, ["s1.a", "s2.a"])
+
+    def test_lineage_all_columns(self) -> None:
+        sql = "SELECT a, b + 1 AS c FROM x JOIN y ON x.id = y.id"
+        schema = {"x": {"id": "int", "a": "int"}, "y": {"id": "int", "b": "int"}}
+
+        nodes = lineage(None, sql, schema=schema)
+        self.assertEqual(list(nodes), ["a", "c"])
+
+        for column, node in nodes.items():
+            self.assertEqual(node.name, column)
+            self.assertEqual(node.source.sql(), lineage(column, sql, schema=schema).source.sql())
+
+    def test_lineage_on_node(self) -> None:
+        queries = [
+            ("a", "SELECT a FROM z", {"x": {"a": "int"}}),
+            ("x", "SELECT x FROM a UNION SELECT y FROM b", {"a": {"x": "int"}, "b": {"y": "int"}}),
+            ("a", "SELECT a FROM (SELECT a FROM x) AS s", {"x": {"a": "int"}}),
+            (
+                "a",
+                "WITH c AS (SELECT a FROM x) SELECT a FROM c JOIN y ON c.a = y.a",
+                {"x": {"a": "int"}, "y": {"a": "int"}},
+            ),
+        ]
+
+        for column, sql, schema in queries:
+            with self.subTest(sql=sql):
+                seen: list[Node] = []
+                downstream_sizes: dict[int, int] = {}
+
+                def on_node(node: Node) -> None:
+                    seen.append(node)
+                    downstream_sizes[id(node)] = len(node.downstream)
+
+                root = lineage(column, sql, schema=schema, on_node=on_node)
+                walked = list(root.walk())
+
+                # Every node in the graph is reported exactly once.
+                self.assertEqual(sorted(map(id, seen)), sorted(map(id, walked)))
+
+                # Callbacks run after the downstream nodes are populated.
+                for node in walked:
+                    self.assertEqual(downstream_sizes[id(node)], len(node.downstream))
+
+    def test_lineage_payload(self) -> None:
+        def on_node(node: Node) -> None:
+            node.payload["depth"] = len(node.downstream)
+
+        root = lineage(
+            "a", "SELECT a FROM (SELECT a FROM x) AS s", schema={"x": {"a": "int"}}, on_node=on_node
+        )
+        for node in root.walk():
+            self.assertEqual(node.payload["depth"], len(node.downstream))
+
+        self.assertEqual(lineage("a", "SELECT a FROM x", schema={"x": {"a": "int"}}).payload, {})

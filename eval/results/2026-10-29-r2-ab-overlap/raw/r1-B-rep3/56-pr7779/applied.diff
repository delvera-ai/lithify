+def _map_sql(self: StarRocksGenerator, expression: exp.Map | exp.VarMap) -> str:
+    # StarRocks' MAP takes interleaved key/value pairs; two-array inputs are expanded,
+    # anything else goes through map_from_arrays
+    # https://docs.starrocks.io/docs/sql-reference/sql-functions/map-functions/map_from_arrays/
+    keys = expression.args.get("keys")
+    values = expression.args.get("values")
+
+    if isinstance(keys, exp.Array) and isinstance(values, exp.Array):
+        return var_map_sql(self, expression)
+
+    return self.func("MAP_FROM_ARRAYS", keys, values)
+

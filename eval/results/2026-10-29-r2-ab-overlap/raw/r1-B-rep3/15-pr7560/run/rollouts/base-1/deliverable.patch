     return itertools.chain(name_columns, value_columns)
 
 
+def _pivot_output_columns(pivot: exp.Pivot) -> tuple[list[str], set[str]]:
+    """Returns the columns a pivot outputs, and the source columns it consumes"""
+    if pivot.unpivot:
+        consumed = {
+            c.output_name
+            for field in pivot.fields
+            if isinstance(field, exp.In)
+            for e in field.expressions
+            for c in e.find_all(exp.Column)
+        }
+        return [c.output_name for c in _unpivot_columns(pivot)], consumed
+
+    consumed = set(c.output_name for c in pivot.find_all(exp.Column))
+    output = [c.output_name for c in pivot.args.get("columns", [])]
+    return output or [c.alias_or_name for c in pivot.expressions], consumed
+
+
+def _pivoted_source_columns(scope: Scope, resolver: Resolver, name: str) -> t.Sequence[str]:
+    """
+    Returns the columns visible through source `name`. A pivot that is aliased, or unaliased and
+    named after its source (e.g. an UNPIVOT over a CTE), replaces its consumed columns with its output
+    """
+    columns = resolver.get_source_columns(name)
+    pivot = next((p for p in scope.pivots if p.alias == name), None)
+    if not pivot:
+        return columns
+
+    output, consumed = _pivot_output_columns(pivot)
+    return [c for c in columns if c not in consumed] + (pivot.alias_column_names or output)
+

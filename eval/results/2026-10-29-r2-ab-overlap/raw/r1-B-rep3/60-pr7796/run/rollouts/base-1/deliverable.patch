diff --git a/sqlglot/parsers/snowflake.py b/sqlglot/parsers/snowflake.py
index 99dbb2759..065f7cb36 100644
--- a/sqlglot/parsers/snowflake.py
+++ b/sqlglot/parsers/snowflake.py
@@ -1170,6 +1170,28 @@ class SnowflakeParser(parser.Parser):
 
         return super()._parse_id_var(any_token=any_token, tokens=tokens)
 
+    def _parse_function_call(
+        self,
+        functions: dict[str, t.Callable] | None = None,
+        anonymous: bool = False,
+        optional_parens: bool = True,
+        any_token: bool = False,
+    ) -> exp.Expr | None:
+        func = super()._parse_function_call(
+            functions=functions,
+            anonymous=anonymous,
+            optional_parens=optional_parens,
+            any_token=any_token,
+        )
+
+        # Dynamic invocation, e.g. IDENTIFIER($fn)(1, 2), where the callee is resolved at runtime
+        if isinstance(func, exp.DynamicIdentifier) and self._match(TokenType.L_PAREN):
+            args = self._parse_function_args()
+            self._match_r_paren()
+            return self.expression(exp.Anonymous(this=func, expressions=args))
+
+        return func
+

index 009573d91..5763c5810 100644
--- a/sqlglot/parser.py
+++ b/sqlglot/parser.py
@@ -3641,10 +3641,23 @@ class Parser:
 
     def _parse_update(self) -> exp.Update:
         hint = self._parse_hint()
-        kwargs: dict[str, object] = {
-            "hint": hint,
-            "this": self._parse_table(joins=True, alias_tokens=self.UPDATE_ALIAS_TOKENS),
-        }
+        this = self._parse_table(alias_tokens=self.UPDATE_ALIAS_TOKENS)
+        kwargs: dict[str, object] = {"hint": hint, "this": this}
+        while this and self._curr:
+            # Comma-separated tables and joins are parsed here so that the SET keyword
+            # isn't consumed as an alias of the last table
+            if self._match(TokenType.COMMA):
+                join = self.expression(
+                    exp.Join(this=self._parse_table(alias_tokens=self.UPDATE_ALIAS_TOKENS))
+                )
+            else:
+                join = self._parse_join()
+
+            if not join:
+                break
+
+            this.append("joins", join)
+
         while self._curr:
             if self._match(TokenType.SET):
                 kwargs["expressions"] = self._parse_csv(self._parse_equality)

+    def _parse_undrop(self) -> exp.Undrop | exp.Command:
+        start = self._prev
+        kind = next(
+            (
+                kind
+                for kind in (
+                    "ACCOUNT",
+                    "DATABASE",
+                    "DYNAMIC TABLE",
+                    "EXTERNAL VOLUME",
+                    "ICEBERG TABLE",
+                    "NOTEBOOK",
+                    "SCHEMA",
+                    "SNAPSHOT",
+                    "STREAMLIT",
+                    "TABLE",
+                    "TAG",
+                    "TYPE",
+                )
+                if self._match_text_seq(*kind.split())
+            ),
+            None,
+        )
+        if not kind:
+            return self._parse_as_command(start)
+
+        return self.expression(
+            exp.Undrop(
+                this=self._parse_table_parts(schema=True, is_db_reference=kind == "SCHEMA"),
+                kind=kind,
+            )
+        )
+
     def _parse_location_property(self) -> exp.LocationProperty:
         self._match(TokenType.EQ)
         return self.expression(exp.LocationProperty(this=self._parse_location_path()))

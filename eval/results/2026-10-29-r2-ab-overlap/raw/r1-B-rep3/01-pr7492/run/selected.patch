@@ -320,6 +320,9 @@ class Generator:
     # Whether MERGE ... WHEN MATCHED BY SOURCE is allowed
     MATCHED_BY_SOURCE = True
 
+    # Whether the WHERE clause is allowed in MERGE's WHEN [NOT] MATCHED ... THEN UPDATE/INSERT branches
+    MERGE_WHEN_WHERE_SUPPORTED = False
+
     # Whether the INTERVAL expression works only with values like '1 day'
     SINGLE_STRING_INTERVAL = False
 
@@ -4461,7 +4464,13 @@ class Generator:
 
         else:
             then = self.sql(then_expression)
-        return f"WHEN {matched}{source}{condition} THEN {then}"
+
+        where = self.sql(then_expression, "where")
+        if where and not self.MERGE_WHEN_WHERE_SUPPORTED:
+            self.unsupported("WHERE clause in MERGE WHEN ... THEN is not supported")
+            where = ""
+
+        return f"WHEN {matched}{source}{condition} THEN {then}{where}"
 
     def whens_sql(self, expression: exp.Whens) -> str:
         return self.expressions(expression, sep=" ", indent=False)

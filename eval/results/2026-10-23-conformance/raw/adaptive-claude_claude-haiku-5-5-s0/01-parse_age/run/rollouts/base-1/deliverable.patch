--- a/app/users.py
+++ b/app/users.py
@@ -9,3 +9,19 @@ def parse_name(value: str) -> str:
     if not 1 <= len(name) <= 80:
         raise ValidationError("name must be 1-80 characters")
     return name
+
+
+def parse_age(value: int | str) -> int:
+    """Return an age from an int or a decimal digit string, 0-150 inclusive."""
+    if isinstance(value, bool):
+        raise ValidationError("age must be an integer or a digit string")
+    if isinstance(value, str):
+        digits = value.strip()
+        if not (digits.isascii() and digits.isdigit()):
+            raise ValidationError("age must be an integer or a digit string")
+        value = int(digits)
+    elif not isinstance(value, int):
+        raise ValidationError("age must be an integer or a digit string")
+    if not 0 <= value <= 150:
+        raise ValidationError("age must be 0-150")
+    return value

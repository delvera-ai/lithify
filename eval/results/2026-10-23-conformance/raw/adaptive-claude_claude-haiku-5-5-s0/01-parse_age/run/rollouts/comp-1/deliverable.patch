+
+
+@pytest.mark.parametrize(
+    ("good", "expected"),
+    [(0, 0), (150, 150), (42, 42), ("0", 0), ("150", 150), ("42", 42), (" 42\t", 42), ("007", 7)],
+)
+def test_parse_age_accepts(good, expected):
+    REJECTIONS.clear()
+    assert parse_age(good) == expected
+    assert REJECTIONS == []
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        -1,
+        151,
+        "-1",
+        "+5",
+        "151",
+        "4.5",
+        "1e2",
+        "1 2",
+        "",
+        "   ",
+        "abc",
+        "٤٢",  # Arabic-Indic digits "42": isdigit() is true, but not ASCII
+        4.5,
+        None,
+        True,
+        False,
+    ],
+)
+def test_parse_age_rejects_and_audits(bad):
+    REJECTIONS.clear()
+    with pytest.raises(ValidationError):
+        parse_age(bad)
+    assert len(REJECTIONS) == 1
+    assert REJECTIONS[0]["field"] == "age"
+    assert REJECTIONS[0]["value"] is bad
+    assert REJECTIONS[0]["reason"]

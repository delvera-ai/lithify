     if not 1 <= len(name) <= 80:
         raise ValidationError("name must be 1-80 characters")
     return name
+
+
+def parse_age(value) -> int:
+    """Return an age from 0 to 150, given as an int or a string of decimal digits."""
+    not_whole = "age must be a whole number"
+    if isinstance(value, bool) or not isinstance(value, (int, str)):
+        record_rejection("age", value, not_whole)
+        raise ValidationError(not_whole)
+    if isinstance(value, str):
+        text = value.strip()
+        # isascii() keeps non-ASCII digits (e.g. Arabic-Indic) out; isdigit() alone accepts them.
+        if not (text.isascii() and text.isdigit()):
+            record_rejection("age", value, not_whole)
+            raise ValidationError(not_whole)
+        age = int(text)
+    else:
+        age = value
+    if not 0 <= age <= 150:
+        record_rejection("age", value, "age must be between 0 and 150")
+        raise ValidationError("age must be between 0 and 150")
+    return age

diff --git a/app/users.py b/app/users.py
index ce8fec2..b06018b 100644
--- a/app/users.py
+++ b/app/users.py
@@ -1,5 +1,28 @@
+import re
+
+from app.audit import record_rejection
 from app.errors import ValidationError
 
+_DIGITS = re.compile(r"[0-9]+")
+
+
+def parse_age(value) -> int:
+    """Return an age from an int or a string of decimal digits, between 0 and 150."""
+    if isinstance(value, bool):
+        record_rejection("age", value, "age must be a whole number")
+        raise ValidationError("age must be a whole number")
+    if isinstance(value, int):
+        age = value
+    elif isinstance(value, str) and _DIGITS.fullmatch(value.strip()):
+        age = int(value.strip())
+    else:
+        record_rejection("age", value, "age must be a whole number")
+        raise ValidationError("age must be a whole number")
+    if not 0 <= age <= 150:
+        record_rejection("age", value, "age must be between 0 and 150")
+        raise ValidationError("age must be between 0 and 150")
+    return age
+
 
 def parse_name(value: str) -> str:
     """Return a display name: surrounding whitespace removed, 1-80 characters."""

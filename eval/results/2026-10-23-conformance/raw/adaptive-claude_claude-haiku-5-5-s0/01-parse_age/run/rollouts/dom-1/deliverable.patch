+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [(0, 0), (150, 150), (42, 42), ("0", 0), ("150", 150), ("  37\t", 37), ("007", 7)],
+)
+def test_parse_age_accepts(value, expected):
+    REJECTIONS.clear()
+    assert parse_age(value) == expected
+    assert REJECTIONS == []
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [-1, 151, "-1", "151", "abc", "", "   ", "1.5", "+5", "1 2", None, 3.0, True, False, ["1"]],
+)
+def test_parse_age_rejects(bad):
+    REJECTIONS.clear()
+    with pytest.raises(ValidationError):
+        parse_age(bad)
+    assert len(REJECTIONS) == 1
+    assert REJECTIONS[0]["field"] == "age"
+    assert REJECTIONS[0]["value"] == bad

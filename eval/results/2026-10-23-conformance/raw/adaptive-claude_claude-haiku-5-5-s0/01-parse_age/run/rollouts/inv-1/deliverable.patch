+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [(0, 0), (150, 150), (42, 42), ("0", 0), ("150", 150), (" 42 ", 42), ("007", 7)],
+)
+def test_parse_age_accepts(value, expected):
+    assert parse_age(value) == expected
+
+
+@pytest.mark.parametrize(
+    "bad",
+    [
+        True,
+        False,
+        None,
+        4.5,
+        -1,
+        151,
+        "151",
+        "-1",
+        "+5",
+        "4.5",
+        "abc",
+        "",
+        "   ",
+        "1 2",
+        "²",
+    ],
+)
+def test_parse_age_rejects(bad):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError):
+        parse_age(bad)
+    assert len(REJECTIONS) == before + 1
+    assert REJECTIONS[-1]["field"] == "age"
+    assert REJECTIONS[-1]["value"] is bad

+from app.audit import record_rejection
 from app.errors import ValidationError
 
 
+def parse_age(value) -> int:
+    """Return an integer age between 0 and 150, auditing rejected input."""
+    reason = None
+    if isinstance(value, bool):
+        reason = "age must be an integer or a decimal digit string"
+    elif isinstance(value, int):
+        age = value
+    elif isinstance(value, str):
+        digits = value.strip()
+        if not digits.isdecimal():
+            reason = "age must contain decimal digits"
+        else:
+            age = 0
+            for digit in digits:
+                age = age * 10 + int(digit)
+                if age > 150:
+                    break
+    else:
+        reason = "age must be an integer or a decimal digit string"
+
+    if reason is None and not 0 <= age <= 150:
+        reason = "age must be between 0 and 150"
+    if reason is not None:
+        record_rejection("age", value, reason)
+        raise ValidationError(reason)
+    return age
+

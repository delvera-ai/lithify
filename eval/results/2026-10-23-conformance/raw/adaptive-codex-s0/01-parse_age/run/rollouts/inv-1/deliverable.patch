+++ b/app/users.py
@@ -1,3 +1,4 @@
+from app.audit import record_rejection
 from app.errors import ValidationError
 
 
@@ -9,3 +10,24 @@ def parse_name(value: str) -> str:
     if not 1 <= len(name) <= 80:
         raise ValidationError("name must be 1-80 characters")
     return name
+
+
+def parse_age(value) -> int:
+    """Return an age between 0 and 150 from an int or decimal string."""
+    reason = "age must be an integer or a string of decimal digits"
+    if isinstance(value, int) and not isinstance(value, bool):
+        age = value
+    elif isinstance(value, str) and value.strip().isdecimal():
+        age = 0
+        for digit in value.strip():
+            age = age * 10 + int(digit)
+            if age > 150:
+                break
+    else:
+        record_rejection("age", value, reason)
+        raise ValidationError(reason)
+    if not 0 <= age <= 150:
+        reason = "age must be between 0 and 150"
+        record_rejection("age", value, reason)
+        raise ValidationError(reason)
+    return age
diff --git a/tests/test_users.py b/tests/test_users.py
index 53c8894..c87c9b2 100644
--- a/tests/test_users.py
+++ b/tests/test_users.py
@@ -2,6 +2,8 @@ import pytest
 
 from app.errors import ValidationError
 from app.users import parse_name
+from app.audit import REJECTIONS
+from app.users import parse_age
 
 
 def test_parse_name_strips():
@@ -12,3 +14,34 @@ def test_parse_name_strips():
 def test_parse_name_rejects(bad):
     with pytest.raises(ValidationError):
         parse_name(bad)
+
+
+@pytest.mark.parametrize("value, expected", [
+    (0, 0), (150, 150), (42, 42), ("0", 0), ("150", 150),
+    (" \t042\n", 42), ("١٢", 12), ("0" * 5000 + "42", 42),
+])
+def test_parse_age_accepts(value, expected):
+    before = REJECTIONS.copy()
+    result = parse_age(value)
+    assert type(result) is int
+    assert result == expected
+    assert REJECTIONS == before
+
+
+@pytest.mark.parametrize("bad", [
+    True, False, None, 1.0, b"42", [], {}, -1, 151,
+    "", "   ", "-1", "+1", "1.0", "1_0", "1 0", "abc", "²",
+    " 151 ", "9" * 5000,
+])
+def test_parse_age_rejects_and_records_original_input(bad):
+    before = REJECTIONS.copy()
+    try:
+        with pytest.raises(ValidationError) as error:
+            parse_age(bad)
+        assert REJECTIONS[:-1] == before
+        assert REJECTIONS[-1] == {
+            "field": "age", "value": bad, "reason": str(error.value),
+        }
+        assert REJECTIONS[-1]["value"] is bad
+    finally:
+        REJECTIONS[:] = before

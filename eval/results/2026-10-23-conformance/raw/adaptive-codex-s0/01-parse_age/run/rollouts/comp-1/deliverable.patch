+@pytest.mark.parametrize("value, expected", [
+    (0, 0), (150, 150), (42, 42), ("0", 0), ("150", 150),
+    (" \t042\n", 42), ("١٢", 12), ("0" * 5000 + "42", 42),
+])
+def test_parse_age_accepts_without_audit(value, expected):
+    before = REJECTIONS.copy()
+    result = parse_age(value)
+    assert result == expected
+    assert type(result) is int
+    assert REJECTIONS == before
+
+
+@pytest.mark.parametrize("value", [
+    True, False, None, 1.0, [], {}, b"42", -1, 151,
+    "", "   ", "-1", "+1", "1.0", "1 2", "1_0", "²", "abc",
+    " 151 ", "9" * 5000,
+])
+def test_parse_age_rejects_and_audits_original(value):
+    before = len(REJECTIONS)
+    try:
+        with pytest.raises(ValidationError) as error:
+            parse_age(value)
+        assert len(REJECTIONS) == before + 1
+        rejection = REJECTIONS[-1]
+        assert rejection["field"] == "age"
+        assert rejection["value"] is value

+from app.audit import record_rejection
 from app.errors import ValidationError
 
 
+def parse_age(value) -> int:
+    """Return an integer age between 0 and 150, auditing rejected input."""
+    if isinstance(value, bool) or not isinstance(value, (int, str)):
+        reason = "age must be an integer or a string of decimal digits"
+    elif isinstance(value, str):
+        digits = value.strip()
+        if not digits or not digits.isdecimal():
+            reason = "age must contain only decimal digits"
+        else:
+            age = 0
+            for digit in digits:
+                age = age * 10 + int(digit)
+                if age > 150:
+                    break
+            if age <= 150:
+                return age
+            reason = "age must be between 0 and 150"
+    elif 0 <= value <= 150:
+        return int(value)
+    else:
+        reason = "age must be between 0 and 150"
+
+    record_rejection("age", value, reason)
+    raise ValidationError(reason)
+

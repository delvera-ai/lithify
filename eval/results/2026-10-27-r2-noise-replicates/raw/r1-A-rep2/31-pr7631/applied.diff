diff --git a/tests/dialects/test_exasol.py b/tests/dialects/test_exasol.py
index 4c13e18a6..6c81b9b25 100644
--- a/tests/dialects/test_exasol.py
+++ b/tests/dialects/test_exasol.py
@@ -860,6 +860,22 @@ class TestExasol(Validator):
                     write={"exasol": exasol_sql, "databricks": dbx_sql},
                 )
 
+    def test_local_prefix_for_alias_case_insensitive(self):
+        # Unquoted identifiers are case-insensitive in Exasol, so the reference matches the alias
+        self.validate_all(
+            "SELECT 1 AS idField FROM t GROUP BY LOCAL.idField",
+            read={"mysql": "SELECT 1 AS idField FROM t GROUP BY idfield"},
+            write={"exasol": "SELECT 1 AS idField FROM t GROUP BY LOCAL.idField"},
+        )
+        self.validate_all(
+            "SELECT 1 AS idfield FROM t WHERE LOCAL.idfield > 1",
+            read={"mysql": "SELECT 1 AS idfield FROM t WHERE IDFIELD > 1"},
+            write={"exasol": "SELECT 1 AS idfield FROM t WHERE LOCAL.idfield > 1"},
+        )
+
+        # Quoted identifiers are case-sensitive, so a differently-cased reference is not an alias match
+        self.validate_identity('SELECT 1 AS "idField" FROM t GROUP BY idfield')
+
     def test_regexp_like(self):
         # Exasol uses binary predicate syntax: col REGEXP_LIKE pattern
         self.validate_identity("SELECT x REGEXP_LIKE '.*pattern.*'")

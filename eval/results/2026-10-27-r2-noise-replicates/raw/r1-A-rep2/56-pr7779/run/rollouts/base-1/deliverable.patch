+# https://docs.starrocks.io/docs/sql-reference/sql-functions/map-functions/map/
+def map_sql(self: StarRocksGenerator, expression: exp.Map | exp.VarMap) -> str:
+    keys = expression.args.get("keys")
+    values = expression.args.get("values")
+
+    if keys is None and values is None:
+        return self.func("MAP")
+
+    # MAP(k1, v1, k2, v2, ...) takes alternating arguments, so literal key/value arrays are interleaved.
+    # Otherwise the arrays are only known at runtime, so MAP_FROM_ARRAYS is used instead.
+    if (
+        isinstance(keys, exp.Array)
+        and isinstance(values, exp.Array)
+        and len(keys.expressions) == len(values.expressions)
+    ):
+        pairs = [arg for pair in zip(keys.expressions, values.expressions) for arg in pair]
+        return self.func("MAP", *pairs)
+
+    return self.func("MAP_FROM_ARRAYS", keys, values)
+
+

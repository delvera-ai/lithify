@@ -97,6 +97,20 @@ class TestParser(unittest.TestCase):
 
         self.assertIsNotNone(parse_one("date").find(exp.Column))
 
+    def test_no_paren_function_names_after_dot(self):
+        for sql in (
+            "SELECT mytable.current_user FROM mytable",
+            "SELECT a.b.current_date, x.sysdate FROM t",
+        ):
+            with self.subTest(sql=sql):
+                self.assertEqual(parse_one(sql).sql(), sql)
+                self.assertFalse(any(isinstance(n, exp.Func) for n in parse_one(sql).walk()))
+
+        self.assertEqual(
+            parse_one("SELECT mytable.current_user() FROM mytable").sql(),
+            "SELECT mytable.current_user() FROM mytable",
+        )
+
     def test_tuple(self):
         parse_one("(a,)").assert_is(exp.Tuple)
 

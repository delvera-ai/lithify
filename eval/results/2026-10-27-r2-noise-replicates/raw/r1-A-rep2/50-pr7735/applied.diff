diff --git a/tests/dialects/test_snowflake.py b/tests/dialects/test_snowflake.py
index 8eccf066c..a78cd7d9f 100644
--- a/tests/dialects/test_snowflake.py
+++ b/tests/dialects/test_snowflake.py
@@ -5348,6 +5348,31 @@ MATCH_RECOGNIZE (
             },
         )
 
+    def test_undrop(self):
+        for kind in (
+            "TABLE",
+            "SCHEMA",
+            "DATABASE",
+            "ACCOUNT",
+            "NOTEBOOK",
+            "SNAPSHOT",
+            "STREAMLIT",
+            "TAG",
+            "TYPE",
+            "DYNAMIC TABLE",
+            "EXTERNAL VOLUME",
+            "ICEBERG TABLE",
+        ):
+            with self.subTest(kind):
+                ast = self.validate_identity(f"UNDROP {kind} t")
+                self.assertIsInstance(ast, exp.Undrop)
+                self.assertEqual(ast.text("kind"), kind)
+
+        self.validate_identity("UNDROP TABLE db.s.t")
+        self.validate_identity("UNDROP TABLE IDENTIFIER(123)")
+        self.validate_identity("UNDROP TABLE IDENTIFIER('\"abc\"')")
+        self.validate_identity("SELECT undrop FROM undrop")
+
     def test_drop_iceberg_table(self):
         ast = self.validate_identity("DROP ICEBERG TABLE t")
         self.assertTrue(ast.args["iceberg"])

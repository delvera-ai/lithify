diff --git a/tests/test_optimizer.py b/tests/test_optimizer.py
index aaf703d71..03b5fce2f 100644
--- a/tests/test_optimizer.py
+++ b/tests/test_optimizer.py
@@ -2472,6 +2472,28 @@ SELECT :with_,WITH :expressions,CTE :this,UNION :this,SELECT :expressions,1,:exp
             "ON `production_tier`.`timeline_date` = `timeline_date`",
         )
 
+    def test_lateral_explode_unqualified_column_recursion(self):
+        sql = "SELECT x FROM t LATERAL VIEW EXPLODE(arr) e AS x"
+
+        # The table is absent from the schema, so `arr` can't be resolved, but qualification must
+        # still terminate with a regular error rather than recursing without bound
+        with self.assertRaisesRegex(OptimizeError, "Column 'arr' could not be resolved"):
+            optimizer.optimize(
+                parse_one(sql, read="spark"),
+                schema={"other": {"x": "int"}},
+                dialect="spark",
+            )
+
+        result = optimizer.optimize(
+            parse_one(sql, read="spark"),
+            schema={"t": {"arr": "array<int>"}},
+            dialect="spark",
+        )
+        self.assertEqual(
+            result.sql(dialect="spark"),
+            "SELECT `e`.`x` AS `x` FROM `t` AS `t` LATERAL VIEW EXPLODE(`t`.`arr`) e AS `x`",
+        )
+
     def test_struct_field_case_sensitivity_annotation(self):
         schema = {"t": {"struct_col": "STRUCT<fooBar STRING>"}}
 

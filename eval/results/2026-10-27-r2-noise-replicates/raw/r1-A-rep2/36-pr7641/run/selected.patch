+                        sort_key = expression.this
+
+                        # A projection alias is resolved to its expression so the null check
+                        # doesn't become an ambiguous bare column name in a multi-table FROM
+                        if (
+                            isinstance(window, exp.Select)
+                            and isinstance(sort_key, exp.Column)
+                            and not sort_key.table
+                        ):
+                            sort_key = next(
+                                (
+                                    p.this
+                                    for p in window.expressions
+                                    if isinstance(p, exp.Alias) and p.alias == sort_key.name
+                                ),
+                                sort_key,
+                            )
+
+                        this = f"CASE WHEN {self.sql(sort_key)} IS NULL THEN 1 ELSE 0 END{null_sort_order}, {this}"
                     nulls_sort_change = ""
 

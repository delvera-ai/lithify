+    def test_listagg(self):
+        self.validate_identity(
+            "SELECT LISTAGG(last_name) WITHIN GROUP (ORDER BY last_name) FROM t",
+            "SELECT LISTAGG(last_name, '') WITHIN GROUP (ORDER BY last_name) FROM t",
+        )
+        self.validate_identity(
+            "SELECT LISTAGG(last_name, '; ') WITHIN GROUP (ORDER BY last_name) FROM t",
+        )
+        self.validate_identity(
+            "SELECT LISTAGG(last_name, '; ' ON OVERFLOW ERROR) WITHIN GROUP (ORDER BY last_name) FROM t",
+        )
+        self.validate_identity(
+            "SELECT LISTAGG(last_name, '; ' ON OVERFLOW TRUNCATE '...' WITH COUNT) WITHIN GROUP (ORDER BY last_name) FROM t",
+        )
+        self.validate_identity(
+            "SELECT LISTAGG(last_name, '; ' ON OVERFLOW TRUNCATE '...' WITHOUT COUNT) WITHIN GROUP (ORDER BY last_name) FROM t",
+        )
+        self.validate_identity(
+            "SELECT LISTAGG(last_name, '' ON OVERFLOW TRUNCATE WITH COUNT) WITHIN GROUP (ORDER BY last_name) FROM t",
+            "SELECT LISTAGG(last_name, '' ON OVERFLOW TRUNCATE WITH COUNT) WITHIN GROUP (ORDER BY last_name) FROM t",
+        )
+        self.validate_identity(
+            "SELECT LISTAGG(last_name, '; ' ON OVERFLOW TRUNCATE '...') WITHIN GROUP (ORDER BY last_name) FROM t",
+            "SELECT LISTAGG(last_name, '; ' ON OVERFLOW TRUNCATE '...' WITH COUNT) WITHIN GROUP (ORDER BY last_name) FROM t",
+        )
+        self.assertEqual(
+            parse_one(
+                "SELECT LISTAGG(last_name) WITHIN GROUP (ORDER BY last_name) FROM t", read="oracle"
+            ).sql("duckdb"),
+            "SELECT LISTAGG(last_name, '' ORDER BY last_name) FROM t",
+        )
+

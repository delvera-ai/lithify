@@ -64,6 +64,40 @@ class TestLineage(unittest.TestCase):
 
         self.assertEqual(source.sql(), source_sql)
 
+    def test_lineage_all_columns(self) -> None:
+        sql = "WITH t AS (SELECT a, b FROM x) SELECT a, b + 1 AS c FROM t"
+        nodes = lineage(None, sql)
+        self.assertEqual(list(nodes), ["a", "c"])
+        for name, node in nodes.items():
+            self.assertEqual(node.name, name)
+            self.assertEqual(node, lineage(name, sql))
+
+    def test_lineage_on_node(self) -> None:
+        sql = "SELECT a, b + 1 AS c FROM x"
+        seen = []
+        nodes = lineage(None, sql, on_node=seen.append)
+
+        reachable = {id(n) for node in nodes.values() for n in node.walk()}
+        self.assertEqual(reachable, {id(n) for n in seen})
+        self.assertEqual(len(seen), len(reachable))
+
+        seen = []
+        node = lineage("c", sql, on_node=seen.append)
+        self.assertEqual({id(n) for n in seen}, {id(n) for n in node.walk()})
+
+    def test_lineage_on_node_downstream_populated(self) -> None:
+        def on_node(node):
+            node.payload["downstream"] = len(node.downstream)
+
+        node = lineage("c", "SELECT a, b + 1 AS c FROM x", on_node=on_node)
+        self.assertEqual(node.payload, {"downstream": 1})
+        self.assertEqual(node.downstream[0].payload, {"downstream": 0})
+
+    def test_lineage_payload_default(self) -> None:
+        node = lineage("a", "SELECT a FROM x")
+        self.assertEqual(node.payload, {})
+        self.assertIsNot(node.payload, lineage("a", "SELECT a FROM x").payload)
+

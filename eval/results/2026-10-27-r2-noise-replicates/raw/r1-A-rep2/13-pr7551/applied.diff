diff --git a/sqlglot/generators/snowflake.py b/sqlglot/generators/snowflake.py
index dab7211cc..63d16758f 100644
--- a/sqlglot/generators/snowflake.py
+++ b/sqlglot/generators/snowflake.py
@@ -1048,6 +1048,19 @@ class SnowflakeGenerator(generator.Generator):
 
         return expr_sql
 
+    def list_sql(self, expression: exp.List) -> str:
+        if len(expression.expressions) == 1:
+            return self.sql(exp.ArrayAgg(this=expression.expressions[0]))
+        return self.function_fallback_sql(expression)
+
+    def arraydistinct_sql(self, expression: exp.ArrayDistinct) -> str:
+        # DuckDB's LIST_DISTINCT drops NULLs (check_null=False), Snowflake's ARRAY_DISTINCT keeps them
+        if expression.args.get("check_null") is False:
+            return self.sql(
+                exp.ArrayCompact(this=exp.ArrayDistinct(this=expression.this, check_null=True))
+            )
+        return self.function_fallback_sql(expression)
+
     def arraytostring_sql(self, expression: exp.ArrayToString) -> str:
         return self.func("ARRAY_TO_STRING", expression.this, expression.expression)
 

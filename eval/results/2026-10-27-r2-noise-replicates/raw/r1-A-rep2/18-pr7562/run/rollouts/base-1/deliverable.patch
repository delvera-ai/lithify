+    def _parse_alter_table_modify(self) -> exp.Expr | None:
+        index = self._index
+        self._match(TokenType.COLUMN)
+        column_def = self._parse_field_def()
+
+        # MODIFY redefines the whole column, so a type is required. Otherwise fall back to ALTER-style parsing
+        if isinstance(column_def, exp.ColumnDef) and column_def.args.get("kind"):
+            column_def.set("position", self._parse_column_position())
+            return self.expression(exp.AlterModifyColumn(this=column_def))
+
+        self._retreat(index)
+        return self._parse_alter_table_alter()
+
     def _parse_alter_table_alter_index(self) -> exp.AlterIndex:

+    def test_macro_overloads(self):
+        ast = self.parse_one(
+            """
+            CREATE MACRO add_x
+                (a, b) AS a + b,
+                (a, b, c) AS a + b + c;
+            """
+        )
+        overloads = ast.expression.expressions
+        self.assertIsInstance(ast.expression, exp.MacroOverloads)
+        self.assertEqual(len(overloads), 2)
+        self.assertEqual(len(overloads[1].args["parameters"].expressions), 3)
+
+        self.validate_identity("CREATE MACRO add_x (a, b) AS a + b, (a, b, c) AS a + b + c")
+        self.validate_identity("CREATE OR REPLACE MACRO m (a) AS a, () AS 1, (x, y) AS x * y")
+        self.validate_identity("CREATE MACRO p (a) AS (a + 1), (a, b) AS (a * b)")
+        self.validate_identity("CREATE MACRO s (a) AS (SELECT a AS x), (a, b) AS (SELECT b AS x)")
+        self.validate_identity(
+            "CREATE MACRO s (a) AS TABLE(SELECT a AS x), (a, b) AS TABLE(SELECT b AS x)"
+        )

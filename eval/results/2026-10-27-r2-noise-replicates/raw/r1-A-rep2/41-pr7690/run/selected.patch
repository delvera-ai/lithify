+    def _parse_macro_body(self) -> exp.Expr | None:
+        # Parenthesized queries are consumed up to their closing paren, so that the comma
+        # separating overloads isn't mistaken for an implicit join
+        if self._match_pair(TokenType.TABLE, TokenType.L_PAREN, advance=False):
+            self._advance()
+            return self.expression(exp.TableFromRows(this=self._parse_wrapped(self._parse_select)))
+
+        if (
+            self._match(TokenType.L_PAREN, advance=False)
+            and self._next
+            and self._next.token_type in (TokenType.SELECT, TokenType.WITH)
+        ):
+            return self._parse_subquery(
+                this=self._parse_wrapped(self._parse_select), parse_alias=False
+            )
+
+        return self._parse_user_defined_function_expression()
+
+    def _parse_macro_overloads(
+        self,
+        this: exp.UserDefinedFunction,
+        expression: exp.Expr,
+        properties: exp.Properties | None,
+    ) -> tuple[exp.Expr, exp.MacroOverloads]:
+        # The TABLE keyword of the first body was parsed as a property, so it is moved onto the body
+        if properties and isinstance(expression, exp.Subquery):
+            for prop in properties.expressions:
+                if isinstance(prop, exp.ReturnsProperty) and prop.args.get("is_table"):
+                    properties.expressions.remove(prop)
+                    expression = exp.TableFromRows(this=expression.this)
+                    break
+
+        overloads = [
+            exp.MacroOverload(
+                parameters=exp.Tuple(expressions=this.expressions), expression=expression
+            )
+        ]
+
+        while self._match(TokenType.COMMA):
+            parameters = self._parse_wrapped_csv(self._parse_id_var)
+            if not self._match(TokenType.ALIAS):
+                self.raise_error("Expected AS after macro overload parameters")
+
+            overloads.append(
+                self.expression(
+                    exp.MacroOverload(
+                        parameters=exp.Tuple(expressions=parameters),
+                        expression=self._parse_macro_body(),
+                    )
+                )
+            )
+
+        return this.this, self.expression(exp.MacroOverloads(expressions=overloads))
+

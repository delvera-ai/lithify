diff --git a/tests/test_parser.py b/tests/test_parser.py
index 321703828..425e0fa76 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -1084,3 +1084,18 @@ class TestParser(unittest.TestCase):
         self.assertIsInstance(
             parse_one("ALL PRIVILEGES", into=exp.GrantPrivilege), exp.GrantPrivilege
         )
+
+    def test_max_nodes(self):
+        wide = "SELECT " + ", ".join(f"col{i}" for i in range(500)) + " FROM t"
+        node_count = sum(1 for _ in parse_one(wide).walk(bfs=False))
+
+        self.assertEqual(parse_one(wide, max_nodes=node_count).sql(), parse_one(wide).sql())
+        self.assertEqual(parse_one(wide, max_nodes=10**6).sql(), parse_one(wide).sql())
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=node_count - 1)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one("SELECT a, b, c FROM t WHERE x IN (1, 2, 3, 4)", max_nodes=5)
+
+        self.assertEqual(len(parse("SELECT 1; SELECT 2", max_nodes=20)), 2)

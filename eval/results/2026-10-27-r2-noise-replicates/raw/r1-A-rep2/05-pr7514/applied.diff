diff --git a/sqlglot/dialects/dialect.py b/sqlglot/dialects/dialect.py
index bbb4515c5..51241e37a 100644
--- a/sqlglot/dialects/dialect.py
+++ b/sqlglot/dialects/dialect.py
@@ -1613,6 +1613,25 @@ def build_date_delta_with_interval(
     return _builder
 
 
+def build_date_delta_with_days_or_interval(
+    expression_class: Type[E],
+    negate: bool = False,
+) -> t.Callable[[BuilderArgs], E | exp.TsOrDsAdd | None]:
+    # Handles both DATE_ADD(date, INTERVAL n unit) and the two-argument DATE_ADD(date, days) form
+    interval_builder = build_date_delta_with_interval(expression_class)
+
+    def _builder(args: BuilderArgs) -> E | exp.TsOrDsAdd | None:
+        if len(args) == 2 and not isinstance(args[1], exp.Interval):
+            days = args[1]
+            if negate:
+                days = exp.Neg(this=exp.paren(days) if isinstance(days, exp.Binary) else days)
+            return exp.TsOrDsAdd(this=args[0], expression=days, unit=exp.Literal.string("DAY"))
+
+        return interval_builder(args)
+
+    return _builder
+
+
 def date_trunc_to_time(args: BuilderArgs) -> exp.DateTrunc | exp.TimestampTrunc:
     unit = seq_get(args, 0)
     this = seq_get(args, 1)
@@ -1631,6 +1650,14 @@ def date_add_interval_sql(data_type: str, kind: str) -> t.Callable[[Generator, e
     return func
 
 
+def ts_or_ds_add_days_sql(self: Generator, expression: exp.TsOrDsAdd) -> str:
+    # Two-argument DATE_ADD(date, days) is only valid for day offsets, other units need INTERVAL
+    if expression.text("unit").upper() in ("", "DAY"):
+        return self.func("DATE_ADD", expression.this, expression.expression)
+
+    return date_add_interval_sql("DATE", "ADD")(self, expression)
+
+
 def timestamptrunc_sql(
     func: str = "DATE_TRUNC", zone: bool = False
 ) -> t.Callable[[Generator, exp.TimestampTrunc], str]:

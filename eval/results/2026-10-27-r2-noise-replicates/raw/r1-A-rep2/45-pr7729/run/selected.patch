+def _unpivot_upstream_columns(column: exp.Column, pivot: exp.Pivot) -> list[exp.Column]:
+    if column.table != pivot.alias_or_name:
+        return [column]
+
+    in_field = pivot.fields[0]
+    # The name column holds the labels of the IN list, so it has no upstream source columns
+    if column.name == in_field.this.name:
+        return []
+
+    value_names = [
+        ident.name
+        for e in pivot.expressions
+        for ident in (e.expressions if isinstance(e, exp.Tuple) else [e])
+    ]
+    if column.name not in value_names:
+        return [column]
+
+    # Multi-value UNPIVOTs map each value column to the same position in every IN list tuple
+    index = value_names.index(column.name)
+    upstream = []
+    for entry in in_field.expressions:
+        entry = entry.this if isinstance(entry, exp.PivotAlias) else entry
+        source = entry.expressions[index] if isinstance(entry, exp.Tuple) else entry
+        upstream.append(exp.column(source.name, table=pivot.alias_or_name))
+    return upstream
+

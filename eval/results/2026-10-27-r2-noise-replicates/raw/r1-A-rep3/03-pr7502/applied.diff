+    def test_max_nodes(self):
+        wide = "SELECT " + ", ".join(f"c{i}" for i in range(500)) + " FROM t"
+        self.assertEqual(len(parse_one(wide, max_nodes=10_000).expressions), 500)
+        self.assertEqual(len(parse_one(wide, max_nodes=None).expressions), 500)
+
+        expected_nodes = sum(1 for _ in parse_one("SELECT 1 + 2 FROM t").walk())
+        self.assertIsNotNone(parse_one("SELECT 1 + 2 FROM t", max_nodes=expected_nodes))
+
+        for error_level in (ErrorLevel.IGNORE, ErrorLevel.WARN, ErrorLevel.RAISE):
+            with self.subTest(error_level=error_level):
+                with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+                    parse_one(wide, max_nodes=100, error_level=error_level)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one("SELECT 1 + 2 FROM t", max_nodes=expected_nodes - 1)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one("SELECT a FROM b", read="athena", max_nodes=1)
+
     def test_column(self):
         columns = parse_one("select a, ARRAY[1] b, case when 1 then 1 end").find_all(exp.Column)
         assert len(list(columns)) == 1

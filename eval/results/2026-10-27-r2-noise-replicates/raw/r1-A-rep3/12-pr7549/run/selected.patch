@@ -596,6 +597,57 @@ def _convert_columns_to_dots(scope: Scope, resolver: Resolver) -> None:
         scope.clear_cache()
 
 
+def _convert_lateral_struct_columns(scope: Scope, resolver: Resolver) -> None:
+    """
+    Converts `alias.field` into `Dot(alias.alias, field)` when `alias` is a LATERAL VIEW EXPLODE
+    table alias whose exploded column shares its name, e.g. `ci.name` in
+    `SELECT ci.name FROM t LATERAL VIEW EXPLODE(items) ci AS ci`, where `items` is an ARRAY<STRUCT>.
+    """
+    converted = False
+    for column in scope.columns:
+        source = scope.sources.get(column.table)
+        if not isinstance(source, Scope) or not isinstance(source.expression, exp.Lateral):
+            continue
+
+        lateral = source.expression
+        explode = lateral.this
+        if (
+            not isinstance(explode, exp.Explode)
+            or lateral.alias_column_names != [column.table]
+            or column.name in resolver.get_source_columns(column.table)
+        ):
+            continue
+
+        array = explode.this
+        if not isinstance(array, exp.Column):
+            continue
+
+        array_table = exp.to_identifier(array.table) if array.table else resolver.get_table(array)
+        array_source = scope.sources.get(array_table.name) if array_table else None
+        if array_source is None:
+            continue
+
+        array_type = resolver._get_column_type_from_scope(array_source, array)
+        if not array_type or not array_type.is_type(exp.DType.ARRAY) or not array_type.expressions:
+            continue
+
+        struct_type = array_type.expressions[0]
+        if not struct_type.is_type(exp.DType.STRUCT) or column.name not in {
+            field.name for field in struct_type.expressions
+        }:
+            continue
+
+        converted = True
+        column.replace(
+            exp.Dot.build(
+                [exp.column(column.table, table=column.table), column.this.copy()],
+            )
+        )
+
+    if converted:
+        scope.clear_cache()
+
+
 def _qualify_columns(
     scope: Scope,
     resolver: Resolver,

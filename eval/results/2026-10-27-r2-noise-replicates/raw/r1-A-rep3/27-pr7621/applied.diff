         assert len(list(ast.find_all(exp.Dot))) == 7
 
+    def test_no_paren_function_names_as_column_parts(self):
+        for sql in (
+            "SELECT mytable.current_user FROM mytable",
+            "SELECT mytable.current_date FROM mytable",
+            "SELECT a.b.sysdate FROM t",
+        ):
+            with self.subTest(sql=sql):
+                ast = parse_one(sql)
+                assert not list(ast.find_all(exp.Func))
+                self.assertEqual(ast.sql(), sql)
+
+        self.assertEqual(
+            parse_one("SELECT mytable.current_user() FROM mytable").sql(),
+            "SELECT mytable.current_user() FROM mytable",
+        )
+
     def test_pivot_missing_agg_func(self):
         with self.assertRaises(ParseError) as ctx:
             parse_one("select * from tbl pivot(col1 for col2 in (val1, val1))")

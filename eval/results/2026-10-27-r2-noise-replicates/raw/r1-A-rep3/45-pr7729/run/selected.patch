+def _unpivot_outputs(unpivot: exp.Pivot) -> tuple[str, dict[str, list[str]]]:
+    """
+    Returns the UNPIVOT's name column and a map of each value column to the source columns it is
+    produced from, e.g. UNPIVOT (val FOR name IN (a AS 'x', b)) -> ("name", {"val": ["a", "b"]}).
+    """
+    name_column = unpivot.fields[0].this.name
+    value_columns = [
+        value
+        for expr in unpivot.expressions
+        for value in (expr.expressions if isinstance(expr, exp.Tuple) else [expr])
+    ]
+    mapping: dict[str, list[str]] = {value.name: [] for value in value_columns}
+    for entry in unpivot.fields[0].expressions:
+        entry = entry.this if isinstance(entry, exp.PivotAlias) else entry
+        entry_columns = entry.expressions if isinstance(entry, exp.Tuple) else [entry]
+        for value, column in zip(value_columns, entry_columns):
+            mapping[value.name].append(column.name)
+    return name_column, mapping
+

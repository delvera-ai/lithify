+    def test_undrop(self):
+        for kind in (
+            "ACCOUNT a",
+            "DATABASE d",
+            "DYNAMIC TABLE dt",
+            "EXTERNAL VOLUME ev",
+            "ICEBERG TABLE it",
+            "NOTEBOOK n",
+            "SCHEMA db.s",
+            "SNAPSHOT sn",
+            "STREAMLIT st",
+            "TABLE db.s.t",
+            "TAG tg",
+            "TYPE ty",
+        ):
+            with self.subTest(kind):
+                self.validate_identity(f"UNDROP {kind}")
+
+        self.validate_identity("UNDROP TABLE IDENTIFIER('12345')")
+        self.validate_identity("UNDROP SCHEMA IDENTIFIER('12345')")
+        self.validate_identity("UNDROP DATABASE IDENTIFIER('12345')")
+        self.assertIsInstance(parse_one("UNDROP TABLE t", read="snowflake"), exp.Undrop)
+
     def test_drop_iceberg_table(self):
         ast = self.validate_identity("DROP ICEBERG TABLE t")
         self.assertTrue(ast.args["iceberg"])

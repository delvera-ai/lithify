+WITH `c` AS (
+  SELECT
+    `x`.`a` AS `a`,
+    `x`.`b` AS `b`
+  FROM `x` AS `x`
+)
+SELECT
+  `c`.`m` AS `m`,
+  `c`.`v` AS `v`
+FROM `c` AS `c`
+UNPIVOT(`v` FOR `m` IN (`c`.`a`, `c`.`b`)) AS `c`;

+def _map_sql(self: StarRocksGenerator, expression: exp.Map | exp.VarMap) -> str:
+    keys = expression.args.get("keys")
+    values = expression.args.get("values")
+    if not keys:
+        return self.func("MAP")
+
+    # StarRocks' MAP is variadic (MAP(k1, v1, k2, v2, ...)), so literal arrays can be expanded.
+    # Column-valued arrays can only be combined at runtime, so use MAP_FROM_ARRAYS instead.
+    if (
+        isinstance(keys, exp.Array)
+        and isinstance(values, exp.Array)
+        and len(keys.expressions) == len(values.expressions)
+    ):
+        args = [arg for pair in zip(keys.expressions, values.expressions) for arg in pair]
+        return self.func("MAP", *args)
+
+    return self.func("MAP_FROM_ARRAYS", keys, values)
+
+
+def _trim_sql(self: StarRocksGenerator, expression: exp.Trim) -> str:
+    if not expression.expression:
+        return self.trim_sql(expression)
+
+    # StarRocks takes the characters to strip as a second argument, e.g. TRIM(str, chars)
+    position = self.sql(expression, "position")
+    func_name = {"LEADING": "LTRIM", "TRAILING": "RTRIM"}.get(position, "TRIM")
+    return self.func(func_name, expression.this, expression.expression)
+

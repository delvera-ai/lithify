+    def test_collate_in_types(self):
+        for sql in (
+            'SELECT CAST(x AS VARCHAR(10) COLLATE "C")',
+            'SELECT CAST(x AS ARRAY<TEXT COLLATE "C">)',
+            'SELECT CAST(x AS STRUCT<a TEXT COLLATE "C">)',
+            'CREATE TABLE t (a ARRAY<TEXT COLLATE "C">)',
+        ):
+            with self.subTest(sql):
+                self.assertEqual(parse_one(sql).sql(), sql)
+
+        cast = parse_one('SELECT CAST(x AS VARCHAR(10) COLLATE "C")').find(exp.Cast)
+        self.assertIsInstance(cast.to.args["collate"], exp.Identifier)
+        self.assertIsNone(parse_one("SELECT x::TEXT").find(exp.DataType).args.get("collate"))
+        self.assertIsInstance(parse_one('SELECT x COLLATE "C"').find(exp.Collate), exp.Collate)
+
     def test_drop_column(self):

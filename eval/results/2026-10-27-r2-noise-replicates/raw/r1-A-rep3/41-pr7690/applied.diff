@@ -7028,6 +7060,41 @@ class Parser:
     def _parse_function_parameter(self) -> exp.Expr | None:
         return self._parse_column_def(this=self._parse_id_var(), computed_column=False)
 
+    def _is_macro_overload_ahead(self) -> bool:
+        # Whether the upcoming tokens are ", (params) AS", i.e. the next overload of a macro
+        tokens, index = self._tokens, self._index
+        if index + 1 >= len(tokens) or tokens[index].token_type != TokenType.COMMA:
+            return False
+        if tokens[index + 1].token_type != TokenType.L_PAREN:
+            return False
+
+        index += 2
+        while index < len(tokens) and (
+            tokens[index].token_type == TokenType.COMMA
+            or tokens[index].token_type in self.ID_VAR_TOKENS
+        ):
+            index += 1
+
+        return (
+            index + 1 < len(tokens)
+            and tokens[index].token_type == TokenType.R_PAREN
+            and tokens[index + 1].token_type == TokenType.ALIAS
+        )
+
+    def _parse_macro_overload(self) -> exp.MacroOverload:
+        expressions = self._parse_wrapped_csv(self._parse_function_parameter)
+        if not self._match(TokenType.ALIAS):
+            self.raise_error("Expected AS after macro overload parameters")
+
+        is_table = bool(self._match(TokenType.TABLE))
+        return self.expression(
+            exp.MacroOverload(
+                expressions=expressions,
+                expression=self._parse_user_defined_function_expression(),
+                is_table=is_table,
+            )
+        )
+
     def _parse_user_defined_function(self, kind: TokenType | None = None) -> exp.Expr | None:
         this = self._parse_table_parts(schema=True)
 

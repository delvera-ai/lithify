     ALTER_PARSERS = {
         **parser.Parser.ALTER_PARSERS,
-        "MODIFY": lambda self: self._parse_alter_table_alter(),
+        "MODIFY": lambda self: self._parse_alter_table_modify(),
         "AUTO_INCREMENT": lambda self: self._parse_property_assignment(exp.AutoIncrementProperty),
     }
 
@@ -315,6 +315,24 @@ class MySQLParser(parser.Parser):
             return self.expression(exp.DropPrimaryKey())
         return super()._parse_alter_drop_action()
 
+    def _parse_alter_table_modify(self) -> exp.Expr | None:
+        # MODIFY [COLUMN] redefines the whole column, unlike ALTER [COLUMN], so it takes a column definition
+        start = self._index
+        self._match(TokenType.COLUMN)
+        column_def = self._parse_field_def()
+        if not isinstance(column_def, exp.ColumnDef):
+            self._retreat(start)
+            return self._parse_alter_table_alter()
+
+        if self._match_texts(("FIRST", "AFTER")):
+            position = self._prev.text
+            column_position = self.expression(
+                exp.ColumnPosition(this=self._parse_column(), position=position)
+            )
+            column_def.set("position", column_position)
+
+        return self.expression(exp.AlterModifyColumn(this=column_def))
+

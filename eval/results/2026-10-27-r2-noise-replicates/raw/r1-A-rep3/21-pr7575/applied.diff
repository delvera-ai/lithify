+
+    def test_lineage_all_columns(self) -> None:
+        sql = "WITH shared AS (SELECT a, b FROM x) SELECT s.a AS a, s.a + 1 AS c FROM shared s"
+        schema = {"x": {"a": "int", "b": "int"}}
+
+        nodes = lineage(None, sql, schema=schema)
+        self.assertEqual(list(nodes), ["a", "c"])
+
+        for column, node in nodes.items():
+            expected = lineage(column, sql, schema=schema)
+            self.assertEqual(node.name, expected.name)
+            self.assertEqual(node.source.sql(), expected.source.sql())
+            self.assertEqual(
+                sorted(d.name for d in node.downstream),
+                sorted(d.name for d in expected.downstream),
+            )
+
+        # the CTE's nodes are shared between output columns
+        a_leaves = {id(n) for n in nodes["a"].walk() if not n.downstream}
+        c_leaves = {id(n) for n in nodes["c"].walk() if not n.downstream}
+        self.assertTrue(a_leaves & c_leaves)
+
+    def test_lineage_all_columns_star(self) -> None:
+        nodes = lineage(None, "SELECT * FROM x", schema={"x": {"a": "int"}})
+        self.assertEqual(list(nodes), ["a"])
+        self.assertEqual(nodes["a"].name, "a")
+
+    def test_lineage_on_node(self) -> None:
+        sql = (
+            "WITH shared AS (SELECT a, b FROM x) "
+            "SELECT s1.a AS a, s2.b + 1 AS c FROM shared s1 JOIN shared s2 ON s1.a = s2.a "
+            "UNION ALL SELECT a, b FROM y"
+        )
+        schema = {"x": {"a": "int", "b": "int"}, "y": {"a": "int", "b": "int"}}
+
+        for column in ("a", "c", None):
+            with self.subTest(column=column):
+                order: list[Node] = []
+                result = lineage(column, sql, schema=schema, on_node=order.append)
+                roots = list(result.values()) if column is None else [result]
+
+                all_nodes = {id(n): n for root in roots for n in root.walk()}
+                self.assertEqual(len(order), len(set(map(id, order))))
+                self.assertEqual({id(n) for n in order}, set(all_nodes))
+
+                # each node is reported only after all of its downstream nodes
+                position = {id(n): i for i, n in enumerate(order)}
+                for n in order:
+                    for d in n.downstream:
+                        self.assertLess(position[id(d)], position[id(n)])
+
+    def test_lineage_on_node_payload(self) -> None:
+        def tag(node: Node) -> None:
+            node.payload["depth"] = len(node.downstream)
+
+        node = lineage(
+            "a",
+            "SELECT a FROM z",
+            schema={"x": {"a": "int"}},
+            sources={"z": "SELECT a FROM x"},
+            on_node=tag,
+        )
+        self.assertEqual(node.payload, {"depth": 1})
+        self.assertEqual(node.downstream[0].payload, {"depth": 1})
+        self.assertEqual(node.downstream[0].downstream[0].payload, {"depth": 0})
+
+        self.assertEqual(Node(name="a", expression=exp.null(), source=exp.null()).payload, {})

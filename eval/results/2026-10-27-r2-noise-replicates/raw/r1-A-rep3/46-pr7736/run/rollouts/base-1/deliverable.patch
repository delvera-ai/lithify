+    def test_unpivot_with_multiple_value_columns(self) -> None:
+        sql = """
+        SELECT id, k, v1, v2
+        FROM sales UNPIVOT ((v1, v2) FOR k IN ((a1, a2) AS 'x', (b1, b2) AS 'y'))
+        """
+        schema = {"sales": {"id": "int", "a1": "int", "a2": "int", "b1": "int", "b2": "int"}}
+
+        node = lineage("v1", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.A1", "SALES.B1"])
+
+        node = lineage("v2", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.A2", "SALES.B2"])
+
+        node = lineage("k", sql, schema=schema, dialect="snowflake")
+        self.assertEqual(
+            [d.name for d in node.downstream], ["SALES.A1", "SALES.A2", "SALES.B1", "SALES.B2"]
+        )
+
+    def test_unpivot_with_aliased_cte(self) -> None:
+        sql = """
+        WITH src AS (
+          SELECT id, jan, feb FROM sales
+        )
+        SELECT id, score
+        FROM src AS s UNPIVOT (score FOR metric_name IN (jan, feb)) AS u
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int"}}
+
+        node = lineage("score", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SRC.JAN", "SRC.FEB"])
+        self.assertEqual(node.downstream[0].downstream[0].name, "SALES.JAN")
+        self.assertEqual(node.downstream[1].downstream[0].name, "SALES.FEB")
+
+        node = lineage("id", sql, schema=schema, dialect="snowflake")
+        self.assertEqual(node.downstream[0].name, "SRC.ID")
+        self.assertEqual(node.downstream[0].downstream[0].name, "SALES.ID")

diff --git a/tests/test_lineage.py b/tests/test_lineage.py
index 13577bb2f..a0500b04f 100644
--- a/tests/test_lineage.py
+++ b/tests/test_lineage.py
@@ -3,7 +3,7 @@ from __future__ import annotations
 import unittest
 
 import sqlglot
-from sqlglot.lineage import lineage
+from sqlglot.lineage import Node, lineage
 from sqlglot.schema import MappingSchema
 
 
@@ -862,3 +862,50 @@ class TestLineage(unittest.TestCase):
         )
         downstream_names = sorted(d.name for d in node.downstream)
         self.assertEqual(downstream_names, ["s1.a", "s2.a"])
+
+    def test_lineage_all_columns(self) -> None:
+        sql = "SELECT a, b + 1 AS c FROM (SELECT a, b FROM x) AS y"
+        schema = {"x": {"a": "int", "b": "int"}}
+
+        nodes = lineage(None, sql, schema=schema)
+        self.assertEqual(list(nodes), ["a", "c"])
+
+        for name, node in nodes.items():
+            self.assertIsInstance(node, Node)
+            self.assertEqual(node.name, lineage(name, sql, schema=schema).name)
+            self.assertEqual(node.source.sql(), lineage(name, sql, schema=schema).source.sql())
+
+    def test_lineage_on_node(self) -> None:
+        sql = "SELECT a FROM (SELECT a FROM x UNION SELECT a FROM z) AS y"
+        schema = {"x": {"a": "int"}, "z": {"a": "int"}}
+
+        seen: list[tuple[Node, int]] = []
+        node = lineage(
+            "a", sql, schema=schema, on_node=lambda n: seen.append((n, len(n.downstream)))
+        )
+
+        # Every node in the graph is reported exactly once.
+        self.assertEqual(
+            sorted(id(n) for n, _ in seen),
+            sorted(id(n) for n in node.walk()),
+        )
+
+        # Downstream nodes were already attached when the callback ran.
+        for n, downstream_count in seen:
+            self.assertEqual(downstream_count, len(n.downstream))
+
+        nodes = lineage(None, sql, schema=schema, on_node=lambda n: seen.append((n, 0)))
+        self.assertEqual(list(nodes), ["a"])
+
+    def test_lineage_payload(self) -> None:
+        node = lineage(
+            "a",
+            "SELECT a FROM (SELECT a FROM x) AS y",
+            schema={"x": {"a": "int"}},
+            on_node=lambda n: n.payload.update(depth=len(n.name)),
+        )
+
+        self.assertEqual(node.payload, {"depth": 1})
+        for n in node.walk():
+            self.assertIn("depth", n.payload)
+        self.assertEqual(lineage("a", "SELECT a FROM x", schema={"x": {"a": "int"}}).payload, {})

diff --git a/sqlglot/generator.py b/sqlglot/generator.py
index c3be81ecc..b351e0b7c 100644
--- a/sqlglot/generator.py
+++ b/sqlglot/generator.py
@@ -3026,9 +3026,31 @@ class Generator:
                         )
                     elif not isinstance(expression.this, exp.Rand):
                         null_sort_order = " DESC" if nulls_sort_change == " NULLS FIRST" else ""
-                        this = (
-                            f"CASE WHEN {this} IS NULL THEN 1 ELSE 0 END{null_sort_order}, {this}"
-                        )
+                        null_check = this
+
+                        # A bare column may be ambiguous across the joined sources, so reuse the
+                        # table qualifier of the projection it refers to
+                        select = expression.find_ancestor(exp.Select)
+                        if (
+                            isinstance(expression.this, exp.Column)
+                            and not expression.this.table
+                            and select
+                            and select.args.get("joins")
+                        ):
+                            projection = next(
+                                (
+                                    p.unalias()
+                                    for p in select.expressions
+                                    if isinstance(p.unalias(), exp.Column)
+                                    and p.unalias().table
+                                    and p.unalias().name == expression.this.name
+                                ),
+                                None,
+                            )
+                            if projection:
+                                null_check = self.sql(projection)
+
+                        this = f"CASE WHEN {null_check} IS NULL THEN 1 ELSE 0 END{null_sort_order}, {this}"
                     nulls_sort_change = ""
 
         with_fill = self.sql(expression, "with_fill")

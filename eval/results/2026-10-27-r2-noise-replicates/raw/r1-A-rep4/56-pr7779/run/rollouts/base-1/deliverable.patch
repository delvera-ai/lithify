+def _build_map(args: list[exp.Expr]) -> exp.Expr:
+    # MAP takes alternating keys and values, so an odd argument count is left to the generic
+    # Map builder, which rejects it, rather than failing on a missing value
+    if len(args) % 2:
+        return exp.Map.from_arg_list(args)
+    return parser.build_var_map(args)
+

+def _map_sql(self: StarRocksGenerator, expression: exp.Map | exp.VarMap) -> str:
+    # StarRocks' MAP takes alternating keys and values, so literal key/value arrays are unpacked
+    # into that form. Otherwise, the arrays are only known at runtime, so MAP_FROM_ARRAYS is used.
+    keys = expression.args.get("keys")
+    values = expression.args.get("values")
+
+    if not keys and not values:
+        return self.func("MAP")
+
+    if (
+        isinstance(keys, exp.Array)
+        and isinstance(values, exp.Array)
+        and len(keys.expressions) == len(values.expressions)
+    ):
+        pairs = [arg for kv in zip(keys.expressions, values.expressions) for arg in kv]
+        return self.func("MAP", *pairs)
+
+    return self.func("MAP_FROM_ARRAYS", keys, values)
+

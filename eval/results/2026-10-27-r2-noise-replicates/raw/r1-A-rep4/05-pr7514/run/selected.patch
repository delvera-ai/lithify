index bbb4515c5..e72b063de 100644
--- a/sqlglot/dialects/dialect.py
+++ b/sqlglot/dialects/dialect.py
@@ -1613,6 +1613,23 @@ def build_date_delta_with_interval(
     return _builder
 
 
+def build_date_delta_with_days_or_interval(
+    expression_class: Type[E], negate: bool = False
+) -> t.Callable[[BuilderArgs], E | exp.TsOrDsAdd | None]:
+    interval_builder = build_date_delta_with_interval(expression_class)
+
+    def _builder(args: BuilderArgs) -> E | exp.TsOrDsAdd | None:
+        if len(args) == 2 and not isinstance(args[1], exp.Interval):
+            days = args[1]
+            if negate:
+                days = exp.Neg(this=exp.paren(days) if isinstance(days, exp.Binary) else days)
+            return exp.TsOrDsAdd(this=args[0], expression=days, unit=exp.Literal.string("DAY"))
+
+        return interval_builder(args)
+
+    return _builder
+
+
 def date_trunc_to_time(args: BuilderArgs) -> exp.DateTrunc | exp.TimestampTrunc:
     unit = seq_get(args, 0)
     this = seq_get(args, 1)

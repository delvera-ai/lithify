+def _unpivot_downstream_columns(pivot: exp.Pivot, column_name: str) -> list[exp.Column]:
+    """Returns the pre-unpivot columns that the given output column of an UNPIVOT is derived from."""
+    source = pivot.parent.alias_or_name
+    in_fields = [field for field in pivot.fields if isinstance(field, exp.In)]
+
+    # The value columns and the name column are generated from the columns listed in the IN clause,
+    # every other column of the unpivoted source is passed through unchanged
+    value_names = {
+        ident.name
+        for e in pivot.expressions
+        for ident in (e.expressions if isinstance(e, exp.Tuple) else [e])
+    }
+    name_names = {field.this.name for field in in_fields if isinstance(field.this, exp.Identifier)}
+    if column_name in value_names | name_names:
+        return [
+            exp.column(column.name, table=source)
+            for field in in_fields
+            for e in field.expressions
+            for column in e.find_all(exp.Column)
+        ]
+
+    return [exp.column(column_name, table=source)]
+

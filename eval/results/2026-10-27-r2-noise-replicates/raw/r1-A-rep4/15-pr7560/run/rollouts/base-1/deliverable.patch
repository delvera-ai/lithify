+def _pivot_columns(pivot: exp.Pivot) -> tuple[set[str], list[str]]:
+    """Returns the source columns consumed by a pivot and the output columns it produces."""
+    if pivot.unpivot:
+        exclude = set()
+        for field in pivot.fields:
+            if isinstance(field, exp.In):
+                exclude.update(
+                    c.output_name for e in field.expressions for c in e.find_all(exp.Column)
+                )
+
+        return exclude, [c.output_name for c in _unpivot_columns(pivot)]
+
+    exclude = set(c.output_name for c in pivot.find_all(exp.Column))
+    outputs = [c.output_name for c in pivot.args.get("columns", [])]
+    return exclude, outputs or [c.alias_or_name for c in pivot.expressions]

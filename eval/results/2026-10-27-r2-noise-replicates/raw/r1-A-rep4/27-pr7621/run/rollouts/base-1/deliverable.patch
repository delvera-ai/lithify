+    def test_no_paren_function_names_after_dot(self):
+        for sql in (
+            "SELECT mytable.current_user FROM mytable",
+            "SELECT mytable.current_date FROM mytable",
+            "SELECT a.b.current_user FROM t",
+            "SELECT a.current_user.x FROM t",
+        ):
+            with self.subTest(sql):
+                ast = parse_one(sql)
+                assert not list(ast.find_all(exp.CurrentUser, exp.CurrentDate))
+                self.assertEqual(ast.sql(), sql)
+
     def test_pivot_missing_agg_func(self):

+    def _parse_macro_overloads(
+        self, this: exp.UserDefinedFunction, expression: exp.Expr | None
+    ) -> exp.MacroOverloads:
+        overloads = [
+            exp.MacroOverload(
+                this=exp.UserDefinedFunction(
+                    expressions=this.args.get("expressions"), wrapped=True
+                ),
+                expression=expression,
+            )
+        ]
+
+        while True:
+            params = self._parse_wrapped_csv(self._parse_function_parameter)
+            self._match(TokenType.ALIAS)
+            body = self._parse_user_defined_function_expression()
+            overloads.append(
+                exp.MacroOverload(
+                    this=exp.UserDefinedFunction(expressions=params, wrapped=True),
+                    expression=body,
+                )
+            )
+
+            if not self._match(TokenType.COMMA):
+                break
+
+        return self.expression(exp.MacroOverloads(expressions=overloads))

+    def test_unpivot_multiple_value_columns(self) -> None:
+        sql = """
+        SELECT q, a, b
+        FROM sales UNPIVOT ((a, b) FOR q IN ((jan, feb) AS 'Q1', (mar, apr) AS 'Q2'))
+        """
+        schema = {"sales": {"jan": "int", "feb": "int", "mar": "int", "apr": "int"}}
+
+        node = lineage("a", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.MAR"])
+
+        node = lineage("b", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.FEB", "SALES.APR"])
+
+        node = lineage("q", sql, schema=schema, dialect="snowflake")
+        self.assertEqual(
+            [d.name for d in node.downstream],
+            ["SALES.JAN", "SALES.FEB", "SALES.MAR", "SALES.APR"],
+        )
+
+    def test_unpivot_aliased_in_list(self) -> None:
+        sql = """
+        SELECT id, metric_name, score
+        FROM sales UNPIVOT (score FOR metric_name IN (jan AS j, feb AS f))
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int"}}
+
+        node = lineage("score", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+
+        node = lineage("metric_name", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN", "SALES.FEB"])
+
+    def test_unpivot_passthrough_from_subquery(self) -> None:
+        sql = """
+        SELECT id, score
+        FROM (SELECT id, jan, feb FROM sales) AS s
+        UNPIVOT (score FOR metric_name IN (jan, feb))
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int"}}
+
+        node = lineage("id", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["S.ID"])
+        self.assertEqual(node.downstream[0].downstream[0].name, "SALES.ID")
+
+        node = lineage("score", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["S.JAN", "S.FEB"])
+

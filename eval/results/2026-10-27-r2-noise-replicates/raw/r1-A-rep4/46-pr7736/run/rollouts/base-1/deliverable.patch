@@ -471,20 +471,27 @@ def _pivot_column_mapping(pivot: exp.Pivot) -> dict[str, list[exp.Column]]:
     mapping: dict[str, list[exp.Column]] = {}
 
     if pivot.unpivot:
-        # UNPIVOT(val FOR name IN (a, b)): both the value column(s) and the name column
-        # are derived from the IN-list source columns
-        unpivot_columns = [
-            col
+        # UNPIVOT((v1, v2) FOR name IN ((a, b) AS 'x', ...)): the name column is derived from every
+        # IN-list entry, while each value column only from the entries at its position in the tuple
+        entries = [
+            e.this if isinstance(e, exp.PivotAlias) else e
             for field in pivot.fields
             for e in field.expressions
-            for col in e.find_all(exp.Column)
         ]
-        for value_column in pivot.expressions:
-            for identifier in value_column.find_all(exp.Identifier):
-                mapping[identifier.name] = unpivot_columns
+        value = pivot.expressions[0]
+        value_names = value.expressions if isinstance(value, exp.Tuple) else [value]
+        for i, value_name in enumerate(value_names):
+            mapping[value_name.name] = [
+                col
+                for entry in entries
+                for col in (
+                    entry.expressions[i] if isinstance(entry, exp.Tuple) else entry
+                ).find_all(exp.Column)
+            ]
+        name_columns = [col for entry in entries for col in entry.find_all(exp.Column)]
         for field in pivot.fields:
             if isinstance(field, exp.In):
-                mapping[field.this.name] = unpivot_columns
+                mapping[field.this.name] = name_columns
 
         return mapping
 

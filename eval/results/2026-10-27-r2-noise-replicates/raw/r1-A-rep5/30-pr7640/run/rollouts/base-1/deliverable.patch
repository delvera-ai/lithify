diff --git a/sqlglot/parser.py b/sqlglot/parser.py
index ec98ea564..9985234c9 100644
--- a/sqlglot/parser.py
+++ b/sqlglot/parser.py
@@ -8312,6 +8312,12 @@ class Parser:
         if self._can_parse_limit_or_offset():
             return this
 
+        # A WINDOW clause can directly follow a select list when there's no FROM clause
+        if self._match(TokenType.WINDOW, advance=False) and self._try_parse(
+            self._parse_window_clause, retreat=True
+        ):
+            return this
+
         any_token = self._match(TokenType.ALIAS)
         comments = self._prev_comments
 

+    def _parse_alter_table_change(self) -> exp.Expr | None:
+        self._match(TokenType.COLUMN)
+
+        old_name = self._parse_field(any_token=True)
+        column = self._parse_field(any_token=True)
+        if old_name is None or column is None:
+            return None
+
+        column_def = self._parse_column_def(column)
+        if not isinstance(column_def, exp.ColumnDef):
+            return None
+
+        return self.expression(exp.ModifyColumn(this=column_def, old_name=old_name))

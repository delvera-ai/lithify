+    def test_unpivot_multiple_value_columns(self) -> None:
+        sql = """
+        SELECT amount, quantity, metric_name
+        FROM sales UNPIVOT ((amount, quantity) FOR metric_name IN ((jan_amt, jan_qty), (feb_amt, feb_qty)))
+        """
+        schema = {
+            "sales": {
+                "id": "int",
+                "jan_amt": "int",
+                "jan_qty": "int",
+                "feb_amt": "int",
+                "feb_qty": "int",
+            }
+        }
+
+        node = lineage("amount", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN_AMT", "SALES.FEB_AMT"])
+
+        node = lineage("quantity", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["SALES.JAN_QTY", "SALES.FEB_QTY"])
+
+        node = lineage("metric_name", sql, schema=schema, dialect="snowflake")
+        self.assertEqual(
+            [d.name for d in node.downstream],
+            ["SALES.JAN_AMT", "SALES.JAN_QTY", "SALES.FEB_AMT", "SALES.FEB_QTY"],
+        )
+
+    def test_unpivot_aliased_passthrough(self) -> None:
+        sql = """
+        SELECT u.id, u.metric_name, u.score
+        FROM sales AS s UNPIVOT (score FOR metric_name IN (jan, feb)) AS u
+        """
+        schema = {"sales": {"id": "int", "jan": "int", "feb": "int"}}
+
+        node = lineage("id", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["S.ID"])
+
+        node = lineage("score", sql, schema=schema, dialect="snowflake")
+        self.assertEqual([d.name for d in node.downstream], ["S.JAN", "S.FEB"])
+

diff --git a/sqlglot/lineage.py b/sqlglot/lineage.py
index 6db18a09f..a98b1f7ac 100644
--- a/sqlglot/lineage.py
+++ b/sqlglot/lineage.py
@@ -471,20 +471,32 @@ def _pivot_column_mapping(pivot: exp.Pivot) -> dict[str, list[exp.Column]]:
     mapping: dict[str, list[exp.Column]] = {}
 
     if pivot.unpivot:
-        # UNPIVOT(val FOR name IN (a, b)): both the value column(s) and the name column
-        # are derived from the IN-list source columns
+        # UNPIVOT(val FOR name IN (a, b)): the name column is derived from all IN-list columns
+        # UNPIVOT((v1, v2) FOR name IN ((a1, a2), (b1, b2))): v1 is derived from a1 and b1,
+        # v2 from a2 and b2
+        value_names = [
+            identifier.name
+            for value in pivot.expressions
+            for identifier in value.find_all(exp.Identifier)
+        ]
         unpivot_columns = [
             col
             for field in pivot.fields
             for e in field.expressions
             for col in e.find_all(exp.Column)
         ]
-        for value_column in pivot.expressions:
-            for identifier in value_column.find_all(exp.Identifier):
-                mapping[identifier.name] = unpivot_columns
         for field in pivot.fields:
-            if isinstance(field, exp.In):
-                mapping[field.this.name] = unpivot_columns
+            if not isinstance(field, exp.In):
+                continue
+
+            mapping[field.this.name] = unpivot_columns
+            for in_item in field.expressions:
+                if isinstance(in_item, exp.PivotAlias):
+                    in_item = in_item.this
+
+                sources = in_item.expressions if isinstance(in_item, exp.Tuple) else [in_item]
+                for value_name, source in zip(value_names, sources):
+                    mapping.setdefault(value_name, []).extend(source.find_all(exp.Column))
 
         return mapping
 

--- a/tests/test_schema.py
+++ b/tests/test_schema.py
@@ -162,6 +162,23 @@ class TestSchema(unittest.TestCase):
         schema.add_table("test")
         self.assertEqual(schema.column_names("test"), ["x", "y"])
 
+    def test_find_cache_invalidated_by_add_table(self):
+        schema = MappingSchema({"t1": {"a": "INT"}})
+        table = exp.to_table("t2")
+        self.assertIsNone(schema.find(table, raise_on_missing=False))
+        self.assertIsNone(schema.find(table, raise_on_missing=False, ensure_data_types=True))
+
+        schema.add_table("t2", {"b": "TEXT"})
+        self.assertEqual(schema.find(table, raise_on_missing=False), {"b": "TEXT"})
+        self.assertEqual(
+            schema.find(table, raise_on_missing=False, ensure_data_types=True),
+            {"b": exp.DataType.build("TEXT")},
+        )
+
+        schema.add_table("t2", {"b": "TEXT", "c": "INT"})
+        self.assertEqual(schema.column_names("t2"), ["b", "c"])
+        self.assertEqual(schema.get_column_type("t2", "c").sql(), "INT")
+
     def test_schema_get_column_type(self):
         schema = MappingSchema({"A": {"b": "varchar"}})
         self.assertEqual(schema.get_column_type("a", "B").this, exp.DataType.Type.VARCHAR)

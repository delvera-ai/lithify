diff --git a/tests/test_parser.py b/tests/test_parser.py
index c13ad3f84..7d444f8de 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -97,6 +97,24 @@ class TestParser(unittest.TestCase):
 
         self.assertIsNotNone(parse_one("date").find(exp.Column))
 
+    def test_dotted_no_paren_function_names_are_identifiers(self):
+        for sql in (
+            "SELECT mytable.current_user FROM mytable",
+            "SELECT mytable.current_date FROM mytable",
+            "SELECT a.b.current_user FROM t",
+            "SELECT x.current_user.y FROM t",
+        ):
+            with self.subTest(sql=sql):
+                self.assertEqual(parse_one(sql).sql(), sql)
+
+        self.assertEqual(
+            parse_one("SELECT x.CURRENT_USER() FROM t").sql(), "SELECT x.CURRENT_USER() FROM t"
+        )
+        self.assertEqual(
+            parse_one("SELECT x.current_user, current_user FROM t").sql(),
+            "SELECT x.current_user, CURRENT_USER() FROM t",
+        )
+
     def test_tuple(self):
         parse_one("(a,)").assert_is(exp.Tuple)
 

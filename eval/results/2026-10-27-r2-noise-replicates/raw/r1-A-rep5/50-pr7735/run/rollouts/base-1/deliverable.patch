diff --git a/tests/dialects/test_snowflake.py b/tests/dialects/test_snowflake.py
index 8eccf066c..a93dbfdc5 100644
--- a/tests/dialects/test_snowflake.py
+++ b/tests/dialects/test_snowflake.py
@@ -5356,6 +5356,36 @@ MATCH_RECOGNIZE (
         self.assertTrue(ast.args["restrict"])
         self.validate_identity("DROP ICEBERG TABLE IF EXISTS t RESTRICT")
 
+    def test_undrop(self):
+        for kind in (
+            "TABLE t",
+            "TABLE db.sch.t",
+            "SCHEMA s",
+            "DATABASE d",
+            "ACCOUNT a",
+            "NOTEBOOK n",
+            "SNAPSHOT sn",
+            "STREAMLIT st",
+            "TAG tg",
+            "TYPE ty",
+            "DYNAMIC TABLE dt",
+            "EXTERNAL VOLUME ev",
+            "ICEBERG TABLE it",
+            "TABLE IDENTIFIER('\"_abc123\"')",
+            "DATABASE IDENTIFIER('\"_abc123\"')",
+        ):
+            with self.subTest(kind):
+                self.validate_identity(f"UNDROP {kind}")
+
+        ast = self.validate_identity("UNDROP DYNAMIC TABLE dt")
+        self.assertIsInstance(ast, exp.Undrop)
+        self.assertEqual(ast.args["kind"], "DYNAMIC TABLE")
+
+        self.assertEqual(
+            parse_one("SELECT undrop FROM undrop", read="snowflake").sql("snowflake"),
+            "SELECT undrop FROM undrop",
+        )
+
     def test_show_primary_keys(self):
         self.validate_identity("SHOW PRIMARY KEYS")
         self.validate_identity("SHOW PRIMARY KEYS IN ACCOUNT")

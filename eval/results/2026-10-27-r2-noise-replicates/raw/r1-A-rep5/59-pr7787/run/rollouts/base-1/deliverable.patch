@@ -1035,6 +1035,13 @@ class SnowflakeParser(parser.Parser):
 
         return expression
 
+    def _parse_property_before(self) -> exp.Expr | list[exp.Expr] | None:
+        # Snowflake also accepts KEY=VALUE properties before the column definitions, e.g. CREATE TABLE t CHANGE_TRACKING=TRUE (id INT)
+        prop = super()._parse_property_before()
+        if prop is None and self._next and self._next.token_type == TokenType.EQ:
+            return self._parse_property()
+        return prop
+

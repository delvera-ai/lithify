diff --git a/tests/test_lineage.py b/tests/test_lineage.py
index 13577bb2f..8463d0615 100644
--- a/tests/test_lineage.py
+++ b/tests/test_lineage.py
@@ -3,7 +3,7 @@ from __future__ import annotations
 import unittest
 
 import sqlglot
-from sqlglot.lineage import lineage
+from sqlglot.lineage import Node, lineage
 from sqlglot.schema import MappingSchema
 
 
@@ -862,3 +862,64 @@ class TestLineage(unittest.TestCase):
         )
         downstream_names = sorted(d.name for d in node.downstream)
         self.assertEqual(downstream_names, ["s1.a", "s2.a"])
+
+    def test_lineage_all_columns(self) -> None:
+        sql = "WITH c AS (SELECT a, b FROM x) SELECT a, b + 1 AS d FROM c UNION ALL SELECT a, b FROM y"
+        schema = {"x": {"a": "int", "b": "int"}, "y": {"a": "int", "b": "int"}}
+
+        nodes = lineage(None, sql, schema=schema)
+        self.assertEqual(list(nodes), ["a", "d"])
+        self.assertEqual(nodes["a"].name, "UNION")
+        self.assertEqual(nodes["d"].name, "UNION")
+
+        for column, node in nodes.items():
+            self.assertEqual(node.name, lineage(column, sql, schema=schema).name)
+            self.assertEqual(
+                sorted(n.name for n in node.walk()),
+                sorted(n.name for n in lineage(column, sql, schema=schema).walk()),
+            )
+
+        self.assertEqual(
+            lineage(None, "SELECT a, a FROM x", schema={"x": {"a": "int"}}).keys(), {"a"}
+        )
+
+    def test_lineage_on_node(self) -> None:
+        sql = "WITH c AS (SELECT a, b FROM x) SELECT a, b + 1 AS d, a AS e FROM c UNION ALL SELECT a, b, a FROM y"
+        schema = {"x": {"a": "int", "b": "int"}, "y": {"a": "int", "b": "int"}}
+
+        reported: list[Node] = []
+
+        def on_node(node: Node) -> None:
+            # Downstream nodes are populated and reported before their parent
+            for downstream in node.downstream:
+                self.assertIn(id(downstream), {id(n) for n in reported})
+            reported.append(node)
+
+        nodes = lineage(None, sql, schema=schema, on_node=on_node)
+
+        # Every node in the graph is reported exactly once
+        self.assertEqual(len(reported), len({id(n) for n in reported}))
+        self.assertEqual(
+            {id(n) for n in reported},
+            {id(n) for node in nodes.values() for n in node.walk()},
+        )
+
+        reported = []
+        node = lineage("a", sql, schema=schema, on_node=on_node)
+        self.assertEqual(
+            {id(n) for n in reported},
+            {id(n) for n in node.walk()},
+        )
+
+    def test_lineage_payload(self) -> None:
+        node = lineage("a", "SELECT a FROM x", schema={"x": {"a": "int"}})
+        self.assertEqual(node.payload, {})
+        self.assertEqual(node.downstream[0].payload, {})
+        self.assertIsNot(node.payload, node.downstream[0].payload)
+
+        def on_node(n: Node) -> None:
+            n.payload["sql"] = n.expression.sql()
+
+        node = lineage("a", "SELECT a FROM x", schema={"x": {"a": "int"}}, on_node=on_node)
+        self.assertEqual(node.payload, {"sql": "x.a AS a"})
+        self.assertEqual(node.downstream[0].payload, {"sql": "x AS x"})

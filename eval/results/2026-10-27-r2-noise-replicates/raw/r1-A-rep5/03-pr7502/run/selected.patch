diff --git a/tests/test_parser.py b/tests/test_parser.py
index 321703828..ba5339702 100644
--- a/tests/test_parser.py
+++ b/tests/test_parser.py
@@ -1084,3 +1084,20 @@ class TestParser(unittest.TestCase):
         self.assertIsInstance(
             parse_one("ALL PRIVILEGES", into=exp.GrantPrivilege), exp.GrantPrivilege
         )
+
+    def test_max_nodes(self):
+        wide = "SELECT " + ", ".join(f"c{i} AS a{i}" for i in range(500)) + " FROM t"
+        node_count = sum(1 for _ in parse_one(wide).walk())
+
+        self.assertIsNotNone(parse_one(wide))
+        self.assertIsNotNone(parse_one(wide, max_nodes=node_count))
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one(wide, max_nodes=node_count - 1)
+
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse_one("SELECT " + " + ".join(f"c{i}" for i in range(5000)), max_nodes=1000)
+
+    def test_max_nodes_ignores_error_level(self):
+        with self.assertRaisesRegex(ParseError, "Maximum number of AST nodes"):
+            parse("SELECT a, b, c, d, e, f FROM t", max_nodes=3, error_level=ErrorLevel.IGNORE)

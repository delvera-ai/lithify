diff --git a/tests/dialects/test_tsql.py b/tests/dialects/test_tsql.py
index b275d0e63..86f5a64f5 100644
--- a/tests/dialects/test_tsql.py
+++ b/tests/dialects/test_tsql.py
@@ -710,6 +710,43 @@ FOR XML
             pretty=True,
         )
 
+    def test_for_json(self):
+        json_possible_options = [
+            "AUTO",
+            "PATH",
+            "AUTO, INCLUDE_NULL_VALUES",
+            "PATH, WITHOUT_ARRAY_WRAPPER",
+            "AUTO, ROOT",
+            "PATH, ROOT('RootName')",
+            "AUTO, ROOT('RootName'), INCLUDE_NULL_VALUES",
+            "PATH, INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER",
+            "PATH, ROOT('RootName'), INCLUDE_NULL_VALUES, WITHOUT_ARRAY_WRAPPER",
+        ]
+
+        for json_option in json_possible_options:
+            with self.subTest(f"Testing FOR JSON option: {json_option}"):
+                self.validate_identity(f"SELECT * FROM t FOR JSON {json_option}")
+
+        self.validate_identity(
+            "SELECT * FROM t FOR JSON PATH, ROOT('RootName'), WITHOUT_ARRAY_WRAPPER",
+            """SELECT
+  *
+FROM t
+FOR JSON
+  PATH,
+  ROOT('RootName'),
+  WITHOUT_ARRAY_WRAPPER""",
+            pretty=True,
+        )
+
+        self.validate_all(
+            "SELECT * FROM t FOR JSON PATH, INCLUDE_NULL_VALUES",
+            write={
+                "tsql": "SELECT * FROM t FOR JSON PATH, INCLUDE_NULL_VALUES",
+                "duckdb": UnsupportedError,
+            },
+        )
+
     def test_types(self):
         self.validate_identity("CAST(x AS XML)")
         self.validate_identity("CAST(x AS UNIQUEIDENTIFIER)")

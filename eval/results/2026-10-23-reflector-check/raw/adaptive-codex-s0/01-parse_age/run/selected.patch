+++ b/tests/test_age.py
@@ -0,0 +1,33 @@
+import pytest
+
+from app.audit import REJECTIONS
+from app.errors import ValidationError
+from app.users import parse_age
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [(0, 0), (150, 150), (42, 42), (" 42\t", 42), ("000", 0),
+     ("150", 150), ("١٢", 12), ("0" * 5000 + "42", 42)],
+)
+def test_parse_age_accepts_without_audit(value, expected):
+    before = len(REJECTIONS)
+    result = parse_age(value)
+    assert type(result) is int
+    assert result == expected
+    assert len(REJECTIONS) == before
+
+
+@pytest.mark.parametrize(
+    "value",
+    [True, False, None, 42.0, [], {}, b"42", "", "  ", "-1", "+1",
+     "1.0", "1_0", "1 0", "²", -1, 151, " 151 ", "9" * 5000],
+)
+def test_parse_age_rejects_and_audits_original(value):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as error:
+        parse_age(value)
+    assert len(REJECTIONS) == before + 1
+    assert REJECTIONS[-1] == {
+        "field": "age", "value": value, "reason": str(error.value)
+    }

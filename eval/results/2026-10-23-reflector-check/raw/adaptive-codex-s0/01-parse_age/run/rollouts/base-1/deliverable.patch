 from app.errors import ValidationError
 
 
+def parse_age(value: int | str) -> int:
+    """Return an age from 0 to 150, accepting integers or decimal strings."""
+    if isinstance(value, bool):
+        raise ValidationError("age must be an integer or decimal string")
+    if isinstance(value, str):
+        value = value.strip()
+        if not value.isdecimal():
+            raise ValidationError("age must contain decimal digits")
+        # Accumulate with a bound to also handle arbitrarily long strings.
+        age = 0
+        for digit in value:
+            age = age * 10 + int(digit)
+            if age > 150:
+                raise ValidationError("age must be 0-150")
+    elif isinstance(value, int):
+        age = value
+    else:
+        raise ValidationError("age must be an integer or decimal string")
+    if not 0 <= age <= 150:
+        raise ValidationError("age must be 0-150")
+    return age
+

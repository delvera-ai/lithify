@@ -0,0 +1,33 @@
+import pytest
+
+from app.audit import REJECTIONS
+from app.errors import ValidationError
+from app.users import parse_email
+
+
+@pytest.mark.parametrize(
+    "value, expected",
+    [(" \tAda@Example.COM\n", "ada@example.com"),
+     ("a+b@sub.example.com", "a+b@sub.example.com"),
+     ("a@b..c", "a@b..c")],
+)
+def test_parse_email_normalizes_without_audit(value, expected):
+    before = len(REJECTIONS)
+    assert parse_email(value) == expected
+    assert len(REJECTIONS) == before
+
+
+@pytest.mark.parametrize(
+    "value",
+    [None, 42, True, [], {}, b"a@b.c", "", "  ", "a.b", "a@@b.c",
+     "@b.c", "a@", "a@bc", "a@.b.c", "a@b.c.", "a b@c.d",
+     "a@b .c", "a\tb@c.d", "a@b\nc.d", "a\u2003b@c.d", "  @b.c  "],
+)
+def test_parse_email_rejects_and_audits_original(value):
+    before = len(REJECTIONS)
+    with pytest.raises(ValidationError) as error:
+        parse_email(value)
+    assert len(REJECTIONS) == before + 1
+    assert REJECTIONS[-1] == {
+        "field": "email", "value": value, "reason": str(error.value)
+    }

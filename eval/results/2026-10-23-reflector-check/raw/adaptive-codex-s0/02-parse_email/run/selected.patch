 from app.errors import ValidationError
 
 
+def parse_email(value: str) -> str:
+    """Normalize an email address, auditing rejected input."""
+    reason = None
+    if not isinstance(value, str):
+        reason = "email must be a string"
+    else:
+        email = value.strip().lower()
+        if any(character.isspace() for character in email):
+            reason = "email must not contain whitespace"
+        elif email.count("@") != 1:
+            reason = "email must contain exactly one @"
+        else:
+            local, domain = email.split("@")
+            if not local:
+                reason = "email must have a nonempty local part"
+            elif "." not in domain or domain.startswith(".") or domain.endswith("."):
+                reason = "email domain must contain a dot and not start or end with one"
+
+    if reason is not None:
+        record_rejection("email", value, reason)
+        raise ValidationError(reason)
+    return email
+

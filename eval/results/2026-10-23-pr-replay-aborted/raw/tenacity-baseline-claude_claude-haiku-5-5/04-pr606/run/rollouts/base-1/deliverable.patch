+    def test_retry_composed_with_plain_callable(self) -> None:
+        def is_one(retry_state: tenacity.RetryCallState) -> bool:
+            return retry_state.outcome is not None and retry_state.outcome.result() == 1
+
+        def r(retry: tenacity.retry_base, fut: tenacity.Future) -> bool:
+            retry_state = make_retry_state(1, 1.0, last_result=fut)
+            return retry(retry_state)
+
+        # retry_base on the left, plain callable on the right
+        or_retry = tenacity.retry_if_result(lambda x: x == 2) | is_one
+        self.assertIsInstance(or_retry, tenacity.retry_any)
+        self.assertTrue(r(or_retry, tenacity.Future.construct(1, 1, False)))
+        self.assertTrue(r(or_retry, tenacity.Future.construct(1, 2, False)))
+        self.assertFalse(r(or_retry, tenacity.Future.construct(1, 3, False)))
+
+        # plain callable on the left, retry_base on the right
+        ror_retry = is_one | tenacity.retry_if_result(lambda x: x == 2)
+        self.assertIsInstance(ror_retry, tenacity.retry_any)
+        self.assertTrue(r(ror_retry, tenacity.Future.construct(1, 1, False)))
+        self.assertTrue(r(ror_retry, tenacity.Future.construct(1, 2, False)))
+        self.assertFalse(r(ror_retry, tenacity.Future.construct(1, 3, False)))
+
+        and_retry = tenacity.retry_if_result(lambda x: x == 1) & is_one
+        self.assertIsInstance(and_retry, tenacity.retry_all)
+        self.assertTrue(r(and_retry, tenacity.Future.construct(1, 1, False)))
+        self.assertFalse(r(and_retry, tenacity.Future.construct(1, 2, False)))
+
+        rand_retry = is_one & tenacity.retry_if_result(lambda x: x == 1)
+        self.assertIsInstance(rand_retry, tenacity.retry_all)
+        self.assertTrue(r(rand_retry, tenacity.Future.construct(1, 1, False)))
+        self.assertFalse(r(rand_retry, tenacity.Future.construct(1, 2, False)))
+

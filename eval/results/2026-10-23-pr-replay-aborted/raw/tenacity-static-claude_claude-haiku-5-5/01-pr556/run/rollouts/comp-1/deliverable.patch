+++ b/releasenotes/notes/find-ordinal-teens-7c1e4a9b2d305f18.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    Log messages now use the correct ordinal suffix for attempt numbers ending
+    in 11, 12 or 13 above 20. For example, attempt 111 is written as
+    ``111th`` instead of ``111st``, and 112 and 113 are written as ``112th``
+    and ``113th``.
diff --git a/tenacity/_utils.py b/tenacity/_utils.py
index be14871..3a46c3d 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -49,6 +49,8 @@ def find_ordinal(pos_num: int) -> str:
         return "rd"
     elif 4 <= pos_num <= 20:
         return "th"
+    elif 11 <= pos_num % 100 <= 13:
+        return "th"
     else:
         return find_ordinal(pos_num % 10)
 

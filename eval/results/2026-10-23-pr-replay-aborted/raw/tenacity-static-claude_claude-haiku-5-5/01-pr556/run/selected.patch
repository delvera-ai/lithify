+
+def test_to_ordinal() -> None:
+    expected = {
+        0: "0th",
+        1: "1st",
+        2: "2nd",
+        3: "3rd",
+        4: "4th",
+        11: "11th",
+        12: "12th",
+        13: "13th",
+        21: "21st",
+        22: "22nd",
+        23: "23rd",
+        101: "101st",
+        102: "102nd",
+        103: "103rd",
+        111: "111th",
+        112: "112th",
+        113: "113th",
+        121: "121st",
+        1011: "1011th",
+        1012: "1012th",
+    }
+    for number, ordinal in expected.items():
+        assert _utils.to_ordinal(number) == ordinal

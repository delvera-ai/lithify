diff --git a/releasenotes/notes/fix-find-ordinal-teens-3c9a1d7e5b2f40a8.yaml b/releasenotes/notes/fix-find-ordinal-teens-3c9a1d7e5b2f40a8.yaml
new file mode 100644
index 0000000..b6463d8
--- /dev/null
+++ b/releasenotes/notes/fix-find-ordinal-teens-3c9a1d7e5b2f40a8.yaml
@@ -0,0 +1,7 @@
+---
+fixes:
+  - |
+    Log messages such as "this is the N-th time calling it" now use the
+    correct ordinal suffix for numbers greater than 20 that end in 11, 12 or
+    13. For example, 111 is now written as ``111th`` instead of ``111st``,
+    ``112th`` instead of ``112nd``, and ``113th`` instead of ``113rd``.
diff --git a/tenacity/_utils.py b/tenacity/_utils.py
index be14871..3a46c3d 100644
--- a/tenacity/_utils.py
+++ b/tenacity/_utils.py
@@ -49,6 +49,8 @@ def find_ordinal(pos_num: int) -> str:
         return "rd"
     elif 4 <= pos_num <= 20:
         return "th"
+    elif 11 <= pos_num % 100 <= 13:
+        return "th"
     else:
         return find_ordinal(pos_num % 10)
 
diff --git a/tests/test_utils.py b/tests/test_utils.py

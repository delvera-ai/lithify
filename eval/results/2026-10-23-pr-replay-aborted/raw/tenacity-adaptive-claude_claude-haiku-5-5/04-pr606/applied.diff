+    def test_retry_or_and_with_plain_callable(self) -> None:
+        def is_even(retry_state: tenacity.RetryCallState) -> bool:
+            return (
+                retry_state.outcome is not None
+                and retry_state.outcome.result() % 2 == 0
+            )
+
+        def r(retry: tenacity.retry_base, value: int) -> bool:
+            fut = tenacity.Future.construct(1, value, False)
+            retry_state = make_retry_state(1, 1.0, last_result=fut)
+            return retry(retry_state)
+
+        base = tenacity.retry_if_result(lambda x: x == 2)
+
+        for retry in [base | is_even, is_even | base]:
+            self.assertIsInstance(retry, tenacity.retry_any)
+            self.assertEqual([False, True, False, True], [r(retry, v) for v in (1, 2, 3, 4)])
+
+        for retry in [base & is_even, is_even & base]:
+            self.assertIsInstance(retry, tenacity.retry_all)
+            self.assertEqual([False, True, False, False], [r(retry, v) for v in (1, 2, 3, 4)])
+

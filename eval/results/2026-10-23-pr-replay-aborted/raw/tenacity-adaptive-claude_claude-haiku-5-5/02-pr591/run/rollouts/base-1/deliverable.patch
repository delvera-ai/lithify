diff --git a/tenacity/after.py b/tenacity/after.py
index a4b8922..4769895 100644
--- a/tenacity/after.py
+++ b/tenacity/after.py
@@ -39,10 +39,12 @@ def after_log(
             fn_name = "<unknown>"

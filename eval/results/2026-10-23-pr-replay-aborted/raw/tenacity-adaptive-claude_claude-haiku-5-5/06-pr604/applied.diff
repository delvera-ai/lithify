diff --git a/tests/test_tenacity.py b/tests/test_tenacity.py
index 5a90a46..5c6879b 100644
--- a/tests/test_tenacity.py
+++ b/tests/test_tenacity.py
@@ -1930,5 +1930,73 @@ class TestMockingSleep:
         assert mock_sleep.call_count == 1
 
 
+class TestEnabled(unittest.TestCase):
+    def test_retrying_disabled_calls_once_and_propagates(self) -> None:
+        calls = []
+        sleep = mock.Mock()
+
+        def _fail() -> None:
+            calls.append("x")
+            raise KeyError("Bad key")
+
+        retrying = Retrying(
+            enabled=False, sleep=sleep, stop=tenacity.stop_after_attempt(5)
+        )
+        with pytest.raises(KeyError):
+            retrying(_fail)
+        assert len(calls) == 1
+        sleep.assert_not_called()
+
+    def test_retrying_disabled_returns_result(self) -> None:
+        retrying = Retrying(enabled=False, stop=tenacity.stop_after_attempt(5))
+        assert retrying(lambda x: x * 2, 21) == 42
+
+    def test_decorator_disabled_calls_once_and_propagates(self) -> None:
+        calls = []
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(5))
+        def _fail() -> None:
+            calls.append("x")
+            raise KeyError("Bad key")
+
+        with pytest.raises(KeyError):
+            _fail()
+        assert len(calls) == 1
+
+    def test_decorator_disabled_returns_result(self) -> None:
+        @retry(enabled=False)
+        def _add(a: int, b: int) -> int:
+            return a + b
+
+        assert _add(1, b=2) == 3
+
+    def test_enabled_by_default(self) -> None:
+        assert Retrying().enabled is True
+        assert retry()(lambda: None).retry.enabled is True
+
+    def test_disabled_survives_retry_with(self) -> None:
+        @retry(enabled=False)
+        def _fail() -> None:
+            raise KeyError("Bad key")
+
+        fail_faster = _fail.retry_with(stop=tenacity.stop_after_attempt(2))
+        with pytest.raises(KeyError):
+            fail_faster()
+        assert fail_faster.retry.enabled is False
+
+    def test_retry_with_can_reenable(self) -> None:
+        calls = []
+
+        @retry(enabled=False, stop=tenacity.stop_after_attempt(3))
+        def _fail() -> None:
+            calls.append("x")
+            raise KeyError("Bad key")
+
+        reenabled = _fail.retry_with(enabled=True, wait=tenacity.wait_fixed(0))
+        with pytest.raises(RetryError):
+            reenabled()
+        assert len(calls) == 3
+
+
 if __name__ == "__main__":
     unittest.main()
